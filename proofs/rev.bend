# The reverse is an anti-automorphism
# -----------------------------------

import Base
import ../src/ring.bend as R
import ../src/spec.bend as S
import ./base.bend as B
import ./leaf.bend as L
import ./add.bend as A
import ./flags.bend as F
import ./sgn.bend as G
import ./gp.bend as P

# the signs of reversed operands come out: inv^c(y) and the signs (-1)^j,
# (-1)^k2 move into the product's flags, leaving rev(y) and inv^b(rev(x))
def Rev.nf(~T: Data, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, ~neg_neg: R.Ring.NegNeg(T, neg), ~neg_mul_l: R.Ring.NegMulL(T, mul, neg), ~neg_mul_r: R.Ring.NegMulR(T, mul, neg),
  +d: Nat, +g: Bool, +k: Bool, +j: Bool, +c: Bool, +y: S.MV(T, d), +k2: Bool, +b: Bool, +x: S.MV(T, d), +sig: S.Sig(d))
  -> {S.MV.gpf(~T, ~add, ~mul, ~neg, d, g, k, S.MV.sgn(~T, ~neg, d, j, c, True{}, y), S.MV.sgn(~T, ~neg, d, k2, b, True{}, x), sig) == S.MV.gpf(~T, ~add, ~mul, ~neg, d, Bool.xor(g, c), Bool.xor(Bool.xor(k, k2), j), S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x), sig) : S.MV(T, d)}:
    Equal.trans(S.MV(T, d), S.MV.gpf(~T, ~add, ~mul, ~neg, d, g, k, S.MV.sgn(~T, ~neg, d, j, c, True{}, y), S.MV.sgn(~T, ~neg, d, k2, b, True{}, x), sig), S.MV.gpf(~T, ~add, ~mul, ~neg, d, g, k, S.MV.sgn(~T, ~neg, d, j, c, False{}, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y)), S.MV.sgn(~T, ~neg, d, k2, False{}, False{}, S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x)), sig), S.MV.gpf(~T, ~add, ~mul, ~neg, d, Bool.xor(g, c), Bool.xor(Bool.xor(k, k2), j), S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x), sig),
      P.Gp.cong(~T, ~add, ~mul, ~neg, d, g, k, S.MV.sgn(~T, ~neg, d, j, c, True{}, y), S.MV.sgn(~T, ~neg, d, j, c, False{}, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y)), S.MV.sgn(~T, ~neg, d, k2, b, True{}, x), S.MV.sgn(~T, ~neg, d, k2, False{}, False{}, S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x)), sig,
        Equal.trans(S.MV(T, d), S.MV.sgn(~T, ~neg, d, j, c, True{}, y), S.MV.sgn(~T, ~neg, d, Bool.xor(j, False{}), Bool.xor(c, False{}), True{}, y), S.MV.sgn(~T, ~neg, d, j, c, False{}, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y)),
          G.Sgn.flag(~T, ~neg, d, j, Bool.xor(j, False{}), c, Bool.xor(c, False{}), True{}, y, Equal.sym(Bool, Bool.xor(j, False{}), j,
            F.Flag.xf(j)), Equal.sym(Bool, Bool.xor(c, False{}), c,
            F.Flag.xf(c))),
          Equal.sym(S.MV(T, d), S.MV.sgn(~T, ~neg, d, j, c, False{}, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y)), S.MV.sgn(~T, ~neg, d, Bool.xor(j, False{}), Bool.xor(c, False{}), True{}, y),
            G.Sgn.compose(~T, ~neg, ~neg_neg, d, j, c, False{}, False{}, False{}, True{}, y))),
        Equal.trans(S.MV(T, d), S.MV.sgn(~T, ~neg, d, k2, b, True{}, x), S.MV.sgn(~T, ~neg, d, Bool.xor(k2, False{}), b, True{}, x), S.MV.sgn(~T, ~neg, d, k2, False{}, False{}, S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x)),
          G.Sgn.flag(~T, ~neg, d, k2, Bool.xor(k2, False{}), b, b, True{}, x, Equal.sym(Bool, Bool.xor(k2, False{}), k2,
            F.Flag.xf(k2)), {==}),
          Equal.sym(S.MV(T, d), S.MV.sgn(~T, ~neg, d, k2, False{}, False{}, S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x)), S.MV.sgn(~T, ~neg, d, Bool.xor(k2, False{}), b, True{}, x),
            G.Sgn.compose(~T, ~neg, ~neg_neg, d, k2, False{}, False{}, False{}, b, True{}, x)))),
      Equal.trans(S.MV(T, d), S.MV.gpf(~T, ~add, ~mul, ~neg, d, g, k, S.MV.sgn(~T, ~neg, d, j, c, False{}, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y)), S.MV.sgn(~T, ~neg, d, k2, False{}, False{}, S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x)), sig), S.MV.gpf(~T, ~add, ~mul, ~neg, d, g, Bool.xor(k, k2), S.MV.sgn(~T, ~neg, d, j, c, False{}, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y)), S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x), sig), S.MV.gpf(~T, ~add, ~mul, ~neg, d, Bool.xor(g, c), Bool.xor(Bool.xor(k, k2), j), S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x), sig),
        P.Gp.sgn_r(~T, ~add, ~mul, ~neg, ~neg_mul_r, ~neg_neg, d, g, k, S.MV.sgn(~T, ~neg, d, j, c, False{}, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y)), k2, S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x), sig),
        P.Gp.sgn_l(~T, ~add, ~mul, ~neg, ~neg_mul_l, ~neg_neg, d, g, Bool.xor(k, k2), j, c, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x), sig)))

# equal flags give equal normal forms
def Rev.match(~T: Data, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, -d: Nat, -g: Bool, -g2: Bool, -k: Bool, -k2: Bool, -y: S.MV(T, d), -b: Bool, -b2: Bool, -x: S.MV(T, d), -sig: S.Sig(d),
  eg: {g == g2 : Bool}, ek: {k == k2 : Bool}, eb: {b == b2 : Bool})
  -> {S.MV.gpf(~T, ~add, ~mul, ~neg, d, g, k, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x), sig) == S.MV.gpf(~T, ~add, ~mul, ~neg, d, g2, k2, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, b2, True{}, x), sig) : S.MV(T, d)}:
  %eg : {S.MV.gpf(~T, ~add, ~mul, ~neg, d, g, k, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x), sig) == S.MV.gpf(~T, ~add, ~mul, ~neg, d, _, k2, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, b2, True{}, x), sig) : S.MV(T, d)}
  %ek : {S.MV.gpf(~T, ~add, ~mul, ~neg, d, g, k, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x), sig) == S.MV.gpf(~T, ~add, ~mul, ~neg, d, g, _, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, b2, True{}, x), sig) : S.MV(T, d)}
  %eb : {S.MV.gpf(~T, ~add, ~mul, ~neg, d, g, k, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, b, True{}, x), sig) == S.MV.gpf(~T, ~add, ~mul, ~neg, d, g, k, S.MV.sgn(~T, ~neg, d, False{}, False{}, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, _, True{}, x), sig) : S.MV(T, d)}
  {==}

# (-1)^m inv^a(rev(inv^f(x) y)), signed by n, is rev(y) times rev(x) with
# the involutions and signs carried: the reverse turns products around
def Rev.gp(~T: Data, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, ~add_comm: R.Ring.Comm(T, add), ~mul_comm: R.Ring.Comm(T, mul),
  ~neg_add: R.Ring.NegAdd(T, add, neg), ~neg_neg: R.Ring.NegNeg(T, neg),
  ~neg_mul_l: R.Ring.NegMulL(T, mul, neg), ~neg_mul_r: R.Ring.NegMulR(T, mul, neg),
  +d: Nat, +m: Bool, +a: Bool, +f: Bool, +n: Bool, x: S.MV(T, d), y: S.MV(T, d), +sig: S.Sig(d))
  -> {S.MV.sgn(~T, ~neg, d, m, a, True{}, S.MV.gpf(~T, ~add, ~mul, ~neg, d, f, n, x, y, sig)) == S.MV.gpf(~T, ~add, ~mul, ~neg, d, False{}, Bool.xor(m, n), S.MV.sgn(~T, ~neg, d, False{}, a, True{}, y), S.MV.sgn(~T, ~neg, d, False{}, Bool.xor(a, f), True{}, x), sig) : S.MV(T, d)}:
  match d:
    case 0n:
      match x:
        case S.LZ{}:
          match y:
            case S.LZ{}:
              {==}
            case S.L{v}:
              {==}
        case S.L{+u}:
          match y:
            case S.LZ{}:
              {==}
            case S.L{+v}:
              B.Leaf.cong(T, S.Ring.negf(~T, ~neg, m, S.Ring.negf(~T, ~neg, n, mul(u, v))), S.Ring.negf(~T, ~neg, Bool.xor(m, n), mul(v, u)),
                Equal.trans(T, S.Ring.negf(~T, ~neg, m, S.Ring.negf(~T, ~neg, n, mul(u, v))), S.Ring.negf(~T, ~neg, Bool.xor(m, n), mul(u, v)),
                  S.Ring.negf(~T, ~neg, Bool.xor(m, n), mul(v, u)),
                  L.Negf.negf(~T, ~neg, ~neg_neg, m, n, mul(u, v)),
                  Equal.cong(T, T, w => S.Ring.negf(~T, ~neg, Bool.xor(m, n), w), mul(u, v), mul(v, u), mul_comm(u, v))))
    case 1n+p:
      match x:
        case S.NZ{}:
          match y:
            case S.NZ{}:
              {==}
            case S.N{y1, y2}:
              {==}
        case S.N{+x1, +x2}:
          match y:
            case S.NZ{}:
              {==}
            case S.N{+y1, +y2}:
              match sig:
                case S.Gen{q, +rest}:
                  match q:
                    case S.QZ{}:
                      Equal.trans(S.MV(T, 1n+p), S.MV.sgn(~T, ~neg, 1n+p, m, a, True{}, S.MV.mk(T, p, S.MV.add(~T, ~add, p, S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, Bool.xor(n, f), x1, y2, rest), S.MV.gpf(~T, ~add, ~mul, ~neg, p, Bool.not(f), n, x2, y1, rest)), S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, n, x2, y2, rest))), S.MV.mk(T, p, S.MV.add(~T, ~add, p, S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(Bool.xor(m, a), Bool.xor(n, f)), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, True{}), True{}, y2), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(Bool.xor(a, True{}), f), True{}, x1), rest), S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(Bool.xor(m, a), n), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, True{}), True{}, y1), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(Bool.xor(a, True{}), Bool.not(f)), True{}, x2), rest)), S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(m, n), S.MV.sgn(~T, ~neg, p, False{}, a, True{}, y2), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, f), True{}, x2), rest)), S.MV.mk(T, p, S.MV.add(~T, ~add, p, S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(Bool.xor(m, n), False{}), S.MV.sgn(~T, ~neg, p, a, Bool.xor(a, True{}), True{}, y1), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, f), True{}, x2), rest), S.MV.gpf(~T, ~add, ~mul, ~neg, p, True{}, Bool.xor(m, n), S.MV.sgn(~T, ~neg, p, False{}, a, True{}, y2), S.MV.sgn(~T, ~neg, p, Bool.xor(a, f), Bool.xor(Bool.xor(a, f), True{}), True{}, x1), rest)), S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(m, n), S.MV.sgn(~T, ~neg, p, False{}, a, True{}, y2), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, f), True{}, x2), rest)),
                          Equal.trans(S.MV(T, 1n+p), S.MV.sgn(~T, ~neg, 1n+p, m, a, True{}, S.MV.mk(T, p, S.MV.add(~T, ~add, p, S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, Bool.xor(n, f), x1, y2, rest), S.MV.gpf(~T, ~add, ~mul, ~neg, p, Bool.not(f), n, x2, y1, rest)), S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, n, x2, y2, rest))), S.MV.mk(T, p, S.MV.sgn(~T, ~neg, p, Bool.xor(m, a), Bool.xor(a, True{}), True{}, S.MV.add(~T, ~add, p, S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, Bool.xor(n, f), x1, y2, rest), S.MV.gpf(~T, ~add, ~mul, ~neg, p, Bool.not(f), n, x2, y1, rest))), S.MV.sgn(~T, ~neg, p, m, a, True{}, S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, n, x2, y2, rest))), S.MV.mk(T, p, S.MV.add(~T, ~add, p, S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(Bool.xor(m, a), Bool.xor(n, f)), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, True{}), True{}, y2), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(Bool.xor(a, True{}), f), True{}, x1), rest), S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(Bool.xor(m, a), n), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, True{}), True{}, y1), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(Bool.xor(a, True{}), Bool.not(f)), True{}, x2), rest)), S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(m, n), S.MV.sgn(~T, ~neg, p, False{}, a, True{}, y2), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, f), True{}, x2), rest)),
                            G.Sgn.mk(~T, ~neg, p, m, a, True{}, S.MV.add(~T, ~add, p, S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, Bool.xor(n, f), x1, y2, rest), S.MV.gpf(~T, ~add, ~mul, ~neg, p, Bool.not(f), n, x2, y1, rest)), S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, n, x2, y2, rest)),
                            P.Mk.cong(T, p, S.MV.sgn(~T, ~neg, p, Bool.xor(m, a), Bool.xor(a, True{}), True{}, S.MV.add(~T, ~add, p, S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, Bool.xor(n, f), x1, y2, rest), S.MV.gpf(~T, ~add, ~mul, ~neg, p, Bool.not(f), n, x2, y1, rest))), S.MV.add(~T, ~add, p, S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(Bool.xor(m, a), Bool.xor(n, f)), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, True{}), True{}, y2), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(Bool.xor(a, True{}), f), True{}, x1), rest), S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(Bool.xor(m, a), n), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, True{}), True{}, y1), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(Bool.xor(a, True{}), Bool.not(f)), True{}, x2), rest)), S.MV.sgn(~T, ~neg, p, m, a, True{}, S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, n, x2, y2, rest)), S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(m, n), S.MV.sgn(~T, ~neg, p, False{}, a, True{}, y2), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, f), True{}, x2), rest),
                              Equal.trans(S.MV(T, p), S.MV.sgn(~T, ~neg, p, Bool.xor(m, a), Bool.xor(a, True{}), True{}, S.MV.add(~T, ~add, p, S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, Bool.xor(n, f), x1, y2, rest), S.MV.gpf(~T, ~add, ~mul, ~neg, p, Bool.not(f), n, x2, y1, rest))), S.MV.add(~T, ~add, p, S.MV.sgn(~T, ~neg, p, Bool.xor(m, a), Bool.xor(a, True{}), True{}, S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, Bool.xor(n, f), x1, y2, rest)), S.MV.sgn(~T, ~neg, p, Bool.xor(m, a), Bool.xor(a, True{}), True{}, S.MV.gpf(~T, ~add, ~mul, ~neg, p, Bool.not(f), n, x2, y1, rest))), S.MV.add(~T, ~add, p, S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(Bool.xor(m, a), Bool.xor(n, f)), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, True{}), True{}, y2), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(Bool.xor(a, True{}), f), True{}, x1), rest), S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(Bool.xor(m, a), n), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, True{}), True{}, y1), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(Bool.xor(a, True{}), Bool.not(f)), True{}, x2), rest)),
                                G.Sgn.add(~T, ~add, ~neg, ~neg_add, p, Bool.xor(m, a), Bool.xor(a, True{}), True{}, S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, Bool.xor(n, f), x1, y2, rest), S.MV.gpf(~T, ~add, ~mul, ~neg, p, Bool.not(f), n, x2, y1, rest)),
                                A.Add.cong(~T, ~add, p, S.MV.sgn(~T, ~neg, p, Bool.xor(m, a), Bool.xor(a, True{}), True{}, S.MV.gpf(~T, ~add, ~mul, ~neg, p, f, Bool.xor(n, f), x1, y2, rest)), S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(Bool.xor(m, a), Bool.xor(n, f)), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, True{}), True{}, y2), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(Bool.xor(a, True{}), f), True{}, x1), rest), S.MV.sgn(~T, ~neg, p, Bool.xor(m, a), Bool.xor(a, True{}), True{}, S.MV.gpf(~T, ~add, ~mul, ~neg, p, Bool.not(f), n, x2, y1, rest)), S.MV.gpf(~T, ~add, ~mul, ~neg, p, False{}, Bool.xor(Bool.xor(m, a), n), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(a, True{}), True{}, y1), S.MV.sgn(~T, ~neg, p, False{}, Bool.xor(Bool.xor(a, True{}), Bool.not(f)), True{}, x2), rest), Rev.gp(~T, ~add, ~mul, ~neg, ~add_comm, ~mul_comm, ~neg_add, ~neg_neg, ~neg_mul_l, ~neg_mul_r, p, Bool.xor(m, a), Bool.xor(a, True{}), f, Bool.xor(n, f), x1, y2, rest), Rev.gp(~T, ~add, ~mul, ~neg, ~add_comm, ~mul_comm, ~neg_add, ~neg_neg, ~neg_mul_l, ~neg_mul_r, p, Bool.xor(m, a), Bool.xor(a, True{}), Bool.not(f), n, x2, y1, rest))),
