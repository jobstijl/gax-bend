    case N.TMul{+a, +b}:
      Le.trans(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~rnd, ~pos_eps, ~rnd_ok, abs(mul(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a), N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b))), mul(abs(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a)), abs(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b))), mul(E.Tm.absev(~T, ~zero, ~add, ~mul, ~abs, env, a), E.Tm.absev(~T, ~zero, ~add, ~mul, ~abs, env, b)), Le.eq(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~rnd, ~pos_eps, ~rnd_ok, abs(mul(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a), N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b))), mul(abs(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a)), abs(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b))), abs_mul(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a), N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b))), Le.mul2(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~rnd, ~pos_eps, ~rnd_ok, abs(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a)), E.Tm.absev(~T, ~zero, ~add, ~mul, ~abs, env, a), abs(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b)), E.Tm.absev(~T, ~zero, ~add, ~mul, ~abs, env, b), Ev.le(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~rnd, ~pos_eps, ~rnd_ok, env, a), Ev.le(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~rnd, ~pos_eps, ~rnd_ok, env, b), pos_abs(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b)), Absev.pos(~T, ~zero, ~one, ~add, ~mul, ~ne