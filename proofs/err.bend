    case N.TNeg{+a}:
      Le.trans(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps, abs(neg(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a))), abs(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a)), E.Tm.absev(~T, ~zero, ~add, ~mul, ~abs, env, a), Le.eq(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps, abs(neg(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a))), abs(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a)), abs_neg(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a))), Ev.le(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps, env, a))

# The theorem
# -----------

# |computed(t) - eval(t)| <= h(k(t)) absev(t), additions computed by fadd
# and products by fmul, each within eps |x| of exact
def Err.bound(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  ~pos: T -> Bool, ~abs: T -> T, ~pos_add: E.Ord.PosAdd(T, add, pos), ~pos_mul: E.Ord.PosMul(T, mul, pos), ~pos_abs: E.Ord.PosAbs(T, abs, pos),
  ~tri: E.Ord.Tri(T, add, neg, abs, pos), ~abs_mul: E.Ord.AbsMul(T, mul, abs), ~abs_neg: E.Ord.AbsNeg(T, neg, abs), ~abs_zero: {abs(zero) == zero : T},
  ~eps: T, ~pos_eps: {pos(eps) == True{} : Bool}, ~fadd: T -> T -> T, ~fmul: T -> T -> T, ~fadd_ok: E.Ord.Rel(T, add, mul, neg, abs, pos, eps, add, fadd), ~fmul_ok: E.Ord.Rel(T, add, mul, neg, abs, pos, eps, mul, fmul), +env: List<&2, T>, t: N.Tm) -> {pos(add(mul(E.Err.H(~T, ~zero, ~one, ~add, ~mul, ~eps, E.Tm.k(t)), E.Tm.absev(~T, ~zero, ~add, ~mul, ~abs, env, t)), neg(abs(add(N.Tm.eval(~T, ~zero, ~fadd, ~fmul, ~neg, env, t), neg(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, t))))))) == True{} : Bool}:
