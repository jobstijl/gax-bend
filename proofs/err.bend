# The rounding error of every term (ADR-005, docs/numerics.md): for an
# ordered commutative ring T and a rounding function rnd satisfying the
# standard model |rnd(x) - x| <= eps |x|,
#   |fl(t) - eval(t)| <= h(k(t)) absev(t),
# with h(k) = (1 + eps)^k - 1 (src/err.bend). Order is positivity: a <= b
# means pos(b - a), and each step is a ring identity (the normaliser) over
# nonnegative pieces.

import Base
import ../src/ring.bend as R
import ../src/norm.bend as N
import ../src/err.bend as E
import ./norm.bend as NP

# Order
# -----

def Pos.rw(~T: Data, ~pos: T -> Bool, -s: T, -t: T, e: {s == t : T}, +p: {pos(s) == True{} : Bool}) -> {pos(t) == True{} : Bool}:
  %e : {pos(_) == True{} : Bool}
  p
def Pos.zero(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  ~pos: T -> Bool, ~abs: T -> T, ~pos_add: E.Ord.PosAdd(T, add, pos), ~pos_mul: E.Ord.PosMul(T, mul, pos), ~pos_abs: E.Ord.PosAbs(T, abs, pos),
  ~tri: E.Ord.Tri(T, add, neg, abs, pos), ~abs_mul: E.Ord.AbsMul(T, mul, abs), ~abs_neg: E.Ord.AbsNeg(T, neg, abs), ~abs_zero: {abs(zero) == zero : T},
  ~eps: T, ~rnd: T -> T, ~pos_eps: {pos(eps) == True{} : Bool}, ~rnd_ok: E.Ord.Rnd(T, add, mul, neg, abs, pos, eps, rnd)) -> {pos(zero) == True{} : Bool}:
  Pos.rw(~T, ~pos, abs(zero), zero, abs_zero, pos_abs(zero))

def Le.refl(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  ~pos: T -> Bool, ~abs: T -> T, ~pos_add: E.Ord.PosAdd(T, add, pos), ~pos_mul: E.Ord.PosMul(T, mul, pos), ~pos_abs: E.Ord.PosAbs(T, abs, pos),
  ~tri: E.Ord.Tri(T, add, neg, abs, pos), ~abs_mul: E.Ord.AbsMul(T, mul, abs), ~abs_neg: E.Ord.AbsNeg(T, neg, abs), ~abs_zero: {abs(zero) == zero : T},
  ~eps: T, ~rnd: T -> T, ~pos_eps: {pos(eps) == True{} : Bool}, ~rnd_ok: E.Ord.Rnd(T, add, mul, neg, abs, pos, eps, rnd), +a: T) -> {pos(add(a, neg(a))) == True{} : Bool}:
  Pos.rw(~T, ~pos, zero, add(a, neg(a)), Equal.sym(T, add(a, neg(a)), zero, inv(a)), Pos.zero(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~rnd, ~pos_eps, ~rnd_ok))

def Le.eq(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  ~pos: T -> Bool, ~abs: T -> T, ~pos_add: E.Ord.PosAdd(T, add, pos), ~pos_mul: E.Ord.PosMul(T, mul, pos), ~pos_abs: E.Ord.PosAbs(T, abs, pos),
  ~tri: E.Ord.Tri(T, add, neg, abs, pos), ~abs_mul: E.Ord.AbsMul(T, mul, abs), ~abs_neg: E.Ord.AbsNeg(T, neg, abs), ~abs_zero: {abs(zero) == zero : T},
  ~eps: T, ~rnd: T -> T, ~pos_eps: {pos(eps) == True{} : Bool}, ~rnd_ok: E.Ord.Rnd(T, add, mul, neg, abs, pos, eps, rnd), +a: T, -b: T, e: {a == b : T}) -> {pos(add(b, neg(a))) == True{} : Bool}:
  %e : {pos(add(_, neg(a))) == True{} : Bool}
  Le.refl(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~rnd, ~pos_eps, ~rnd_ok, a)

def Le.trans(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  ~pos: T -> Bool, ~abs: T -> T, ~pos_add: E.Ord.PosAdd(T, add, pos), ~pos_mul: E.Ord.PosMul(T, mul, pos), ~pos_abs: E.Ord.PosAbs(T, abs, pos),
  ~tri: E.Ord.Tri(T, add, neg, abs, pos), ~abs_mul: E.Ord.AbsMul(T, mul, abs), ~abs_neg: E.Ord.AbsNeg(T, neg, abs), ~abs_zero: {abs(zero) == zero : T},
  ~eps: T, ~rnd: T -> T, ~pos_eps: {pos(eps) == True{} : Bool}, ~rnd_ok: E.Ord.Rnd(T, add, mul, neg, abs, pos, eps, rnd), +x: T, +y: T, +w3: T, +p: {pos(add(y, neg(x))) == True{} : Bool}, +q: {pos(add(w3, neg(y))) == True{} : Bool}) -> {pos(add(w3, neg(x))) == True{} : Bool}:
  Pos.rw(~T, ~pos, add(add(w3, neg(y)), add(y, neg(x))), add(w3, neg(x)), NP.Norm.eq(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [x, y, w3], N.TAdd{N.TAdd{N.TVar{2n}, N.TNeg{N.TVar{1n}}}, N.TAdd{N.TVar{1n}, N.TNeg{N.TVar{0n}}}}, N.TAdd{N.TVar{2n}, N.TNeg{N.TVar{0n}}}, {==}), pos_add(add(w3, neg(y)), add(y, neg(x)), q, p))

def Le.add(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
