  ~tri: E.Ord.Tri(T, add, neg, abs, pos), ~abs_mul: E.Ord.AbsMul(T, mul, abs), ~abs_neg: E.Ord.AbsNeg(T, neg, abs), ~abs_zero: {abs(zero) == zero : T},
  ~eps: T, ~rnd: T -> T, ~pos_eps: {pos(eps) == True{} : Bool}, ~rnd_ok: E.Ord.Rnd(T, add, mul, neg, abs, pos, eps, rnd), +x1: T, +y1: T, +x2: T, +y2: T, +p1: {pos(add(y1, neg(x1))) == True{} : Bool}, +p2: {pos(add(y2, neg(x2))) == True{} : Bool}) -> {pos(add(add(y1, y2), neg(add(x1, x2)))) == True{} : Bool}:
  Pos.rw(~T, ~pos, add(add(y1, neg(x1)), add(y2, neg(x2))), add(add(y1, y2), neg(add(x1, x2))), NP.Norm.eq(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [x1, y1, x2, y2], N.TAdd{N.TAdd{N.TVar{1n}, N.TNeg{N.TVar{0n}}}, N.TAdd{N.TVar{3n}, N.TNeg{N.TVar{2n}}}}, N.TAdd{N.TAdd{N.TVar{1n}, N.TVar{3n}}, N.TNeg{N.TAdd{N.TVar{0n}, N.TVar{2n}}}}, {==}), pos_add(add(y1, neg(x1)), add(y2, neg(x2)), p1, p2))

