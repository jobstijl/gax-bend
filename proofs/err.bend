  ~eps: T, ~rnd: T -> T, ~pos_eps: {pos(eps) == True{} : Bool}, ~rnd_ok: E.Ord.Rnd(T, add, mul, neg, abs, pos, eps, rnd), +c: T, +x: T, +y: T, +pc: {pos(c) == True{} : Bool}, +p: {pos(add(y, neg(x))) == True{} : Bool}) -> {pos(add(mul(c, y), neg(mul(c, x)))) == True{} : Bool}:
  Pos.rw(~T, ~pos, mul(c, add(y, neg(x))), add(mul(c, y), neg(mul(c, x))), NP.Norm.eq(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [c, x, y], N.TMul{N.TVar{0n}, N.TAdd{N.TVar{2n}, N.TNeg{N.TVar{1n}}}}, N.TAdd{N.TMul{N.TVar{0n}, N.TVar{2n}}, N.TNeg{N.TMul{N.TVar{0n}, N.TVar{1n}}}}, {==}), pos_mul(c, add(y, neg(x)), pc, p))

