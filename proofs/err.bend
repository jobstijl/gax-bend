  ~tri: E.Ord.Tri(T, add, neg, abs, pos), ~abs_mul: E.Ord.AbsMul(T, mul, abs), ~abs_neg: E.Ord.AbsNeg(T, neg, abs), ~abs_zero: {abs(zero) == zero : T},
  ~eps: T, ~rnd: T -> T, ~pos_eps: {pos(eps) == True{} : Bool}, ~rnd_ok: E.Ord.Rnd(T, add, mul, neg, abs, pos, eps, rnd), +c: T, +x: T, +y: T, +pc: {pos(c) == True{} : Bool}, +p: {pos(add(y, neg(x))) == True{} : Bool}) -> {pos(add(mul(y, c), neg(mul(x, c)))) == True{} : Bool}:
  Pos.rw(~T, ~pos, mul(add(y, neg(x)), c), add(mul(y, c), neg(mul(x, c))), NP.Norm.eq(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [c, x, y], N.TMul{N.TAdd{N.TVar{2n}, N.TNeg{N.TVar{1n}}}, N.TVar{0n}}, N.TAdd{N.TMul{N.TVar{2n}, N.TVar{0n}}, N.TNeg{N.TMul{N.TVar{1n}, N.TVar{0n}}}}, {==}), pos_mul(add(y, neg(x)), c, p, pc))

def Le.zero(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
