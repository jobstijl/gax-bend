# Approximate inputs carried through a term (src/approx.bend): if every
# input moves by at most del_i, a term's value moves by at most Tm.dev, and
# a computed run at the moved inputs is within h(k) A' + dev of the exact
# value at the exact inputs. Kernel by kernel: algebras/*/approx.bend.

import Base
import ../src/ring.bend as R
import ../src/norm.bend as N
import ../src/err.bend as E
import ../src/approx.bend as AP
import ./base.bend as B
import ./norm.bend as NP
import ./err.bend as ER

# |0 - 0| <= 0
def Zero.le(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  ~pos: T -> Bool, ~abs: T -> T, ~pos_add: E.Ord.PosAdd(T, add, pos), ~pos_mul: E.Ord.PosMul(T, mul, pos), ~pos_abs: E.Ord.PosAbs(T, abs, pos),
  ~tri: E.Ord.Tri(T, add, neg, abs, pos), ~abs_mul: E.Ord.AbsMul(T, mul, abs), ~abs_neg: E.Ord.AbsNeg(T, neg, abs), ~abs_zero: {abs(zero) == zero : T},
  ~eps: T, ~pos_eps: {pos(eps) == True{} : Bool}) -> {pos(add(zero, neg(abs(add(zero, neg(zero)))))) == True{} : Bool}:
  ER.Le.trans(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps, abs(add(zero, neg(zero))), zero, zero, ER.Le.eq(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps, abs(add(zero, neg(zero))), zero, Equal.trans(T, abs(add(zero, neg(zero))), abs(zero), zero, Equal.cong(T, T, w => abs(w), add(zero, neg(zero)), zero, inv(zero)), abs_zero)), ER.Le.refl(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps, zero))

# an input's own bound, from Close
def Close.at(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  ~pos: T -> Bool, ~abs: T -> T, ~pos_add: E.Ord.PosAdd(T, add, pos), ~pos_mul: E.Ord.PosMul(T, mul, pos), ~pos_abs: E.Ord.PosAbs(T, abs, pos),
  ~tri: E.Ord.Tri(T, add, neg, abs, pos), ~abs_mul: E.Ord.AbsMul(T, mul, abs), ~abs_neg: E.Ord.AbsNeg(T, neg, abs), ~abs_zero: {abs(zero) == zero : T},
  ~eps: T, ~pos_eps: {pos(eps) == True{} : Bool},
  +env2: List<&2, T>, +env: List<&2, T>, +del: List<&2, T>, +i: Nat, +hc: {AP.Close(~T, ~add, ~neg, ~abs, ~pos, env2, env, del) == True{} : Bool})
  -> {pos(add(N.Env.at(~T, ~zero, del, i), neg(abs(add(N.Env.at(~T, ~zero, env2, i), neg(N.Env.at(~T, ~zero, env, i))))))) == True{} : Bool}:
  match env2:
    case Nil{}:
      match env:
        case Nil{}:
          match del:
            case Nil{}:
              Zero.le(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps)
            case d <> dt:
              B.Bool.tf({pos(add(N.Env.at(~T, ~zero, d <> dt, i), neg(abs(add(N.Env.at(~T, ~zero, Nil{}, i), neg(N.Env.at(~T, ~zero, Nil{}, i))))))) == True{} : Bool}, Equal.sym(Bool, False{}, True{}, hc))
        case x <> xt:
          B.Bool.tf({pos(add(N.Env.at(~T, ~zero, del, i), neg(abs(add(N.Env.at(~T, ~zero, Nil{}, i), neg(N.Env.at(~T, ~zero, x <> xt, i))))))) == True{} : Bool}, Equal.sym(Bool, False{}, True{}, hc))
    case +x2 <> +t2:
      match env:
        case Nil{}:
          B.Bool.tf({pos(add(N.Env.at(~T, ~zero, del, i), neg(abs(add(N.Env.at(~T, ~zero, x2 <> t2, i), neg(N.Env.at(~T, ~zero, Nil{}, i))))))) == True{} : Bool}, Equal.sym(Bool, False{}, True{}, hc))
        case +x <> +xt:
          match del:
            case Nil{}:
              B.Bool.tf({pos(add(N.Env.at(~T, ~zero, Nil{}, i), neg(abs(add(N.Env.at(~T, ~zero, x2 <> t2, i), neg(N.Env.at(~T, ~zero, x <> xt, i))))))) == True{} : Bool}, Equal.sym(Bool, False{}, True{}, hc))
            case +d <> +dt:
              match i:
                case 0n:
                  NP.Bool.and_l(pos(add(d, neg(abs(add(x2, neg(x)))))), AP.Close(~T, ~add, ~neg, ~abs, ~pos, t2, xt, dt), hc)
                case 1n+(+j):
                  Close.at(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps, t2, xt, dt, j, NP.Bool.and_r(pos(add(d, neg(abs(add(x2, neg(x)))))), AP.Close(~T, ~add, ~neg, ~abs, ~pos, t2, xt, dt), hc))

# the deviation bound: |eval(env2, t) - eval(env, t)| <= dev(env, del, t)
def Prop.bound(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  ~pos: T -> Bool, ~abs: T -> T, ~pos_add: E.Ord.PosAdd(T, add, pos), ~pos_mul: E.Ord.PosMul(T, mul, pos), ~pos_abs: E.Ord.PosAbs(T, abs, pos),
  ~tri: E.Ord.Tri(T, add, neg, abs, pos), ~abs_mul: E.Ord.AbsMul(T, mul, abs), ~abs_neg: E.Ord.AbsNeg(T, neg, abs), ~abs_zero: {abs(zero) == zero : T},
  ~eps: T, ~pos_eps: {pos(eps) == True{} : Bool},
  +env2: List<&2, T>, +env: List<&2, T>, +del: List<&2, T>, +hc: {AP.Close(~T, ~add, ~neg, ~abs, ~pos, env2, env, del) == True{} : Bool}, t: N.Tm)
  -> {pos(add(AP.Tm.dev(~T, ~zero, ~add, ~mul, ~abs, env, del, t), neg(abs(add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, t), neg(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, t))))))) == True{} : Bool}:
  match t:
    case N.TVar{+i}:
      Close.at(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps, env2, env, del, i, hc)
    case N.TZero{}:
      Zero.le(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps)
    case N.TAdd{+a, +b}:
      ER.Le.trans(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps, abs(add(add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, a), N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, b)), neg(add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a), N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b))))), abs(add(add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, a), neg(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a))), add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, b), neg(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b))))), add(AP.Tm.dev(~T, ~zero, ~add, ~mul, ~abs, env, del, a), AP.Tm.dev(~T, ~zero, ~add, ~mul, ~abs, env, del, b)), ER.Le.eq(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps, abs(add(add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, a), N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, b)), neg(add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a), N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b))))), abs(add(add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, a), neg(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a))), add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, b), neg(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b))))), Equal.cong(T, T, w => abs(w), add(add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, a), N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, b)), neg(add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a), N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b)))), add(add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, a), neg(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, a))), add(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2, b), neg(N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env, b)))), NP.Norm.eq(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [N.Tm.eval(~T, ~zero, ~add, ~mul, ~neg, env2,