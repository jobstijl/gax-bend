# every field of a kernel at once (algebras/*/approx.bend)
def Err.fields_a(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  ~pos: T -> Bool, ~abs: T -> T, ~pos_add: E.Ord.PosAdd(T, add, pos), ~pos_mul: E.Ord.PosMul(T, mul, pos), ~pos_abs: E.Ord.PosAbs(T, abs, pos),
  ~tri: E.Ord.Tri(T, add, neg, abs, pos), ~abs_mul: E.Ord.AbsMul(T, mul, abs), ~abs_neg: E.Ord.AbsNeg(T, neg, abs), ~abs_zero: {abs(zero) == zero : T},
  ~eps: T, ~pos_eps: {pos(eps) == True{} : Bool},
  ~fadd: T -> T -> T, ~fmul: T -> T -> T, ~fadd_ok: E.Ord.Rel(T, add, mul, neg, abs, pos, eps, add, fadd), ~fmul_ok: E.Ord.Rel(T, add, mul, neg, abs, pos, eps, mul, fmul),
  +env2: List<&2, T>, +env: List<&2, T>, +del: List<&2, T>, +hc: {AP.Close(~T, ~add, ~neg, ~abs, ~pos, env2, env, del) == True{} : Bool}, ts: List<&2, N.Tm>)
  -> AP.Err.Fields_a(~T, ~zero, ~one, ~add, ~mul, ~neg, ~pos, ~abs, ~eps, E.Tm.evals(~T, ~zero, ~fadd, ~fmul, ~neg, env2, ts), E.Tm.evals(~T, ~zero, ~add, ~mul, ~neg, env, ts),
    E.Tm.absevs(~T, ~zero, ~add, ~mul, ~abs, env2, ts), AP.Tm.devs(~T, ~zero, ~add, ~mul, ~abs, env, del, ts), E.Tm.ks(ts)):
  match ts:
    case Nil{}:
      Unit{}
    case +t <> r:
      (Err.approx(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps, ~fadd, ~fmul, ~fadd_ok, ~fmul_ok, env2, env, del, hc, t), Err.fields_a(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, ~pos, ~abs, ~pos_add, ~pos_mul, ~pos_abs, ~tri, ~abs_mul, ~abs_neg, ~abs_zero, ~eps, ~pos_eps, ~fadd, ~fmul, ~fadd_ok, ~fmul_ok, env2, env, del, hc, r))
