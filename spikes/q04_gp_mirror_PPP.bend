# Q4 (generated by gen_q04.py PPP), Layer S copied from q03:
# Q3: a type-level MV(T, sig) as parameter and result of recursive live defs.
# Fuchs-Thery tree: a level for generator e holds N{x1, x2} = e*x1 + x2, Z{} = 0.
# gp(sig, f, n, x, y) = (-1)^n * inv^f(x) * y, the grade involution passed down
# as the flag f, the sign as the flag n, so no negated subtree is ever built.
import Base

type Q is Data:
  QP{}
  QN{}
  QZ{}

type S<-T: Data> is Data:
  S0{}
  S1{x: T}

type Lv<-A: Data> is Data:
  Z{}
  N{e: A, r: A}

def MV(T: Data, sig: List<&2, Q>) -> Data:
  match sig:
    case Nil{}:
      S<T>
    case Con{q, +rest}:
      Lv<MV(T, rest)>

def MV.add(~T: Data, ~add: T -> T -> T, sig: List<&2, Q>, a: MV(T, sig), b: MV(T, sig)) -> MV(T, sig):
  match sig:
    case Nil{}:
      match a:
        case S0{}:
          b
        case S1{x}:
          match b:
            case S0{}:
              S1{x}
            case S1{y}:
              S1{add(x, y)}
    case Con{q, +rest}:
      match a:
        case Z{}:
          b
        case N{a1, a2}:
          match b:
            case Z{}:
              N{a1, a2}
            case N{b1, b2}:
              N{MV.add(~T, ~add, rest, a1, b1), MV.add(~T, ~add, rest, a2, b2)}

def Leaf.mul(~T: Data, ~mul: T -> T -> T, ~neg: T -> T, n: Bool, a: T, b: T) -> T:
  match n:
    case False{}:
      mul(a, b)
    case True{}:
      neg(mul(a, b))

def MV.gp(~T: Data, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  sig: List<&2, Q>, +f: Bool, +n: Bool, x: MV(T, sig), y: MV(T, sig)) -> MV(T, sig):
  match sig:
    case Nil{}:
      match x:
        case S0{}:
          S0{}
        case S1{a}:
          match y:
            case S0{}:
              S0{}
            case S1{b}:
              S1{Leaf.mul(~T, ~mul, ~neg, n, a, b)}
    case Con{q, +rest}:
      match q:
        case QZ{}:
          match x:
            case Z{}:
              Z{}
            case N{x1, +x2}:
              match y:
                case Z{}:
                  Z{}
                case N{y1, +y2}:
                  +nf = Bool.xor(n, f)
                  e = MV.add(~T, ~add, rest, MV.gp(~T, ~add, ~mul, ~neg, rest, f, nf, x1, y2), MV.gp(~T, ~add, ~mul, ~neg, rest, Bool.not(f), n, x2, y1))
                  r2 = MV.gp(~T, ~add, ~mul, ~neg, rest, f, n, x2, y2)
                  N{e, r2}
        case QP{}:
          match x:
            case Z{}:
              Z{}
            case N{+x1, +x2}:
              match y:
                case Z{}:
                  Z{}
                case N{+y1, +y2}:
                  +nf = Bool.xor(n, f)
                  e = MV.add(~T, ~add, rest, MV.gp(~T, ~add, ~mul, ~neg, rest, f, nf, x1, y2), MV.gp(~T, ~add, ~mul, ~neg, rest, Bool.not(f), n, x2, y1))
                  r2 = MV.gp(~T, ~add, ~mul, ~neg, rest, f, n, x2, y2)
                  N{e, MV.add(~T, ~add, rest, MV.gp(~T, ~add, ~mul, ~neg, rest, Bool.not(f), nf, x1, y1), r2)}
        case QN{}:
          match x:
            case Z{}:
              Z{}
            case N{+x1, +x2}:
              match y:
                case Z{}:
                  Z{}
                case N{+y1, +y2}:
                  +nf = Bool.xor(n, f)
                  e = MV.add(~T, ~add, rest, MV.gp(~T, ~add, ~mul, ~neg, rest, f, nf, x1, y2), MV.gp(~T, ~add, ~mul, ~neg, rest, Bool.not(f), n, x2, y1))
                  r2 = MV.gp(~T, ~add, ~mul, ~neg, rest, f, n, x2, y2)
                  N{e, MV.add(~T, ~add, rest, MV.gp(~T, ~add, ~mul, ~neg, rest, Bool.not(f), Bool.not(nf), x1, y1), r2)}

def U32.neg(a: U32) -> U32:
  (0 - a : U32)

def gp2(sig: List<&2, Q>, x: MV(U32, sig), y: MV(U32, sig)) -> MV(U32, sig):
  MV.gp(~U32, ~U32.add, ~U32.mul, ~U32.neg, sig, False{}, False{}, x, y)

def E2() -> List<&2, Q>:
  [QP{}, QP{}]

def e1() -> MV(U32, E2()):
  N{N{S0{}, S1{1}}, Z{}}

def e2() -> MV(U32, E2()):
  N{Z{}, N{S1{1}, S0{}}}


def Sig() -> List<&2, Q>:
  [QP{}, QP{}, QP{}]

type Flat<-T: Data> is Data:
  Flat{c0: T, c1: T, c2: T, c3: T, c4: T, c5: T, c6: T, c7: T}

def Flat.tree(-T: Data, x: Flat<T>) -> MV(T, Sig()):
  match x:
    case Flat{a0, a1, a2, a3, a4, a5, a6, a7}:
      N{N{N{S1{a0}, S1{a1}}, N{S1{a2}, S1{a3}}}, N{N{S1{a4}, S1{a5}}, N{S1{a6}, S1{a7}}}}

# the mirror kernel: 64 multiplies
def Flat.gp(~T: Data, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, x: Flat<T>, y: Flat<T>) -> Flat<T>:
  match x y:
    case Flat{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7} Flat{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7}:
      Flat{add(add(add(mul(a0, b7), mul(a1, b6)), add(neg(mul(a2, b5)), mul(a3, b4))), add(add(mul(a4, b3), neg(mul(a5, b2))), add(mul(a6, b1), mul(a7, b0)))), add(add(add(mul(a0, b6), mul(a1, b7)), add(neg(mul(a2, b4)), mul(a3, b5))), add(add(mul(a4, b2), neg(mul(a5, b3))), add(mul(a6, b0), mul(a7, b1)))), add(add(add(neg(mul(a0, b5)), mul(a1, b4)), add(mul(a2, b7), mul(a3, b6))), add(add(neg(mul(a4, b1)), neg(mul(a5, b0))), add(neg(mul(a6, b3)), mul(a7, b2)))), add(add(add(neg(mul(a0, b4)), mul(a1, b5)), add(mul(a2, b6), mul(a3, b7))), add(add(neg(mul(a4, b0)), neg(mul(a5, b1))), add(neg(mul(a6, b2)), mul(a7, b3)))), add(add(add(mul(a0, b3), neg(mul(a1, b2))), add(mul(a2, b1), mul(a3, b0))), add(add(mul(a4, b7), mul(a5, b6)), add(neg(mul(a6, b5)), mul(a7, b4)))), add(add(add(mul(a0, b2), neg(mul(a1, b3))), add(mul(a2, b0), mul(a3, b1))), add(add(mul(a4, b6), mul(a5, b7)), add(neg(mul(a6, b4)), mul(a7, b5)))), add(add(add(neg(mul(a0, b1)), neg(mul(a1, b0))), add(neg(mul(a2, b3)), mul(a3, b2))), add(add(neg(mul(a4, b5)), mul(a5, b4)), add(mul(a6, b7), mul(a7, b6)))), add(add(add(neg(mul(a0, b0)), neg(mul(a1, b1))), add(neg(mul(a2, b2)), mul(a3, b3))), add(add(neg(mul(a4, b4)), mul(a5, b5)), add(mul(a6, b6), mul(a7, b7))))}

law gp_mirror:
  for ~T: Data
  for ~add: T -> T -> T
  for ~mul: T -> T -> T
  for ~neg: T -> T
  for x: Flat<T>
  for y: Flat<T>
  {Flat.tree(T, Flat.gp(~T, ~add, ~mul, ~neg, x, y)) == MV.gp(~T, ~add, ~mul, ~neg, Sig(), False{}, False{}, Flat.tree(T, x), Flat.tree(T, y)) : MV(T, Sig())}

def gp_mirror(T, add, mul, neg, x, y):
  match x y:
    case Flat{a0, a1, a2, a3, a4, a5, a6, a7} Flat{b0, b1, b2, b3, b4, b5, b6, b7}:
      {==}
