# Q4 (generated by gen_q04.py PPPP), Layer S copied from q03:
# Q3: a type-level MV(T, sig) as parameter and result of recursive live defs.
# Fuchs-Thery tree: a level for generator e holds N{x1, x2} = e*x1 + x2, Z{} = 0.
# gp(sig, f, n, x, y) = (-1)^n * inv^f(x) * y, the grade involution passed down
# as the flag f, the sign as the flag n, so no negated subtree is ever built.
import Base

type Q is Data:
  QP{}
  QN{}
  QZ{}

type S<-T: Data> is Data:
  S0{}
  S1{x: T}

type Lv<-A: Data> is Data:
  Z{}
  N{e: A, r: A}

def MV(T: Data, sig: List<&2, Q>) -> Data:
  match sig:
    case Nil{}:
      S<T>
    case Con{q, +rest}:
      Lv<MV(T, rest)>

def MV.add(~T: Data, ~add: T -> T -> T, sig: List<&2, Q>, a: MV(T, sig), b: MV(T, sig)) -> MV(T, sig):
  match sig:
    case Nil{}:
      match a:
        case S0{}:
          b
        case S1{x}:
          match b:
            case S0{}:
              S1{x}
            case S1{y}:
              S1{add(x, y)}
    case Con{q, +rest}:
      match a:
        case Z{}:
          b
        case N{a1, a2}:
          match b:
            case Z{}:
              N{a1, a2}
            case N{b1, b2}:
              N{MV.add(~T, ~add, rest, a1, b1), MV.add(~T, ~add, rest, a2, b2)}

def Leaf.mul(~T: Data, ~mul: T -> T -> T, ~neg: T -> T, n: Bool, a: T, b: T) -> T:
  match n:
    case False{}:
      mul(a, b)
    case True{}:
      neg(mul(a, b))

def MV.gp(~T: Data, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  sig: List<&2, Q>, +f: Bool, +n: Bool, x: MV(T, sig), y: MV(T, sig)) -> MV(T, sig):
  match sig:
    case Nil{}:
      match x:
        case S0{}:
          S0{}
        case S1{a}:
          match y:
            case S0{}:
              S0{}
            case S1{b}:
              S1{Leaf.mul(~T, ~mul, ~neg, n, a, b)}
    case Con{q, +rest}:
      match q:
        case QZ{}:
          match x:
            case Z{}:
              Z{}
            case N{x1, +x2}:
              match y:
                case Z{}:
                  Z{}
                case N{y1, +y2}:
                  +nf = Bool.xor(n, f)
                  e = MV.add(~T, ~add, rest, MV.gp(~T, ~add, ~mul, ~neg, rest, f, nf, x1, y2), MV.gp(~T, ~add, ~mul, ~neg, rest, Bool.not(f), n, x2, y1))
                  r2 = MV.gp(~T, ~add, ~mul, ~neg, rest, f, n, x2, y2)
                  N{e, r2}
        case QP{}:
          match x:
            case Z{}:
              Z{}
            case N{+x1, +x2}:
              match y:
                case Z{}:
                  Z{}
                case N{+y1, +y2}:
                  +nf = Bool.xor(n, f)
                  e = MV.add(~T, ~add, rest, MV.gp(~T, ~add, ~mul, ~neg, rest, f, nf, x1, y2), MV.gp(~T, ~add, ~mul, ~neg, rest, Bool.not(f), n, x2, y1))
                  r2 = MV.gp(~T, ~add, ~mul, ~neg, rest, f, n, x2, y2)
                  N{e, MV.add(~T, ~add, rest, MV.gp(~T, ~add, ~mul, ~neg, rest, Bool.not(f), nf, x1, y1), r2)}
        case QN{}:
          match x:
            case Z{}:
              Z{}
            case N{+x1, +x2}:
              match y:
                case Z{}:
                  Z{}
                case N{+y1, +y2}:
                  +nf = Bool.xor(n, f)
                  e = MV.add(~T, ~add, rest, MV.gp(~T, ~add, ~mul, ~neg, rest, f, nf, x1, y2), MV.gp(~T, ~add, ~mul, ~neg, rest, Bool.not(f), n, x2, y1))
                  r2 = MV.gp(~T, ~add, ~mul, ~neg, rest, f, n, x2, y2)
                  N{e, MV.add(~T, ~add, rest, MV.gp(~T, ~add, ~mul, ~neg, rest, Bool.not(f), Bool.not(nf), x1, y1), r2)}

def U32.neg(a: U32) -> U32:
  (0 - a : U32)

def gp2(sig: List<&2, Q>, x: MV(U32, sig), y: MV(U32, sig)) -> MV(U32, sig):
  MV.gp(~U32, ~U32.add, ~U32.mul, ~U32.neg, sig, False{}, False{}, x, y)

def E2() -> List<&2, Q>:
  [QP{}, QP{}]

def e1() -> MV(U32, E2()):
  N{N{S0{}, S1{1}}, Z{}}

def e2() -> MV(U32, E2()):
  N{Z{}, N{S1{1}, S0{}}}


def Sig() -> List<&2, Q>:
  [QP{}, QP{}, QP{}, QP{}]

type Flat<-T: Data> is Data:
  Flat{c0: T, c1: T, c2: T, c3: T, c4: T, c5: T, c6: T, c7: T, c8: T, c9: T, c10: T, c11: T, c12: T, c13: T, c14: T, c15: T}

def Flat.tree(-T: Data, x: Flat<T>) -> MV(T, Sig()):
  match x:
    case Flat{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15}:
      N{N{N{N{S1{a0}, S1{a1}}, N{S1{a2}, S1{a3}}}, N{N{S1{a4}, S1{a5}}, N{S1{a6}, S1{a7}}}}, N{N{N{S1{a8}, S1{a9}}, N{S1{a10}, S1{a11}}}, N{N{S1{a12}, S1{a13}}, N{S1{a14}, S1{a15}}}}}

# the mirror kernel: 256 multiplies
def Flat.gp(~T: Data, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, x: Flat<T>, y: Flat<T>) -> Flat<T>:
  match x y:
    case Flat{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11, +a12, +a13, +a14, +a15} Flat{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7, +b8, +b9, +b10, +b11, +b12, +b13, +b14, +b15}:
      Flat{add(add(add(add(mul(a0, b15), mul(a1, b14)), add(neg(mul(a2, b13)), mul(a3, b12))), add(add(mul(a4, b11), neg(mul(a5, b10))), add(mul(a6, b9), mul(a7, b8)))), add(add(add(neg(mul(a8, b7)), mul(a9, b6)), add(neg(mul(a10, b5)), neg(mul(a11, b4)))), add(add(mul(a12, b3), mul(a13, b2)), add(neg(mul(a14, b1)), mul(a15, b0))))), add(add(add(add(mul(a0, b14), mul(a1, b15)), add(neg(mul(a2, b12)), mul(a3, b13))), add(add(mul(a4, b10), neg(mul(a5, b11))), add(mul(a6, b8), mul(a7, b9)))), add(add(add(neg(mul(a8, b6)), mul(a9, b7)), add(neg(mul(a10, b4)), neg(mul(a11, b5)))), add(add(mul(a12, b2), mul(a13, b3)), add(neg(mul(a14, b0)), mul(a15, b1))))), add(add(add(add(neg(mul(a0, b13)), mul(a1, b12)), add(mul(a2, b15), mul(a3, b14))), add(add(neg(mul(a4, b9)), neg(mul(a5, b8))), add(neg(mul(a6, b11)), mul(a7, b10)))), add(add(add(mul(a8, b5), mul(a9, b4)), add(mul(a10, b7), neg(mul(a11, b6)))), add(add(neg(mul(a12, b1)), mul(a13, b0)), add(mul(a14, b3), mul(a15, b2))))), add(add(add(add(neg(mul(a0, b12)), mul(a1, b13)), add(mul(a2, b14), mul(a3, b15))), add(add(neg(mul(a4, b8)), neg(mul(a5, b9))), add(neg(mul(a6, b10)), mul(a7, b11)))), add(add(add(mul(a8, b4), mul(a9, b5)), add(mul(a10, b6), neg(mul(a11, b7)))), add(add(neg(mul(a12, b0)), mul(a13, b1)), add(mul(a14, b2), mul(a15, b3))))), add(add(add(add(mul(a0, b11), neg(mul(a1, b10))), add(mul(a2, b9), mul(a3, b8))), add(add(mul(a4, b15), mul(a5, b14)), add(neg(mul(a6, b13)), mul(a7, b12)))), add(add(add(neg(mul(a8, b3)), neg(mul(a9, b2))), add(mul(a10, b1), neg(mul(a11, b0)))), add(add(mul(a12, b7), neg(mul(a13, b6))), add(mul(a14, b5), mul(a15, b4))))), add(add(add(add(mul(a0, b10), neg(mul(a1, b11))), add(mul(a2, b8), mul(a3, b9))), add(add(mul(a4, b14), mul(a5, b15)), add(neg(mul(a6, b12)), mul(a7, b13)))), add(add(add(neg(mul(a8, b2)), neg(mul(a9, b3))), add(mul(a10, b0), neg(mul(a11, b1)))), add(add(mul(a12, b6), neg(mul(a13, b7))), add(mul(a14, b4), mul(a15, b5))))), add(add(add(add(neg(mul(a0, b9)), neg(mul(a1, b8))), add(neg(mul(a2, b11)), mul(a3, b10))), add(add(neg(mul(a4, b13)), mul(a5, b12)), add(mul(a6, b15), mul(a7, b14)))), add(add(add(mul(a8, b1), neg(mul(a9, b0))), add(neg(mul(a10, b3)), neg(mul(a11, b2)))), add(add(neg(mul(a12, b5)), neg(mul(a13, b4))), add(neg(mul(a14, b7)), mul(a15, b6))))), add(add(add(add(neg(mul(a0, b8)), neg(mul(a1, b9))), add(neg(mul(a2, b10)), mul(a3, b11))), add(add(neg(mul(a4, b12)), mul(a5, b13)), add(mul(a6, b14), mul(a7, b15)))), add(add(add(mul(a8, b0), neg(mul(a9, b1))), add(neg(mul(a10, b2)), neg(mul(a11, b3)))), add(add(neg(mul(a12, b4)), neg(mul(a13, b5))), add(neg(mul(a14, b6)), mul(a15, b7))))), add(add(add(add(neg(mul(a0, b7)), mul(a1, b6)), add(neg(mul(a2, b5)), neg(mul(a3, b4)))), add(add(mul(a4, b3), mul(a5, b2)), add(neg(mul(a6, b1)), mul(a7, b0)))), add(add(add(mul(a8, b15), mul(a9, b14)), add(neg(mul(a10, b13)), mul(a11, b12))), add(add(mul(a12, b11), neg(mul(a13, b10))), add(mul(a14, b9), mul(a15, b8))))), add(add(add(add(neg(mul(a0, b6)), mul(a1, b7)), add(neg(mul(a2, b4)), neg(mul(a3, b5)))), add(add(mul(a4, b2), mul(a5, b3)), add(neg(mul(a6, b0)), mul(a7, b1)))), add(add(add(mul(a8, b14), mul(a9, b15)), add(neg(mul(a10, b12)), mul(a11, b13))), add(add(mul(a12, b10), neg(mul(a13, b11))), add(mul(a14, b8), mul(a15, b9))))), add(add(add(add(mul(a0, b5), mul(a1, b4)), add(mul(a2, b7), neg(mul(a3, b6)))), add(add(neg(mul(a4, b1)), mul(a5, b0)), add(mul(a6, b3), mul(a7, b2)))), add(add(add(neg(mul(a8, b13)), mul(a9, b12)), add(mul(a10, b15), mul(a11, b14))), add(add(neg(mul(a12, b9)), neg(mul(a13, b8))), add(neg(mul(a14, b11)), mul(a15, b10))))), add(add(add(add(mul(a0, b4), mul(a1, b5)), add(mul(a2, b6), neg(mul(a3, b7)))), add(add(neg(mul(a4, b0)), mul(a5, b1)), add(mul(a6, b2), mul(a7, b3)))), add(add(add(neg(mul(a8, b12)), mul(a9, b13)), add(mul(a10, b14), mul(a11, b15))), add(add(neg(mul(a12, b8)), neg(mul(a13, b9))), add(neg(mul(a14, b10)), mul(a15, b11))))), add(add(add(add(neg(mul(a0, b3)), neg(mul(a1, b2))), add(mul(a2, b1), neg(mul(a3, b0)))), add(add(mul(a4, b7), neg(mul(a5, b6))), add(mul(a6, b5), mul(a7, b4)))), add(add(add(mul(a8, b11), neg(mul(a9, b10))), add(mul(a10, b9), mul(a11, b8))), add(add(mul(a12, b15), mul(a13, b14)), add(neg(mul(a14, b13)), mul(a15, b12))))), add(add(add(add(neg(mul(a0, b2)), neg(mul(a1, b3))), add(mul(a2, b0), neg(mul(a3, b1)))), add(add(mul(a4, b6), neg(mul(a5, b7))), add(mul(a6, b4), mul(a7, b5)))), add(add(add(mul(a8, b10), neg(mul(a9, b11))), add(mul(a10, b8), mul(a11, b9))), add(add(mul(a12, b14), mul(a13, b15)), add(neg(mul(a14, b12)), mul(a15, b13))))), add(add(add(add(mul(a0, b1), neg(mul(a1, b0))), add(neg(mul(a2, b3)), neg(mul(a3, b2)))), add(add(neg(mul(a4, b5)), neg(mul(a5, b4))), add(neg(mul(a6, b7)), mul(a7, b6)))), add(add(add(neg(mul(a8, b9)), neg(mul(a9, b8))), add(neg(mul(a10, b11)), mul(a11, b10))), add(add(neg(mul(a12, b13)), mul(a13, b12)), add(mul(a14, b15), mul(a15, b14))))), add(add(add(add(mul(a0, b0), neg(mul(a1, b1))), add(neg(mul(a2, b2)), neg(mul(a3, b3)))), add(add(neg(mul(a4, b4)), neg(mul(a5, b5))), add(neg(mul(a6, b6)), mul(a7, b7)))), add(add(add(neg(mul(a8, b8)), neg(mul(a9, b9))), add(neg(mul(a10, b10)), mul(a11, b11))), add(add(neg(mul(a12, b12)), mul(a13, b13)), add(mul(a14, b14), mul(a15, b15)))))}

law gp_mirror:
  for ~T: Data
  for ~add: T -> T -> T
  for ~mul: T -> T -> T
  for ~neg: T -> T
  for x: Flat<T>
  for y: Flat<T>
  {Flat.tree(T, Flat.gp(~T, ~add, ~mul, ~neg, x, y)) == MV.gp(~T, ~add, ~mul, ~neg, Sig(), False{}, False{}, Flat.tree(T, x), Flat.tree(T, y)) : MV(T, Sig())}

def gp_mirror(T, add, mul, neg, x, y):
  match x y:
    case Flat{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15} Flat{b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15}:
      {==}
