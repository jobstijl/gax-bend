def Quadvector.rc.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Scalar<T>) -> K.Quadvector<T>:
  match a b:
    case K.Quadvector{+a_e1234, +a_e234o, +a_e314o, +a_e124o, +a_e123o, +a_e234i, +a_e314i, +a_e124i, +a_e123i, +a_e23oi, +a_e31oi, +a_e12oi, +a_e41oi, +a_e42oi, +a_e43oi} K.Scalar{+b_s}:
      K.Quadvector{
        mul(a_e1234, b_s),
        mul(a_e234o, b_s),
        mul(a_e314o, b_s),
        mul(a_e124o, b_s),
        mul(a_e123o, b_s),
        mul(a_e234i, b_s),
        mul(a_e314i, b_s),
        mul(a_e124i, b_s),
        mul(a_e123i, b_s),
        mul(a_e23oi, b_s),
        mul(a_e31oi, b_s),
        mul(a_e12oi, b_s),
        mul(a_e41oi, b_s),
        mul(a_e42oi, b_s),
        mul(a_e43oi, b_s)}

def Quadvector.rc.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Vector<T>) -> K.Trivector<T>:
