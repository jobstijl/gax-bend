def Odd.lc.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Vector<T>) -> K.Scalar<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_e4, +a_eo, +a_ei, +a_e234, +a_e314, +a_e124, +a_e123, +a_e23o, +a_e31o, +a_e12o, +a_e41o, +a_e42o, +a_e43o, +a_e23i, +a_e31i, +a_e12i, +a_e41i, +a_e42i, +a_e43i, +a_e1oi, +a_e2oi, +a_e3oi, +a_e4oi, +a_e234oi, +a_e314oi, +a_e124oi, +a_e123oi, +a_e1234o, +a_e1234i} K.Vector{+b_e1, +b_e2, +b_e3, +b_e4, +b_eo, +b_ei}:
      K.Scalar{
        add(add(add(add(add(neg(mul(a_ei, b_eo)), neg(mul(a_eo, b_ei))), neg(mul(a_e4, b_e4))), mul(a_e3, b_e3)), mul(a_e2, b_e2)), mul(a_e1, b_e1))}

def Odd.lc.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Twist<T>) -> K.Vector<T>:
