def Vector.lc.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Vector<T>) -> K.Scalar<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_e4, +a_eo, +a_ei} K.Vector{+b_e1, +b_e2, +b_e3, +b_e4, +b_eo, +b_ei}:
      K.Scalar{
        add(add(add(add(add(neg(mul(a_ei, b_eo)), neg(mul(a_eo, b_ei))), neg(mul(a_e4, b_e4))), mul(a_e3, b_e3)), mul(a_e2, b_e2)), mul(a_e1, b_e1))}

def Vector.lc.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Twist<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_e4, +a_eo, +a_ei} K.Twist{+b_e23, +b_e31, +b_e12, +b_e41, +b_e42, +b_e43, +b_e1i, +b_e2i, +b_e3i, +b_e4i}:
      K.Vector{
        add(add(add(mul(a_eo, b_e1i), neg(mul(a_e4, b_e41))), mul(a_e3, b_e31)), neg(mul(a_e2, b_e12))),
        add(add(add(mul(a_eo, b_e2i), neg(mul(a_e4, b_e42))), neg(mul(a_e3, b_e23))), mul(a_e1, b_e12)),
        add(add(add(mul(a_eo, b_e3i), neg(mul(a_e4, b_e43))), mul(a_e2, b_e23)), neg(mul(a_e1, b_e31))),
        add(add(add(mul(a_eo, b_e4i), neg(mul(a_e3, b_e43))), neg(mul(a_e2, b_e42))), neg(mul(a_e1, b_e41))),
        zero,
        add(add(add(neg(mul(a_e4, b_e4i)), mul(a_e3, b_e3i)), mul(a_e2, b_e2i)), mul(a_e1, b_e1i))}

def Vector.lc.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Bivector<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_e4, +a_eo, +a_ei} K.Bivector{+b_e23, +b_e31, +b_e12, +b_e41, +b_e42, +b_e43, +b_e1o, +b_e2o, +b_e3o, +b_e4o, +b_e1i, +b_e2i, +b_e3i, +b_e4i, +b_eoi}:
      K.Vector{
