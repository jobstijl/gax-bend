      +m3_1 = add(q1_3, q1_3)
      +m3_2 = add(q2_3, q2_3)
      +m3_3 = add(add(add(add(add(q4_5, q4_5), neg(q3_3)), neg(q2_2)), neg(q1_1)), neg(q0_0))
