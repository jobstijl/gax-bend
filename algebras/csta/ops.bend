        add(add(neg(mul(a_e3, b_e43oi)), neg(mul(a_e2, b_e42oi))), neg(mul(a_e1, b_e41oi)))}

def Vector.dot.Quintvector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Quintvector<T>) -> K.Quadvector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_e4, +a_eo, +a_ei} K.Quintvector{+b_e234oi, +b_e314oi, +b_e124oi, +b_e123oi, +b_e1234o, +b_e1234i}:
      K.Quadvector{
        add(neg(mul(a_ei, b_e1234o)), neg(mul(a_eo, b_e1234i))),
        add(neg(mul(a_eo, b_e234oi)), mul(a_e1, b_e1234o)),
        add(neg(mul(a_eo, b_e314oi)), mul(a_e2, b_e1234o)),
        add(neg(mul(a_eo, b_e124oi)), mul(a_e3, b_e1234o)),
        add(neg(mul(a_eo, b_e123oi)), mul(a_e4, b_e1234o)),
        add(mul(a_ei, b_e234oi), mul(a_e1, b_e1234i)),
        add(mul(a_ei, b_e314oi), mul(a_e2, b_e1234i)),
        add(mul(a_ei, b_e124oi), mul(a_e3, b_e1234i)),
        add(mul(a_ei, b_e123oi), mul(a_e4, b_e1234i)),
        add(neg(mul(a_e4, b_e234oi)), mul(a_e1, b_e123oi)),
        add(neg(mul(a_e4, b_e314oi)), mul(a_e2, b_e123oi)),
        add(neg(mul(a_e4, b_e124oi)), mul(a_e3, b_e123oi)),
        add(neg(mul(a_e3, b_e314oi)), mul(a_e2, b_e124oi)),
        add(mul(a_e3, b_e234oi), neg(mul(a_e1, b_e124oi))),
