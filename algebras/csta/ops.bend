        add(add(mul(a_ei, b_e314o), mul(a_eo, b_e314i)), mul(a_e2, b_e1234)),
        add(add(mul(a_ei, b_e124o), mul(a_eo, b_e124i)), mul(a_e3, b_e1234)),
        add(add(mul(a_ei, b_e123o), mul(a_eo, b_e123i)), mul(a_e4, b_e1234)),
        add(add(mul(a_eo, b_e23oi), neg(mul(a_e4, b_e234o))), mul(a_e1, b_e123o)),
        add(add(mul(a_eo, b_e31oi), neg(mul(a_e4, b_e314o))), mul(a_e2, b_e123o)),
