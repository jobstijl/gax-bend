        add(add(neg(mul(a_ei, b_e23oi)), neg(mul(a_e4, b_e234i))), mul(a_e1, b_e123i)),
        add(add(neg(mul(a_ei, b_e31oi)), neg(mul(a_e4, b_e314i))), mul(a_e2, b_e123i)),
        add(add(neg(mul(a_ei, b_e12oi)), neg(mul(a_e4, b_e124i))), mul(a_e3, b_e123i)),
        add(add(neg(mul(a_ei, b_e41oi)), neg(mul(a_e3, b_e314i))), mul(a_e2, b_e124i)),
        add(add(neg(mul(a_ei, b_e42oi)), mul(a_e3, b_e234i)), neg(mul(a_e1, b_e124i))),
        add(add(neg(mul(a_ei, b_e43oi)), neg(mul(a_e2, b_e234i))), mul(a_e1, b_e314i)),
