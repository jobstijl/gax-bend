      K.Quadvector{
        zero,
        zero,
        zero,
        zero,
        zero,
        neg(mul(a_e1234oi, b_e1i)),
        neg(mul(a_e1234oi, b_e2i)),
        neg(mul(a_e1234oi, b_e3i)),
        neg(mul(a_e1234oi, b_e4i)),
        neg(mul(a_e1234oi, b_e41)),
        neg(mul(a_e1234oi, b_e42)),
        neg(mul(a_e1234oi, b_e43)),
        mul(a_e1234oi, b_e23),
        mul(a_e1234oi, b_e31),
        mul(a_e1234oi, b_e12)}

