def Quintvector.dot.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quintvector<T>, b: K.Odd<T>) -> K.Even<T>:
  match a b:
    case K.Quintvector{+a_e234oi, +a_e314oi, +a_e124oi, +a_e123oi, +a_e1234o, +a_e1234i} K.Odd{+b_e1, +b_e2, +b_e3, +b_e4, +b_eo, +b_ei, +b_e234, +b_e314, +b_e124, +b_e123, +b_e23o, +b_e31o, +b_e12o, +b_e41o, +b_e42o, +b_e43o, +b_e23i, +b_e31i, +b_e12i, +b_e41i, +b_e42i, +b_e43i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e4oi, +b_e234oi, +b_e314oi, +b_e124oi, +b_e123oi, +b_e1234o, +b_e1234i}:
      K.Even{
