def Quintvector.dot.Quadvector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quintvector<T>, b: K.Quadvector<T>) -> K.Vector<T>:
