        mul(a_e1234o, b_s),
        add(add(add(add(mul(a_e1234i, b_s), mul(a_e123oi, b_e4i)), neg(mul(a_e124oi, b_e3i))), neg(mul(a_e314oi, b_e2i))), neg(mul(a_e234oi, b_e1i)))}

def Quintvector.gp.Even(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quintvector<T>, b: K.Even<T>) -> K.Odd<T>:
