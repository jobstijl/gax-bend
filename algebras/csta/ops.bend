def Quintvector.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quintvector<T>, b: K.Pseudoscalar<T>) -> K.Vector<T>:
  match a b:
    case K.Quintvector{+a_e234oi, +a_e314oi, +a_e124oi, +a_e123oi, +a_e1234o, +a_e1234i} K.Pseudoscalar{+b_e1234oi}:
      K.Vector{
        neg(mul(a_e234oi, b_e1234oi)),
        neg(mul(a_e314oi, b_e1234oi)),
        neg(mul(a_e124oi, b_e1234oi)),
        neg(mul(a_e123oi, b_e1234oi)),
        neg(mul(a_e1234o, b_e1234oi)),
        mul(a_e1234i, b_e1234oi)}

def Quintvector.gp.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quintvector<T>, b: K.Motor<T>) -> K.Odd<T>:
