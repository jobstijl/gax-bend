  match a b:
    case K.Trivector{+a_e234, +a_e314, +a_e124, +a_e123, +a_e23o, +a_e31o, +a_e12o, +a_e41o, +a_e42o, +a_e43o, +a_e23i, +a_e31i, +a_e12i, +a_e41i, +a_e42i, +a_e43i, +a_e1oi, +a_e2oi, +a_e3oi, +a_e4oi} K.Scalar{+b_s}:
      K.Trivector{
        mul(a_e234, b_s),
        mul(a_e314, b_s),
        mul(a_e124, b_s),
        mul(a_e123, b_s),
        mul(a_e23o, b_s),
        mul(a_e31o, b_s),
        mul(a_e12o, b_s),
        mul(a_e41o, b_s),
        mul(a_e42o, b_s),
        mul(a_e43o, b_s),
        mul(a_e23i, b_s),
