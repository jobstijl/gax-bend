        add(neg(mul(a_e1234, b_e2)), neg(mul(a_e314i, b_eo))),
        add(neg(mul(a_e1234, b_e3)), neg(mul(a_e124i, b_eo))),
        add(neg(mul(a_e1234, b_e4)), neg(mul(a_e123i, b_eo))),
        zero,
        zero,
        zero,
        zero,
        zero,
        zero,
        add(neg(mul(a_e123i, b_e1)), mul(a_e234i, b_e4)),
        add(neg(mul(a_e123i, b_e2)), mul(a_e314i, b_e4)),
        add(neg(mul(a_e123i, b_e3)), mul(a_e124i, b_e4)),
        add(neg(mul(a_e124i, b_e2)), mul(a_e314i, b_e3)),
        add(mul(a_e124i, b_e1), neg(mul(a_e234i, b_e3))),
        add(neg(mul(a_e314i, b_e1)), mul(a_e234i, b_e2)),
