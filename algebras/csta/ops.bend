        add(add(add(mul(a_ei, b_e3oi), neg(mul(a_e4, b_e43i))), mul(a_e2, b_e23i)), neg(mul(a_e1, b_e31i))),
        add(add(add(mul(a_ei, b_e4oi), neg(mul(a_e3, b_e43i))), neg(mul(a_e2, b_e42i))), neg(mul(a_e1, b_e41i))),
        add(add(add(neg(mul(a_e4, b_e4oi)), mul(a_e3, b_e3oi)), mul(a_e2, b_e2oi)), mul(a_e1, b_e1oi))}

def Vector.dot.Quadvector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Quadvector<T>) -> K.Trivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_e4, +a_eo, +a_ei} K.Quadvector{+b_e1234, +b_e234o, +b_e314o, +b_e124o, +b_e123o, +b_e234i, +b_e314i, +b_e124i, +b_e123i, +b_e23oi, +b_e31oi, +b_e12oi, +b_e41oi, +b_e42oi, +b_e43oi}:
