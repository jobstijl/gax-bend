        mul(a_e314i, b_s),
        mul(a_e124i, b_s),
        mul(a_e123i, b_s),
        mul(a_e1234, b_s)}

def Motor.rc.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Vector<T>) -> K.Odd<T>:
  match a b:
