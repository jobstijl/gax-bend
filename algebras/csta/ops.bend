        add(add(add(add(mul(a_eo, b_e124i), mul(a_e4, b_e12)), mul(a_e3, b_e1234)), mul(a_e2, b_e41)), neg(mul(a_e1, b_e42))),
        add(add(add(add(mul(a_eo, b_e123i), mul(a_e4, b_e1234)), mul(a_e3, b_e12)), mul(a_e2, b_e31)), mul(a_e1, b_e23)),
