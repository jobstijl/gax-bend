        add(add(neg(mul(a_e4i, b_e2)), mul(a_e2i, b_e4)), mul(a_e42, b_ei)),
        add(add(neg(mul(a_e4i, b_e3)), mul(a_e3i, b_e4)), mul(a_e43, b_ei)),
        neg(mul(a_e1i, b_eo)),
