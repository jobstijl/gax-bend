def Odd.dot.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Scalar<T>) -> K.Odd<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_e4, +a_eo, +a_ei, +a_e234, +a_e314, +a_e124, +a_e123, +a_e23o, +a_e31o, +a_e12o, +a_e41o, +a_e42o, +a_e43o, +a_e23i, +a_e31i, +a_e12i, +a_e41i, +a_e42i, +a_e43i, +a_e1oi, +a_e2oi, +a_e3oi, +a_e4oi, +a_e234oi, +a_e314oi, +a_e124oi, +a_e123oi, +a_e1234o, +a_e1234i} K.Scalar{+b_s}:
      K.Odd{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_e4, b_s),
        mul(a_eo, b_s),
        mul(a_ei, b_s),
        mul(a_e234, b_s),
        mul(a_e314, b_s),
        mul(a_e124, b_s),
        mul(a_e123, b_s),
        mul(a_e23o, b_s),
        mul(a_e31o, b_s),
        mul(a_e12o, b_s),
        mul(a_e41o, b_s),
        mul(a_e42o, b_s),
        mul(a_e43o, b_s),
        mul(a_e23i, b_s),
        mul(a_e31i, b_s),
        mul(a_e12i, b_s),
        mul(a_e41i, b_s),
        mul(a_e42i, b_s),
        mul(a_e43i, b_s),
        mul(a_e1oi, b_s),
        mul(a_e2oi, b_s),
        mul(a_e3oi, b_s),
        mul(a_e4oi, b_s),
        mul(a_e234oi, b_s),
        mul(a_e314oi, b_s),
        mul(a_e124oi, b_s),
        mul(a_e123oi, b_s),
        mul(a_e1234o, b_s),
        mul(a_e1234i, b_s)}

