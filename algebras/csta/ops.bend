def Vector.dot.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Motor<T>) -> K.Odd<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_e4, +a_eo, +a_ei} K.Motor{+b_s, +b_e23, +b_e31, +b_e12, +b_e41, +b_e42, +b_e43, +b_e1i, +b_e2i, +b_e3i, +b_e4i, +b_e234i, +b_e314i, +b_e124i, +b_e123i, +b_e1234}:
      K.Odd{
        add(add(add(add(mul(a_eo, b_e1i), neg(mul(a_e4, b_e41))), mul(a_e3, b_e31)), neg(mul(a_e2, b_e12))), mul(a_e1, b_s)),
        add(add(add(add(mul(a_eo, b_e2i), neg(mul(a_e4, b_e42))), neg(mul(a_e3, b_e23))), mul(a_e2, b_s)), mul(a_e1, b_e12)),
        add(add(add(add(mul(a_eo, b_e3i), neg(mul(a_e4, b_e43))), mul(a_e3, b_s)), mul(a_e2, b_e23)), neg(mul(a_e1, b_e31))),
        add(add(add(add(mul(a_eo, b_e4i), mul(a_e4, b_s)), neg(mul(a_e3, b_e43))), neg(mul(a_e2, b_e42))), neg(mul(a_e1, b_e41))),
        mul(a_eo, b_s),
        add(add(add(add(mul(a_ei, b_s), neg(mul(a_e4, b_e4i))), mul(a_e3, b_e3i)), mul(a_e2, b_e2i)), mul(a_e1, b_e1i)),
