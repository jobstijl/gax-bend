        add(add(add(add(mul(a_ei, b_e2o), mul(a_eo, b_e2i)), neg(mul(a_e4, b_e42))), neg(mul(a_e3, b_e23))), mul(a_e1, b_e12)),
        add(add(add(add(mul(a_ei, b_e3o), mul(a_eo, b_e3i)), neg(mul(a_e4, b_e43))), mul(a_e2, b_e23)), neg(mul(a_e1, b_e31))),
        add(add(add(add(mul(a_ei, b_e4o), mul(a_eo, b_e4i)), neg(mul(a_e3, b_e43))), neg(mul(a_e2, b_e42))), neg(mul(a_e1, b_e41))),
        add(add(add(add(mul(a_eo, b_eoi), neg(mul(a_e4, b_e4o))), mul(a_e3, b_e3o)), mul(a_e2, b_e2o)), mul(a_e1, b_e1o)),
        add(add(add(add(neg(mul(a_ei, b_eoi)), neg(mul(a_e4, b_e4i))), mul(a_e3, b_e3i)), mul(a_e2, b_e2i)), mul(a_e1, b_e1i))}

def Vector.lc.Trivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Trivector<T>) -> K.Bivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_e4, +a_eo, +a_ei} K.Trivector{+b_e234, +b_e314, +b_e124, +b_e123, +b_e23o, +b_e31o, +b_e12o, +b_e41o, +b_e42o, +b_e43o, +b_e23i, +b_e31i, +b_e12i, +b_e41i, +b_e42i, +b_e43i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e4oi}:
