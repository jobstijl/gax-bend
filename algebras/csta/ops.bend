        mul(a_e42, b_s),
        mul(a_e43, b_s),
        mul(a_e1i, b_s),
        mul(a_e2i, b_s),
        mul(a_e3i, b_s),
        mul(a_e4i, b_s)}

def Twist.anticommutator.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Twist<T>, b: K.Vector<T>) -> K.Trivector<T>:
