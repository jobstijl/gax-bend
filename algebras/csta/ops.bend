        add(add(neg(mul(a_e12oi, b_eo)), neg(mul(a_e123o, b_e3))), mul(a_e124o, b_e4)),
        add(add(neg(mul(a_e41oi, b_eo)), neg(mul(a_e124o, b_e2))), mul(a_e314o, b_e3)),
        add(add(neg(mul(a_e42oi, b_eo)), mul(a_e124o, b_e1)), neg(mul(a_e234o, b_e3))),
        add(add(neg(mul(a_e43oi, b_eo)), neg(mul(a_e314o, b_e1))), mul(a_e234o, b_e2)),
        add(add(mul(a_e23oi, b_ei), neg(mul(a_e123i, b_e1))), mul(a_e234i, b_e4)),
        add(add(mul(a_e31oi, b_ei), neg(mul(a_e123i, b_e2))), mul(a_e314i, b_e4)),
