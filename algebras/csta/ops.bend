        add(add(add(neg(mul(a_ei, b_e31o)), neg(mul(a_eo, b_e31i))), neg(mul(a_e4, b_e314))), mul(a_e2, b_e123)),
        add(add(add(neg(mul(a_ei, b_e12o)), neg(mul(a_eo, b_e12i))), neg(mul(a_e4, b_e124))), mul(a_e3, b_e123)),
        add(add(add(neg(mul(a_ei, b_e41o)), neg(mul(a_eo, b_e41i))), neg(mul(a_e3, b_e314))), mul(a_e2, b_e124)),
        add(add(add(neg(mul(a_ei, b_e42o)), neg(mul(a_eo, b_e42i))), mul(a_e3, b_e234)), neg(mul(a_e1, b_e124))),
        add(add(add(neg(mul(a_ei, b_e43o)), neg(mul(a_eo, b_e43i))), neg(mul(a_e2, b_e234))), mul(a_e1, b_e314)),
        add(add(add(neg(mul(a_eo, b_e1oi)), neg(mul(a_e4, b_e41o))), mul(a_e3, b_e31o)), neg(mul(a_e2, b_e12o))),
        add(add(add(neg(mul(a_eo, b_e2oi)), neg(mul(a_e4, b_e42o))), neg(mul(a_e3, b_e23o))), mul(a_e1, b_e12o)),
        add(add(add(neg(mul(a_eo, b_e3oi)), neg(mul(a_e4, b_e43o))), mul(a_e2, b_e23o)), neg(mul(a_e1, b_e31o))),
        add(add(add(neg(mul(a_eo, b_e4oi)), neg(mul(a_e3, b_e43o))), neg(mul(a_e2, b_e42o))), neg(mul(a_e1, b_e41o))),
        add(add(add(mul(a_ei, b_e1oi), neg(mul(a_e4, b_e41i))), mul(a_e3, b_e31i)), neg(mul(a_e2, b_e12i))),
        add(add(add(mul(a_ei, b_e2oi), neg(mul(a_e4, b_e42i))), neg(mul(a_e3, b_e23i))), mul(a_e1, b_e12i)),
        add(add(add(mul(a_ei, b_e3oi), neg(mul(a_e4, b_e43i))), mul(a_e2, b_e23i)), neg(mul(a_e1, b_e31i))),
        add(add(add(mul(a_ei, b_e4oi), neg(mul(a_e3, b_e43i))), neg(mul(a_e2, b_e42i))), neg(mul(a_e1, b_e41i))),
        add(add(add(neg(mul(a_e4, b_e4oi)), mul(a_e3, b_e3oi)), mul(a_e2, b_e2oi)), mul(a_e1, b_e1oi))}

def Vector.lc.Quadvector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Quadvector<T>) -> K.Trivector<T>:
  match a b:
