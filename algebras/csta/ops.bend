    case K.Quadvector{+a_e1234, +a_e234o, +a_e314o, +a_e124o, +a_e123o, +a_e234i, +a_e314i, +a_e124i, +a_e123i, +a_e23oi, +a_e31oi, +a_e12oi, +a_e41oi, +a_e42oi, +a_e43oi} K.Vector{+b_e1, +b_e2, +b_e3, +b_e4, +b_eo, +b_ei}:
