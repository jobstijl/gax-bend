    case K.Quintvector{+a_e234oi, +a_e314oi, +a_e124oi, +a_e123oi, +a_e1234o, +a_e1234i} K.Even{+b_s, +b_e23, +b_e31, +b_e12, +b_e41, +b_e42, +b_e43, +b_e1o, +b_e2o, +b_e3o, +b_e4o, +b_e1i, +b_e2i, +b_e3i, +b_e4i, +b_eoi, +b_e1234, +b_e234o, +b_e314o, +b_e124o, +b_e123o, +b_e234i, +b_e314i, +b_e124i, +b_e123i, +b_e23oi, +b_e31oi, +b_e12oi, +b_e41oi, +b_e42oi, +b_e43oi, +b_e1234oi}:
