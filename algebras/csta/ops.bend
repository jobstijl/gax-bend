def Twist.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Twist<T>, b: K.Scalar<T>) -> K.Twist<T>:
  match a b:
    case K.Twist{+a_e23, +a_e31, +a_e12, +a_e41, +a_e42, +a_e43, +a_e1i, +a_e2i, +a_e3i, +a_e4i} K.Scalar{+b_s}:
      K.Twist{
        mul(a_e23, b_s),
        mul(a_e31, b_s),
        mul(a_e12, b_s),
        mul(a_e41, b_s),
        mul(a_e42, b_s),
        mul(a_e43, b_s),
        mul(a_e1i, b_s),
        mul(a_e2i, b_s),
        mul(a_e3i, b_s),
        mul(a_e4i, b_s)}

def Twist.gp.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Twist<T>, b: K.Vector<T>) -> K.Odd<T>:
  match a b:
    case K.Twist{+a_e23, +a_e31, +a_e12, +a_e41, +a_e42, +a_e43, +a_e1i, +a_e2i, +a_e3i, +a_e4i} K.Vector{+b_e1, +b_e2, +b_e3, +b_e4, +b_eo, +b_ei}:
      K.Odd{
        add(add(add(neg(mul(a_e1i, b_eo)), mul(a_e41, b_e4)), mul(a_e12, b_e2)), neg(mul(a_e31, b_e3))),
        add(add(add(neg(mul(a_e2i, b_eo)), mul(a_e42, b_e4)), neg(mul(a_e12, b_e1))), mul(a_e23, b_e3)),
        add(add(add(neg(mul(a_e3i, b_eo)), mul(a_e43, b_e4)), mul(a_e31, b_e1)), neg(mul(a_e23, b_e2))),
        add(add(add(neg(mul(a_e4i, b_eo)), mul(a_e43, b_e3)), mul(a_e42, b_e2)), mul(a_e41, b_e1)),
        zero,
        add(add(add(mul(a_e4i, b_e4), neg(mul(a_e3i, b_e3))), neg(mul(a_e2i, b_e2))), neg(mul(a_e1i, b_e1))),
        add(add(neg(mul(a_e43, b_e2)), mul(a_e42, b_e3)), mul(a_e23, b_e4)),
        add(add(mul(a_e43, b_e1), neg(mul(a_e41, b_e3))), mul(a_e31, b_e4)),
        add(add(neg(mul(a_e42, b_e1)), mul(a_e41, b_e2)), mul(a_e12, b_e4)),
        add(add(mul(a_e12, b_e3), mul(a_e31, b_e2)), mul(a_e23, b_e1)),
        mul(a_e23, b_eo),
        mul(a_e31, b_eo),
        mul(a_e12, b_eo),
        mul(a_e41, b_eo),
        mul(a_e42, b_eo),
        mul(a_e43, b_eo),
        add(add(mul(a_e3i, b_e2), neg(mul(a_e2i, b_e3))), mul(a_e23, b_ei)),
        add(add(neg(mul(a_e3i, b_e1)), mul(a_e1i, b_e3)), mul(a_e31, b_ei)),
        add(add(mul(a_e2i, b_e1), neg(mul(a_e1i, b_e2))), mul(a_e12, b_ei)),
        add(add(neg(mul(a_e4i, b_e1)), mul(a_e1i, b_e4)), mul(a_e41, b_ei)),
        add(add(neg(mul(a_e4i, b_e2)), mul(a_e2i, b_e4)), mul(a_e42, b_ei)),
        add(add(neg(mul(a_e4i, b_e3)), mul(a_e3i, b_e4)), mul(a_e43, b_ei)),
        neg(mul(a_e1i, b_eo)),
        neg(mul(a_e2i, b_eo)),
        neg(mul(a_e3i, b_eo)),
        neg(mul(a_e4i, b_eo)),
        zero,
        zero,
        zero,
        zero,
        zero,
        zero}

def Twist.gp.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Twist<T>, b: K.Twist<T>) -> K.Motor<T>:
  match a b:
    case K.Twist{+a_e23, +a_e31, +a_e12, +a_e41, +a_e42, +a_e43, +a_e1i, +a_e2i, +a_e3i, +a_e4i} K.Twist{+b_e23, +b_e31, +b_e12, +b_e41, +b_e42, +b_e43, +b_e1i, +b_e2i, +b_e3i, +b_e4i}:
      K.Motor{
        add(add(add(add(add(mul(a_e43, b_e43), mul(a_e42, b_e42)), mul(a_e41, b_e41)), neg(mul(a_e12, b_e12))), neg(mul(a_e31, b_e31))), neg(mul(a_e23, b_e23))),
        add(add(add(neg(mul(a_e43, b_e42)), mul(a_e42, b_e43)), mul(a_e12, b_e31)), neg(mul(a_e31, b_e12))),
        add(add(add(mul(a_e43, b_e41), neg(mul(a_e41, b_e43))), neg(mul(a_e12, b_e23))), mul(a_e23, b_e12)),
        add(add(add(neg(mul(a_e42, b_e41)), mul(a_e41, b_e42)), mul(a_e31, b_e23)), neg(mul(a_e23, b_e31))),
