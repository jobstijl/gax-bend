        add(add(add(add(mul(a_ei, b_e124o), neg(mul(a_eo, b_e124i))), mul(a_e4, b_e12oi)), mul(a_e2, b_e41oi)), neg(mul(a_e1, b_e42oi))),
        add(add(add(add(mul(a_ei, b_e123o), neg(mul(a_eo, b_e123i))), mul(a_e3, b_e12oi)), mul(a_e2, b_e31oi)), mul(a_e1, b_e23oi)),
