        add(add(add(mul(a_e1234i, b_e43o), mul(a_e1234o, b_e43i)), mul(a_e123oi, b_e3oi)), neg(mul(a_e124oi, b_e4oi))),
        add(add(add(neg(mul(a_e1234i, b_e23o)), neg(mul(a_e1234o, b_e23i))), mul(a_e124oi, b_e2oi)), neg(mul(a_e314oi, b_e3oi))),
        add(add(add(neg(mul(a_e1234i, b_e31o)), neg(mul(a_e1234o, b_e31i))), neg(mul(a_e124oi, b_e1oi))), mul(a_e234oi, b_e3oi)),
        add(add(add(neg(mul(a_e1234i, b_e12o)), neg(mul(a_e1234o, b_e12i))), mul(a_e314oi, b_e1oi)), neg(mul(a_e234oi, b_e2oi))),
        add(add(add(neg(mul(a_e1234o, b_e234)), mul(a_e123oi, b_e23o)), mul(a_e124oi, b_e42o)), neg(mul(a_e314oi, b_e43o))),
        add(add(add(neg(mul(a_e1234o, b_e314)), mul(a_e123oi, b_e31o)), neg(mul(a_e124oi, b_e41o))), mul(a_e234oi, b_e43o)),
        add(add(add(neg(mul(a_e1234o, b_e124)), mul(a_e123oi, b_e12o)), mul(a_e314oi, b_e41o)), neg(mul(a_e234oi, b_e42o))),
        add(add(add(neg(mul(a_e1234o, b_e123)), mul(a_e124oi, b_e12o)), mul(a_e314oi, b_e31o)), mul(a_e234oi, b_e23o)),
        add(add(add(neg(mul(a_e1234i, b_e234)), neg(mul(a_e123oi, b_e23i))), neg(mul(a_e124oi, b_e42i))), mul(a_e314oi, b_e43i)),
        add(add(add(neg(mul(a_e1234i, b_e314)), neg(mul(a_e123oi, b_e31i))), mul(a_e124oi, b_e41i)), neg(mul(a_e234oi, b_e43i))),
