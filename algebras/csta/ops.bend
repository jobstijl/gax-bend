        add(add(neg(mul(a_e4, b_e42oi)), neg(mul(a_e3, b_e23oi))), mul(a_e1, b_e12oi)),
        add(add(neg(mul(a_e4, b_e43oi)), mul(a_e2, b_e23oi)), neg(mul(a_e1, b_e31oi))),
