        add(add(add(neg(mul(a_eo, b_e123)), mul(a_e3, b_e12o)), mul(a_e2, b_e31o)), mul(a_e1, b_e23o)),
        add(add(add(neg(mul(a_ei, b_e234)), mul(a_e4, b_e23i)), mul(a_e3, b_e42i)), neg(mul(a_e2, b_e43i))),
        add(add(add(neg(mul(a_ei, b_e314)), mul(a_e4, b_e31i)), neg(mul(a_e3, b_e41i))), mul(a_e1, b_e43i)),
