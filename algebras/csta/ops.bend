        add(add(add(add(neg(mul(a_e1234i, b_e43)), mul(a_e123oi, b_e3i)), neg(mul(a_e124oi, b_e4i))), neg(mul(a_e314oi, b_e234i))), mul(a_e234oi, b_e314i)),
        add(add(add(add(mul(a_e1234i, b_e23), mul(a_e123oi, b_e234i)), mul(a_e124oi, b_e2i)), neg(mul(a_e314oi, b_e3i))), neg(mul(a_e234oi, b_e123i))),
        add(add(add(add(mul(a_e1234i, b_e31), mul(a_e123oi, b_e314i)), neg(mul(a_e124oi, b_e1i))), neg(mul(a_e314oi, b_e123i))), mul(a_e234oi, b_e3i)),
        add(add(add(add(mul(a_e1234i, b_e12), mul(a_e123oi, b_e124i)), neg(mul(a_e124oi, b_e123i))), mul(a_e314oi, b_e1i)), neg(mul(a_e234oi, b_e2i))),
        add(add(add(add(neg(mul(a_e1234o, b_e234i)), neg(mul(a_e123oi, b_e23))), neg(mul(a_e124oi, b_e42))), mul(a_e314oi, b_e43)), neg(mul(a_e234oi, b_e1234))),
        add(add(add(add(neg(mul(a_e1234o, b_e314i)), neg(mul(a_e123oi, b_e31))), mul(a_e124oi, b_e41)), neg(mul(a_e314oi, b_e1234))), neg(mul(a_e234oi, b_e43))),
        add(add(add(add(neg(mul(a_e1234o, b_e124i)), neg(mul(a_e123oi, b_e12))), neg(mul(a_e124oi, b_e1234))), neg(mul(a_e314oi, b_e41))), mul(a_e234oi, b_e42)),
        add(add(add(add(neg(mul(a_e1234o, b_e123i)), neg(mul(a_e123oi, b_e1234))), neg(mul(a_e124oi, b_e12))), neg(mul(a_e314oi, b_e31))), neg(mul(a_e234oi, b_e23))),
