        add(add(add(neg(mul(a_eo, b_e2oi)), neg(mul(a_e4, b_e42o))), neg(mul(a_e3, b_e23o))), mul(a_e1, b_e12o)),
        add(add(add(neg(mul(a_eo, b_e3oi)), neg(mul(a_e4, b_e43o))), mul(a_e2, b_e23o)), neg(mul(a_e1, b_e31o))),
        add(add(add(neg(mul(a_eo, b_e4oi)), neg(mul(a_e3, b_e43o))), neg(mul(a_e2, b_e42o))), neg(mul(a_e1, b_e41o))),
