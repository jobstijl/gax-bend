def Pseudoscalar.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Scalar<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Pseudoscalar{+a_e1234oi} K.Scalar{+b_s}:
      K.Pseudoscalar{
        mul(a_e1234oi, b_s)}

def Pseudoscalar.gp.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Vector<T>) -> K.Quintvector<T>:
