        add(add(add(neg(mul(a_e1234i, b_e123)), neg(mul(a_e124oi, b_e12i))), neg(mul(a_e314oi, b_e31i))), neg(mul(a_e234oi, b_e23i))),
        add(add(add(neg(mul(a_e123oi, b_e123)), mul(a_e124oi, b_e124)), mul(a_e314oi, b_e314)), mul(a_e234oi, b_e234)),
