    case K.Scalar{+a_s} K.Vector{+b_e1, +b_e2, +b_e3, +b_e4, +b_eo, +b_ei}:
      K.Vector{
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        mul(a_s, b_e4),
        mul(a_s, b_eo),
        mul(a_s, b_ei)}

