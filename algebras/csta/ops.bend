        add(add(add(add(mul(a_ei, b_e31), neg(mul(a_e4, b_e314i))), mul(a_e3, b_e1i)), mul(a_e2, b_e123i)), neg(mul(a_e1, b_e3i))),
        add(add(add(add(mul(a_ei, b_e12), neg(mul(a_e4, b_e124i))), mul(a_e3, b_e123i)), neg(mul(a_e2, b_e1i))), mul(a_e1, b_e2i)),
