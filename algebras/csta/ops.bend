  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_e4, +a_eo, +a_ei} K.Scalar{+b_s}:
      K.Vector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_e4, b_s),
        mul(a_eo, b_s),
        mul(a_ei, b_s)}

def Vector.dot.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Vector<T>) -> K.Scalar<T>:
