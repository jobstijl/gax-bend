    case K.Twist{+a_e23, +a_e31, +a_e12, +a_e41, +a_e42, +a_e43, +a_e1i, +a_e2i, +a_e3i, +a_e4i} K.Scalar{+b_s}:
      K.Twist{
        mul(a_e23, b_s),
        mul(a_e31, b_s),
        mul(a_e12, b_s),
        mul(a_e41, b_s),
        mul(a_e42, b_s),
        mul(a_e43, b_s),
        mul(a_e1i, b_s),
        mul(a_e2i, b_s),
        mul(a_e3i, b_s),
        mul(a_e4i, b_s)}

def Twist.dot.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Twist<T>, b: K.Vector<T>) -> K.Vector<T>:
