        add(add(add(neg(mul(a_e1234i, b_e2oi)), neg(mul(a_e123oi, b_e42i))), neg(mul(a_e124oi, b_e23i))), mul(a_e234oi, b_e12i)),
        add(add(add(neg(mul(a_e1234i, b_e3oi)), neg(mul(a_e123oi, b_e43i))), mul(a_e314oi, b_e23i)), neg(mul(a_e234oi, b_e31i))),
