        mul(a_e41i, b_s),
        mul(a_e42i, b_s),
        mul(a_e43i, b_s),
        mul(a_e1oi, b_s),
        mul(a_e2oi, b_s),
        mul(a_e3oi, b_s),
        mul(a_e4oi, b_s)}

