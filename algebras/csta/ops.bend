        add(add(add(mul(a_e1234i, b_e41o), mul(a_e1234o, b_e41i)), mul(a_e123oi, b_e1oi)), neg(mul(a_e234oi, b_e4oi))),
        add(add(add(mul(a_e1234i, b_e42o), mul(a_e1234o, b_e42i)), mul(a_e123oi, b_e2oi)), neg(mul(a_e314oi, b_e4oi))),
