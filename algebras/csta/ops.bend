def Pseudoscalar.rc.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Scalar<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Pseudoscalar{+a_e1234oi} K.Scalar{+b_s}:
      K.Pseudoscalar{
        mul(a_e1234oi, b_s)}

def Pseudoscalar.rc.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Vector<T>) -> K.Quintvector<T>:
  match a b:
    case K.Pseudoscalar{+a_e1234oi} K.Vector{+b_e1, +b_e2, +b_e3, +b_e4, +b_eo, +b_ei}:
      K.Quintvector{
        neg(mul(a_e1234oi, b_e1)),
        neg(mul(a_e1234oi, b_e2)),
        neg(mul(a_e1234oi, b_e3)),
        neg(mul(a_e1234oi, b_e4)),
        neg(mul(a_e1234oi, b_eo)),
        mul(a_e1234oi, b_ei)}

