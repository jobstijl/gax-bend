def Quintvector.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quintvector<T>, b: K.Scalar<T>) -> K.Quintvector<T>:
  match a b:
    case K.Quintvector{+a_e234oi, +a_e314oi, +a_e124oi, +a_e123oi, +a_e1234o, +a_e1234i} K.Scalar{+b_s}:
      K.Quintvector{
        mul(a_e234oi, b_s),
        mul(a_e314oi, b_s),
        mul(a_e124oi, b_s),
        mul(a_e123oi, b_s),
        mul(a_e1234o, b_s),
        mul(a_e1234i, b_s)}

