    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e41, +a_e42, +a_e43, +a_e1i, +a_e2i, +a_e3i, +a_e4i, +a_e234i, +a_e314i, +a_e124i, +a_e123i, +a_e1234} K.Scalar{+b_s}:
      K.Motor{
        mul(a_s, b_s),
        mul(a_e23, b_s),
        mul(a_e31, b_s),
        mul(a_e12, b_s),
        mul(a_e41, b_s),
        mul(a_e42, b_s),
        mul(a_e43, b_s),
        mul(a_e1i, b_s),
        mul(a_e2i, b_s),
        mul(a_e3i, b_s),
        mul(a_e4i, b_s),
        mul(a_e234i, b_s),
        mul(a_e314i, b_s),
        mul(a_e124i, b_s),
        mul(a_e123i, b_s),
        mul(a_e1234, b_s)}

def Motor.anticommutator.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Vector<T>) -> K.Odd<T>:
