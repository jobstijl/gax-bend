        add(add(mul(a_ei, b_e31), mul(a_e3, b_e1i)), neg(mul(a_e1, b_e3i))),
        add(add(mul(a_ei, b_e12), neg(mul(a_e2, b_e1i))), mul(a_e1, b_e2i)),
        add(add(mul(a_ei, b_e41), mul(a_e4, b_e1i)), neg(mul(a_e1, b_e4i))),
        add(add(mul(a_ei, b_e42), mul(a_e4, b_e2i)), neg(mul(a_e2, b_e4i))),
        add(add(mul(a_ei, b_e43), mul(a_e4, b_e3i)), neg(mul(a_e3, b_e4i))),
        neg(mul(a_eo, b_e1i)),
        neg(mul(a_eo, b_e2i)),
        neg(mul(a_eo, b_e3i)),
        neg(mul(a_eo, b_e4i))}

