        K.Multivector.fields(N.Tm, O.Multivector.anticommutator.Multivector(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Multivector{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}}, Multivector.plus(~N.Tm, ~N.Tm.add, K.Multivector{N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}, K.Multivector{N.TVar{8n}, N.TVar{9n}, N.TVar{10n}, N.TVar{11n}}))),
        K.Multivector.fields(N.Tm, Multivector.plus(~N.Tm, ~N.Tm.add, O.Multivector.anticommutator.Multivector(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Multivector{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}}, K.Multivector{N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}), O.Multivector.anticommutator.Multivector(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Multivector{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}}, K.Multivector{N.TVar{8n}, N.TVar{9n}, N.TVar{10n}, N.TVar{11n}}))),
        {==})

def Multivector.anticommutator.Multivector.sc_b(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  c: T, a: K.Multivector<T>, b: K.Multivector<T>)
  -> {K.Multivector.fields(T, O.Multivector.anticommutator.Multivector(~T, ~zero, ~add, ~mul, ~neg, a, K.Multivector.map(~T, ~T, ~(x => mul(c, x)), b)))
    == K.Multivector.fields(T, K.Multivector.map(~T, ~T, ~(x => mul(c, x)), O.Multivector.anticommutator.Multivector(~T, ~zero, ~add, ~mul, ~neg, a, b))) : List<&2, T>}:
  match a b:
    case K.Multivector{a_s, a_e1, a_e2, a_e12} K.Multivector{b_s, b_e1, b_e2, b_e12}:
      LN.Lin.eqs(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [c, a_s, a_e1, a_e2, a_e12, b_s, b_e1, b_e2, b_e12],
        K.Multivector.fields(N.Tm, O.Multivector.anticommutator.Multivector(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Multivector{N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}}, K.Multivector.map(~N.Tm, ~N.Tm, ~(x => N.TMul{N.TVar{0n}, x}), K.Multivector{N.TVar{5n}, N.TVar{6n}, N.TVar{7n}, N.TVar{8n}}))),
        K.Multivector.fields(N.Tm, K.Multivector.map(~N.Tm, ~N.Tm, ~(x => N.TMul{N.TVar{0n}, x}), O.Multivector.anticommutator.Multivector(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Multivector{N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}}, K.Multivector{N.TVar{5n}, N.TVar{6n}, N.TVar{7n}, N.TVar{8n}}))),
        {==})
