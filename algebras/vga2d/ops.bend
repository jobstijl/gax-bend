def Rotor.undual(~T: Data, ~zero: T, ~neg: T -> T, a: K.Rotor<T>) -> K.Rotor<T>:
  match a:
    case K.Rotor{+a_s, +a_e12}:
      K.Rotor{
        a_e12,
        a_s}

def Multivector.undual(~T: Data, ~zero: T, ~neg: T -> T, a: K.Multivector<T>) -> K.Multivector<T>:
  match a:
    case K.Multivector{+a_s, +a_e1, +a_e2, +a_e12}:
      K.Multivector{
        a_e12,
        a_e2,
        neg(a_e1),
        a_s}

def Vector.transform.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Scalar<T>) -> K.Scalar<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2} K.Scalar{+b_s}:
      +q1_1 = mul(a_e2, a_e2)
      +q0_0 = mul(a_e1, a_e1)
      +m0_0 = add(q1_1, q0_0)
      K.Scalar{
        mul(b_s, m0_0)}

def Vector.transform.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Vector<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2} K.Vector{+b_e1, +b_e2}:
      +q1_1 = mul(a_e2, a_e2)
      +q0_0 = mul(a_e1, a_e1)
      +q0_1 = mul(a_e1, a_e2)
      +m0_0 = add(neg(q1_1), q0_0)
      +m0_1 = add(q0_1, q0_1)
      +m1_0 = add(q0_1, q0_1)
      +m1_1 = add(q1_1, neg(q0_0))
      K.Vector{
        add(mul(b_e1, m0_0), mul(b_e2, m0_1)),
        add(mul(b_e1, m1_0), mul(b_e2, m1_1))}

def Vector.transform.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Pseudoscalar<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2} K.Pseudoscalar{+b_e12}:
      +q1_1 = mul(a_e2, a_e2)
      +q0_0 = mul(a_e1, a_e1)
      +m0_0 = add(neg(q1_1), neg(q0_0))
      K.Pseudoscalar{
        mul(b_e12, m0_0)}

def Vector.transform.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Rotor<T>) -> K.Rotor<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2} K.Rotor{+b_s, +b_e12}:
      +q1_1 = mul(a_e2, a_e2)
      +q0_0 = mul(a_e1, a_e1)
      +m0_0 = add(q1_1, q0_0)
      +m1_1 = add(neg(q1_1), neg(q0_0))
      K.Rotor{
        mul(b_s, m0_0),
        mul(b_e12, m1_1)}

def Vector.transform.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2} K.Multivector{+b_s, +b_e1, +b_e2, +b_e12}:
      +q1_1 = mul(a_e2, a_e2)
      +q0_0 = mul(a_e1, a_e1)
      +q0_1 = mul(a_e1, a_e2)
      +m0_0 = add(q1_1, q0_0)
      +m1_1 = add(neg(q1_1), q0_0)
      +m1_2 = add(q0_1, q0_1)
      +m2_1 = add(q0_1, q0_1)
      +m2_2 = add(q1_1, neg(q0_0))
      +m3_3 = add(neg(q1_1), neg(q0_0))
      K.Multivector{
        mul(b_s, m0_0),
        add(mul(b_e1, m1_1), mul(b_e2, m1_2)),
        add(mul(b_e1, m2_1), mul(b_e2, m2_2)),
        mul(b_e12, m3_3)}

def Rotor.transform.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Scalar<T>) -> K.Scalar<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Scalar{+b_s}:
      +q1_1 = mul(a_e12, a_e12)
      +q0_0 = mul(a_s, a_s)
      +m0_0 = add(q1_1, q0_0)
      K.Scalar{
        mul(b_s, m0_0)}

def Rotor.transform.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Vector<T>) -> K.Vector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Vector{+b_e1, +b_e2}:
      +q1_1 = mul(a_e12, a_e12)
      +q0_0 = mul(a_s, a_s)
      +q0_1 = mul(a_s, a_e12)
      +m0_0 = add(neg(q1_1), q0_0)
      +m0_1 = add(q0_1, q0_1)
      +m1_0 = add(neg(q0_1), neg(q0_1))
      +m1_1 = add(neg(q1_1), q0_0)
      K.Vector{
        add(mul(b_e1, m0_0), mul(b_e2, m0_1)),
        add(mul(b_e1, m1_0), mul(b_e2, m1_1))}

def Rotor.transform.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Pseudoscalar<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Pseudoscalar{+b_e12}:
      +q1_1 = mul(a_e12, a_e12)
      +q0_0 = mul(a_s, a_s)
      +m0_0 = add(q1_1, q0_0)
      K.Pseudoscalar{
        mul(b_e12, m0_0)}

def Rotor.transform.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Rotor<T>) -> K.Rotor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Rotor{+b_s, +b_e12}:
      +q1_1 = mul(a_e12, a_e12)
      +q0_0 = mul(a_s, a_s)
      +m0_0 = add(q1_1, q0_0)
      +m1_1 = add(q1_1, q0_0)
      K.Rotor{
        mul(b_s, m0_0),
        mul(b_e12, m1_1)}

def Rotor.transform.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Multivector{+b_s, +b_e1, +b_e2, +b_e12}:
      +q1_1 = mul(a_e12, a_e12)
      +q0_0 = mul(a_s, a_s)
      +q0_1 = mul(a_s, a_e12)
      +m0_0 = add(q1_1, q0_0)
      +m1_1 = add(neg(q1_1), q0_0)
      +m1_2 = add(q0_1, q0_1)
      +m2_1 = add(neg(q0_1), neg(q0_1))
      +m2_2 = add(neg(q1_1), q0_0)
      +m3_3 = add(q1_1, q0_0)
      K.Multivector{
        mul(b_s, m0_0),
        add(mul(b_e1, m1_1), mul(b_e2, m1_2)),
        add(mul(b_e1, m2_1), mul(b_e2, m2_2)),
        mul(b_e12, m3_3)}

def Vector.commutator.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Vector<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2} K.Vector{+b_e1, +b_e2}:
      K.Pseudoscalar{
        add(neg(mul(a_e2, b_e1)), mul(a_e1, b_e2))}

def Vector.commutator.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Pseudoscalar<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2} K.Pseudoscalar{+b_e12}:
      K.Vector{
        neg(mul(a_e2, b_e12)),
        mul(a_e1, b_e12)}

def Vector.commutator.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Rotor<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2} K.Rotor{+b_s, +b_e12}:
      K.Vector{
        neg(mul(a_e2, b_e12)),
        mul(a_e1, b_e12)}

def Vector.commutator.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2} K.Multivector{+b_s, +b_e1, +b_e2, +b_e12}:
      K.Multivector{
        zero,
        neg(mul(a_e2, b_e12)),
        mul(a_e1, b_e12),
        add(neg(mul(a_e2, b_e1)), mul(a_e1, b_e2))}

def Pseudoscalar.commutator.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Vector<T>) -> K.Vector<T>:
  match a b:
    case K.Pseudoscalar{+a_e12} K.Vector{+b_e1, +b_e2}:
      K.Vector{
        mul(a_e12, b_e2),
        neg(mul(a_e12, b_e1))}

def Pseudoscalar.commutator.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Multivector<T>) -> K.Vector<T>:
  match a b:
    case K.Pseudoscalar{+a_e12} K.Multivector{+b_s, +b_e1, +b_e2, +b_e12}:
      K.Vector{
        mul(a_e12, b_e2),
        neg(mul(a_e12, b_e1))}

def Rotor.commutator.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Vector<T>) -> K.Vector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Vector{+b_e1, +b_e2}:
      K.Vector{
        mul(a_e12, b_e2),
        neg(mul(a_e12, b_e1))}

