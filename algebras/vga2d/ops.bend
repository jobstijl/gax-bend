  match a b:
    case K.Scalar{+a_s} K.Multivector{+b_s, +b_e1, +b_e2, +b_e12}:
      K.Multivector{
        mul(a_s, b_s),
        mul(a_s, b_e1),
        mul(a_s, b_e2),
