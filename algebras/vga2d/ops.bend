  match a b:
    case K.Scalar{+a_s} K.Pseudoscalar{+b_e12}:
      K.Pseudoscalar{
        mul(a_s, b_e12)}

def Scalar.anticommutator.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Rotor<T>) -> K.Rotor<T>:
  match a b:
    case K.Scalar{+a_s} K.Rotor{+b_s, +b_e12}:
      K.Rotor{
        mul(a_s, b_s),
        mul(a_s, b_e12)}

