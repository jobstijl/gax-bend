  match a:
    case K.Multivector{+a_s, +a_e1, +a_e2, +a_e12}:
      K.Multivector{
        a_s,
        a_e1,
        a_e2,
        neg(a_e12)}

def Scalar.involute(~T: Data, ~zero: T, ~neg: T -> T, a: K.Scalar<T>) -> K.Scalar<T>:
  match a:
    case K.Scalar{+a_s}:
      K.Scalar{
        a_s}

def Vector.involute(~T: Data, ~zero: T, ~neg: T -> T, a: K.Vector<T>) -> K.Vector<T>:
  match a:
    case K.Vector{+a_e1, +a_e2}:
      K.Vector{
        neg(a_e1),
        neg(a_e2)}

def Pseudoscalar.involute(~T: Data, ~zero: T, ~neg: T -> T, a: K.Pseudoscalar<T>) -> K.Pseudoscalar<T>:
  match a:
    case K.Pseudoscalar{+a_e12}:
      K.Pseudoscalar{
        a_e12}

def Rotor.involute(~T: Data, ~zero: T, ~neg: T -> T, a: K.Rotor<T>) -> K.Rotor<T>:
  match a:
    case K.Rotor{+a_s, +a_e12}:
      K.Rotor{
