        add(add(neg(mul(neg(a_e021), b_e1)), mul(a_e013, b_e123)), mul(neg(a_e032), b_e3)),
        add(add(neg(mul(neg(a_e021), b_e123)), neg(mul(a_e013, b_e1))), neg(mul(neg(a_e032), b_e2))),
        add(add(mul(neg(a_e021), b_e3), neg(mul(a_e013, b_e2))), mul(neg(a_e032), b_e1))}

def Direction.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Direction<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Direction{+a_e032, +a_e013, +a_e021} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e3, +b_e01, +b_e02, +b_e03, +b_e12, +b_e31, +b_e23, +b_e021, +b_e013, +b_e032, +b_e123, +b_e0123}:
      K.Multivector{
        zero,
        add(add(neg(mul(neg(a_e021), b_e12)), neg(mul(a_e013, neg(b_e31)))), neg(mul(neg(a_e032), b_e23))),
        zero,
        zero,
        zero,
        add(add(mul(neg(a_e021), b_e2), mul(a_e013, b_e3)), neg(mul(neg(a_e032), b_e123))),
        add(add(neg(mul(neg(a_e021), b_e1)), mul(a_e013, b_e123)), mul(neg(a_e032), b_e3)),
        add(add(neg(mul(neg(a_e021), b_e123)), neg(mul(a_e013, b_e1))), neg(mul(neg(a_e032), b_e2))),
        zero,
        zero,
        zero,
        neg(add(add(mul(neg(a_e021), b_s), neg(mul(a_e013, b_e23))), mul(neg(a_e032), neg(b_e31)))),
        add(add(mul(neg(a_e021), b_e23), mul(a_e013, b_s)), neg(mul(neg(a_e032), b_e12))),
        neg(add(add(neg(mul(neg(a_e021), neg(b_e31))), mul(a_e013, b_e12)), mul(neg(a_e032), b_s))),
        zero,
        add(add(mul(neg(a_e021), b_e3), neg(mul(a_e013, b_e2))), mul(neg(a_e032), b_e1))}

