        add(mul(neg(a_e013), neg(b_e021)), neg(mul(neg(a_e021), neg(b_e013)))),
        neg(add(mul(neg(a_e032), neg(b_e021)), neg(mul(neg(a_e021), neg(b_e032))))),
        add(mul(neg(a_e032), neg(b_e013)), neg(mul(neg(a_e013), neg(b_e032)))),
        add(mul(neg(a_e123), neg(b_e021)), neg(mul(neg(a_e021), neg(b_e123)))),
