      +m4_3 = add(add(add(neg(q1_7), neg(q1_7)), neg(q0_2)), neg(q0_2))
      +m5_1 = add(add(add(neg(q2_7), neg(q2_7)), neg(q0_1)), neg(q0_1))
      +m5_2 = add(add(add(neg(q7_7), q2_2), neg(q1_1)), q0_0)
