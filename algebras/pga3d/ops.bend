      +q1_3 = mul(a_e23, a_e12)
      +q0_2 = mul(a_s, a_e31)
      +q2_3 = mul(a_e31, a_e12)
      +q0_1 = mul(a_s, a_e23)
      +m0_0 = add(add(add(neg(q3_3), neg(q2_2)), q1_1), q0_0)
      +m0_1 = add(add(add(q1_2, q1_2), q0_3), q0_3)
