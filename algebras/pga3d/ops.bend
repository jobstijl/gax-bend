        neg(mul(neg(a_e021), b_e0123)),
        neg(mul(neg(a_e123), b_e0123))}

def Point.vee.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Point<T>, b: K.Flector<T>) -> K.Motor<T>:
