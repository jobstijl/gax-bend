def Scalar.wedge.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Scalar<T>) -> K.Scalar<T>:
  match a b:
    case K.Scalar{+a_s} K.Scalar{+b_s}:
      K.Scalar{
        mul(a_s, b_s)}

def Scalar.wedge.Plane(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Plane<T>) -> K.Plane<T>:
  match a b:
    case K.Scalar{+a_s} K.Plane{+b_e1, +b_e2, +b_e3, +b_e0}:
      K.Plane{
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        mul(a_s, b_e0)}

def Scalar.wedge.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Line<T>) -> K.Line<T>:
  match a b:
    case K.Scalar{+a_s} K.Line{+b_e23, +b_e31, +b_e12, +b_e01, +b_e02, +b_e03}:
      K.Line{
        mul(a_s, b_e23),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e12),
        mul(a_s, b_e01),
        mul(a_s, b_e02),
        mul(a_s, b_e03)}

def Scalar.wedge.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Point<T>) -> K.Point<T>:
  match a b:
    case K.Scalar{+a_s} K.Point{+b_e032, +b_e013, +b_e021, +b_e123}:
      K.Point{
        neg(mul(a_s, neg(b_e032))),
        mul(a_s, b_e013),
        neg(mul(a_s, neg(b_e021))),
        mul(a_s, b_e123)}

def Scalar.wedge.Direction(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Direction<T>) -> K.Point<T>:
  match a b:
    case K.Scalar{+a_s} K.Direction{+b_e032, +b_e013, +b_e021}:
      K.Point{
        neg(mul(a_s, neg(b_e032))),
        mul(a_s, b_e013),
        neg(mul(a_s, neg(b_e021))),
        zero}

def Scalar.wedge.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Pseudoscalar<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Scalar{+a_s} K.Pseudoscalar{+b_e0123}:
      K.Pseudoscalar{
        mul(a_s, b_e0123)}

def Scalar.wedge.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Rotor<T>) -> K.Rotor<T>:
  match a b:
    case K.Scalar{+a_s} K.Rotor{+b_s, +b_e23, +b_e31, +b_e12}:
      K.Rotor{
        mul(a_s, b_s),
        mul(a_s, b_e23),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e12)}

def Scalar.wedge.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Translator<T>) -> K.Translator<T>:
  match a b:
    case K.Scalar{+a_s} K.Translator{+b_s, +b_e01, +b_e02, +b_e03}:
      K.Translator{
        mul(a_s, b_s),
        mul(a_s, b_e01),
        mul(a_s, b_e02),
        mul(a_s, b_e03)}

def Scalar.wedge.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Motor<T>) -> K.Motor<T>:
  match a b:
    case K.Scalar{+a_s} K.Motor{+b_s, +b_e23, +b_e31, +b_e12, +b_e01, +b_e02, +b_e03, +b_e0123}:
      K.Motor{
        mul(a_s, b_s),
        mul(a_s, b_e23),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e12),
        mul(a_s, b_e01),
        mul(a_s, b_e02),
        mul(a_s, b_e03),
        mul(a_s, b_e0123)}

def Scalar.wedge.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Flector<T>) -> K.Flector<T>:
  match a b:
    case K.Scalar{+a_s} K.Flector{+b_e1, +b_e2, +b_e3, +b_e0, +b_e032, +b_e013, +b_e021, +b_e123}:
      K.Flector{
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        mul(a_s, b_e0),
        neg(mul(a_s, neg(b_e032))),
        mul(a_s, b_e013),
        neg(mul(a_s, neg(b_e021))),
        mul(a_s, b_e123)}

def Scalar.wedge.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Scalar{+a_s} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e3, +b_e01, +b_e02, +b_e03, +b_e12, +b_e31, +b_e23, +b_e021, +b_e013, +b_e032, +b_e123, +b_e0123}:
      K.Multivector{
        mul(a_s, b_s),
        mul(a_s, b_e0),
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        mul(a_s, b_e01),
        mul(a_s, b_e02),
        mul(a_s, b_e03),
        mul(a_s, b_e12),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e23),
        neg(mul(a_s, neg(b_e021))),
        mul(a_s, b_e013),
        neg(mul(a_s, neg(b_e032))),
        mul(a_s, b_e123),
        mul(a_s, b_e0123)}

def Plane.wedge.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Plane<T>, b: K.Scalar<T>) -> K.Plane<T>:
  match a b:
    case K.Plane{+a_e1, +a_e2, +a_e3, +a_e0} K.Scalar{+b_s}:
      K.Plane{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_e0, b_s)}

def Plane.wedge.Plane(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Plane<T>, b: K.Plane<T>) -> K.Line<T>:
  match a b:
    case K.Plane{+a_e1, +a_e2, +a_e3, +a_e0} K.Plane{+b_e1, +b_e2, +b_e3, +b_e0}:
      K.Line{
        add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2))),
