        add(neg(mul(neg(a_e021), b_e123)), add(add(mul(a_e123, neg(b_e021)), neg(mul(a_e1, b_e013))), neg(mul(a_e2, neg(b_e032))))),
        add(mul(a_e0, b_e123), add(neg(mul(a_e1, neg(b_e032))), add(mul(a_e2, b_e013), neg(mul(a_e3, neg(b_e021))))))}

def Flector.gp.Direction(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Direction<T>) -> K.Motor<T>:
