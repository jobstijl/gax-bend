def Rotor.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Scalar<T>) -> K.Rotor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Scalar{+b_s}:
      K.Rotor{
        mul(a_s, b_s),
        mul(a_e23, b_s),
        neg(mul(neg(a_e31), b_s)),
        mul(a_e12, b_s)}

def Rotor.gp.Plane(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Plane<T>) -> K.Flector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Plane{+b_e1, +b_e2, +b_e3, +b_e0}:
      K.Flector{
        add(add(mul(a_e12, b_e2), mul(neg(a_e31), b_e3)), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), add(mul(a_e23, b_e3), mul(a_s, b_e2))),
        add(neg(mul(neg(a_e31), b_e1)), add(neg(mul(a_e23, b_e2)), mul(a_s, b_e3))),
        mul(a_s, b_e0),
        neg(mul(a_e23, b_e0)),
        mul(neg(a_e31), b_e0),
        neg(mul(a_e12, b_e0)),
        add(add(mul(a_e12, b_e3), neg(mul(neg(a_e31), b_e2))), mul(a_e23, b_e1))}

def Rotor.gp.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Line<T>) -> K.Motor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Line{+b_e23, +b_e31, +b_e12, +b_e01, +b_e02, +b_e03}:
      K.Motor{
        add(add(neg(mul(a_e12, b_e12)), neg(mul(neg(a_e31), neg(b_e31)))), neg(mul(a_e23, b_e23))),
        add(add(neg(mul(a_e12, neg(b_e31))), mul(neg(a_e31), b_e12)), mul(a_s, b_e23)),
        neg(add(mul(a_e12, b_e23), add(neg(mul(a_e23, b_e12)), mul(a_s, neg(b_e31))))),
        add(neg(mul(neg(a_e31), b_e23)), add(mul(a_e23, neg(b_e31)), mul(a_s, b_e12))),
        add(add(mul(a_e12, b_e02), mul(neg(a_e31), b_e03)), mul(a_s, b_e01)),
        add(neg(mul(a_e12, b_e01)), add(mul(a_e23, b_e03), mul(a_s, b_e02))),
        add(neg(mul(neg(a_e31), b_e01)), add(neg(mul(a_e23, b_e02)), mul(a_s, b_e03))),
        add(add(mul(a_e12, b_e03), neg(mul(neg(a_e31), b_e02))), mul(a_e23, b_e01))}

def Rotor.gp.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Point<T>) -> K.Flector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Point{+b_e032, +b_e013, +b_e021, +b_e123}:
      K.Flector{
        neg(mul(a_e23, b_e123)),
        mul(neg(a_e31), b_e123),
        neg(mul(a_e12, b_e123)),
        add(add(neg(mul(a_e12, neg(b_e021))), neg(mul(neg(a_e31), b_e013))), neg(mul(a_e23, neg(b_e032)))),
        neg(add(add(neg(mul(a_e12, b_e013)), mul(neg(a_e31), neg(b_e021))), mul(a_s, neg(b_e032)))),
        add(mul(a_e12, neg(b_e032)), add(neg(mul(a_e23, neg(b_e021))), mul(a_s, b_e013))),
        neg(add(neg(mul(neg(a_e31), neg(b_e032))), add(mul(a_e23, b_e013), mul(a_s, neg(b_e021))))),
        mul(a_s, b_e123)}

def Rotor.gp.Direction(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Direction<T>) -> K.Flector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Direction{+b_e032, +b_e013, +b_e021}:
      K.Flector{
        zero,
        zero,
        zero,
        add(add(neg(mul(a_e12, neg(b_e021))), neg(mul(neg(a_e31), b_e013))), neg(mul(a_e23, neg(b_e032)))),
        neg(add(add(neg(mul(a_e12, b_e013)), mul(neg(a_e31), neg(b_e021))), mul(a_s, neg(b_e032)))),
        add(mul(a_e12, neg(b_e032)), add(neg(mul(a_e23, neg(b_e021))), mul(a_s, b_e013))),
        neg(add(neg(mul(neg(a_e31), neg(b_e032))), add(mul(a_e23, b_e013), mul(a_s, neg(b_e021))))),
        zero}

def Rotor.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Pseudoscalar<T>) -> K.Motor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Pseudoscalar{+b_e0123}:
      K.Motor{
        zero,
        zero,
        zero,
        zero,
        neg(mul(a_e23, b_e0123)),
        mul(neg(a_e31), b_e0123),
        neg(mul(a_e12, b_e0123)),
        mul(a_s, b_e0123)}

def Rotor.gp.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Rotor<T>) -> K.Rotor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Rotor{+b_s, +b_e23, +b_e31, +b_e12}:
      K.Rotor{
        add(add(neg(mul(a_e12, b_e12)), neg(mul(neg(a_e31), neg(b_e31)))), add(neg(mul(a_e23, b_e23)), mul(a_s, b_s))),
        add(add(neg(mul(a_e12, neg(b_e31))), mul(neg(a_e31), b_e12)), add(mul(a_e23, b_s), mul(a_s, b_e23))),
        neg(add(add(mul(a_e12, b_e23), mul(neg(a_e31), b_s)), add(neg(mul(a_e23, b_e12)), mul(a_s, neg(b_e31))))),
        add(add(mul(a_e12, b_s), neg(mul(neg(a_e31), b_e23))), add(mul(a_e23, neg(b_e31)), mul(a_s, b_e12)))}

def Rotor.gp.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Translator<T>) -> K.Motor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Translator{+b_s, +b_e01, +b_e02, +b_e03}:
      K.Motor{
        mul(a_s, b_s),
        mul(a_e23, b_s),
        neg(mul(neg(a_e31), b_s)),
        mul(a_e12, b_s),
        add(add(mul(a_e12, b_e02), mul(neg(a_e31), b_e03)), mul(a_s, b_e01)),
        add(neg(mul(a_e12, b_e01)), add(mul(a_e23, b_e03), mul(a_s, b_e02))),
        add(neg(mul(neg(a_e31), b_e01)), add(neg(mul(a_e23, b_e02)), mul(a_s, b_e03))),
        add(add(mul(a_e12, b_e03), neg(mul(neg(a_e31), b_e02))), mul(a_e23, b_e01))}

def Rotor.gp.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Motor<T>) -> K.Motor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Motor{+b_s, +b_e23, +b_e31, +b_e12, +b_e01, +b_e02, +b_e03, +b_e0123}:
      K.Motor{
        add(add(neg(mul(a_e12, b_e12)), neg(mul(neg(a_e31), neg(b_e31)))), add(neg(mul(a_e23, b_e23)), mul(a_s, b_s))),
        add(add(neg(mul(a_e12, neg(b_e31))), mul(neg(a_e31), b_e12)), add(mul(a_e23, b_s), mul(a_s, b_e23))),
        neg(add(add(mul(a_e12, b_e23), mul(neg(a_e31), b_s)), add(neg(mul(a_e23, b_e12)), mul(a_s, neg(b_e31))))),
        add(add(mul(a_e12, b_s), neg(mul(neg(a_e31), b_e23))), add(mul(a_e23, neg(b_e31)), mul(a_s, b_e12))),
        add(add(mul(a_e12, b_e02), mul(neg(a_e31), b_e03)), add(neg(mul(a_e23, b_e0123)), mul(a_s, b_e01))),
        add(add(neg(mul(a_e12, b_e01)), mul(neg(a_e31), b_e0123)), add(mul(a_e23, b_e03), mul(a_s, b_e02))),
        add(add(neg(mul(a_e12, b_e0123)), neg(mul(neg(a_e31), b_e01))), add(neg(mul(a_e23, b_e02)), mul(a_s, b_e03))),
        add(add(mul(a_e12, b_e03), neg(mul(neg(a_e31), b_e02))), add(mul(a_e23, b_e01), mul(a_s, b_e0123)))}

def Rotor.gp.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Flector<T>) -> K.Flector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Flector{+b_e1, +b_e2, +b_e3, +b_e0, +b_e032, +b_e013, +b_e021, +b_e123}:
      K.Flector{
        add(add(mul(a_e12, b_e2), mul(neg(a_e31), b_e3)), add(neg(mul(a_e23, b_e123)), mul(a_s, b_e1))),
        add(add(neg(mul(a_e12, b_e1)), mul(neg(a_e31), b_e123)), add(mul(a_e23, b_e3), mul(a_s, b_e2))),
        add(add(neg(mul(a_e12, b_e123)), neg(mul(neg(a_e31), b_e1))), add(neg(mul(a_e23, b_e2)), mul(a_s, b_e3))),
        add(add(neg(mul(a_e12, neg(b_e021))), neg(mul(neg(a_e31), b_e013))), add(neg(mul(a_e23, neg(b_e032))), mul(a_s, b_e0))),
        neg(add(add(neg(mul(a_e12, b_e013)), mul(neg(a_e31), neg(b_e021))), add(mul(a_e23, b_e0), mul(a_s, neg(b_e032))))),
        add(add(mul(a_e12, neg(b_e032)), mul(neg(a_e31), b_e0)), add(neg(mul(a_e23, neg(b_e021))), mul(a_s, b_e013))),
        neg(add(add(mul(a_e12, b_e0), neg(mul(neg(a_e31), neg(b_e032)))), add(mul(a_e23, b_e013), mul(a_s, neg(b_e021))))),
        add(add(mul(a_e12, b_e3), neg(mul(neg(a_e31), b_e2))), add(mul(a_e23, b_e1), mul(a_s, b_e123)))}

def Rotor.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e3, +b_e01, +b_e02, +b_e03, +b_e12, +b_e31, +b_e23, +b_e021, +b_e013, +b_e032, +b_e123, +b_e0123}:
      K.Multivector{
        add(add(neg(mul(a_e12, b_e12)), neg(mul(neg(a_e31), neg(b_e31)))), add(neg(mul(a_e23, b_e23)), mul(a_s, b_s))),
        add(add(neg(mul(a_e12, neg(b_e021))), neg(mul(neg(a_e31), b_e013))), add(neg(mul(a_e23, neg(b_e032))), mul(a_s, b_e0))),
        add(add(mul(a_e12, b_e2), mul(neg(a_e31), b_e3)), add(neg(mul(a_e23, b_e123)), mul(a_s, b_e1))),
        add(add(neg(mul(a_e12, b_e1)), mul(neg(a_e31), b_e123)), add(mul(a_e23, b_e3), mul(a_s, b_e2))),
        add(add(neg(mul(a_e12, b_e123)), neg(mul(neg(a_e31), b_e1))), add(neg(mul(a_e23, b_e2)), mul(a_s, b_e3))),
        add(add(mul(a_e12, b_e02), mul(neg(a_e31), b_e03)), add(neg(mul(a_e23, b_e0123)), mul(a_s, b_e01))),
        add(add(neg(mul(a_e12, b_e01)), mul(neg(a_e31), b_e0123)), add(mul(a_e23, b_e03), mul(a_s, b_e02))),
        add(add(neg(mul(a_e12, b_e0123)), neg(mul(neg(a_e31), b_e01))), add(neg(mul(a_e23, b_e02)), mul(a_s, b_e03))),
        add(add(mul(a_e12, b_s), neg(mul(neg(a_e31), b_e23))), add(mul(a_e23, neg(b_e31)), mul(a_s, b_e12))),
        neg(add(add(mul(a_e12, b_e23), mul(neg(a_e31), b_s)), add(neg(mul(a_e23, b_e12)), mul(a_s, neg(b_e31))))),
        add(add(neg(mul(a_e12, neg(b_e31))), mul(neg(a_e31), b_e12)), add(mul(a_e23, b_s), mul(a_s, b_e23))),
        neg(add(add(mul(a_e12, b_e0), neg(mul(neg(a_e31), neg(b_e032)))), add(mul(a_e23, b_e013), mul(a_s, neg(b_e021))))),
        add(add(mul(a_e12, neg(b_e032)), mul(neg(a_e31), b_e0)), add(neg(mul(a_e23, neg(b_e021))), mul(a_s, b_e013))),
        neg(add(add(neg(mul(a_e12, b_e013)), mul(neg(a_e31), neg(b_e021))), add(mul(a_e23, b_e0), mul(a_s, neg(b_e032))))),
        add(add(mul(a_e12, b_e3), neg(mul(neg(a_e31), b_e2))), add(mul(a_e23, b_e1), mul(a_s, b_e123))),
        add(add(mul(a_e12, b_e03), neg(mul(neg(a_e31), b_e02))), add(mul(a_e23, b_e01), mul(a_s, b_e0123)))}

def Translator.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Scalar<T>) -> K.Translator<T>:
  match a b:
    case K.Translator{+a_s, +a_e01, +a_e02, +a_e03} K.Scalar{+b_s}:
      K.Translator{
        mul(a_s, b_s),
        mul(a_e01, b_s),
        mul(a_e02, b_s),
        mul(a_e03, b_s)}

def Translator.gp.Plane(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Plane<T>) -> K.Flector<T>:
  match a b:
    case K.Translator{+a_s, +a_e01, +a_e02, +a_e03} K.Plane{+b_e1, +b_e2, +b_e3, +b_e0}:
      K.Flector{
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        add(add(mul(a_e01, b_e1), add(mul(a_e02, b_e2), mul(a_e03, b_e3))), mul(a_s, b_e0)),
        neg(add(mul(a_e02, b_e3), neg(mul(a_e03, b_e2)))),
        add(mul(a_e01, b_e3), neg(mul(a_e03, b_e1))),
        neg(add(mul(a_e01, b_e2), neg(mul(a_e02, b_e1)))),
        zero}

def Translator.gp.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Line<T>) -> K.Motor<T>:
  match a b:
    case K.Translator{+a_s, +a_e01, +a_e02, +a_e03} K.Line{+b_e23, +b_e31, +b_e12, +b_e01, +b_e02, +b_e03}:
      K.Motor{
        zero,
        mul(a_s, b_e23),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e12),
        add(add(neg(mul(a_e02, b_e12)), neg(mul(a_e03, neg(b_e31)))), mul(a_s, b_e01)),
        add(add(mul(a_e01, b_e12), neg(mul(a_e03, b_e23))), mul(a_s, b_e02)),
        add(add(mul(a_e01, neg(b_e31)), mul(a_e02, b_e23)), mul(a_s, b_e03)),
        add(mul(a_e01, b_e23), add(neg(mul(a_e02, neg(b_e31))), mul(a_e03, b_e12)))}

def Translator.gp.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Point<T>) -> K.Point<T>:
  match a b:
    case K.Translator{+a_s, +a_e01, +a_e02, +a_e03} K.Point{+b_e032, +b_e013, +b_e021, +b_e123}:
      K.Point{
        neg(add(mul(a_e01, b_e123), mul(a_s, neg(b_e032)))),
        add(neg(mul(a_e02, b_e123)), mul(a_s, b_e013)),
        neg(add(mul(a_e03, b_e123), mul(a_s, neg(b_e021)))),
        mul(a_s, b_e123)}

def Translator.gp.Direction(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Direction<T>) -> K.Point<T>:
  match a b:
    case K.Translator{+a_s, +a_e01, +a_e02, +a_e03} K.Direction{+b_e032, +b_e013, +b_e021}:
      K.Point{
        neg(mul(a_s, neg(b_e032))),
        mul(a_s, b_e013),
        neg(mul(a_s, neg(b_e021))),
        zero}

def Translator.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Pseudoscalar<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Translator{+a_s, +a_e01, +a_e02, +a_e03} K.Pseudoscalar{+b_e0123}:
      K.Pseudoscalar{
        mul(a_s, b_e0123)}

def Translator.gp.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Rotor<T>) -> K.Motor<T>:
  match a b:
    case K.Translator{+a_s, +a_e01, +a_e02, +a_e03} K.Rotor{+b_s, +b_e23, +b_e31, +b_e12}:
      K.Motor{
        mul(a_s, b_s),
        mul(a_s, b_e23),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e12),
        add(mul(a_e01, b_s), add(neg(mul(a_e02, b_e12)), neg(mul(a_e03, neg(b_e31))))),
        add(mul(a_e01, b_e12), add(mul(a_e02, b_s), neg(mul(a_e03, b_e23)))),
        add(mul(a_e01, neg(b_e31)), add(mul(a_e02, b_e23), mul(a_e03, b_s))),
        add(mul(a_e01, b_e23), add(neg(mul(a_e02, neg(b_e31))), mul(a_e03, b_e12)))}

def Translator.gp.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Translator<T>) -> K.Translator<T>:
  match a b:
    case K.Translator{+a_s, +a_e01, +a_e02, +a_e03} K.Translator{+b_s, +b_e01, +b_e02, +b_e03}:
      K.Translator{
        mul(a_s, b_s),
        add(mul(a_e01, b_s), mul(a_s, b_e01)),
        add(mul(a_e02, b_s), mul(a_s, b_e02)),
        add(mul(a_e03, b_s), mul(a_s, b_e03))}

def Translator.gp.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Motor<T>) -> K.Motor<T>:
  match a b:
    case K.Translator{+a_s, +a_e01, +a_e02, +a_e03} K.Motor{+b_s, +b_e23, +b_e31, +b_e12, +b_e01, +b_e02, +b_e03, +b_e0123}:
      K.Motor{
        mul(a_s, b_s),
        mul(a_s, b_e23),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e12),
        add(add(mul(a_e01, b_s), add(neg(mul(a_e02, b_e12)), neg(mul(a_e03, neg(b_e31))))), mul(a_s, b_e01)),
        add(add(mul(a_e01, b_e12), add(mul(a_e02, b_s), neg(mul(a_e03, b_e23)))), mul(a_s, b_e02)),
        add(add(mul(a_e01, neg(b_e31)), add(mul(a_e02, b_e23), mul(a_e03, b_s))), mul(a_s, b_e03)),
        add(add(mul(a_e01, b_e23), add(neg(mul(a_e02, neg(b_e31))), mul(a_e03, b_e12))), mul(a_s, b_e0123))}

def Translator.gp.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Flector<T>) -> K.Flector<T>:
  match a b:
    case K.Translator{+a_s, +a_e01, +a_e02, +a_e03} K.Flector{+b_e1, +b_e2, +b_e3, +b_e0, +b_e032, +b_e013, +b_e021, +b_e123}:
      K.Flector{
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        add(add(mul(a_e01, b_e1), add(mul(a_e02, b_e2), mul(a_e03, b_e3))), mul(a_s, b_e0)),
        neg(add(add(mul(a_e01, b_e123), add(mul(a_e02, b_e3), neg(mul(a_e03, b_e2)))), mul(a_s, neg(b_e032)))),
        add(add(mul(a_e01, b_e3), add(neg(mul(a_e02, b_e123)), neg(mul(a_e03, b_e1)))), mul(a_s, b_e013)),
        neg(add(add(mul(a_e01, b_e2), add(neg(mul(a_e02, b_e1)), mul(a_e03, b_e123))), mul(a_s, neg(b_e021)))),
        mul(a_s, b_e123)}

def Translator.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Translator{+a_s, +a_e01, +a_e02, +a_e03} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e3, +b_e01, +b_e02, +b_e03, +b_e12, +b_e31, +b_e23, +b_e021, +b_e013, +b_e032, +b_e123, +b_e0123}:
      K.Multivector{
        mul(a_s, b_s),
        add(add(mul(a_e01, b_e1), add(mul(a_e02, b_e2), mul(a_e03, b_e3))), mul(a_s, b_e0)),
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        add(add(mul(a_e01, b_s), add(neg(mul(a_e02, b_e12)), neg(mul(a_e03, neg(b_e31))))), mul(a_s, b_e01)),
        add(add(mul(a_e01, b_e12), add(mul(a_e02, b_s), neg(mul(a_e03, b_e23)))), mul(a_s, b_e02)),
        add(add(mul(a_e01, neg(b_e31)), add(mul(a_e02, b_e23), mul(a_e03, b_s))), mul(a_s, b_e03)),
        mul(a_s, b_e12),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e23),
        neg(add(add(mul(a_e01, b_e2), add(neg(mul(a_e02, b_e1)), mul(a_e03, b_e123))), mul(a_s, neg(b_e021)))),
        add(add(mul(a_e01, b_e3), add(neg(mul(a_e02, b_e123)), neg(mul(a_e03, b_e1)))), mul(a_s, b_e013)),
        neg(add(add(mul(a_e01, b_e123), add(mul(a_e02, b_e3), neg(mul(a_e03, b_e2)))), mul(a_s, neg(b_e032)))),
        mul(a_s, b_e123),
