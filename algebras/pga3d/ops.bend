        add(mul(a_e021, b_e1), neg(mul(a_e032, b_e3))),
        add(neg(mul(a_e013, b_e1)), mul(a_e032, b_e2)),
        zero}

def Flector.anticommutator.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Line<T>) -> K.Flector<T>:
  match a b:
