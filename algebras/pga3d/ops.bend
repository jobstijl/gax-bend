        add(add(mul(a_e123, b_e1), mul(a_e1, b_e123)), add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2)))),
        neg(add(add(add(mul(neg(a_e021), b_s), neg(mul(a_e013, b_e23))), add(mul(neg(a_e032), neg(b_e31)), mul(a_e0, b_e12))), add(add(neg(mul(a_e123, b_e03)), neg(mul(a_e1, b_e02))), add(mul(a_e2, b_e01), neg(mul(a_e3, b_e0123)))))),
        add(add(add(mul(neg(a_e021), b_e23), mul(a_e013, b_s)), add(neg(mul(neg(a_e032), b_e12)), mul(a_e0, neg(b_e31)))), add(add(mul(a_e123, b_e02), neg(mul(a_e1, b_e03))), add(mul(a_e2, b_e0123), mul(a_e3, b_e01)))),
        neg(add(add(add(neg(mul(neg(a_e021), neg(b_e31))), mul(a_e013, b_e12)), add(mul(neg(a_e032), b_s), mul(a_e0, b_e23))), add(add(neg(mul(a_e123, b_e01)), neg(mul(a_e1, b_e0123))), add(neg(mul(a_e2, b_e03)), mul(a_e3, b_e02))))),
