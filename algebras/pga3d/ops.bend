        neg(mul(a_e123, b_e23)),
        mul(a_e123, neg(b_e31)),
        neg(mul(a_e123, b_e12)),
        add(add(add(mul(neg(a_e021), b_e2), mul(a_e013, b_e3)), neg(mul(neg(a_e032), b_e123))), mul(a_e123, neg(b_e032))),
        add(add(add(neg(mul(neg(a_e021), b_e1)), mul(a_e013, b_e123)), mul(neg(a_e032), b_e3)), neg(mul(a_e123, b_e013))),
        add(add(add(neg(mul(neg(a_e021), b_e123)), neg(mul(a_e013, b_e1))), neg(mul(neg(a_e032), b_e2))), mul(a_e123, neg(b_e021))),
        mul(a_e123, b_e3),
        neg(neg(mul(a_e123, b_e2))),
        mul(a_e123, b_e1),
        neg(add(add(add(mul(neg(a_e021), b_s), neg(mul(a_e013, b_e23))), mul(neg(a_e032), neg(b_e31))), neg(mul(a_e123, b_e03)))),
        add(add(add(mul(neg(a_e021), b_e23), mul(a_e013, b_s)), neg(mul(neg(a_e032), b_e12))), mul(a_e123, b_e02)),
        neg(add(add(add(neg(mul(neg(a_e021), neg(b_e31))), mul(a_e013, b_e12)), mul(neg(a_e032), b_s)), neg(mul(a_e123, b_e01)))),
        mul(a_e123, b_s),
        add(add(add(mul(neg(a_e021), b_e3), neg(mul(a_e013, b_e2))), mul(neg(a_e032), b_e1)), neg(mul(a_e123, b_e0)))}

def Direction.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Direction<T>, b: K.Scalar<T>) -> K.Point<T>:
