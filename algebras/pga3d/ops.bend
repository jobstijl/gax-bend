    case K.Flector{+a_e1, +a_e2, +a_e3, +a_e0, +a_e032, +a_e013, +a_e021, +a_e123} K.Scalar{+b_s}:
      K.Flector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_e0, b_s),
        neg(mul(neg(a_e032), b_s)),
        mul(a_e013, b_s),
        neg(mul(neg(a_e021), b_s)),
        mul(a_e123, b_s)}

def Flector.gp.Plane(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Plane<T>) -> K.Motor<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e3, +a_e0, +a_e032, +a_e013, +a_e021, +a_e123} K.Plane{+b_e1, +b_e2, +b_e3, +b_e0}:
      K.Motor{
        add(mul(a_e1, b_e1), add(mul(a_e2, b_e2), mul(a_e3, b_e3))),
        add(mul(a_e123, b_e1), add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2)))),
        neg(add(add(neg(mul(a_e123, b_e2)), mul(a_e1, b_e3)), neg(mul(a_e3, b_e1)))),
        add(add(mul(a_e123, b_e3), mul(a_e1, b_e2)), neg(mul(a_e2, b_e1))),
        add(add(add(mul(neg(a_e021), b_e2), mul(a_e013, b_e3)), mul(a_e0, b_e1)), neg(mul(a_e1, b_e0))),
        add(add(neg(mul(neg(a_e021), b_e1)), add(mul(neg(a_e032), b_e3), mul(a_e0, b_e2))), neg(mul(a_e2, b_e0))),
        add(add(neg(mul(a_e013, b_e1)), add(neg(mul(neg(a_e032), b_e2)), mul(a_e0, b_e3))), neg(mul(a_e3, b_e0))),
        add(add(add(mul(neg(a_e021), b_e3), neg(mul(a_e013, b_e2))), mul(neg(a_e032), b_e1)), neg(mul(a_e123, b_e0)))}

def Flector.gp.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Line<T>) -> K.Flector<T>:
  match a b:
