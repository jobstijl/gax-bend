        mul(a_e123, b_e3),
        add(add(add(mul(neg(a_e021), b_e2), mul(a_e013, b_e3)), neg(mul(neg(a_e032), b_e123))), mul(a_e123, neg(b_e032))),
        add(add(add(neg(mul(neg(a_e021), b_e1)), mul(a_e013, b_e123)), mul(neg(a_e032), b_e3)), neg(mul(a_e123, b_e013))),
        add(add(add(neg(mul(neg(a_e021), b_e123)), neg(mul(a_e013, b_e1))), neg(mul(neg(a_e032), b_e2))), mul(a_e123, neg(b_e021))),
        add(add(add(mul(neg(a_e021), b_e3), neg(mul(a_e013, b_e2))), mul(neg(a_e032), b_e1)), neg(mul(a_e123, b_e0)))}

def Point.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Point<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Point{+a_e032, +a_e013, +a_e021, +a_e123} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e3, +b_e01, +b_e02, +b_e03, +b_e12, +b_e31, +b_e23, +b_e021, +b_e013, +b_e032, +b_e123, +b_e0123}:
