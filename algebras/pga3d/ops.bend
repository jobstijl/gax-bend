        add(add(mul(a_e123, neg(b_e31)), mul(a_e1, b_e12)), neg(mul(a_e3, b_e23))),
        add(add(neg(mul(a_e123, b_e12)), mul(a_e1, neg(b_e31))), mul(a_e2, b_e23)),
        add(add(add(neg(mul(neg(a_e021), b_e12)), neg(mul(a_e013, neg(b_e31)))), neg(mul(neg(a_e032), b_e23))), add(neg(mul(a_e1, b_e01)), add(neg(mul(a_e2, b_e02)), neg(mul(a_e3, b_e03))))),
        neg(add(add(add(neg(mul(neg(a_e021), neg(b_e31))), mul(a_e013, b_e12)), mul(a_e0, b_e23)), add(neg(mul(a_e123, b_e01)), add(neg(mul(a_e2, b_e03)), mul(a_e3, b_e02))))),
        add(add(mul(neg(a_e021), b_e23), add(neg(mul(neg(a_e032), b_e12)), mul(a_e0, neg(b_e31)))), add(add(mul(a_e123, b_e02), neg(mul(a_e1, b_e03))), mul(a_e3, b_e01))),
        neg(add(add(neg(mul(a_e013, b_e23)), add(mul(neg(a_e032), neg(b_e31)), mul(a_e0, b_e12))), add(add(neg(mul(a_e123, b_e03)), neg(mul(a_e1, b_e02))), mul(a_e2, b_e01)))),
        add(mul(a_e1, b_e23), add(neg(mul(a_e2, neg(b_e31))), mul(a_e3, b_e12)))}

def Flector.gp.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Point<T>) -> K.Motor<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e3, +a_e0, +a_e032, +a_e013, +a_e021, +a_e123} K.Point{+b_e032, +b_e013, +b_e021, +b_e123}:
