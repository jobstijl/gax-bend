      +q7_7 = mul(a_e123, a_e123)
      +q2_2 = mul(a_e3, a_e3)
      +q1_1 = mul(a_e2, a_e2)
      +q0_0 = mul(a_e1, a_e1)
      +q2_7 = mul(a_e3, a_e123)
