        mul(a_e123, neg(b_e31)),
        neg(mul(a_e123, b_e12)),
        add(add(add(neg(mul(neg(a_e021), b_e12)), neg(mul(a_e013, neg(b_e31)))), neg(mul(neg(a_e032), b_e23))), mul(a_e123, b_e0123)),
        neg(add(add(add(neg(mul(neg(a_e021), neg(b_e31))), mul(a_e013, b_e12)), mul(neg(a_e032), b_s)), neg(mul(a_e123, b_e01)))),
        add(add(add(mul(neg(a_e021), b_e23), mul(a_e013, b_s)), neg(mul(neg(a_e032), b_e12))), mul(a_e123, b_e02)),
        neg(add(add(add(mul(neg(a_e021), b_s), neg(mul(a_e013, b_e23))), mul(neg(a_e032), neg(b_e31))), neg(mul(a_e123, b_e03)))),
        mul(a_e123, b_s)}

def Point.gp.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Point<T>, b: K.Flector<T>) -> K.Motor<T>:
  match a b:
    case K.Point{+a_e032, +a_e013, +a_e021, +a_e123} K.Flector{+b_e1, +b_e2, +b_e3, +b_e0, +b_e032, +b_e013, +b_e021, +b_e123}:
