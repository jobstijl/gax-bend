        mul(a_s, b_e2),
        mul(a_s, b_e3),
        add(mul(a_e01, b_s), mul(a_s, b_e01)),
        add(mul(a_e02, b_s), mul(a_s, b_e02)),
        add(mul(a_e03, b_s), mul(a_s, b_e03)),
        mul(a_s, b_e12),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e23),
        neg(add(add(mul(a_e01, b_e2), neg(mul(a_e02, b_e1))), mul(a_s, neg(b_e021)))),
        add(add(mul(a_e01, b_e3), neg(mul(a_e03, b_e1))), mul(a_s, b_e013)),
        neg(add(add(mul(a_e02, b_e3), neg(mul(a_e03, b_e2))), mul(a_s, neg(b_e032)))),
        mul(a_s, b_e123),
        add(add(mul(a_e01, b_e23), add(neg(mul(a_e02, neg(b_e31))), mul(a_e03, b_e12))), mul(a_s, b_e0123))}

def Motor.wedge.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Scalar<T>) -> K.Motor<T>:
