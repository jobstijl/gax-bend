        neg(add(add(add(mul(neg(a_e021), b_s), neg(mul(a_e013, b_e23))), add(mul(neg(a_e032), neg(b_e31)), mul(a_e0, b_e12))), add(add(neg(mul(a_e123, b_e03)), neg(mul(a_e1, b_e02))), add(mul(a_e2, b_e01), neg(mul(a_e3, b_e0123)))))),
        add(add(mul(a_e123, b_s), mul(a_e1, b_e23)), add(neg(mul(a_e2, neg(b_e31))), mul(a_e3, b_e12)))}

def Flector.gp.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Flector<T>) -> K.Motor<T>:
