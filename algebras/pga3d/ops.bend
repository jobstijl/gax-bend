      +m0_0 = add(add(add(neg(q7_7), neg(q2_2)), neg(q1_1)), neg(q0_0))
      K.Pseudoscalar{
        mul(b_e0123, m0_0)}

def Flector.transform.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Rotor<T>) -> K.Motor<T>:
