def Multivector.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Scalar<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e3, +a_e01, +a_e02, +a_e03, +a_e12, +a_e31, +a_e23, +a_e021, +a_e013, +a_e032, +a_e123, +a_e0123} K.Scalar{+b_s}:
      K.Multivector{
        mul(a_s, b_s),
        mul(a_e0, b_s),
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_e01, b_s),
        mul(a_e02, b_s),
        mul(a_e03, b_s),
        mul(a_e12, b_s),
        neg(mul(neg(a_e31), b_s)),
        mul(a_e23, b_s),
        neg(mul(neg(a_e021), b_s)),
        mul(a_e013, b_s),
        neg(mul(neg(a_e032), b_s)),
        mul(a_e123, b_s),
        mul(a_e0123, b_s)}

def Multivector.gp.Plane(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Plane<T>) -> K.Multivector<T>:
