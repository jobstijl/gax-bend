      K.Scalar{
        add(a_s, b_s)}

def Scalar.add.Plane(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Plane<T>) -> K.Multivector<T>:
