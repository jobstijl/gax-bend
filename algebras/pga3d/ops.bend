        mul(a_e123, b_s)}

def Point.gp.Plane(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Point<T>, b: K.Plane<T>) -> K.Motor<T>:
