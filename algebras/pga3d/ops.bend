        add(add(add(mul(a_e0123, b_s), mul(a_e03, b_e12)), mul(a_e02, b_e31)), mul(a_e01, b_e23))}

def Motor.anticommutator.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Translator<T>) -> K.Motor<T>:
