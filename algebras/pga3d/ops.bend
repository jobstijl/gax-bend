        add(add(neg(mul(a_e123, b_e23)), mul(a_e1, b_s)), add(neg(mul(a_e2, b_e12)), neg(mul(a_e3, neg(b_e31))))),
        add(add(mul(a_e123, neg(b_e31)), mul(a_e1, b_e12)), add(mul(a_e2, b_s), neg(mul(a_e3, b_e23)))),
        add(add(neg(mul(a_e123, b_e12)), mul(a_e1, neg(b_e31))), add(mul(a_e2, b_e23), mul(a_e3, b_s))),
        add(add(add(mul(neg(a_e021), b_e2), mul(a_e013, b_e3)), add(neg(mul(neg(a_e032), b_e123)), mul(a_e0, b_e1))), add(add(mul(a_e123, neg(b_e032)), neg(mul(a_e1, b_e0))), add(mul(a_e2, neg(b_e021)), mul(a_e3, b_e013)))),
        add(add(add(neg(mul(neg(a_e021), b_e1)), mul(a_e013, b_e123)), add(mul(neg(a_e032), b_e3), mul(a_e0, b_e2))), add(add(neg(mul(a_e123, b_e013)), neg(mul(a_e1, neg(b_e021)))), add(neg(mul(a_e2, b_e0)), mul(a_e3, neg(b_e032))))),
        add(add(add(neg(mul(neg(a_e021), b_e123)), neg(mul(a_e013, b_e1))), add(neg(mul(neg(a_e032), b_e2)), mul(a_e0, b_e3))), add(add(mul(a_e123, neg(b_e021)), neg(mul(a_e1, b_e013))), add(neg(mul(a_e2, neg(b_e032))), neg(mul(a_e3, b_e0))))),
        add(add(mul(a_e123, b_e3), mul(a_e1, b_e2)), add(neg(mul(a_e2, b_e1)), mul(a_e3, b_e123))),
