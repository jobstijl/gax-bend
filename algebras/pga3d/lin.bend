        K.Multivector.fields(N.Tm, K.Multivector.map(~N.Tm, ~N.Tm, ~(x => N.TMul{N.TVar{0n}, x}), O.Multivector.anticommutator.Multivector(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Multivector{N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}, N.TVar{8n}, N.TVar{9n}, N.TVar{10n}, N.TVar{11n}, N.TVar{12n}, N.TVar{13n}, N.TVar{14n}, N.TVar{15n}, N.TVar{16n}}, K.Multivector{N.TVar{17n}, N.TVar{18n}, N.TVar{19n}, N.TVar{20n}, N.TVar{21n}, N.TVar{22n}, N.TVar{23n}, N.TVar{24n}, N.TVar{25n}, N.TVar{26n}, N.TVar{27n}, N.TVar{28n}, N.TVar{29n}, N.TVar{30n}, N.TVar{31n}, N.TVar{32n}}))),
