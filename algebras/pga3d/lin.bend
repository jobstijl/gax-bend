  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  c: T, a: K.Plane<T>)
  -> {K.Point.fields(T, O.Plane.dual(~T, ~zero, ~neg, K.Plane.map(~T, ~T, ~(x => mul(c, x)), a)))
    == K.Point.fields(T, K.Point.map(~T, ~T, ~(x => mul(c, x)), O.Plane.dual(~T, ~zero, ~neg, a))) : List<&2, T>}:
  match a:
    case K.Plane{a_e1, a_e2, a_e3, a_e0}:
      LN.Lin.eqs(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [c, a_e1, a_e2, a_e3, a_e0],
        K.Point.fields(N.Tm, O.Plane.dual(~N.Tm, ~N.TZero{}, ~N.Tm.neg, K.Plane.map(~N.Tm, ~N.Tm, ~(x => N.TMul{N.TVar{0n}, x}), K.Plane{N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}}))),
        K.Point.fields(N.Tm, K.Point.map(~N.Tm, ~N.Tm, ~(x => N.TMul{N.TVar{0n}, x}), O.Plane.dual(~N.Tm, ~N.TZero{}, ~N.Tm.neg, K.Plane{N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}}))),
        {==})

