  -> {K.Motor.e0123(T, O.Motor.gp.Motor(~T, ~zero, ~add, ~mul, ~neg, m, O.Motor.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Point.fields(T, O.Plane.wedge.Line(~T, ~zero, ~add, ~mul, ~neg, O.Motor.transform.Plane(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Motor.transform.Line(~T, ~zero, ~add, ~mul, ~neg, m, b)))
