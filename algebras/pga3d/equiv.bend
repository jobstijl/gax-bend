def Motor.dot.Line.Plane.equiv(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  m: K.Motor<T>, a: K.Line<T>, b: K.Plane<T>)
  -> {K.Motor.e0123(T, O.Motor.gp.Motor(~T, ~zero, ~add, ~mul, ~neg, m, O.Motor.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Plane.fields(T, O.Line.dot.Plane(~T, ~zero, ~add, ~mul, ~neg, O.Motor.transform.Line(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Motor.transform.Plane(~T, ~zero, ~add, ~mul, ~neg, m, b)))
    == K.Plane.fields(T, K.Plane.map(~T, ~T, ~(x => mul(K.Motor.s(T, O.Motor.gp.Motor(~T, ~zero, ~add, ~mul, ~neg, m, O.Motor.reverse(~T, ~zero, ~neg, m))), x)), O.Motor.transform.Plane(~T, ~zero, ~add, ~mul, ~neg, m, O.Line.dot.Plane(~T, ~zero, ~add, ~mul, ~neg, a, b)))) : List<&2, T>}:
  match m a b:
    case K.Motor{m_s, m_e23, m_e31, m_e12, m_e01, m_e02, m_e03, m_e0123} K.Line{a_e23, a_e31, a_e12, a_e01, a_e02, a_e03} K.Plane{b_e1, b_e2, b_e3, b_e0}:
      hr => EQ.Rel.eqs(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [m_s, m_e23, m_e31, m_e12, m_e01, m_e02, m_e03, m_e0123, a_e23, a_e31, a_e12, a_e01, a_e02, a_e03, b_e1, b_e2, b_e3, b_e0],
        K.Plane.fields(N.Tm, O.Line.dot.Plane(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, O.Motor.transform.Line(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Motor{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}, K.Line{N.TVar{8n}, N.TVar{9n}, N.TVar{10n}, N.TVar{11n}, N.TVar{12n}, N.TVar{13n}}), O.Motor.transform.Plane(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Motor{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}, K.Plane{N.TVar{14n}, N.TVar{15n}, N.TVar{16n}, N.TVar{17n}}))),
        K.Plane.fields(N.Tm, K.Plane.map(~N.Tm, ~N.Tm, ~(x => N.TMul{K.Motor.s(N.Tm, O.Motor.gp.Motor(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Motor{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}, O.Motor.reverse(~N.Tm, ~N.TZero{}, ~N.Tm.neg, K.Motor{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}))), x}), O.Motor.transform.Plane(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Motor{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}, O.Line.dot.Plane(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Line{N.TVar{8n}, N.TVar{9n}, N.TVar{10n}, N.TVar{11n}, N.TVar{12n}, N.TVar{13n}}, K.Plane{N.TVar{14n}, N.TVar{15n}, N.TVar{16n}, N.TVar{17n}})))),
        [N.TZero{},
         N.TZero{},
         N.TZero{},
         N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{0n}, N.TMul{N.TVar{8n}, N.TVar{14n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{0n}, N.TMul{N.TVar{9n}, N.TVar{15n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{0n}, N.TMul{N.TVar{10n}, N.TVar{16n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{1n}, N.TMul{N.TVar{1n}, N.TMul{N.TVar{8n}, N.TVar{14n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{1n}, N.TMul{N.TVar{1n}, N.TMul{N.TVar{9n}, N.TVar{15n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{1n}, N.TMul{N.TVar{1n}, N.TMul{N.TVar{10n}, N.TVar{16n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{2n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{8n}, N.TVar{14n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{2n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{9n}, N.TVar{15n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{2n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{10n}, N.TVar{16n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{3n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{8n}, N.TVar{14n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{3n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{9n}, N.TVar{15n}}}}}, N.TNeg{N.TMul{N.TVar{3n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{10n}, N.TVar{16n}}}}}}}}}}}}}}}}],
        K.Motor.e0123(N.Tm, O.Motor.gp.Motor(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Motor{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}, O.Motor.reverse(~N.Tm, ~N.TZero{}, ~N.Tm.neg, K.Motor{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}))), {==}, hr)
