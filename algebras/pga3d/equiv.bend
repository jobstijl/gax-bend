    case K.Motor{m_s, m_e23, m_e31, m_e12, m_e01, m_e02, m_e03, m_e0123} K.Plane{a_e1, a_e2, a_e3, a_e0} K.Line{b_e23, b_e31, b_e12, b_e01, b_e02, b_e03}:
