  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  m: K.Motor<T>, a: K.Line<T>, b: K.Line<T>)
  -> {K.Motor.e0123(T, O.Motor.gp.Motor(~T, ~zero, ~add, ~mul, ~neg, m, O.Motor.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Pseudoscalar.fields(T, O.Line.wedge.Line(~T, ~zero, ~add, ~mul, ~neg, O.Motor.transform.Line(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Motor.transform.Line(~T, ~zero, ~add, ~mul, ~neg, m, b)))
    == K.Pseudoscalar.fields(T, K.Pseudoscalar.map(~T, ~T, ~(x => mul(K.Motor.s(T, O.Motor.gp.Motor(~T, ~zero, ~add, ~mul, ~neg, m, O.Motor.reverse(~T, ~zero, ~neg, m))), x)), O.Motor.transform.Pseudoscalar(~T, ~zero, ~add, ~mul, ~neg, m, O.Line.wedge.Line(~T, ~zero, ~add, ~mul, ~neg, a, b)))) : List<&2, T>}:
  match m a b:
    case K.Motor{m_s, m_e23, m_e31, m_e12, m_e01, m_e02, m_e03, m_e0123} K.Line{a_e23, a_e31, a_e12, a_e01, a_e02, a_e03} K.Line{b_e23, b_e31, b_e12, b_e01, b_e02, b_e03}:
