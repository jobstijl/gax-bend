  -> {K.Motor.e0123(T, O.Flector.gp.Flector(~T, ~zero, ~add, ~mul, ~neg, m, O.Flector.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Pseudoscalar.fields(T, O.Line.wedge.Line(~T, ~zero, ~add, ~mul, ~neg, O.Flector.transform.Line(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Flector.transform.Line(~T, ~zero, ~add, ~mul, ~neg, m, b)))
