def Phasor.anticommutator.Odd.ok(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg), a: K.Phasor<T>, b: K.Odd<T>)
  -> {K.Odd.of_tree(~T, ~zero, ~neg, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 4n, K.STA.sig(), K.Phasor.tree(~T, ~neg, a), K.Odd.tree(~T, ~neg, b))) == O.Odd.add.Odd(~T, ~zero, ~add, ~mul, ~neg, O.Phasor.anticommutator.Odd(~T, ~zero, ~add, ~mul, ~neg, a, b), O.Phasor.anticommutator.Odd(~T, ~zero, ~add, ~mul, ~neg, a, b)) : K.Odd<T>}:
  match a b:
    case K.Phasor{+a_s, +a_e0123} K.Odd{+b_e0, +b_e1, +b_e2, +b_e3, +b_e123, +b_e032, +b_e013, +b_e021}:
