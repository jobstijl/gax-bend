        K.Trivector.e123(T, O.Trivector.add.Trivector(~T, ~zero, ~add, ~mul, ~neg, O.Trivector.anticommutator.Scalar(~T, ~zero, ~add, ~mul, ~neg, K.Trivector{a_e123, a_e032, a_e013, a_e021}, K.Scalar{b_s}), O.Trivector.anticommutator.Scalar(~T, ~zero, ~add, ~mul, ~neg, K.Trivector{a_e123, a_e032, a_e013, a_e021}, K.Scalar{b_s}))),
