  -> {K.Multivector.of_tree(~T, ~zero, ~neg, S.MV.commutator2(~T, ~add, ~mul, ~neg, 4n, K.STA.sig(), K.Vector.tree(~T, ~neg, a), K.Multivector.tree(~T, ~neg, b))) == O.Multivector.add.Multivector(~T, ~zero, ~add, ~mul, ~neg, O.Vector.commutator.Multivector(~T, ~zero, ~add, ~mul, ~neg, a, b), O.Vector.commutator.Multivector(~T, ~zero, ~add, ~mul, ~neg, a, b)) : K.Multivector<T>}:
  match a b:
    case K.Vector{+a_e0, +a_e1, +a_e2, +a_e3} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e3, +b_e10, +b_e20, +b_e30, +b_e23, +b_e31, +b_e12, +b_e123, +b_e032, +b_e013, +b_e021, +b_e0123}:
