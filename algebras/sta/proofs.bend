    case K.Even{a_s, a_e10, a_e20, a_e30, a_e23, a_e31, a_e12, a_e0123} K.Scalar{b_s}:
      NP.NormS.zero(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [a_s, a_e10, a_e20, a_e30, a_e23, a_e31, a_e12, a_e0123, b_s],
