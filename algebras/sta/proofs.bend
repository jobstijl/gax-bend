def Odd.commutator.Phasor.ok(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg), a: K.Odd<T>, b: K.Phasor<T>)
  -> {K.Odd.of_tree(~T, ~zero, ~neg, S.MV.commutator2(~T, ~add, ~mul, ~neg, 4n, K.STA.sig(), K.Odd.tree(~T, ~neg, a), K.Phasor.tree(~T, ~neg, b))) == O.Odd.add.Odd(~T, ~zero, ~add, ~mul, ~neg, O.Odd.commutator.Phasor(~T, ~zero, ~add, ~mul, ~neg, a, b), O.Odd.commutator.Phasor(~T, ~zero, ~add, ~mul, ~neg, a, b)) : K.Odd<T>}:
  match a b:
    case K.Odd{+a_e0, +a_e1, +a_e2, +a_e3, +a_e123, +a_e032, +a_e013, +a_e021} K.Phasor{+b_s, +b_e0123}:
      K.Odd.cong(T,
        S.MV.at(~T, ~zero, ~neg, 4n, [True{}, False{}, False{}, False{}], False{}, S.MV.commutator2(~T, ~add, ~mul, ~neg, 4n, K.STA.sig(), K.Odd.tree(~T, ~neg, K.Odd{a_e0, a_e1, a_e2, a_e3, a_e123, a_e032, a_e013, a_e021}), K.Phasor.tree(~T, ~neg, K.Phasor{b_s, b_e0123}))),
        S.MV.at(~T, ~zero, ~neg, 4n, [False{}, True{}, False{}, False{}], False{}, S.MV.commutator2(~T, ~add, ~mul, ~neg, 4n, K.STA.sig(), K.Odd.tree(~T, ~neg, K.Odd{a_e0, a_e1, a_e2, a_e3, a_e123, a_e032, a_e013, a_e021}), K.Phasor.tree(~T, ~neg, K.Phasor{b_s, b_e0123}))),
