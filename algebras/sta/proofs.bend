  match a b:
    case K.Trivector{+a_e123, +a_e032, +a_e013, +a_e021} K.Scalar{+b_s}:
      K.Trivector.cong(T,
        S.MV.at(~T, ~zero, ~neg, 4n, [False{}, True{}, True{}, True{}], False{}, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 4n, K.STA.sig(), K.Trivector.tree(~T, ~neg, K.Trivector{a_e123, a_e032, a_e013, a_e021}), K.Scalar.tree(~T, ~neg, K.Scalar{b_s}))),
