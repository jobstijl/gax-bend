  -> {K.Even.e0123(T, O.Even.gp.Even(~T, ~zero, ~add, ~mul, ~neg, m, O.Even.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Vector.fields(T, O.Bivector.rc.Vector(~T, ~zero, ~add, ~mul, ~neg, O.Even.transform.Bivector(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Even.transform.Vector(~T, ~zero, ~add, ~mul, ~neg, m, b)))
