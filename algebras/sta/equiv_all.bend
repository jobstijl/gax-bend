def Even.dot.Bivector.Vector.equiv(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  m: K.Even<T>, a: K.Bivector<T>, b: K.Vector<T>)
  -> {K.Even.e0123(T, O.Even.gp.Even(~T, ~zero, ~add, ~mul, ~neg, m, O.Even.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Vector.fields(T, O.Bivector.dot.Vector(~T, ~zero, ~add, ~mul, ~neg, O.Even.transform.Bivector(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Even.transform.Vector(~T, ~zero, ~add, ~mul, ~neg, m, b)))
