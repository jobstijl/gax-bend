  -> {K.Even.e0123(T, O.Even.gp.Even(~T, ~zero, ~add, ~mul, ~neg, m, O.Even.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Bivector.fields(T, O.Vector.dot.Trivector(~T, ~zero, ~add, ~mul, ~neg, O.Even.transform.Vector(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Even.transform.Trivector(~T, ~zero, ~add, ~mul, ~neg, m, b)))
