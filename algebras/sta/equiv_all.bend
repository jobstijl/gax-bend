    case K.Even{m_s, m_e10, m_e20, m_e30, m_e23, m_e31, m_e12, m_e0123} K.Vector{a_e0, a_e1, a_e2, a_e3} K.Trivector{b_e123, b_e032, b_e013, b_e021}:
