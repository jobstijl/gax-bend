  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  m: K.Odd<T>, a: K.Vector<T>, b: K.Trivector<T>)
  -> {K.Even.e0123(T, O.Odd.gp.Odd(~T, ~zero, ~add, ~mul, ~neg, m, O.Odd.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Bivector.fields(T, O.Vector.dot.Trivector(~T, ~zero, ~add, ~mul, ~neg, O.Odd.transform.Vector(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Odd.transform.Trivector(~T, ~zero, ~add, ~mul, ~neg, m, b)))
