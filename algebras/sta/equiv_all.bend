    case K.Even{m_s, m_e10, m_e20, m_e30, m_e23, m_e31, m_e12, m_e0123} K.Trivector{a_e123, a_e032, a_e013, a_e021} K.Vector{b_e0, b_e1, b_e2, b_e3}:
