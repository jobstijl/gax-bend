def Odd.wedge.Vector.Bivector.equiv(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  m: K.Odd<T>, a: K.Vector<T>, b: K.Bivector<T>)
  -> {K.Even.e0123(T, O.Odd.gp.Odd(~T, ~zero, ~add, ~mul, ~neg, m, O.Odd.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Trivector.fields(T, O.Vector.wedge.Bivector(~T, ~zero, ~add, ~mul, ~neg, O.Odd.transform.Vector(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Odd.transform.Bivector(~T, ~zero, ~add, ~mul, ~neg, m, b)))
    == K.Trivector.fields(T, K.Trivector.map(~T, ~T, ~(x => mul(K.Even.s(T, O.Odd.gp.Odd(~T, ~zero, ~add, ~mul, ~neg, m, O.Odd.reverse(~T, ~zero, ~neg, m))), x)), O.Odd.transform.Trivector(~T, ~zero, ~add, ~mul, ~neg, m, O.Vector.wedge.Bivector(~T, ~zero, ~add, ~mul, ~neg, a, b)))) : List<&2, T>}:
  match m a b:
    case K.Odd{m_e0, m_e1, m_e2, m_e3, m_e123, m_e032, m_e013, m_e021} K.Vector{a_e0, a_e1, a_e2, a_e3} K.Bivector{b_e10, b_e20, b_e30, b_e23, b_e31, b_e12}:
