def Even.wedge.Bivector.Vector.equiv(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  m: K.Even<T>, a: K.Bivector<T>, b: K.Vector<T>)
  -> {K.Even.e0123(T, O.Even.gp.Even(~T, ~zero, ~add, ~mul, ~neg, m, O.Even.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Trivector.fields(T, O.Bivector.wedge.Vector(~T, ~zero, ~add, ~mul, ~neg, O.Even.transform.Bivector(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Even.transform.Vector(~T, ~zero, ~add, ~mul, ~neg, m, b)))
    == K.Trivector.fields(T, K.Trivector.map(~T, ~T, ~(x => mul(K.Even.s(T, O.Even.gp.Even(~T, ~zero, ~add, ~mul, ~neg, m, O.Even.reverse(~T, ~zero, ~neg, m))), x)), O.Even.transform.Trivector(~T, ~zero, ~add, ~mul, ~neg, m, O.Bivector.wedge.Vector(~T, ~zero, ~add, ~mul, ~neg, a, b)))) : List<&2, T>}:
  match m a b:
    case K.Even{m_s, m_e10, m_e20, m_e30, m_e23, m_e31, m_e12, m_e0123} K.Bivector{a_e10, a_e20, a_e30, a_e23, a_e31, a_e12} K.Vector{b_e0, b_e1, b_e2, b_e3}:
      hr => EQ.Rel.eqs(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [m_s, m_e10, m_e20, m_e30, m_e23, m_e31, m_e12, m_e0123, a_e10, a_e20, a_e30, a_e23, a_e31, a_e12, b_e0, b_e1, b_e2, b_e3],
