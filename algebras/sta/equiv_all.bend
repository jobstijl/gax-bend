  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  m: K.Odd<T>, a: K.Bivector<T>, b: K.Vector<T>)
  -> {K.Even.e0123(T, O.Odd.gp.Odd(~T, ~zero, ~add, ~mul, ~neg, m, O.Odd.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Trivector.fields(T, O.Bivector.wedge.Vector(~T, ~zero, ~add, ~mul, ~neg, O.Odd.transform.Bivector(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Odd.transform.Vector(~T, ~zero, ~add, ~mul, ~neg, m, b)))
