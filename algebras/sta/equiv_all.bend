  match m a b:
    case K.Odd{m_e0, m_e1, m_e2, m_e3, m_e123, m_e032, m_e013, m_e021} K.Vector{a_e0, a_e1, a_e2, a_e3} K.Vector{b_e0, b_e1, b_e2, b_e3}:
