  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  m: K.Even<T>, a: K.Trivector<T>, b: K.Vector<T>)
  -> {K.Even.e0123(T, O.Even.gp.Even(~T, ~zero, ~add, ~mul, ~neg, m, O.Even.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Bivector.fields(T, O.Trivector.rc.Vector(~T, ~zero, ~add, ~mul, ~neg, O.Even.transform.Trivector(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Even.transform.Vector(~T, ~zero, ~add, ~mul, ~neg, m, b)))
