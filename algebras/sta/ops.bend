        a_s}

def Even.dual(~T: Data, ~zero: T, ~neg: T -> T, a: K.Even<T>) -> K.Even<T>:
  match a:
    case K.Even{+a_s, +a_e10, +a_e20, +a_e30, +a_e23, +a_e31, +a_e12, +a_e0123}:
      K.Even{
        a_e0123,
        neg(a_e23),
        neg(neg(neg(a_e31))),
        neg(a_e12),
        neg(a_e10),
        neg(neg(neg(a_e20))),
        neg(a_e30),
        a_s}

def Odd.dual(~T: Data, ~zero: T, ~neg: T -> T, a: K.Odd<T>) -> K.Odd<T>:
  match a:
    case K.Odd{+a_e0, +a_e1, +a_e2, +a_e3, +a_e123, +a_e032, +a_e013, +a_e021}:
      K.Odd{
        neg(a_e123),
        neg(a_e032),
        neg(a_e013),
        neg(a_e021),
        a_e0,
        neg(neg(a_e1)),
        a_e2,
