        mul(a_s, b_e30),
        mul(a_s, b_e23),
        mul(a_s, b_e31),
        mul(a_s, b_e12),
        mul(a_s, b_e0123)}

def Scalar.anticommutator.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Odd<T>) -> K.Odd<T>:
  match a b:
