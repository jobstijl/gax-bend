      K.Scalar{
        add(mul(a_e0, b_e0), add(neg(mul(a_e1, b_e1)), add(neg(mul(a_e2, b_e2)), neg(mul(a_e3, b_e3)))))}

def Odd.lc.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Bivector<T>) -> K.Vector<T>:
