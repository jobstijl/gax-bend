        neg(a_e30)}

def Trivector.undual(~T: Data, ~zero: T, ~neg: T -> T, a: K.Trivector<T>) -> K.Vector<T>:
  match a:
    case K.Trivector{+a_e123, +a_e032, +a_e013, +a_e021}:
