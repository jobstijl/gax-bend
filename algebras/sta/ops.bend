def Multivector.dual(~T: Data, ~zero: T, ~neg: T -> T, a: K.Multivector<T>) -> K.Multivector<T>:
  match a:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e3, +a_e10, +a_e20, +a_e30, +a_e23, +a_e31, +a_e12, +a_e123, +a_e032, +a_e013, +a_e021, +a_e0123}:
      K.Multivector{
        a_e0123,
        neg(a_e123),
        neg(a_e032),
        neg(a_e013),
        neg(a_e021),
        neg(a_e23),
        neg(neg(neg(a_e31))),
        neg(a_e12),
        neg(a_e10),
        neg(neg(neg(a_e20))),
        neg(a_e30),
        a_e0,
        neg(neg(a_e1)),
        a_e2,
        neg(neg(a_e3)),
        a_s}

def Scalar.undual(~T: Data, ~zero: T, ~neg: T -> T, a: K.Scalar<T>) -> K.Pseudoscalar<T>:
  match a:
    case K.Scalar{+a_s}:
      K.Pseudoscalar{
        a_s}

def Vector.undual(~T: Data, ~zero: T, ~neg: T -> T, a: K.Vector<T>) -> K.Trivector<T>:
  match a:
