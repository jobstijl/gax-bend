      +m0_0 = add(add(add(add(add(add(add(neg(q7_7), q6_6), q5_5), q4_4), neg(q3_3)), neg(q2_2)), neg(q1_1)), q0_0)
      +m1_0 = add(add(add(add(add(add(add(q3_6, q3_6), q2_5), q2_5), q1_4), q1_4), q0_7), q0_7)
      K.Phasor{
        mul(b_s, m0_0),
        mul(b_s, m1_0)}

