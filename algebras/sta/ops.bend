def Trivector.gp.Even(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Trivector<T>, b: K.Even<T>) -> K.Odd<T>:
  match a b:
    case K.Trivector{+a_e123, +a_e032, +a_e013, +a_e021} K.Even{+b_s, +b_e10, +b_e20, +b_e30, +b_e23, +b_e31, +b_e12, +b_e0123}:
      K.Odd{
        add(add(add(neg(mul(neg(a_e021), b_e12)), neg(mul(a_e013, neg(b_e31)))), neg(mul(neg(a_e032), b_e23))), neg(mul(a_e123, b_e0123))),
        add(add(add(neg(mul(neg(a_e021), neg(b_e20))), neg(mul(a_e013, neg(b_e30)))), neg(mul(neg(a_e032), b_e0123))), neg(mul(a_e123, b_e23))),
        add(add(add(mul(neg(a_e021), neg(b_e10)), mul(a_e013, b_e0123)), neg(mul(neg(a_e032), neg(b_e30)))), mul(a_e123, neg(b_e31))),
        add(add(add(neg(mul(neg(a_e021), b_e0123)), mul(a_e013, neg(b_e10))), mul(neg(a_e032), neg(b_e20))), neg(mul(a_e123, b_e12))),
        add(add(add(mul(neg(a_e021), neg(b_e30)), neg(mul(a_e013, neg(b_e20)))), mul(neg(a_e032), neg(b_e10))), mul(a_e123, b_s)),
        neg(add(add(add(mul(neg(a_e021), neg(b_e31)), neg(mul(a_e013, b_e12))), mul(neg(a_e032), b_s)), mul(a_e123, neg(b_e10)))),
        add(add(add(neg(mul(neg(a_e021), b_e23)), mul(a_e013, b_s)), mul(neg(a_e032), b_e12)), neg(mul(a_e123, neg(b_e20)))),
        neg(add(add(add(mul(neg(a_e021), b_s), mul(a_e013, b_e23)), neg(mul(neg(a_e032), neg(b_e31)))), mul(a_e123, neg(b_e30))))}

def Trivector.gp.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Trivector<T>, b: K.Odd<T>) -> K.Even<T>:
  match a b:
    case K.Trivector{+a_e123, +a_e032, +a_e013, +a_e021} K.Odd{+b_e0, +b_e1, +b_e2, +b_e3, +b_e123, +b_e032, +b_e013, +b_e021}:
      K.Even{
        add(add(add(neg(mul(neg(a_e021), neg(b_e021))), neg(mul(a_e013, b_e013))), neg(mul(neg(a_e032), neg(b_e032)))), mul(a_e123, b_e123)),
        neg(add(add(add(neg(mul(neg(a_e021), b_e2)), neg(mul(a_e013, b_e3))), neg(mul(neg(a_e032), b_e123))), mul(a_e123, neg(b_e032)))),
        neg(add(add(add(mul(neg(a_e021), b_e1), mul(a_e013, b_e123)), neg(mul(neg(a_e032), b_e3))), neg(mul(a_e123, b_e013)))),
        neg(add(add(add(neg(mul(neg(a_e021), b_e123)), mul(a_e013, b_e1)), mul(neg(a_e032), b_e2)), mul(a_e123, neg(b_e021)))),
        add(add(add(mul(neg(a_e021), b_e013), neg(mul(a_e013, neg(b_e021)))), mul(neg(a_e032), b_e0)), neg(mul(a_e123, b_e1))),
        neg(add(add(add(neg(mul(neg(a_e021), neg(b_e032))), mul(a_e013, b_e0)), mul(neg(a_e032), neg(b_e021))), mul(a_e123, b_e2))),
        add(add(add(mul(neg(a_e021), b_e0), mul(a_e013, neg(b_e032))), neg(mul(neg(a_e032), b_e013))), neg(mul(a_e123, b_e3))),
        add(add(add(mul(neg(a_e021), b_e3), neg(mul(a_e013, b_e2))), mul(neg(a_e032), b_e1)), neg(mul(a_e123, b_e0)))}

def Trivector.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Trivector<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Trivector{+a_e123, +a_e032, +a_e013, +a_e021} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e3, +b_e10, +b_e20, +b_e30, +b_e23, +b_e31, +b_e12, +b_e123, +b_e032, +b_e013, +b_e021, +b_e0123}:
      K.Multivector{
        add(add(add(neg(mul(neg(a_e021), neg(b_e021))), neg(mul(a_e013, b_e013))), neg(mul(neg(a_e032), neg(b_e032)))), mul(a_e123, b_e123)),
        add(add(add(neg(mul(neg(a_e021), b_e12)), neg(mul(a_e013, neg(b_e31)))), neg(mul(neg(a_e032), b_e23))), neg(mul(a_e123, b_e0123))),
        add(add(add(neg(mul(neg(a_e021), neg(b_e20))), neg(mul(a_e013, neg(b_e30)))), neg(mul(neg(a_e032), b_e0123))), neg(mul(a_e123, b_e23))),
        add(add(add(mul(neg(a_e021), neg(b_e10)), mul(a_e013, b_e0123)), neg(mul(neg(a_e032), neg(b_e30)))), mul(a_e123, neg(b_e31))),
        add(add(add(neg(mul(neg(a_e021), b_e0123)), mul(a_e013, neg(b_e10))), mul(neg(a_e032), neg(b_e20))), neg(mul(a_e123, b_e12))),
        neg(add(add(add(neg(mul(neg(a_e021), b_e2)), neg(mul(a_e013, b_e3))), neg(mul(neg(a_e032), b_e123))), mul(a_e123, neg(b_e032)))),
        neg(add(add(add(mul(neg(a_e021), b_e1), mul(a_e013, b_e123)), neg(mul(neg(a_e032), b_e3))), neg(mul(a_e123, b_e013)))),
        neg(add(add(add(neg(mul(neg(a_e021), b_e123)), mul(a_e013, b_e1)), mul(neg(a_e032), b_e2)), mul(a_e123, neg(b_e021)))),
        add(add(add(mul(neg(a_e021), b_e013), neg(mul(a_e013, neg(b_e021)))), mul(neg(a_e032), b_e0)), neg(mul(a_e123, b_e1))),
        neg(add(add(add(neg(mul(neg(a_e021), neg(b_e032))), mul(a_e013, b_e0)), mul(neg(a_e032), neg(b_e021))), mul(a_e123, b_e2))),
        add(add(add(mul(neg(a_e021), b_e0), mul(a_e013, neg(b_e032))), neg(mul(neg(a_e032), b_e013))), neg(mul(a_e123, b_e3))),
        add(add(add(mul(neg(a_e021), neg(b_e30)), neg(mul(a_e013, neg(b_e20)))), mul(neg(a_e032), neg(b_e10))), mul(a_e123, b_s)),
        neg(add(add(add(mul(neg(a_e021), neg(b_e31)), neg(mul(a_e013, b_e12))), mul(neg(a_e032), b_s)), mul(a_e123, neg(b_e10)))),
        add(add(add(neg(mul(neg(a_e021), b_e23)), mul(a_e013, b_s)), mul(neg(a_e032), b_e12)), neg(mul(a_e123, neg(b_e20)))),
        neg(add(add(add(mul(neg(a_e021), b_s), mul(a_e013, b_e23)), neg(mul(neg(a_e032), neg(b_e31)))), mul(a_e123, neg(b_e30)))),
        add(add(add(mul(neg(a_e021), b_e3), neg(mul(a_e013, b_e2))), mul(neg(a_e032), b_e1)), neg(mul(a_e123, b_e0)))}

def Pseudoscalar.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Scalar<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Pseudoscalar{+a_e0123} K.Scalar{+b_s}:
      K.Pseudoscalar{
        mul(a_e0123, b_s)}

def Pseudoscalar.gp.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Vector<T>) -> K.Trivector<T>:
  match a b:
    case K.Pseudoscalar{+a_e0123} K.Vector{+b_e0, +b_e1, +b_e2, +b_e3}:
      K.Trivector{
        neg(mul(a_e0123, b_e0)),
        neg(neg(mul(a_e0123, b_e1))),
        mul(a_e0123, b_e2),
        neg(neg(mul(a_e0123, b_e3)))}

def Pseudoscalar.gp.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Bivector<T>) -> K.Bivector<T>:
  match a b:
    case K.Pseudoscalar{+a_e0123} K.Bivector{+b_e10, +b_e20, +b_e30, +b_e23, +b_e31, +b_e12}:
      K.Bivector{
        neg(neg(mul(a_e0123, b_e23))),
        neg(mul(a_e0123, neg(b_e31))),
        neg(neg(mul(a_e0123, b_e12))),
        mul(a_e0123, neg(b_e10)),
        neg(neg(mul(a_e0123, neg(b_e20)))),
        mul(a_e0123, neg(b_e30))}

def Pseudoscalar.gp.Trivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Trivector<T>) -> K.Vector<T>:
  match a b:
    case K.Pseudoscalar{+a_e0123} K.Trivector{+b_e123, +b_e032, +b_e013, +b_e021}:
      K.Vector{
        mul(a_e0123, b_e123),
        mul(a_e0123, neg(b_e032)),
        neg(mul(a_e0123, b_e013)),
        mul(a_e0123, neg(b_e021))}

def Pseudoscalar.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Pseudoscalar<T>) -> K.Scalar<T>:
  match a b:
    case K.Pseudoscalar{+a_e0123} K.Pseudoscalar{+b_e0123}:
      K.Scalar{
        neg(mul(a_e0123, b_e0123))}

def Pseudoscalar.gp.Phasor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Phasor<T>) -> K.Phasor<T>:
  match a b:
    case K.Pseudoscalar{+a_e0123} K.Phasor{+b_s, +b_e0123}:
      K.Phasor{
        neg(mul(a_e0123, b_e0123)),
        mul(a_e0123, b_s)}

def Pseudoscalar.gp.Even(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Even<T>) -> K.Even<T>:
  match a b:
    case K.Pseudoscalar{+a_e0123} K.Even{+b_s, +b_e10, +b_e20, +b_e30, +b_e23, +b_e31, +b_e12, +b_e0123}:
      K.Even{
        neg(mul(a_e0123, b_e0123)),
        neg(neg(mul(a_e0123, b_e23))),
        neg(mul(a_e0123, neg(b_e31))),
        neg(neg(mul(a_e0123, b_e12))),
        mul(a_e0123, neg(b_e10)),
        neg(neg(mul(a_e0123, neg(b_e20)))),
        mul(a_e0123, neg(b_e30)),
        mul(a_e0123, b_s)}

def Pseudoscalar.gp.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Odd<T>) -> K.Odd<T>:
  match a b:
    case K.Pseudoscalar{+a_e0123} K.Odd{+b_e0, +b_e1, +b_e2, +b_e3, +b_e123, +b_e032, +b_e013, +b_e021}:
      K.Odd{
        mul(a_e0123, b_e123),
        mul(a_e0123, neg(b_e032)),
        neg(mul(a_e0123, b_e013)),
        mul(a_e0123, neg(b_e021)),
        neg(mul(a_e0123, b_e0)),
        neg(neg(mul(a_e0123, b_e1))),
        mul(a_e0123, b_e2),
        neg(neg(mul(a_e0123, b_e3)))}

def Pseudoscalar.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Pseudoscalar{+a_e0123} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e3, +b_e10, +b_e20, +b_e30, +b_e23, +b_e31, +b_e12, +b_e123, +b_e032, +b_e013, +b_e021, +b_e0123}:
      K.Multivector{
        neg(mul(a_e0123, b_e0123)),
        mul(a_e0123, b_e123),
        mul(a_e0123, neg(b_e032)),
        neg(mul(a_e0123, b_e013)),
        mul(a_e0123, neg(b_e021)),
        neg(neg(mul(a_e0123, b_e23))),
        neg(mul(a_e0123, neg(b_e31))),
        neg(neg(mul(a_e0123, b_e12))),
        mul(a_e0123, neg(b_e10)),
        neg(neg(mul(a_e0123, neg(b_e20)))),
        mul(a_e0123, neg(b_e30)),
        neg(mul(a_e0123, b_e0)),
        neg(neg(mul(a_e0123, b_e1))),
        mul(a_e0123, b_e2),
        neg(neg(mul(a_e0123, b_e3))),
        mul(a_e0123, b_s)}

def Phasor.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Phasor<T>, b: K.Scalar<T>) -> K.Phasor<T>:
  match a b:
    case K.Phasor{+a_s, +a_e0123} K.Scalar{+b_s}:
      K.Phasor{
        mul(a_s, b_s),
        mul(a_e0123, b_s)}

def Phasor.gp.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Phasor<T>, b: K.Vector<T>) -> K.Odd<T>:
  match a b:
    case K.Phasor{+a_s, +a_e0123} K.Vector{+b_e0, +b_e1, +b_e2, +b_e3}:
      K.Odd{
        mul(a_s, b_e0),
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        neg(mul(a_e0123, b_e0)),
        neg(neg(mul(a_e0123, b_e1))),
        mul(a_e0123, b_e2),
        neg(neg(mul(a_e0123, b_e3)))}

def Phasor.gp.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Phasor<T>, b: K.Bivector<T>) -> K.Bivector<T>:
  match a b:
    case K.Phasor{+a_s, +a_e0123} K.Bivector{+b_e10, +b_e20, +b_e30, +b_e23, +b_e31, +b_e12}:
      K.Bivector{
        neg(add(neg(mul(a_e0123, b_e23)), mul(a_s, neg(b_e10)))),
        neg(add(mul(a_e0123, neg(b_e31)), mul(a_s, neg(b_e20)))),
        neg(add(neg(mul(a_e0123, b_e12)), mul(a_s, neg(b_e30)))),
        add(mul(a_e0123, neg(b_e10)), mul(a_s, b_e23)),
        neg(add(neg(mul(a_e0123, neg(b_e20))), mul(a_s, neg(b_e31)))),
        add(mul(a_e0123, neg(b_e30)), mul(a_s, b_e12))}

def Phasor.gp.Trivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Phasor<T>, b: K.Trivector<T>) -> K.Odd<T>:
  match a b:
    case K.Phasor{+a_s, +a_e0123} K.Trivector{+b_e123, +b_e032, +b_e013, +b_e021}:
      K.Odd{
        mul(a_e0123, b_e123),
        mul(a_e0123, neg(b_e032)),
        neg(mul(a_e0123, b_e013)),
        mul(a_e0123, neg(b_e021)),
        mul(a_s, b_e123),
        neg(mul(a_s, neg(b_e032))),
        mul(a_s, b_e013),
        neg(mul(a_s, neg(b_e021)))}

def Phasor.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Phasor<T>, b: K.Pseudoscalar<T>) -> K.Phasor<T>:
  match a b:
    case K.Phasor{+a_s, +a_e0123} K.Pseudoscalar{+b_e0123}:
      K.Phasor{
        neg(mul(a_e0123, b_e0123)),
        mul(a_s, b_e0123)}

def Phasor.gp.Phasor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Phasor<T>, b: K.Phasor<T>) -> K.Phasor<T>:
  match a b:
    case K.Phasor{+a_s, +a_e0123} K.Phasor{+b_s, +b_e0123}:
      K.Phasor{
        add(neg(mul(a_e0123, b_e0123)), mul(a_s, b_s)),
        add(mul(a_e0123, b_s), mul(a_s, b_e0123))}

def Phasor.gp.Even(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Phasor<T>, b: K.Even<T>) -> K.Even<T>:
  match a b:
    case K.Phasor{+a_s, +a_e0123} K.Even{+b_s, +b_e10, +b_e20, +b_e30, +b_e23, +b_e31, +b_e12, +b_e0123}:
      K.Even{
        add(neg(mul(a_e0123, b_e0123)), mul(a_s, b_s)),
        neg(add(neg(mul(a_e0123, b_e23)), mul(a_s, neg(b_e10)))),
        neg(add(mul(a_e0123, neg(b_e31)), mul(a_s, neg(b_e20)))),
        neg(add(neg(mul(a_e0123, b_e12)), mul(a_s, neg(b_e30)))),
        add(mul(a_e0123, neg(b_e10)), mul(a_s, b_e23)),
        neg(add(neg(mul(a_e0123, neg(b_e20))), mul(a_s, neg(b_e31)))),
        add(mul(a_e0123, neg(b_e30)), mul(a_s, b_e12)),
        add(mul(a_e0123, b_s), mul(a_s, b_e0123))}

def Phasor.gp.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Phasor<T>, b: K.Odd<T>) -> K.Odd<T>:
  match a b:
    case K.Phasor{+a_s, +a_e0123} K.Odd{+b_e0, +b_e1, +b_e2, +b_e3, +b_e123, +b_e032, +b_e013, +b_e021}:
      K.Odd{
        add(mul(a_e0123, b_e123), mul(a_s, b_e0)),
        add(mul(a_e0123, neg(b_e032)), mul(a_s, b_e1)),
        add(neg(mul(a_e0123, b_e013)), mul(a_s, b_e2)),
        add(mul(a_e0123, neg(b_e021)), mul(a_s, b_e3)),
        add(neg(mul(a_e0123, b_e0)), mul(a_s, b_e123)),
        neg(add(neg(mul(a_e0123, b_e1)), mul(a_s, neg(b_e032)))),
        add(mul(a_e0123, b_e2), mul(a_s, b_e013)),
        neg(add(neg(mul(a_e0123, b_e3)), mul(a_s, neg(b_e021))))}

def Phasor.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Phasor<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Phasor{+a_s, +a_e0123} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e3, +b_e10, +b_e20, +b_e30, +b_e23, +b_e31, +b_e12, +b_e123, +b_e032, +b_e013, +b_e021, +b_e0123}:
      K.Multivector{
        add(neg(mul(a_e0123, b_e0123)), mul(a_s, b_s)),
        add(mul(a_e0123, b_e123), mul(a_s, b_e0)),
        add(mul(a_e0123, neg(b_e032)), mul(a_s, b_e1)),
        add(neg(mul(a_e0123, b_e013)), mul(a_s, b_e2)),
        add(mul(a_e0123, neg(b_e021)), mul(a_s, b_e3)),
        neg(add(neg(mul(a_e0123, b_e23)), mul(a_s, neg(b_e10)))),
        neg(add(mul(a_e0123, neg(b_e31)), mul(a_s, neg(b_e20)))),
        neg(add(neg(mul(a_e0123, b_e12)), mul(a_s, neg(b_e30)))),
        add(mul(a_e0123, neg(b_e10)), mul(a_s, b_e23)),
        neg(add(neg(mul(a_e0123, neg(b_e20))), mul(a_s, neg(b_e31)))),
        add(mul(a_e0123, neg(b_e30)), mul(a_s, b_e12)),
        add(neg(mul(a_e0123, b_e0)), mul(a_s, b_e123)),
        neg(add(neg(mul(a_e0123, b_e1)), mul(a_s, neg(b_e032)))),
        add(mul(a_e0123, b_e2), mul(a_s, b_e013)),
        neg(add(neg(mul(a_e0123, b_e3)), mul(a_s, neg(b_e021)))),
        add(mul(a_e0123, b_s), mul(a_s, b_e0123))}

def Even.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Even<T>, b: K.Scalar<T>) -> K.Even<T>:
  match a b:
    case K.Even{+a_s, +a_e10, +a_e20, +a_e30, +a_e23, +a_e31, +a_e12, +a_e0123} K.Scalar{+b_s}:
      K.Even{
        mul(a_s, b_s),
        neg(mul(neg(a_e10), b_s)),
        neg(mul(neg(a_e20), b_s)),
        neg(mul(neg(a_e30), b_s)),
        mul(a_e23, b_s),
        neg(mul(neg(a_e31), b_s)),
        mul(a_e12, b_s),
        mul(a_e0123, b_s)}

def Even.gp.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Even<T>, b: K.Vector<T>) -> K.Odd<T>:
  match a b:
