def Bivector.wedge.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Bivector<T>, b: K.Odd<T>) -> K.Trivector<T>:
  match a b:
    case K.Bivector{+a_e10, +a_e20, +a_e30, +a_e23, +a_e31, +a_e12} K.Odd{+b_e0, +b_e1, +b_e2, +b_e3, +b_e123, +b_e032, +b_e013, +b_e021}:
