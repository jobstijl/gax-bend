  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  c: T, a: K.Scalar<T>)
  -> {K.Scalar.fields(T, O.Scalar.conjugate(~T, ~zero, ~neg, K.Scalar.map(~T, ~T, ~(x => mul(c, x)), a)))
    == K.Scalar.fields(T, K.Scalar.map(~T, ~T, ~(x => mul(c, x)), O.Scalar.conjugate(~T, ~zero, ~neg, a))) : List<&2, T>}:
  match a:
    case K.Scalar{a_s}:
      LN.Lin.eqs(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [c, a_s],
        K.Scalar.fields(N.Tm, O.Scalar.conjugate(~N.Tm, ~N.TZero{}, ~N.Tm.neg, K.Scalar.map(~N.Tm, ~N.Tm, ~(x => N.TMul{N.TVar{0n}, x}), K.Scalar{N.TVar{1n}}))),
        K.Scalar.fields(N.Tm, K.Scalar.map(~N.Tm, ~N.Tm, ~(x => N.TMul{N.TVar{0n}, x}), O.Scalar.conjugate(~N.Tm, ~N.TZero{}, ~N.Tm.neg, K.Scalar{N.TVar{1n}}))),
        {==})

