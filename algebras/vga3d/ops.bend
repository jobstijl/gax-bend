        add(neg(mul(a_e123, b_e12)), add(mul(a_e1, neg(b_e31)), mul(a_e2, b_e23)))}

def Odd.dot.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Pseudoscalar<T>) -> K.Rotor<T>:
