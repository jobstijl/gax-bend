        mul(a_e3, b_s),
        zero,
        zero,
        zero,
        zero}

def Paravector.gp.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Paravector<T>, b: K.Vector<T>) -> K.Multivector<T>:
  match a b:
    case K.Paravector{+a_s, +a_e1, +a_e2, +a_e3} K.Vector{+b_e1, +b_e2, +b_e3}:
      K.Multivector{
        add(mul(a_e1, b_e1), add(mul(a_e2, b_e2), mul(a_e3, b_e3))),
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2))),
        neg(add(mul(a_e1, b_e3), neg(mul(a_e3, b_e1)))),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1))),
        zero}

def Paravector.gp.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Paravector<T>, b: K.Bivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Paravector{+a_s, +a_e1, +a_e2, +a_e3} K.Bivector{+b_e23, +b_e31, +b_e12}:
      K.Multivector{
        zero,
        add(neg(mul(a_e2, b_e12)), neg(mul(a_e3, neg(b_e31)))),
        add(mul(a_e1, b_e12), neg(mul(a_e3, b_e23))),
        add(mul(a_e1, neg(b_e31)), mul(a_e2, b_e23)),
        mul(a_s, b_e23),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e12),
        add(mul(a_e1, b_e23), add(neg(mul(a_e2, neg(b_e31))), mul(a_e3, b_e12)))}

def Paravector.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Paravector<T>, b: K.Pseudoscalar<T>) -> K.Multivector<T>:
  match a b:
    case K.Paravector{+a_s, +a_e1, +a_e2, +a_e3} K.Pseudoscalar{+b_e123}:
      K.Multivector{
        zero,
        zero,
        zero,
        zero,
        mul(a_e1, b_e123),
        neg(neg(mul(a_e2, b_e123))),
        mul(a_e3, b_e123),
        mul(a_s, b_e123)}

def Paravector.gp.Paravector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Paravector<T>, b: K.Paravector<T>) -> K.Multivector<T>:
  match a b:
    case K.Paravector{+a_s, +a_e1, +a_e2, +a_e3} K.Paravector{+b_s, +b_e1, +b_e2, +b_e3}:
      K.Multivector{
        add(mul(a_e1, b_e1), add(mul(a_e2, b_e2), add(mul(a_e3, b_e3), mul(a_s, b_s)))),
        add(mul(a_e1, b_s), mul(a_s, b_e1)),
        add(mul(a_e2, b_s), mul(a_s, b_e2)),
        add(mul(a_e3, b_s), mul(a_s, b_e3)),
        add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2))),
        neg(add(mul(a_e1, b_e3), neg(mul(a_e3, b_e1)))),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1))),
        zero}

def Paravector.gp.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Paravector<T>, b: K.Rotor<T>) -> K.Multivector<T>:
  match a b:
    case K.Paravector{+a_s, +a_e1, +a_e2, +a_e3} K.Rotor{+b_s, +b_e23, +b_e31, +b_e12}:
      K.Multivector{
        mul(a_s, b_s),
        add(mul(a_e1, b_s), add(neg(mul(a_e2, b_e12)), neg(mul(a_e3, neg(b_e31))))),
        add(mul(a_e1, b_e12), add(mul(a_e2, b_s), neg(mul(a_e3, b_e23)))),
        add(mul(a_e1, neg(b_e31)), add(mul(a_e2, b_e23), mul(a_e3, b_s))),
        mul(a_s, b_e23),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e12),
        add(mul(a_e1, b_e23), add(neg(mul(a_e2, neg(b_e31))), mul(a_e3, b_e12)))}

def Paravector.gp.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Paravector<T>, b: K.Odd<T>) -> K.Multivector<T>:
  match a b:
    case K.Paravector{+a_s, +a_e1, +a_e2, +a_e3} K.Odd{+b_e1, +b_e2, +b_e3, +b_e123}:
      K.Multivector{
        add(mul(a_e1, b_e1), add(mul(a_e2, b_e2), mul(a_e3, b_e3))),
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        add(mul(a_e1, b_e123), add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2)))),
        neg(add(mul(a_e1, b_e3), add(neg(mul(a_e2, b_e123)), neg(mul(a_e3, b_e1))))),
        add(mul(a_e1, b_e2), add(neg(mul(a_e2, b_e1)), mul(a_e3, b_e123))),
        mul(a_s, b_e123)}

def Paravector.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Paravector<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Paravector{+a_s, +a_e1, +a_e2, +a_e3} K.Multivector{+b_s, +b_e1, +b_e2, +b_e3, +b_e23, +b_e31, +b_e12, +b_e123}:
      K.Multivector{
        add(mul(a_e1, b_e1), add(mul(a_e2, b_e2), add(mul(a_e3, b_e3), mul(a_s, b_s)))),
        add(mul(a_e1, b_s), add(neg(mul(a_e2, b_e12)), add(neg(mul(a_e3, neg(b_e31))), mul(a_s, b_e1)))),
        add(mul(a_e1, b_e12), add(mul(a_e2, b_s), add(neg(mul(a_e3, b_e23)), mul(a_s, b_e2)))),
        add(mul(a_e1, neg(b_e31)), add(mul(a_e2, b_e23), add(mul(a_e3, b_s), mul(a_s, b_e3)))),
        add(mul(a_e1, b_e123), add(mul(a_e2, b_e3), add(neg(mul(a_e3, b_e2)), mul(a_s, b_e23)))),
        neg(add(mul(a_e1, b_e3), add(neg(mul(a_e2, b_e123)), add(neg(mul(a_e3, b_e1)), mul(a_s, neg(b_e31)))))),
        add(mul(a_e1, b_e2), add(neg(mul(a_e2, b_e1)), add(mul(a_e3, b_e123), mul(a_s, b_e12)))),
        add(mul(a_e1, b_e23), add(neg(mul(a_e2, neg(b_e31))), add(mul(a_e3, b_e12), mul(a_s, b_e123))))}

def Rotor.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Scalar<T>) -> K.Rotor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Scalar{+b_s}:
      K.Rotor{
        mul(a_s, b_s),
        mul(a_e23, b_s),
        neg(mul(neg(a_e31), b_s)),
        mul(a_e12, b_s)}

def Rotor.gp.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Vector<T>) -> K.Odd<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Vector{+b_e1, +b_e2, +b_e3}:
      K.Odd{
        add(add(mul(a_e12, b_e2), mul(neg(a_e31), b_e3)), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), add(mul(a_e23, b_e3), mul(a_s, b_e2))),
        add(neg(mul(neg(a_e31), b_e1)), add(neg(mul(a_e23, b_e2)), mul(a_s, b_e3))),
        add(add(mul(a_e12, b_e3), neg(mul(neg(a_e31), b_e2))), mul(a_e23, b_e1))}

def Rotor.gp.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Bivector<T>) -> K.Rotor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Bivector{+b_e23, +b_e31, +b_e12}:
      K.Rotor{
        add(add(neg(mul(a_e12, b_e12)), neg(mul(neg(a_e31), neg(b_e31)))), neg(mul(a_e23, b_e23))),
        add(add(neg(mul(a_e12, neg(b_e31))), mul(neg(a_e31), b_e12)), mul(a_s, b_e23)),
        neg(add(mul(a_e12, b_e23), add(neg(mul(a_e23, b_e12)), mul(a_s, neg(b_e31))))),
        add(neg(mul(neg(a_e31), b_e23)), add(mul(a_e23, neg(b_e31)), mul(a_s, b_e12)))}

def Rotor.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Pseudoscalar<T>) -> K.Odd<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Pseudoscalar{+b_e123}:
      K.Odd{
        neg(mul(a_e23, b_e123)),
        mul(neg(a_e31), b_e123),
        neg(mul(a_e12, b_e123)),
        mul(a_s, b_e123)}

def Rotor.gp.Paravector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Paravector<T>) -> K.Multivector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Paravector{+b_s, +b_e1, +b_e2, +b_e3}:
      K.Multivector{
        mul(a_s, b_s),
        add(add(mul(a_e12, b_e2), mul(neg(a_e31), b_e3)), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), add(mul(a_e23, b_e3), mul(a_s, b_e2))),
        add(neg(mul(neg(a_e31), b_e1)), add(neg(mul(a_e23, b_e2)), mul(a_s, b_e3))),
        mul(a_e23, b_s),
        neg(mul(neg(a_e31), b_s)),
        mul(a_e12, b_s),
        add(add(mul(a_e12, b_e3), neg(mul(neg(a_e31), b_e2))), mul(a_e23, b_e1))}

def Rotor.gp.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Rotor<T>) -> K.Rotor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Rotor{+b_s, +b_e23, +b_e31, +b_e12}:
      K.Rotor{
        add(add(neg(mul(a_e12, b_e12)), neg(mul(neg(a_e31), neg(b_e31)))), add(neg(mul(a_e23, b_e23)), mul(a_s, b_s))),
        add(add(neg(mul(a_e12, neg(b_e31))), mul(neg(a_e31), b_e12)), add(mul(a_e23, b_s), mul(a_s, b_e23))),
        neg(add(add(mul(a_e12, b_e23), mul(neg(a_e31), b_s)), add(neg(mul(a_e23, b_e12)), mul(a_s, neg(b_e31))))),
        add(add(mul(a_e12, b_s), neg(mul(neg(a_e31), b_e23))), add(mul(a_e23, neg(b_e31)), mul(a_s, b_e12)))}

def Rotor.gp.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Odd<T>) -> K.Odd<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Odd{+b_e1, +b_e2, +b_e3, +b_e123}:
      K.Odd{
        add(add(mul(a_e12, b_e2), mul(neg(a_e31), b_e3)), add(neg(mul(a_e23, b_e123)), mul(a_s, b_e1))),
        add(add(neg(mul(a_e12, b_e1)), mul(neg(a_e31), b_e123)), add(mul(a_e23, b_e3), mul(a_s, b_e2))),
        add(add(neg(mul(a_e12, b_e123)), neg(mul(neg(a_e31), b_e1))), add(neg(mul(a_e23, b_e2)), mul(a_s, b_e3))),
        add(add(mul(a_e12, b_e3), neg(mul(neg(a_e31), b_e2))), add(mul(a_e23, b_e1), mul(a_s, b_e123)))}

def Rotor.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Multivector{+b_s, +b_e1, +b_e2, +b_e3, +b_e23, +b_e31, +b_e12, +b_e123}:
      K.Multivector{
        add(add(neg(mul(a_e12, b_e12)), neg(mul(neg(a_e31), neg(b_e31)))), add(neg(mul(a_e23, b_e23)), mul(a_s, b_s))),
        add(add(mul(a_e12, b_e2), mul(neg(a_e31), b_e3)), add(neg(mul(a_e23, b_e123)), mul(a_s, b_e1))),
        add(add(neg(mul(a_e12, b_e1)), mul(neg(a_e31), b_e123)), add(mul(a_e23, b_e3), mul(a_s, b_e2))),
        add(add(neg(mul(a_e12, b_e123)), neg(mul(neg(a_e31), b_e1))), add(neg(mul(a_e23, b_e2)), mul(a_s, b_e3))),
        add(add(neg(mul(a_e12, neg(b_e31))), mul(neg(a_e31), b_e12)), add(mul(a_e23, b_s), mul(a_s, b_e23))),
        neg(add(add(mul(a_e12, b_e23), mul(neg(a_e31), b_s)), add(neg(mul(a_e23, b_e12)), mul(a_s, neg(b_e31))))),
        add(add(mul(a_e12, b_s), neg(mul(neg(a_e31), b_e23))), add(mul(a_e23, neg(b_e31)), mul(a_s, b_e12))),
        add(add(mul(a_e12, b_e3), neg(mul(neg(a_e31), b_e2))), add(mul(a_e23, b_e1), mul(a_s, b_e123)))}

def Odd.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Scalar<T>) -> K.Odd<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_e123} K.Scalar{+b_s}:
      K.Odd{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_e123, b_s)}

def Odd.gp.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Vector<T>) -> K.Rotor<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_e123} K.Vector{+b_e1, +b_e2, +b_e3}:
      K.Rotor{
        add(mul(a_e1, b_e1), add(mul(a_e2, b_e2), mul(a_e3, b_e3))),
        add(mul(a_e123, b_e1), add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2)))),
        neg(add(add(neg(mul(a_e123, b_e2)), mul(a_e1, b_e3)), neg(mul(a_e3, b_e1)))),
        add(add(mul(a_e123, b_e3), mul(a_e1, b_e2)), neg(mul(a_e2, b_e1)))}

def Odd.gp.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Bivector<T>) -> K.Odd<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_e123} K.Bivector{+b_e23, +b_e31, +b_e12}:
      K.Odd{
        add(neg(mul(a_e123, b_e23)), add(neg(mul(a_e2, b_e12)), neg(mul(a_e3, neg(b_e31))))),
        add(add(mul(a_e123, neg(b_e31)), mul(a_e1, b_e12)), neg(mul(a_e3, b_e23))),
        add(add(neg(mul(a_e123, b_e12)), mul(a_e1, neg(b_e31))), mul(a_e2, b_e23)),
        add(mul(a_e1, b_e23), add(neg(mul(a_e2, neg(b_e31))), mul(a_e3, b_e12)))}

def Odd.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Pseudoscalar<T>) -> K.Rotor<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_e123} K.Pseudoscalar{+b_e123}:
      K.Rotor{
        neg(mul(a_e123, b_e123)),
        mul(a_e1, b_e123),
        neg(neg(mul(a_e2, b_e123))),
        mul(a_e3, b_e123)}

def Odd.gp.Paravector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Paravector<T>) -> K.Multivector<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_e123} K.Paravector{+b_s, +b_e1, +b_e2, +b_e3}:
      K.Multivector{
        add(mul(a_e1, b_e1), add(mul(a_e2, b_e2), mul(a_e3, b_e3))),
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        add(mul(a_e123, b_e1), add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2)))),
        neg(add(add(neg(mul(a_e123, b_e2)), mul(a_e1, b_e3)), neg(mul(a_e3, b_e1)))),
        add(add(mul(a_e123, b_e3), mul(a_e1, b_e2)), neg(mul(a_e2, b_e1))),
        mul(a_e123, b_s)}

def Odd.gp.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Rotor<T>) -> K.Odd<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_e123} K.Rotor{+b_s, +b_e23, +b_e31, +b_e12}:
      K.Odd{
        add(add(neg(mul(a_e123, b_e23)), mul(a_e1, b_s)), add(neg(mul(a_e2, b_e12)), neg(mul(a_e3, neg(b_e31))))),
        add(add(mul(a_e123, neg(b_e31)), mul(a_e1, b_e12)), add(mul(a_e2, b_s), neg(mul(a_e3, b_e23)))),
        add(add(neg(mul(a_e123, b_e12)), mul(a_e1, neg(b_e31))), add(mul(a_e2, b_e23), mul(a_e3, b_s))),
        add(add(mul(a_e123, b_s), mul(a_e1, b_e23)), add(neg(mul(a_e2, neg(b_e31))), mul(a_e3, b_e12)))}

def Odd.gp.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Odd<T>) -> K.Rotor<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_e123} K.Odd{+b_e1, +b_e2, +b_e3, +b_e123}:
      K.Rotor{
        add(add(neg(mul(a_e123, b_e123)), mul(a_e1, b_e1)), add(mul(a_e2, b_e2), mul(a_e3, b_e3))),
        add(add(mul(a_e123, b_e1), mul(a_e1, b_e123)), add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2)))),
        neg(add(add(neg(mul(a_e123, b_e2)), mul(a_e1, b_e3)), add(neg(mul(a_e2, b_e123)), neg(mul(a_e3, b_e1))))),
        add(add(mul(a_e123, b_e3), mul(a_e1, b_e2)), add(neg(mul(a_e2, b_e1)), mul(a_e3, b_e123)))}

def Odd.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_e123} K.Multivector{+b_s, +b_e1, +b_e2, +b_e3, +b_e23, +b_e31, +b_e12, +b_e123}:
      K.Multivector{
        add(add(neg(mul(a_e123, b_e123)), mul(a_e1, b_e1)), add(mul(a_e2, b_e2), mul(a_e3, b_e3))),
        add(add(neg(mul(a_e123, b_e23)), mul(a_e1, b_s)), add(neg(mul(a_e2, b_e12)), neg(mul(a_e3, neg(b_e31))))),
        add(add(mul(a_e123, neg(b_e31)), mul(a_e1, b_e12)), add(mul(a_e2, b_s), neg(mul(a_e3, b_e23)))),
        add(add(neg(mul(a_e123, b_e12)), mul(a_e1, neg(b_e31))), add(mul(a_e2, b_e23), mul(a_e3, b_s))),
        add(add(mul(a_e123, b_e1), mul(a_e1, b_e123)), add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2)))),
        neg(add(add(neg(mul(a_e123, b_e2)), mul(a_e1, b_e3)), add(neg(mul(a_e2, b_e123)), neg(mul(a_e3, b_e1))))),
        add(add(mul(a_e123, b_e3), mul(a_e1, b_e2)), add(neg(mul(a_e2, b_e1)), mul(a_e3, b_e123))),
        add(add(mul(a_e123, b_s), mul(a_e1, b_e23)), add(neg(mul(a_e2, neg(b_e31))), mul(a_e3, b_e12)))}

def Multivector.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Scalar<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e1, +a_e2, +a_e3, +a_e23, +a_e31, +a_e12, +a_e123} K.Scalar{+b_s}:
      K.Multivector{
        mul(a_s, b_s),
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_e23, b_s),
        neg(mul(neg(a_e31), b_s)),
        mul(a_e12, b_s),
        mul(a_e123, b_s)}

def Multivector.gp.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Vector<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e1, +a_e2, +a_e3, +a_e23, +a_e31, +a_e12, +a_e123} K.Vector{+b_e1, +b_e2, +b_e3}:
      K.Multivector{
        add(mul(a_e1, b_e1), add(mul(a_e2, b_e2), mul(a_e3, b_e3))),
        add(add(mul(a_e12, b_e2), mul(neg(a_e31), b_e3)), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), add(mul(a_e23, b_e3), mul(a_s, b_e2))),
        add(neg(mul(neg(a_e31), b_e1)), add(neg(mul(a_e23, b_e2)), mul(a_s, b_e3))),
        add(mul(a_e123, b_e1), add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2)))),
        neg(add(add(neg(mul(a_e123, b_e2)), mul(a_e1, b_e3)), neg(mul(a_e3, b_e1)))),
        add(add(mul(a_e123, b_e3), mul(a_e1, b_e2)), neg(mul(a_e2, b_e1))),
        add(add(mul(a_e12, b_e3), neg(mul(neg(a_e31), b_e2))), mul(a_e23, b_e1))}

def Multivector.gp.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Bivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e1, +a_e2, +a_e3, +a_e23, +a_e31, +a_e12, +a_e123} K.Bivector{+b_e23, +b_e31, +b_e12}:
      K.Multivector{
        add(add(neg(mul(a_e12, b_e12)), neg(mul(neg(a_e31), neg(b_e31)))), neg(mul(a_e23, b_e23))),
        add(neg(mul(a_e123, b_e23)), add(neg(mul(a_e2, b_e12)), neg(mul(a_e3, neg(b_e31))))),
        add(add(mul(a_e123, neg(b_e31)), mul(a_e1, b_e12)), neg(mul(a_e3, b_e23))),
        add(add(neg(mul(a_e123, b_e12)), mul(a_e1, neg(b_e31))), mul(a_e2, b_e23)),
        add(add(neg(mul(a_e12, neg(b_e31))), mul(neg(a_e31), b_e12)), mul(a_s, b_e23)),
        neg(add(mul(a_e12, b_e23), add(neg(mul(a_e23, b_e12)), mul(a_s, neg(b_e31))))),
        add(neg(mul(neg(a_e31), b_e23)), add(mul(a_e23, neg(b_e31)), mul(a_s, b_e12))),
        add(mul(a_e1, b_e23), add(neg(mul(a_e2, neg(b_e31))), mul(a_e3, b_e12)))}

def Multivector.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Pseudoscalar<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e1, +a_e2, +a_e3, +a_e23, +a_e31, +a_e12, +a_e123} K.Pseudoscalar{+b_e123}:
      K.Multivector{
        neg(mul(a_e123, b_e123)),
        neg(mul(a_e23, b_e123)),
        mul(neg(a_e31), b_e123),
        neg(mul(a_e12, b_e123)),
        mul(a_e1, b_e123),
        neg(neg(mul(a_e2, b_e123))),
        mul(a_e3, b_e123),
        mul(a_s, b_e123)}

def Multivector.gp.Paravector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Paravector<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e1, +a_e2, +a_e3, +a_e23, +a_e31, +a_e12, +a_e123} K.Paravector{+b_s, +b_e1, +b_e2, +b_e3}:
      K.Multivector{
        add(mul(a_e1, b_e1), add(mul(a_e2, b_e2), add(mul(a_e3, b_e3), mul(a_s, b_s)))),
        add(add(mul(a_e12, b_e2), add(mul(neg(a_e31), b_e3), mul(a_e1, b_s))), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), add(add(mul(a_e23, b_e3), mul(a_e2, b_s)), mul(a_s, b_e2))),
        add(neg(mul(neg(a_e31), b_e1)), add(neg(mul(a_e23, b_e2)), add(mul(a_e3, b_s), mul(a_s, b_e3)))),
        add(mul(a_e123, b_e1), add(add(mul(a_e23, b_s), mul(a_e2, b_e3)), neg(mul(a_e3, b_e2)))),
        neg(add(add(neg(mul(a_e123, b_e2)), add(mul(neg(a_e31), b_s), mul(a_e1, b_e3))), neg(mul(a_e3, b_e1)))),
        add(add(add(mul(a_e123, b_e3), mul(a_e12, b_s)), mul(a_e1, b_e2)), neg(mul(a_e2, b_e1))),
        add(add(add(mul(a_e123, b_s), mul(a_e12, b_e3)), neg(mul(neg(a_e31), b_e2))), mul(a_e23, b_e1))}

def Multivector.gp.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Rotor<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e1, +a_e2, +a_e3, +a_e23, +a_e31, +a_e12, +a_e123} K.Rotor{+b_s, +b_e23, +b_e31, +b_e12}:
      K.Multivector{
        add(add(neg(mul(a_e12, b_e12)), neg(mul(neg(a_e31), neg(b_e31)))), add(neg(mul(a_e23, b_e23)), mul(a_s, b_s))),
        add(add(neg(mul(a_e123, b_e23)), mul(a_e1, b_s)), add(neg(mul(a_e2, b_e12)), neg(mul(a_e3, neg(b_e31))))),
        add(add(mul(a_e123, neg(b_e31)), mul(a_e1, b_e12)), add(mul(a_e2, b_s), neg(mul(a_e3, b_e23)))),
        add(add(neg(mul(a_e123, b_e12)), mul(a_e1, neg(b_e31))), add(mul(a_e2, b_e23), mul(a_e3, b_s))),
        add(add(neg(mul(a_e12, neg(b_e31))), mul(neg(a_e31), b_e12)), add(mul(a_e23, b_s), mul(a_s, b_e23))),
        neg(add(add(mul(a_e12, b_e23), mul(neg(a_e31), b_s)), add(neg(mul(a_e23, b_e12)), mul(a_s, neg(b_e31))))),
        add(add(mul(a_e12, b_s), neg(mul(neg(a_e31), b_e23))), add(mul(a_e23, neg(b_e31)), mul(a_s, b_e12))),
        add(add(mul(a_e123, b_s), mul(a_e1, b_e23)), add(neg(mul(a_e2, neg(b_e31))), mul(a_e3, b_e12)))}

def Multivector.gp.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Odd<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e1, +a_e2, +a_e3, +a_e23, +a_e31, +a_e12, +a_e123} K.Odd{+b_e1, +b_e2, +b_e3, +b_e123}:
      K.Multivector{
        add(add(neg(mul(a_e123, b_e123)), mul(a_e1, b_e1)), add(mul(a_e2, b_e2), mul(a_e3, b_e3))),
        add(add(mul(a_e12, b_e2), mul(neg(a_e31), b_e3)), add(neg(mul(a_e23, b_e123)), mul(a_s, b_e1))),
        add(add(neg(mul(a_e12, b_e1)), mul(neg(a_e31), b_e123)), add(mul(a_e23, b_e3), mul(a_s, b_e2))),
        add(add(neg(mul(a_e12, b_e123)), neg(mul(neg(a_e31), b_e1))), add(neg(mul(a_e23, b_e2)), mul(a_s, b_e3))),
        add(add(mul(a_e123, b_e1), mul(a_e1, b_e123)), add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2)))),
        neg(add(add(neg(mul(a_e123, b_e2)), mul(a_e1, b_e3)), add(neg(mul(a_e2, b_e123)), neg(mul(a_e3, b_e1))))),
        add(add(mul(a_e123, b_e3), mul(a_e1, b_e2)), add(neg(mul(a_e2, b_e1)), mul(a_e3, b_e123))),
        add(add(mul(a_e12, b_e3), neg(mul(neg(a_e31), b_e2))), add(mul(a_e23, b_e1), mul(a_s, b_e123)))}

def Multivector.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e1, +a_e2, +a_e3, +a_e23, +a_e31, +a_e12, +a_e123} K.Multivector{+b_s, +b_e1, +b_e2, +b_e3, +b_e23, +b_e31, +b_e12, +b_e123}:
      K.Multivector{
        add(add(add(neg(mul(a_e123, b_e123)), neg(mul(a_e12, b_e12))), add(neg(mul(neg(a_e31), neg(b_e31))), mul(a_e1, b_e1))), add(add(neg(mul(a_e23, b_e23)), mul(a_e2, b_e2)), add(mul(a_e3, b_e3), mul(a_s, b_s)))),
        add(add(add(neg(mul(a_e123, b_e23)), mul(a_e12, b_e2)), add(mul(neg(a_e31), b_e3), mul(a_e1, b_s))), add(add(neg(mul(a_e23, b_e123)), neg(mul(a_e2, b_e12))), add(neg(mul(a_e3, neg(b_e31))), mul(a_s, b_e1)))),
        add(add(add(mul(a_e123, neg(b_e31)), neg(mul(a_e12, b_e1))), add(mul(neg(a_e31), b_e123), mul(a_e1, b_e12))), add(add(mul(a_e23, b_e3), mul(a_e2, b_s)), add(neg(mul(a_e3, b_e23)), mul(a_s, b_e2)))),
        add(add(add(neg(mul(a_e123, b_e12)), neg(mul(a_e12, b_e123))), add(neg(mul(neg(a_e31), b_e1)), mul(a_e1, neg(b_e31)))), add(add(neg(mul(a_e23, b_e2)), mul(a_e2, b_e23)), add(mul(a_e3, b_s), mul(a_s, b_e3)))),
        add(add(add(mul(a_e123, b_e1), neg(mul(a_e12, neg(b_e31)))), add(mul(neg(a_e31), b_e12), mul(a_e1, b_e123))), add(add(mul(a_e23, b_s), mul(a_e2, b_e3)), add(neg(mul(a_e3, b_e2)), mul(a_s, b_e23)))),
        neg(add(add(add(neg(mul(a_e123, b_e2)), mul(a_e12, b_e23)), add(mul(neg(a_e31), b_s), mul(a_e1, b_e3))), add(add(neg(mul(a_e23, b_e12)), neg(mul(a_e2, b_e123))), add(neg(mul(a_e3, b_e1)), mul(a_s, neg(b_e31)))))),
        add(add(add(mul(a_e123, b_e3), mul(a_e12, b_s)), add(neg(mul(neg(a_e31), b_e23)), mul(a_e1, b_e2))), add(add(mul(a_e23, neg(b_e31)), neg(mul(a_e2, b_e1))), add(mul(a_e3, b_e123), mul(a_s, b_e12)))),
        add(add(add(mul(a_e123, b_s), mul(a_e12, b_e3)), add(neg(mul(neg(a_e31), b_e2)), mul(a_e1, b_e23))), add(add(mul(a_e23, b_e1), neg(mul(a_e2, neg(b_e31)))), add(mul(a_e3, b_e12), mul(a_s, b_e123))))}

def Scalar.wedge.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Scalar<T>) -> K.Scalar<T>:
  match a b:
    case K.Scalar{+a_s} K.Scalar{+b_s}:
      K.Scalar{
        mul(a_s, b_s)}

def Scalar.wedge.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Vector<T>) -> K.Vector<T>:
  match a b:
    case K.Scalar{+a_s} K.Vector{+b_e1, +b_e2, +b_e3}:
      K.Vector{
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3)}

def Scalar.wedge.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Bivector<T>) -> K.Bivector<T>:
  match a b:
    case K.Scalar{+a_s} K.Bivector{+b_e23, +b_e31, +b_e12}:
      K.Bivector{
        mul(a_s, b_e23),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e12)}

def Scalar.wedge.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Pseudoscalar<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Scalar{+a_s} K.Pseudoscalar{+b_e123}:
      K.Pseudoscalar{
        mul(a_s, b_e123)}

def Scalar.wedge.Paravector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Paravector<T>) -> K.Multivector<T>:
  match a b:
    case K.Scalar{+a_s} K.Paravector{+b_s, +b_e1, +b_e2, +b_e3}:
      K.Multivector{
        mul(a_s, b_s),
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        zero,
        zero,
        zero,
        zero}

def Scalar.wedge.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Rotor<T>) -> K.Rotor<T>:
  match a b:
    case K.Scalar{+a_s} K.Rotor{+b_s, +b_e23, +b_e31, +b_e12}:
      K.Rotor{
        mul(a_s, b_s),
        mul(a_s, b_e23),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e12)}

def Scalar.wedge.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Odd<T>) -> K.Odd<T>:
  match a b:
    case K.Scalar{+a_s} K.Odd{+b_e1, +b_e2, +b_e3, +b_e123}:
      K.Odd{
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        mul(a_s, b_e123)}

def Scalar.wedge.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Scalar{+a_s} K.Multivector{+b_s, +b_e1, +b_e2, +b_e3, +b_e23, +b_e31, +b_e12, +b_e123}:
      K.Multivector{
        mul(a_s, b_s),
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        mul(a_s, b_e23),
        neg(mul(a_s, neg(b_e31))),
        mul(a_s, b_e12),
        mul(a_s, b_e123)}

def Vector.wedge.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Scalar<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3} K.Scalar{+b_s}:
      K.Vector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s)}

def Vector.wedge.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Vector<T>) -> K.Bivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3} K.Vector{+b_e1, +b_e2, +b_e3}:
      K.Bivector{
        add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2))),
        neg(add(mul(a_e1, b_e3), neg(mul(a_e3, b_e1)))),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1)))}

def Vector.wedge.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Bivector<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3} K.Bivector{+b_e23, +b_e31, +b_e12}:
      K.Pseudoscalar{
        add(mul(a_e1, b_e23), add(neg(mul(a_e2, neg(b_e31))), mul(a_e3, b_e12)))}

def Vector.wedge.Paravector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Paravector<T>) -> K.Multivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3} K.Paravector{+b_s, +b_e1, +b_e2, +b_e3}:
      K.Multivector{
        zero,
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2))),
        neg(add(mul(a_e1, b_e3), neg(mul(a_e3, b_e1)))),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1))),
        zero}

def Vector.wedge.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Rotor<T>) -> K.Odd<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3} K.Rotor{+b_s, +b_e23, +b_e31, +b_e12}:
      K.Odd{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        add(mul(a_e1, b_e23), add(neg(mul(a_e2, neg(b_e31))), mul(a_e3, b_e12)))}

def Vector.wedge.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Odd<T>) -> K.Bivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3} K.Odd{+b_e1, +b_e2, +b_e3, +b_e123}:
      K.Bivector{
        add(mul(a_e2, b_e3), neg(mul(a_e3, b_e2))),
