        mul(a_e23, b_s),
        neg(mul(neg(a_e31), b_s)),
        mul(a_e12, b_s),
        zero}

def Rotor.dot.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Rotor<T>) -> K.Rotor<T>:
  match a b:
