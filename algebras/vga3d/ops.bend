        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_e123, b_e1),
        neg(neg(mul(a_e123, b_e2))),
        mul(a_e123, b_e3),
        mul(a_e123, b_s)}

def Odd.dot.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Rotor<T>) -> K.Odd<T>:
  match a b:
