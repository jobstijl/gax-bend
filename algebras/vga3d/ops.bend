        add(neg(mul(a_e12, b_e1)), mul(a_e23, b_e3)),
        add(mul(a_e31, b_e1), neg(mul(a_e23, b_e2))),
        add(neg(mul(a_e3, b_e2)), mul(a_e2, b_e3)),
        add(mul(a_e3, b_e1), neg(mul(a_e1, b_e3))),
