def Scalar.dot.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Bivector<T>) -> K.Bivector<T>:
  match a b:
    case K.Scalar{+a_s} K.Bivector{+b_e23, +b_e31, +b_e12}:
