        S.MV.at(~T, ~zero, ~neg, 3n, [False{}, True{}, True{}], False{}, S.MV.commutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Vector.tree(~T, ~neg, K.Vector{a_e1, a_e2, a_e3}), K.Vector.tree(~T, ~neg, K.Vector{b_e1, b_e2, b_e3}))),
