def Paravector.anticommutator.Pseudoscalar.ok(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg), a: K.Paravector<T>, b: K.Pseudoscalar<T>)
  -> {K.Multivector.of_tree(~T, ~zero, ~neg, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Paravector.tree(~T, ~neg, a), K.Pseudoscalar.tree(~T, ~neg, b))) == O.Multivector.add.Multivector(~T, ~zero, ~add, ~mul, ~neg, O.Paravector.anticommutator.Pseudoscalar(~T, ~zero, ~add, ~mul, ~neg, a, b), O.Paravector.anticommutator.Pseudoscalar(~T, ~zero, ~add, ~mul, ~neg, a, b)) : K.Multivector<T>}:
  match a b:
    case K.Paravector{+a_s, +a_e1, +a_e2, +a_e3} K.Pseudoscalar{+b_e123}:
      K.Multivector.cong(T,
        S.MV.at(~T, ~zero, ~neg, 3n, [False{}, False{}, False{}], False{}, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Paravector.tree(~T, ~neg, K.Paravector{a_s, a_e1, a_e2, a_e3}), K.Pseudoscalar.tree(~T, ~neg, K.Pseudoscalar{b_e123}))),
        S.MV.at(~T, ~zero, ~neg, 3n, [True{}, False{}, False{}], False{}, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Paravector.tree(~T, ~neg, K.Paravector{a_s, a_e1, a_e2, a_e3}), K.Pseudoscalar.tree(~T, ~neg, K.Pseudoscalar{b_e123}))),
        S.MV.at(~T, ~zero, ~neg, 3n, [False{}, True{}, False{}], False{}, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Paravector.tree(~T, ~neg, K.Paravector{a_s, a_e1, a_e2, a_e3}), K.Pseudoscalar.tree(~T, ~neg, K.Pseudoscalar{b_e123}))),
