def Odd.anticommutator.Rotor.ok(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg), a: K.Odd<T>, b: K.Rotor<T>)
  -> {K.Odd.of_tree(~T, ~zero, ~neg, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Odd.tree(~T, ~neg, a), K.Rotor.tree(~T, ~neg, b))) == O.Odd.add.Odd(~T, ~zero, ~add, ~mul, ~neg, O.Odd.anticommutator.Rotor(~T, ~zero, ~add, ~mul, ~neg, a, b), O.Odd.anticommutator.Rotor(~T, ~zero, ~add, ~mul, ~neg, a, b)) : K.Odd<T>}:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_e123} K.Rotor{+b_s, +b_e23, +b_e31, +b_e12}:
      K.Odd.cong(T,
        S.MV.at(~T, ~zero, ~neg, 3n, [True{}, False{}, False{}], False{}, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Odd.tree(~T, ~neg, K.Odd{a_e1, a_e2, a_e3, a_e123}), K.Rotor.tree(~T, ~neg, K.Rotor{b_s, b_e23, b_e31, b_e12}))),
        S.MV.at(~T, ~zero, ~neg, 3n, [False{}, True{}, False{}], False{}, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Odd.tree(~T, ~neg, K.Odd{a_e1, a_e2, a_e3, a_e123}), K.Rotor.tree(~T, ~neg, K.Rotor{b_s, b_e23, b_e31, b_e12}))),
        S.MV.at(~T, ~zero, ~neg, 3n, [False{}, False{}, True{}], False{}, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Odd.tree(~T, ~neg, K.Odd{a_e1, a_e2, a_e3, a_e123}), K.Rotor.tree(~T, ~neg, K.Rotor{b_s, b_e23, b_e31, b_e12}))),
