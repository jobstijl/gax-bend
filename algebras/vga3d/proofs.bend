def Rotor.commutator.Vector.ok(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg), a: K.Rotor<T>, b: K.Vector<T>)
  -> {K.Vector.of_tree(~T, ~zero, ~neg, S.MV.commutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Rotor.tree(~T, ~neg, a), K.Vector.tree(~T, ~neg, b))) == O.Vector.add.Vector(~T, ~zero, ~add, ~mul, ~neg, O.Rotor.commutator.Vector(~T, ~zero, ~add, ~mul, ~neg, a, b), O.Rotor.commutator.Vector(~T, ~zero, ~add, ~mul, ~neg, a, b)) : K.Vector<T>}:
  match a b:
    case K.Rotor{+a_s, +a_e23, +a_e31, +a_e12} K.Vector{+b_e1, +b_e2, +b_e3}:
      K.Vector.cong(T,
        S.MV.at(~T, ~zero, ~neg, 3n, [True{}, False{}, False{}], False{}, S.MV.commutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Rotor.tree(~T, ~neg, K.Rotor{a_s, a_e23, a_e31, a_e12}), K.Vector.tree(~T, ~neg, K.Vector{b_e1, b_e2, b_e3}))),
