  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg), a: K.Multivector<T>, b: K.Paravector<T>)
  -> {K.Multivector.of_tree(~T, ~zero, ~neg, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Multivector.tree(~T, ~neg, a), K.Paravector.tree(~T, ~neg, b))) == O.Multivector.add.Multivector(~T, ~zero, ~add, ~mul, ~neg, O.Multivector.anticommutator.Paravector(~T, ~zero, ~add, ~mul, ~neg, a, b), O.Multivector.anticommutator.Paravector(~T, ~zero, ~add, ~mul, ~neg, a, b)) : K.Multivector<T>}:
