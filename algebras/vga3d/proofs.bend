  match a b:
    case K.Bivector{+a_e23, +a_e31, +a_e12} K.Scalar{+b_s}:
      K.Bivector.cong(T,
        S.MV.at(~T, ~zero, ~neg, 3n, [False{}, True{}, True{}], False{}, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Bivector.tree(~T, ~neg, K.Bivector{a_e23, a_e31, a_e12}), K.Scalar.tree(~T, ~neg, K.Scalar{b_s}))),
