        S.MV.at(~T, ~zero, ~neg, 3n, [True{}, True{}, True{}], False{}, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 3n, K.VGA3.sig(), K.Pseudoscalar.tree(~T, ~neg, K.Pseudoscalar{a_e123}), K.Scalar.tree(~T, ~neg, K.Scalar{b_s}))),
