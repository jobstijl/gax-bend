    case K.Motor{+a_s, +a_e01, +a_e02, +a_e03, +a_e04, +a_e23, +a_e31, +a_e12, +a_e41, +a_e42, +a_e43, +a_e0324, +a_e0134, +a_e0214, +a_e0123, +a_e1234}:
      K.Odd{
        a_e1234,
        neg(neg(a_e0324)),
        a_e0134,
        neg(neg(a_e0214)),
        a_e0123,
        neg(a_e41),
        neg(neg(neg(a_e42))),
        neg(a_e43),
        a_e23,
        neg(neg(a_e31)),
        a_e12,
        neg(a_e04),
        a_e01,
        neg(neg(a_e02)),
        a_e03,
        a_s}

def Odd.undual(~T: Data, ~zero: T, ~neg: T -> T, a: K.Odd<T>) -> K.Motor<T>:
  match a:
