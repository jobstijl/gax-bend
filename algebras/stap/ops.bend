      +q1_4 = mul(a_e1, a_e4)
      +q0_3 = mul(a_e0, a_e3)
      +q0_2 = mul(a_e0, a_e2)
      +q0_4 = mul(a_e0, a_e4)
      +q2_3 = mul(a_e2, a_e3)
      +q2_4 = mul(a_e2, a_e4)
      +q0_1 = mul(a_e0, a_e1)
      +q3_4 = mul(a_e3, a_e4)
      +m0_0 = add(add(add(neg(q4_4), q3_3), q2_2), neg(q1_1))
      +m0_1 = add(neg(q1_2), neg(q1_2))
      +m0_2 = add(neg(q1_3), neg(q1_3))
      +m0_3 = add(q1_4, q1_4)
      +m0_5 = add(neg(q0_3), neg(q0_3))
      +m0_6 = add(q0_2, q0_2)
      +m0_7 = add(q0_4, q0_4)
      +m1_0 = add(neg(q1_2), neg(q1_2))
      +m1_1 = add(add(add(neg(q4_4), q3_3), neg(q2_2)), q1_1)
      +m1_2 = add(neg(q2_3), neg(q2_3))
      +m1_3 = add(q2_4, q2_4)
      +m1_4 = add(q0_3, q0_3)
      +m1_6 = add(neg(q0_1), neg(q0_1))
      +m1_8 = add(q0_4, q0_4)
      +m2_0 = add(neg(q1_3), neg(q1_3))
      +m2_1 = add(neg(q2_3), neg(q2_3))
      +m2_2 = add(add(add(neg(q4_4), neg(q3_3)), q2_2), q1_1)
      +m2_3 = add(q3_4, q3_4)
      +m2_4 = add(neg(q0_2), neg(q0_2))
      +m2_5 = add(q0_1, q0_1)
      +m2_9 = add(q0_4, q0_4)
      +m3_0 = add(neg(q1_4), neg(q1_4))
      +m3_1 = add(neg(q2_4), neg(q2_4))
      +m3_2 = add(neg(q3_4), neg(q3_4))
      +m3_3 = add(add(add(q4_4, q3_3), q2_2), q1_1)
      +m3_7 = add(q0_1, q0_1)
      +m3_8 = add(q0_2, q0_2)
      +m3_9 = add(q0_3, q0_3)
      +m4_4 = add(add(add(neg(q4_4), neg(q3_3)), neg(q2_2)), q1_1)
      +m4_5 = add(q1_2, q1_2)
      +m4_6 = add(q1_3, q1_3)
      +m4_8 = add(neg(q3_4), neg(q3_4))
      +m4_9 = add(q2_4, q2_4)
      +m5_4 = add(q1_2, q1_2)
      +m5_5 = add(add(add(neg(q4_4), neg(q3_3)), q2_2), neg(q1_1))
      +m5_6 = add(q2_3, q2_3)
      +m5_7 = add(q3_4, q3_4)
      +m5_9 = add(neg(q1_4), neg(q1_4))
      +m6_4 = add(q1_3, q1_3)
      +m6_5 = add(q2_3, q2_3)
      +m6_6 = add(add(add(neg(q4_4), q3_3), neg(q2_2)), neg(q1_1))
      +m6_7 = add(neg(q2_4), neg(q2_4))
      +m6_8 = add(q1_4, q1_4)
      +m7_5 = add(neg(q3_4), neg(q3_4))
      +m7_6 = add(q2_4, q2_4)
