        add(mul(b_e31, m7_5), add(mul(b_e12, m7_6), add(mul(b_e41, m7_7), add(mul(b_e42, m7_8), mul(b_e43, m7_9))))),
        add(mul(b_e23, m8_4), add(mul(b_e12, m8_6), add(mul(b_e41, m8_7), add(mul(b_e42, m8_8), mul(b_e43, m8_9))))),
