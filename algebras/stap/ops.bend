def Vector.transform.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Scalar<T>) -> K.Scalar<T>:
  match a b:
    case K.Vector{+a_e0, +a_e1, +a_e2, +a_e3, +a_e4} K.Scalar{+b_s}:
      +q4_4 = mul(a_e4, a_e4)
      +q3_3 = mul(a_e3, a_e3)
      +q2_2 = mul(a_e2, a_e2)
      +q1_1 = mul(a_e1, a_e1)
      +m0_0 = add(add(add(neg(q4_4), q3_3), q2_2), q1_1)
      K.Scalar{
        mul(b_s, m0_0)}

type VectorScalarMap<-T: Data> is Data:
  VectorScalarMap{m0_0: T}

def Vector.prepare.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>) -> VectorScalarMap<T>:
  match a:
    case K.Vector{+a_e0, +a_e1, +a_e2, +a_e3, +a_e4}:
      +q4_4 = mul(a_e4, a_e4)
      +q3_3 = mul(a_e3, a_e3)
      +q2_2 = mul(a_e2, a_e2)
      +q1_1 = mul(a_e1, a_e1)
      +m0_0 = add(add(add(neg(q4_4), q3_3), q2_2), q1_1)
      VectorScalarMap{m0_0}

def Vector.Scalar.apply(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, m: VectorScalarMap<T>, b: K.Scalar<T>) -> K.Scalar<T>:
  match m b:
    case VectorScalarMap{+m0_0} K.Scalar{+b_s}:
      K.Scalar{
        mul(b_s, m0_0)}

def Vector.transform.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Vector<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e0, +a_e1, +a_e2, +a_e3, +a_e4} K.Vector{+b_e0, +b_e1, +b_e2, +b_e3, +b_e4}:
      +q4_4 = mul(a_e4, a_e4)
      +q3_3 = mul(a_e3, a_e3)
      +q2_2 = mul(a_e2, a_e2)
      +q1_1 = mul(a_e1, a_e1)
      +q0_1 = mul(a_e0, a_e1)
      +q0_2 = mul(a_e0, a_e2)
      +q0_3 = mul(a_e0, a_e3)
      +q0_4 = mul(a_e0, a_e4)
      +q1_2 = mul(a_e1, a_e2)
      +q1_3 = mul(a_e1, a_e3)
      +q1_4 = mul(a_e1, a_e4)
      +q2_3 = mul(a_e2, a_e3)
      +q2_4 = mul(a_e2, a_e4)
      +q3_4 = mul(a_e3, a_e4)
      +m0_0 = add(add(add(q4_4, neg(q3_3)), neg(q2_2)), neg(q1_1))
      +m0_1 = add(q0_1, q0_1)
      +m0_2 = add(q0_2, q0_2)
      +m0_3 = add(q0_3, q0_3)
      +m0_4 = add(neg(q0_4), neg(q0_4))
      +m1_1 = add(add(add(q4_4, neg(q3_3)), neg(q2_2)), q1_1)
      +m1_2 = add(q1_2, q1_2)
      +m1_3 = add(q1_3, q1_3)
      +m1_4 = add(neg(q1_4), neg(q1_4))
      +m2_1 = add(q1_2, q1_2)
      +m2_2 = add(add(add(q4_4, neg(q3_3)), q2_2), neg(q1_1))
      +m2_3 = add(q2_3, q2_3)
      +m2_4 = add(neg(q2_4), neg(q2_4))
      +m3_1 = add(q1_3, q1_3)
      +m3_2 = add(q2_3, q2_3)
      +m3_3 = add(add(add(q4_4, q3_3), neg(q2_2)), neg(q1_1))
      +m3_4 = add(neg(q3_4), neg(q3_4))
      +m4_1 = add(q1_4, q1_4)
      +m4_2 = add(q2_4, q2_4)
      +m4_3 = add(q3_4, q3_4)
      +m4_4 = add(add(add(neg(q4_4), neg(q3_3)), neg(q2_2)), neg(q1_1))
      K.Vector{
        add(mul(b_e0, m0_0), add(mul(b_e1, m0_1), add(mul(b_e2, m0_2), add(mul(b_e3, m0_3), mul(b_e4, m0_4))))),
        add(mul(b_e1, m1_1), add(mul(b_e2, m1_2), add(mul(b_e3, m1_3), mul(b_e4, m1_4)))),
        add(mul(b_e1, m2_1), add(mul(b_e2, m2_2), add(mul(b_e3, m2_3), mul(b_e4, m2_4)))),
        add(mul(b_e1, m3_1), add(mul(b_e2, m3_2), add(mul(b_e3, m3_3), mul(b_e4, m3_4)))),
        add(mul(b_e1, m4_1), add(mul(b_e2, m4_2), add(mul(b_e3, m4_3), mul(b_e4, m4_4))))}

type VectorVectorMap<-T: Data> is Data:
  VectorVectorMap{m0_0: T, m0_1: T, m0_2: T, m0_3: T, m0_4: T, m1_1: T, m1_2: T, m1_3: T, m1_4: T, m2_1: T, m2_2: T, m2_3: T, m2_4: T, m3_1: T, m3_2: T, m3_3: T, m3_4: T, m4_1: T, m4_2: T, m4_3: T, m4_4: T}

def Vector.prepare.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>) -> VectorVectorMap<T>:
  match a:
    case K.Vector{+a_e0, +a_e1, +a_e2, +a_e3, +a_e4}:
      +q4_4 = mul(a_e4, a_e4)
      +q3_3 = mul(a_e3, a_e3)
      +q2_2 = mul(a_e2, a_e2)
      +q1_1 = mul(a_e1, a_e1)
      +q0_1 = mul(a_e0, a_e1)
      +q0_2 = mul(a_e0, a_e2)
      +q0_3 = mul(a_e0, a_e3)
      +q0_4 = mul(a_e0, a_e4)
      +q1_2 = mul(a_e1, a_e2)
      +q1_3 = mul(a_e1, a_e3)
      +q1_4 = mul(a_e1, a_e4)
      +q2_3 = mul(a_e2, a_e3)
      +q2_4 = mul(a_e2, a_e4)
      +q3_4 = mul(a_e3, a_e4)
      +m0_0 = add(add(add(q4_4, neg(q3_3)), neg(q2_2)), neg(q1_1))
      +m0_1 = add(q0_1, q0_1)
      +m0_2 = add(q0_2, q0_2)
      +m0_3 = add(q0_3, q0_3)
      +m0_4 = add(neg(q0_4), neg(q0_4))
      +m1_1 = add(add(add(q4_4, neg(q3_3)), neg(q2_2)), q1_1)
      +m1_2 = add(q1_2, q1_2)
      +m1_3 = add(q1_3, q1_3)
      +m1_4 = add(neg(q1_4), neg(q1_4))
      +m2_1 = add(q1_2, q1_2)
      +m2_2 = add(add(add(q4_4, neg(q3_3)), q2_2), neg(q1_1))
      +m2_3 = add(q2_3, q2_3)
      +m2_4 = add(neg(q2_4), neg(q2_4))
      +m3_1 = add(q1_3, q1_3)
      +m3_2 = add(q2_3, q2_3)
      +m3_3 = add(add(add(q4_4, q3_3), neg(q2_2)), neg(q1_1))
      +m3_4 = add(neg(q3_4), neg(q3_4))
      +m4_1 = add(q1_4, q1_4)
      +m4_2 = add(q2_4, q2_4)
      +m4_3 = add(q3_4, q3_4)
      +m4_4 = add(add(add(neg(q4_4), neg(q3_3)), neg(q2_2)), neg(q1_1))
      VectorVectorMap{m0_0, m0_1, m0_2, m0_3, m0_4, m1_1, m1_2, m1_3, m1_4, m2_1, m2_2, m2_3, m2_4, m3_1, m3_2, m3_3, m3_4, m4_1, m4_2, m4_3, m4_4}

def Vector.Vector.apply(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, m: VectorVectorMap<T>, b: K.Vector<T>) -> K.Vector<T>:
  match m b:
    case VectorVectorMap{+m0_0, +m0_1, +m0_2, +m0_3, +m0_4, +m1_1, +m1_2, +m1_3, +m1_4, +m2_1, +m2_2, +m2_3, +m2_4, +m3_1, +m3_2, +m3_3, +m3_4, +m4_1, +m4_2, +m4_3, +m4_4} K.Vector{+b_e0, +b_e1, +b_e2, +b_e3, +b_e4}:
      K.Vector{
        add(mul(b_e0, m0_0), add(mul(b_e1, m0_1), add(mul(b_e2, m0_2), add(mul(b_e3, m0_3), mul(b_e4, m0_4))))),
        add(mul(b_e1, m1_1), add(mul(b_e2, m1_2), add(mul(b_e3, m1_3), mul(b_e4, m1_4)))),
        add(mul(b_e1, m2_1), add(mul(b_e2, m2_2), add(mul(b_e3, m2_3), mul(b_e4, m2_4)))),
        add(mul(b_e1, m3_1), add(mul(b_e2, m3_2), add(mul(b_e3, m3_3), mul(b_e4, m3_4)))),
        add(mul(b_e1, m4_1), add(mul(b_e2, m4_2), add(mul(b_e3, m4_3), mul(b_e4, m4_4))))}

def Vector.transform.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Bivector<T>) -> K.Bivector<T>:
  match a b:
    case K.Vector{+a_e0, +a_e1, +a_e2, +a_e3, +a_e4} K.Bivector{+b_e01, +b_e02, +b_e03, +b_e04, +b_e23, +b_e31, +b_e12, +b_e41, +b_e42, +b_e43}:
      +q4_4 = mul(a_e4, a_e4)
