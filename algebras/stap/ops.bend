      +m9_7 = add(neg(q1_3), neg(q1_3))
      +m9_8 = add(neg(q2_3), neg(q2_3))
      +m9_9 = add(add(add(q4_4, neg(q3_3)), q2_2), q1_1)
      K.Bivector{
        add(mul(b_e01, m0_0), add(mul(b_e02, m0_1), add(mul(b_e03, m0_2), add(mul(b_e04, m0_3), add(mul(b_e31, m0_5), add(mul(b_e12, m0_6), mul(b_e41, m0_7))))))),
