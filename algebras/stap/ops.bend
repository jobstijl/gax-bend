        add(mul(b_e01, m3_0), add(mul(b_e02, m3_1), add(mul(b_e03, m3_2), add(mul(b_e04, m3_3), add(mul(b_e41, m3_7), add(mul(b_e42, m3_8), mul(b_e43, m3_9))))))),
