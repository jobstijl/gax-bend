def Vector.Multivector.prepared(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Multivector<T>)
  -> {O.Vector.transform.Multivector(~T, ~zero, ~add, ~mul, ~neg, a, b) == O.Vector.Multivector.apply(~T, ~zero, ~add, ~mul, ~neg, O.Vector.prepare.Multivector(~T, ~zero, ~add, ~mul, ~neg, a), b) : K.Multivector<T>}:
  match a b:
    case K.Vector{a_e0, a_e1, a_e2, a_e3, a_e4} K.Multivector{b_s, b_e0, b_e1, b_e2, b_e3, b_e4, b_e01, b_e02, b_e03, b_e04, b_e23, b_e31, b_e12, b_e41, b_e42, b_e43, b_e023, b_e031, b_e012, b_e014, b_e024, b_e034, b_e123, b_e234, b_e314, b_e124, b_e0324, b_e0134, b_e0214, b_e0123, b_e1234, b_e01234}:
      {==}

def Motor.transform.Scalar.ok(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg), a: K.Motor<T>, b: K.Scalar<T>)
  -> {K.Motor.of_tree(~T, ~zero, ~neg, S.MV.gp(~T, ~add, ~mul, ~neg, 5n, K.STAP.sig(), S.MV.gp(~T, ~add, ~mul, ~neg, 5n, K.STAP.sig(), K.Motor.tree(~T, ~neg, a), K.Scalar.tree(~T, ~neg, b)), S.MV.reverse(~T, ~neg, 5n, K.Motor.tree(~T, ~neg, a)))) == O.Motor.transform.Scalar(~T, ~zero, ~add, ~mul, ~neg, a, b) : K.Motor<T>}:
  match a b:
