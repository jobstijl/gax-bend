def Bivector.anticommutator.Vector.zero_e0(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg), a: K.Bivector<T>, b: K.Vector<T>)
  -> {S.MV.at(~T, ~zero, ~neg, 5n, [True{}, False{}, False{}, False{}, False{}], False{}, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 5n, K.STAP.sig(), K.Bivector.tree(~T, ~neg, a), K.Vector.tree(~T, ~neg, b))) == zero : T}:
  match a b:
