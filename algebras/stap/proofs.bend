def Odd.Motor.prepared(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Motor<T>)
  -> {O.Odd.transform.Motor(~T, ~zero, ~add, ~mul, ~neg, a, b) == O.Odd.Motor.apply(~T, ~zero, ~add, ~mul, ~neg, O.Odd.prepare.Motor(~T, ~zero, ~add, ~mul, ~neg, a), b) : K.Motor<T>}:
  match a b:
    case K.Odd{a_e0, a_e1, a_e2, a_e3, a_e4, a_e023, a_e031, a_e012, a_e014, a_e024, a_e034, a_e123, a_e234, a_e314, a_e124, a_e01234} K.Motor{b_s, b_e01, b_e02, b_e03, b_e04, b_e23, b_e31, b_e12, b_e41, b_e42, b_e43, b_e0324, b_e0134, b_e0214, b_e0123, b_e1234}:
      {==}

def Odd.transform.Odd.ok(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
