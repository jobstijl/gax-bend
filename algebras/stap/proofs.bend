def Quadvector.anticommutator.Scalar.ok(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg), a: K.Quadvector<T>, b: K.Scalar<T>)
  -> {K.Quadvector.of_tree(~T, ~zero, ~neg, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 5n, K.STAP.sig(), K.Quadvector.tree(~T, ~neg, a), K.Scalar.tree(~T, ~neg, b))) == O.Quadvector.add.Quadvector(~T, ~zero, ~add, ~mul, ~neg, O.Quadvector.anticommutator.Scalar(~T, ~zero, ~add, ~mul, ~neg, a, b), O.Quadvector.anticommutator.Scalar(~T, ~zero, ~add, ~mul, ~neg, a, b)) : K.Quadvector<T>}:
  match a b:
    case K.Quadvector{+a_e0324, +a_e0134, +a_e0214, +a_e0123, +a_e1234} K.Scalar{+b_s}:
