def Odd.Scalar.prepared(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Scalar<T>)
  -> {O.Odd.transform.Scalar(~T, ~zero, ~add, ~mul, ~neg, a, b) == O.Odd.Scalar.apply(~T, ~zero, ~add, ~mul, ~neg, O.Odd.prepare.Scalar(~T, ~zero, ~add, ~mul, ~neg, a), b) : K.Motor<T>}:
  match a b:
    case K.Odd{a_e0, a_e1, a_e2, a_e3, a_e4, a_e023, a_e031, a_e012, a_e014, a_e024, a_e034, a_e123, a_e234, a_e314, a_e124, a_e01234} K.Scalar{b_s}:
      {==}

