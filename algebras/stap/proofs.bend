    case K.Odd{+a_e0, +a_e1, +a_e2, +a_e3, +a_e4, +a_e023, +a_e031, +a_e012, +a_e014, +a_e024, +a_e034, +a_e123, +a_e234, +a_e314, +a_e124, +a_e01234} K.Pseudoscalar{+b_e01234}:
