  match a b:
    case K.Motor{a_s, a_e01, a_e02, a_e03, a_e04, a_e23, a_e31, a_e12, a_e41, a_e42, a_e43, a_e0324, a_e0134, a_e0214, a_e0123, a_e1234} K.Multivector{b_s, b_e0, b_e1, b_e2, b_e3, b_e4, b_e01, b_e02, b_e03, b_e04, b_e23, b_e31, b_e12, b_e41, b_e42, b_e43, b_e023, b_e031, b_e012, b_e014, b_e024, b_e034, b_e123, b_e234, b_e314, b_e124, b_e0324, b_e0134, b_e0214, b_e0123, b_e1234, b_e01234}:
