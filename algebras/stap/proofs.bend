  match a b:
    case K.Motor{a_s, a_e01, a_e02, a_e03, a_e04, a_e23, a_e31, a_e12, a_e41, a_e42, a_e43, a_e0324, a_e0134, a_e0214, a_e0123, a_e1234} K.Scalar{b_s}:
      {==}

