def Vector.anticommutator.Scalar.ok(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg), a: K.Vector<T>, b: K.Scalar<T>)
  -> {K.Vector.of_tree(~T, ~zero, ~neg, S.MV.anticommutator2(~T, ~add, ~mul, ~neg, 5n, K.STAP.sig(), K.Vector.tree(~T, ~neg, a), K.Scalar.tree(~T, ~neg, b))) == O.Vector.add.Vector(~T, ~zero, ~add, ~mul, ~neg, O.Vector.anticommutator.Scalar(~T, ~zero, ~add, ~mul, ~neg, a, b), O.Vector.anticommutator.Scalar(~T, ~zero, ~add, ~mul, ~neg, a, b)) : K.Vector<T>}:
  match a b:
    case K.Vector{+a_e0, +a_e1, +a_e2, +a_e3, +a_e4} K.Scalar{+b_s}:
