def Flector.dot.Pseudoscalar.Point.equiv(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  m: K.Flector<T>, a: K.Pseudoscalar<T>, b: K.Point<T>)
  -> {K.Line.fields(T, O.Pseudoscalar.dot.Point(~T, ~zero, ~add, ~mul, ~neg, O.Flector.transform.Pseudoscalar(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Flector.transform.Point(~T, ~zero, ~add, ~mul, ~neg, m, b)))
    == K.Line.fields(T, K.Line.map(~T, ~T, ~(x => mul(K.Motor.s(T, O.Flector.gp.Flector(~T, ~zero, ~add, ~mul, ~neg, m, O.Flector.reverse(~T, ~zero, ~neg, m))), x)), O.Flector.transform.Line(~T, ~zero, ~add, ~mul, ~neg, m, O.Pseudoscalar.dot.Point(~T, ~zero, ~add, ~mul, ~neg, a, b)))) : List<&2, T>}:
  match m a b:
    case K.Flector{m_e1, m_e2, m_e0, m_e012} K.Pseudoscalar{a_e012} K.Point{b_e20, b_e01, b_e12}:
      EQ.Rel.eqs(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [m_e1, m_e2, m_e0, m_e012, a_e012, b_e20, b_e01, b_e12],
        K.Line.fields(N.Tm, O.Pseudoscalar.dot.Point(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, O.Flector.transform.Pseudoscalar(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Flector{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}}, K.Pseudoscalar{N.TVar{4n}}), O.Flector.transform.Point(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Flector{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}}, K.Point{N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}))),
        K.Line.fields(N.Tm, K.Line.map(~N.Tm, ~N.Tm, ~(x => N.TMul{K.Motor.s(N.Tm, O.Flector.gp.Flector(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Flector{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}}, O.Flector.reverse(~N.Tm, ~N.TZero{}, ~N.Tm.neg, K.Flector{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}}))), x}), O.Flector.transform.Line(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Flector{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}}, O.Pseudoscalar.dot.Point(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Pseudoscalar{N.TVar{4n}}, K.Point{N.TVar{5n}, N.TVar{6n}, N.TVar{7n}})))),
        [N.TZero{},
         N.TZero{},
         N.TZero{}],
        N.TZero{}, {==}, {==})
