        neg(neg(mul(a_e01, b_e12))),
        neg(mul(neg(neg(a_e20)), b_e12)),
        add(mul(neg(neg(a_e20)), b_e01), neg(mul(a_e01, neg(neg(b_e20)))))}

def Direction.vee.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Direction<T>, b: K.Flector<T>) -> K.Translator<T>:
  match a b:
    case K.Direction{+a_e20, +a_e01} K.Flector{+b_e1, +b_e2, +b_e0, +b_e012}:
