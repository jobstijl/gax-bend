        mul(a_s, b_s),
        add(mul(a_e12, b_s), mul(a_s, b_e12))}

def Rotor.wedge.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Translator<T>) -> K.Motor<T>:
