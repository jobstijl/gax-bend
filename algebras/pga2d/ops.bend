def Multivector.conjugate(~T: Data, ~zero: T, ~neg: T -> T, a: K.Multivector<T>) -> K.Multivector<T>:
  match a:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012}:
      K.Multivector{
        a_s,
        neg(a_e0),
        neg(a_e1),
        neg(a_e2),
        neg(a_e01),
        neg(neg(neg(a_e20))),
        neg(a_e12),
        a_e012}

def Scalar.dual(~T: Data, ~zero: T, ~neg: T -> T, a: K.Scalar<T>) -> K.Pseudoscalar<T>:
  match a:
    case K.Scalar{+a_s}:
