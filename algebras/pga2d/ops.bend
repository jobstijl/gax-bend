        neg(a_e01),
        neg(a_e12)}

def Direction.conjugate(~T: Data, ~zero: T, ~neg: T -> T, a: K.Direction<T>) -> K.Point<T>:
  match a:
    case K.Direction{+a_e20, +a_e01}:
      K.Point{
