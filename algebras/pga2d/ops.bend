        add(mul(a_e12, neg(neg(b_e20))), neg(mul(neg(neg(a_e20)), b_e12))),
        add(mul(neg(neg(a_e20)), b_e01), neg(mul(a_e01, neg(neg(b_e20)))))}

def Point.vee.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Point<T>, b: K.Flector<T>) -> K.Motor<T>:
