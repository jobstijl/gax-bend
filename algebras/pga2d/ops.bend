  match a:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01}:
      K.Motor{
        a_s,
        neg(a_e12),
        neg(neg(neg(a_e20))),
        neg(a_e01)}

def Flector.conjugate(~T: Data, ~zero: T, ~neg: T -> T, a: K.Flector<T>) -> K.Flector<T>:
  match a:
