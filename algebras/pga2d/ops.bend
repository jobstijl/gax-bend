        add(mul(a_e12, neg(neg(b_e20))), neg(mul(neg(neg(a_e20)), b_e12))),
        add(mul(neg(neg(a_e20)), b_e01), neg(mul(a_e01, neg(neg(b_e20)))))}

def Motor.vee.Direction(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Direction<T>) -> K.Line<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Direction{+b_e20, +b_e01}:
      K.Line{
        neg(mul(a_e12, b_e01)),
        mul(a_e12, neg(neg(b_e20))),
        add(mul(neg(neg(a_e20)), b_e01), neg(mul(a_e01, neg(neg(b_e20)))))}

def Motor.vee.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Pseudoscalar<T>) -> K.Motor<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Pseudoscalar{+b_e012}:
      K.Motor{
        mul(a_s, b_e012),
        mul(a_e12, b_e012),
        neg(neg(mul(neg(neg(a_e20)), b_e012))),
        mul(a_e01, b_e012)}

def Motor.vee.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Rotor<T>) -> K.Line<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Rotor{+b_s, +b_e12}:
      K.Line{
        neg(neg(mul(a_e01, b_e12))),
        neg(mul(neg(neg(a_e20)), b_e12)),
        zero}

def Motor.vee.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Translator<T>) -> K.Line<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Translator{+b_s, +b_e20, +b_e01}:
      K.Line{
        neg(mul(a_e12, b_e01)),
        mul(a_e12, neg(neg(b_e20))),
        add(mul(neg(neg(a_e20)), b_e01), neg(mul(a_e01, neg(neg(b_e20)))))}

def Motor.vee.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Motor<T>) -> K.Line<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Motor{+b_s, +b_e12, +b_e20, +b_e01}:
      K.Line{
        neg(add(mul(a_e12, b_e01), neg(mul(a_e01, b_e12)))),
        add(mul(a_e12, neg(neg(b_e20))), neg(mul(neg(neg(a_e20)), b_e12))),
        add(mul(neg(neg(a_e20)), b_e01), neg(mul(a_e01, neg(neg(b_e20)))))}

def Motor.vee.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Flector<T>) -> K.Motor<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Flector{+b_e1, +b_e2, +b_e0, +b_e012}:
      K.Motor{
        add(add(mul(a_s, b_e012), mul(a_e12, b_e0)), add(neg(mul(neg(neg(a_e20)), neg(b_e1))), mul(a_e01, b_e2))),
        mul(a_e12, b_e012),
        neg(neg(mul(neg(neg(a_e20)), b_e012))),
        mul(a_e01, b_e012)}

def Motor.vee.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e01, +b_e20, +b_e12, +b_e012}:
      K.Multivector{
        add(add(mul(a_s, b_e012), mul(a_e12, b_e0)), add(neg(mul(neg(neg(a_e20)), neg(b_e1))), mul(a_e01, b_e2))),
        add(mul(neg(neg(a_e20)), b_e01), neg(mul(a_e01, neg(neg(b_e20))))),
        neg(add(mul(a_e12, b_e01), neg(mul(a_e01, b_e12)))),
        add(mul(a_e12, neg(neg(b_e20))), neg(mul(neg(neg(a_e20)), b_e12))),
        mul(a_e01, b_e012),
        neg(neg(mul(neg(neg(a_e20)), b_e012))),
        mul(a_e12, b_e012),
        zero}

def Flector.vee.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Scalar<T>) -> K.Scalar<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Scalar{+b_s}:
      K.Scalar{
        mul(a_e012, b_s)}

def Flector.vee.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Line<T>) -> K.Line<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Line{+b_e1, +b_e2, +b_e0}:
      K.Line{
        neg(mul(a_e012, neg(b_e1))),
        mul(a_e012, b_e2),
        mul(a_e012, b_e0)}

def Flector.vee.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Point<T>) -> K.Motor<T>:
