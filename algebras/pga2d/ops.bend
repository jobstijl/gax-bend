      K.Multivector{
        a_s,
        add(a_e0, b_e0),
        add(a_e1, b_e1),
        add(a_e2, b_e2),
        a_e01,
        neg(neg(a_e20)),
        a_e12,
        add(a_e012, b_e012)}

