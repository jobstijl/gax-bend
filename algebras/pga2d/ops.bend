def Multivector.vee.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e01, +b_e20, +b_e12, +b_e012}:
      K.Multivector{
        add(add(add(mul(a_s, b_e012), mul(a_e2, b_e01)), add(neg(mul(neg(a_e1), neg(neg(b_e20)))), mul(a_e12, b_e0))), add(add(mul(a_e0, b_e12), neg(mul(neg(neg(a_e20)), neg(b_e1)))), add(mul(a_e01, b_e2), mul(a_e012, b_s)))),
        add(add(mul(a_e0, b_e012), mul(neg(neg(a_e20)), b_e01)), add(neg(mul(a_e01, neg(neg(b_e20)))), mul(a_e012, b_e0))),
        neg(add(add(mul(neg(a_e1), b_e012), mul(a_e12, b_e01)), add(neg(mul(a_e01, b_e12)), mul(a_e012, neg(b_e1))))),
        add(add(mul(a_e2, b_e012), mul(a_e12, neg(neg(b_e20)))), add(neg(mul(neg(neg(a_e20)), b_e12)), mul(a_e012, b_e2))),
        add(mul(a_e01, b_e012), mul(a_e012, b_e01)),
        neg(neg(add(mul(neg(neg(a_e20)), b_e012), mul(a_e012, neg(neg(b_e20)))))),
        add(mul(a_e12, b_e012), mul(a_e012, b_e12)),
        mul(a_e012, b_e012)}

def Scalar.add.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Scalar<T>) -> K.Scalar<T>:
  match a b:
    case K.Scalar{+a_s} K.Scalar{+b_s}:
      K.Scalar{
        add(a_s, b_s)}

def Scalar.add.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Line<T>) -> K.Multivector<T>:
  match a b:
    case K.Scalar{+a_s} K.Line{+b_e1, +b_e2, +b_e0}:
      K.Multivector{
        a_s,
        b_e0,
        b_e1,
        b_e2,
        zero,
        zero,
        zero,
        zero}

def Scalar.add.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Point<T>) -> K.Motor<T>:
  match a b:
    case K.Scalar{+a_s} K.Point{+b_e20, +b_e01, +b_e12}:
      K.Motor{
        a_s,
        b_e12,
        neg(neg(b_e20)),
        b_e01}

def Scalar.add.Direction(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Direction<T>) -> K.Translator<T>:
