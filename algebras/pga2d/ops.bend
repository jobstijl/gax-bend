        add(mul(a_e01, b_s), mul(a_s, b_e01))}

def Motor.wedge.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Motor<T>) -> K.Motor<T>:
