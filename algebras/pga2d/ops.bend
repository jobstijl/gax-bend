def Line.add.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Line<T>, b: K.Pseudoscalar<T>) -> K.Flector<T>:
  match a b:
    case K.Line{+a_e1, +a_e2, +a_e0} K.Pseudoscalar{+b_e012}:
      K.Flector{
        a_e1,
        a_e2,
