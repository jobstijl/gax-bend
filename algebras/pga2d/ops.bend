        add(mul(a_e01, b_s), neg(mul(neg(a_e20), b_e12))),
        neg(add(mul(a_e01, b_e12), mul(neg(a_e20), b_s))),
        zero,
        add(mul(a_e01, b_e2), neg(mul(neg(a_e20), b_e1)))}

def Pseudoscalar.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Scalar<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Pseudoscalar{+a_e012} K.Scalar{+b_s}:
      K.Pseudoscalar{
        mul(a_e012, b_s)}

def Pseudoscalar.gp.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Line<T>) -> K.Point<T>:
  match a b:
    case K.Pseudoscalar{+a_e012} K.Line{+b_e1, +b_e2, +b_e0}:
      K.Point{
        neg(neg(mul(a_e012, b_e1))),
        mul(a_e012, b_e2),
        zero}

def Pseudoscalar.gp.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Point<T>) -> K.Line<T>:
  match a b:
    case K.Pseudoscalar{+a_e012} K.Point{+b_e20, +b_e01, +b_e12}:
      K.Line{
        zero,
        zero,
        neg(mul(a_e012, b_e12))}

def Pseudoscalar.gp.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Rotor<T>) -> K.Flector<T>:
  match a b:
    case K.Pseudoscalar{+a_e012} K.Rotor{+b_s, +b_e12}:
      K.Flector{
        zero,
        zero,
        neg(mul(a_e012, b_e12)),
        mul(a_e012, b_s)}

def Pseudoscalar.gp.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Translator<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Pseudoscalar{+a_e012} K.Translator{+b_s, +b_e20, +b_e01}:
      K.Pseudoscalar{
        mul(a_e012, b_s)}

def Pseudoscalar.gp.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Motor<T>) -> K.Flector<T>:
  match a b:
    case K.Pseudoscalar{+a_e012} K.Motor{+b_s, +b_e12, +b_e20, +b_e01}:
      K.Flector{
        zero,
        zero,
        neg(mul(a_e012, b_e12)),
        mul(a_e012, b_s)}

def Pseudoscalar.gp.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Flector<T>) -> K.Point<T>:
  match a b:
    case K.Pseudoscalar{+a_e012} K.Flector{+b_e1, +b_e2, +b_e0, +b_e012}:
      K.Point{
        neg(neg(mul(a_e012, b_e1))),
        mul(a_e012, b_e2),
        zero}

def Pseudoscalar.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Pseudoscalar{+a_e012} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e01, +b_e20, +b_e12, +b_e012}:
      K.Multivector{
        zero,
        neg(mul(a_e012, b_e12)),
        zero,
        zero,
        mul(a_e012, b_e2),
        neg(neg(mul(a_e012, b_e1))),
        zero,
        mul(a_e012, b_s)}

def Rotor.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Scalar<T>) -> K.Rotor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Scalar{+b_s}:
      K.Rotor{
        mul(a_s, b_s),
        mul(a_e12, b_s)}

def Rotor.gp.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Line<T>) -> K.Flector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Line{+b_e1, +b_e2, +b_e0}:
      K.Flector{
        add(mul(a_e12, b_e2), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), mul(a_s, b_e2)),
        mul(a_s, b_e0),
        mul(a_e12, b_e0)}

def Rotor.gp.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Point<T>) -> K.Motor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Point{+b_e20, +b_e01, +b_e12}:
      K.Motor{
        neg(mul(a_e12, b_e12)),
        mul(a_s, b_e12),
        neg(add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20)))),
        add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01))}

def Rotor.gp.Direction(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Direction<T>) -> K.Point<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Direction{+b_e20, +b_e01}:
      K.Point{
        neg(add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20)))),
        add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01)),
        zero}

def Rotor.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Pseudoscalar<T>) -> K.Flector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Pseudoscalar{+b_e012}:
      K.Flector{
        zero,
        zero,
        neg(mul(a_e12, b_e012)),
        mul(a_s, b_e012)}

def Rotor.gp.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Rotor<T>) -> K.Rotor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Rotor{+b_s, +b_e12}:
      K.Rotor{
        add(neg(mul(a_e12, b_e12)), mul(a_s, b_s)),
        add(mul(a_e12, b_s), mul(a_s, b_e12))}

def Rotor.gp.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Translator<T>) -> K.Motor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Translator{+b_s, +b_e20, +b_e01}:
      K.Motor{
        mul(a_s, b_s),
        mul(a_e12, b_s),
        neg(add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20)))),
        add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01))}

def Rotor.gp.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Motor<T>) -> K.Motor<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Motor{+b_s, +b_e12, +b_e20, +b_e01}:
      K.Motor{
        add(neg(mul(a_e12, b_e12)), mul(a_s, b_s)),
        add(mul(a_e12, b_s), mul(a_s, b_e12)),
        neg(add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20)))),
        add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01))}

def Rotor.gp.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Flector<T>) -> K.Flector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Flector{+b_e1, +b_e2, +b_e0, +b_e012}:
      K.Flector{
        add(mul(a_e12, b_e2), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), mul(a_s, b_e2)),
        add(neg(mul(a_e12, b_e012)), mul(a_s, b_e0)),
        add(mul(a_e12, b_e0), mul(a_s, b_e012))}

def Rotor.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Rotor<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Rotor{+a_s, +a_e12} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e01, +b_e20, +b_e12, +b_e012}:
      K.Multivector{
        add(neg(mul(a_e12, b_e12)), mul(a_s, b_s)),
        add(neg(mul(a_e12, b_e012)), mul(a_s, b_e0)),
        add(mul(a_e12, b_e2), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), mul(a_s, b_e2)),
        add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01)),
        neg(add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20)))),
        add(mul(a_e12, b_s), mul(a_s, b_e12)),
        add(mul(a_e12, b_e0), mul(a_s, b_e012))}

def Translator.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Scalar<T>) -> K.Translator<T>:
  match a b:
    case K.Translator{+a_s, +a_e20, +a_e01} K.Scalar{+b_s}:
      K.Translator{
        mul(a_s, b_s),
        neg(mul(neg(a_e20), b_s)),
        mul(a_e01, b_s)}

def Translator.gp.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Line<T>) -> K.Flector<T>:
  match a b:
    case K.Translator{+a_s, +a_e20, +a_e01} K.Line{+b_e1, +b_e2, +b_e0}:
      K.Flector{
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        add(add(mul(a_e01, b_e1), mul(neg(a_e20), b_e2)), mul(a_s, b_e0)),
        add(mul(a_e01, b_e2), neg(mul(neg(a_e20), b_e1)))}

def Translator.gp.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Point<T>) -> K.Point<T>:
  match a b:
    case K.Translator{+a_s, +a_e20, +a_e01} K.Point{+b_e20, +b_e01, +b_e12}:
      K.Point{
        neg(add(mul(a_e01, b_e12), mul(a_s, neg(b_e20)))),
        add(neg(mul(neg(a_e20), b_e12)), mul(a_s, b_e01)),
        mul(a_s, b_e12)}

def Translator.gp.Direction(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Direction<T>) -> K.Point<T>:
  match a b:
    case K.Translator{+a_s, +a_e20, +a_e01} K.Direction{+b_e20, +b_e01}:
      K.Point{
        neg(mul(a_s, neg(b_e20))),
        mul(a_s, b_e01),
        zero}

def Translator.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Pseudoscalar<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Translator{+a_s, +a_e20, +a_e01} K.Pseudoscalar{+b_e012}:
      K.Pseudoscalar{
        mul(a_s, b_e012)}

def Translator.gp.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Rotor<T>) -> K.Motor<T>:
  match a b:
    case K.Translator{+a_s, +a_e20, +a_e01} K.Rotor{+b_s, +b_e12}:
      K.Motor{
        mul(a_s, b_s),
        mul(a_s, b_e12),
        neg(add(mul(a_e01, b_e12), mul(neg(a_e20), b_s))),
        add(mul(a_e01, b_s), neg(mul(neg(a_e20), b_e12)))}

def Translator.gp.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Translator<T>) -> K.Translator<T>:
  match a b:
    case K.Translator{+a_s, +a_e20, +a_e01} K.Translator{+b_s, +b_e20, +b_e01}:
      K.Translator{
        mul(a_s, b_s),
        neg(add(mul(neg(a_e20), b_s), mul(a_s, neg(b_e20)))),
        add(mul(a_e01, b_s), mul(a_s, b_e01))}

def Translator.gp.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Motor<T>) -> K.Motor<T>:
  match a b:
    case K.Translator{+a_s, +a_e20, +a_e01} K.Motor{+b_s, +b_e12, +b_e20, +b_e01}:
      K.Motor{
        mul(a_s, b_s),
        mul(a_s, b_e12),
        neg(add(add(mul(a_e01, b_e12), mul(neg(a_e20), b_s)), mul(a_s, neg(b_e20)))),
        add(add(mul(a_e01, b_s), neg(mul(neg(a_e20), b_e12))), mul(a_s, b_e01))}

def Translator.gp.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Flector<T>) -> K.Flector<T>:
  match a b:
    case K.Translator{+a_s, +a_e20, +a_e01} K.Flector{+b_e1, +b_e2, +b_e0, +b_e012}:
      K.Flector{
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        add(add(mul(a_e01, b_e1), mul(neg(a_e20), b_e2)), mul(a_s, b_e0)),
        add(add(mul(a_e01, b_e2), neg(mul(neg(a_e20), b_e1))), mul(a_s, b_e012))}

def Translator.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Translator<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Translator{+a_s, +a_e20, +a_e01} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e01, +b_e20, +b_e12, +b_e012}:
      K.Multivector{
        mul(a_s, b_s),
        add(add(mul(a_e01, b_e1), mul(neg(a_e20), b_e2)), mul(a_s, b_e0)),
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        add(add(mul(a_e01, b_s), neg(mul(neg(a_e20), b_e12))), mul(a_s, b_e01)),
        neg(add(add(mul(a_e01, b_e12), mul(neg(a_e20), b_s)), mul(a_s, neg(b_e20)))),
        mul(a_s, b_e12),
        add(add(mul(a_e01, b_e2), neg(mul(neg(a_e20), b_e1))), mul(a_s, b_e012))}

def Motor.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Scalar<T>) -> K.Motor<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Scalar{+b_s}:
      K.Motor{
        mul(a_s, b_s),
        mul(a_e12, b_s),
        neg(mul(neg(a_e20), b_s)),
        mul(a_e01, b_s)}

def Motor.gp.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Line<T>) -> K.Flector<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Line{+b_e1, +b_e2, +b_e0}:
      K.Flector{
        add(mul(a_e12, b_e2), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), mul(a_s, b_e2)),
        add(add(mul(a_e01, b_e1), mul(neg(a_e20), b_e2)), mul(a_s, b_e0)),
        add(add(mul(a_e01, b_e2), neg(mul(neg(a_e20), b_e1))), mul(a_e12, b_e0))}

def Motor.gp.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Point<T>) -> K.Motor<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Point{+b_e20, +b_e01, +b_e12}:
      K.Motor{
        neg(mul(a_e12, b_e12)),
        mul(a_s, b_e12),
        neg(add(mul(a_e01, b_e12), add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20))))),
        add(neg(mul(neg(a_e20), b_e12)), add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01)))}

def Motor.gp.Direction(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Direction<T>) -> K.Point<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Direction{+b_e20, +b_e01}:
      K.Point{
        neg(add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20)))),
        add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01)),
        zero}

def Motor.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Pseudoscalar<T>) -> K.Flector<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Pseudoscalar{+b_e012}:
      K.Flector{
        zero,
        zero,
        neg(mul(a_e12, b_e012)),
        mul(a_s, b_e012)}

def Motor.gp.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Rotor<T>) -> K.Motor<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Rotor{+b_s, +b_e12}:
      K.Motor{
        add(neg(mul(a_e12, b_e12)), mul(a_s, b_s)),
        add(mul(a_e12, b_s), mul(a_s, b_e12)),
        neg(add(mul(a_e01, b_e12), mul(neg(a_e20), b_s))),
        add(mul(a_e01, b_s), neg(mul(neg(a_e20), b_e12)))}

def Motor.gp.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Translator<T>) -> K.Motor<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Translator{+b_s, +b_e20, +b_e01}:
      K.Motor{
        mul(a_s, b_s),
        mul(a_e12, b_s),
        neg(add(mul(neg(a_e20), b_s), add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20))))),
        add(mul(a_e01, b_s), add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01)))}

def Motor.gp.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Motor<T>) -> K.Motor<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Motor{+b_s, +b_e12, +b_e20, +b_e01}:
      K.Motor{
        add(neg(mul(a_e12, b_e12)), mul(a_s, b_s)),
        add(mul(a_e12, b_s), mul(a_s, b_e12)),
        neg(add(add(mul(a_e01, b_e12), mul(neg(a_e20), b_s)), add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20))))),
        add(add(mul(a_e01, b_s), neg(mul(neg(a_e20), b_e12))), add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01)))}

def Motor.gp.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Flector<T>) -> K.Flector<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Flector{+b_e1, +b_e2, +b_e0, +b_e012}:
      K.Flector{
        add(mul(a_e12, b_e2), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), mul(a_s, b_e2)),
        add(add(mul(a_e01, b_e1), mul(neg(a_e20), b_e2)), add(neg(mul(a_e12, b_e012)), mul(a_s, b_e0))),
        add(add(mul(a_e01, b_e2), neg(mul(neg(a_e20), b_e1))), add(mul(a_e12, b_e0), mul(a_s, b_e012)))}

def Motor.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Motor{+a_s, +a_e12, +a_e20, +a_e01} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e01, +b_e20, +b_e12, +b_e012}:
      K.Multivector{
        add(neg(mul(a_e12, b_e12)), mul(a_s, b_s)),
        add(add(mul(a_e01, b_e1), mul(neg(a_e20), b_e2)), add(neg(mul(a_e12, b_e012)), mul(a_s, b_e0))),
        add(mul(a_e12, b_e2), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), mul(a_s, b_e2)),
        add(add(mul(a_e01, b_s), neg(mul(neg(a_e20), b_e12))), add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01))),
        neg(add(add(mul(a_e01, b_e12), mul(neg(a_e20), b_s)), add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20))))),
        add(mul(a_e12, b_s), mul(a_s, b_e12)),
        add(add(mul(a_e01, b_e2), neg(mul(neg(a_e20), b_e1))), add(mul(a_e12, b_e0), mul(a_s, b_e012)))}

def Flector.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Scalar<T>) -> K.Flector<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Scalar{+b_s}:
      K.Flector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e0, b_s),
        mul(a_e012, b_s)}

def Flector.gp.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Line<T>) -> K.Motor<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Line{+b_e1, +b_e2, +b_e0}:
      K.Motor{
        add(mul(a_e1, b_e1), mul(a_e2, b_e2)),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1))),
        neg(add(add(neg(mul(a_e012, b_e1)), mul(a_e0, b_e2)), neg(mul(a_e2, b_e0)))),
        add(add(mul(a_e012, b_e2), mul(a_e0, b_e1)), neg(mul(a_e1, b_e0)))}

def Flector.gp.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Point<T>) -> K.Flector<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Point{+b_e20, +b_e01, +b_e12}:
      K.Flector{
        neg(mul(a_e2, b_e12)),
        mul(a_e1, b_e12),
        add(neg(mul(a_e012, b_e12)), add(neg(mul(a_e1, b_e01)), neg(mul(a_e2, neg(b_e20))))),
        add(mul(a_e0, b_e12), add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01)))}

def Flector.gp.Direction(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Direction<T>) -> K.Flector<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Direction{+b_e20, +b_e01}:
      K.Flector{
        zero,
        zero,
        add(neg(mul(a_e1, b_e01)), neg(mul(a_e2, neg(b_e20)))),
        add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01))}

def Flector.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Pseudoscalar<T>) -> K.Point<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Pseudoscalar{+b_e012}:
      K.Point{
        neg(neg(mul(a_e1, b_e012))),
        mul(a_e2, b_e012),
        zero}

def Flector.gp.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Rotor<T>) -> K.Flector<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Rotor{+b_s, +b_e12}:
      K.Flector{
        add(mul(a_e1, b_s), neg(mul(a_e2, b_e12))),
        add(mul(a_e1, b_e12), mul(a_e2, b_s)),
        add(neg(mul(a_e012, b_e12)), mul(a_e0, b_s)),
        add(mul(a_e012, b_s), mul(a_e0, b_e12))}

def Flector.gp.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Translator<T>) -> K.Flector<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Translator{+b_s, +b_e20, +b_e01}:
      K.Flector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        add(mul(a_e0, b_s), add(neg(mul(a_e1, b_e01)), neg(mul(a_e2, neg(b_e20))))),
        add(mul(a_e012, b_s), add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01)))}

def Flector.gp.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Motor<T>) -> K.Flector<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Motor{+b_s, +b_e12, +b_e20, +b_e01}:
      K.Flector{
        add(mul(a_e1, b_s), neg(mul(a_e2, b_e12))),
        add(mul(a_e1, b_e12), mul(a_e2, b_s)),
        add(add(neg(mul(a_e012, b_e12)), mul(a_e0, b_s)), add(neg(mul(a_e1, b_e01)), neg(mul(a_e2, neg(b_e20))))),
        add(add(mul(a_e012, b_s), mul(a_e0, b_e12)), add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01)))}

def Flector.gp.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Flector<T>) -> K.Motor<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Flector{+b_e1, +b_e2, +b_e0, +b_e012}:
      K.Motor{
        add(mul(a_e1, b_e1), mul(a_e2, b_e2)),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1))),
        neg(add(add(neg(mul(a_e012, b_e1)), mul(a_e0, b_e2)), add(neg(mul(a_e1, b_e012)), neg(mul(a_e2, b_e0))))),
        add(add(mul(a_e012, b_e2), mul(a_e0, b_e1)), add(neg(mul(a_e1, b_e0)), mul(a_e2, b_e012)))}

def Flector.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e01, +b_e20, +b_e12, +b_e012}:
      K.Multivector{
        add(mul(a_e1, b_e1), mul(a_e2, b_e2)),
        add(add(neg(mul(a_e012, b_e12)), mul(a_e0, b_s)), add(neg(mul(a_e1, b_e01)), neg(mul(a_e2, neg(b_e20))))),
        add(mul(a_e1, b_s), neg(mul(a_e2, b_e12))),
        add(mul(a_e1, b_e12), mul(a_e2, b_s)),
        add(add(mul(a_e012, b_e2), mul(a_e0, b_e1)), add(neg(mul(a_e1, b_e0)), mul(a_e2, b_e012))),
        neg(add(add(neg(mul(a_e012, b_e1)), mul(a_e0, b_e2)), add(neg(mul(a_e1, b_e012)), neg(mul(a_e2, b_e0))))),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1))),
        add(add(mul(a_e012, b_s), mul(a_e0, b_e12)), add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01)))}

def Multivector.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Scalar<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Scalar{+b_s}:
      K.Multivector{
        mul(a_s, b_s),
        mul(a_e0, b_s),
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e01, b_s),
        neg(mul(neg(a_e20), b_s)),
        mul(a_e12, b_s),
        mul(a_e012, b_s)}

def Multivector.gp.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Line<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Line{+b_e1, +b_e2, +b_e0}:
      K.Multivector{
        add(mul(a_e1, b_e1), mul(a_e2, b_e2)),
        add(add(mul(a_e01, b_e1), mul(neg(a_e20), b_e2)), mul(a_s, b_e0)),
        add(mul(a_e12, b_e2), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), mul(a_s, b_e2)),
        add(add(mul(a_e012, b_e2), mul(a_e0, b_e1)), neg(mul(a_e1, b_e0))),
        neg(add(add(neg(mul(a_e012, b_e1)), mul(a_e0, b_e2)), neg(mul(a_e2, b_e0)))),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1))),
        add(add(mul(a_e01, b_e2), neg(mul(neg(a_e20), b_e1))), mul(a_e12, b_e0))}

def Multivector.gp.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Point<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Point{+b_e20, +b_e01, +b_e12}:
      K.Multivector{
        neg(mul(a_e12, b_e12)),
        add(neg(mul(a_e012, b_e12)), add(neg(mul(a_e1, b_e01)), neg(mul(a_e2, neg(b_e20))))),
        neg(mul(a_e2, b_e12)),
        mul(a_e1, b_e12),
        add(neg(mul(neg(a_e20), b_e12)), add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01))),
        neg(add(mul(a_e01, b_e12), add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20))))),
        mul(a_s, b_e12),
        add(mul(a_e0, b_e12), add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01)))}

def Multivector.gp.Direction(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Direction<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Direction{+b_e20, +b_e01}:
      K.Multivector{
        zero,
        add(neg(mul(a_e1, b_e01)), neg(mul(a_e2, neg(b_e20)))),
        zero,
        zero,
        add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01)),
        neg(add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20)))),
        zero,
        add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01))}

def Multivector.gp.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Pseudoscalar<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Pseudoscalar{+b_e012}:
      K.Multivector{
        zero,
        neg(mul(a_e12, b_e012)),
        zero,
        zero,
        mul(a_e2, b_e012),
        neg(neg(mul(a_e1, b_e012))),
        zero,
        mul(a_s, b_e012)}

def Multivector.gp.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Rotor<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Rotor{+b_s, +b_e12}:
      K.Multivector{
        add(neg(mul(a_e12, b_e12)), mul(a_s, b_s)),
        add(neg(mul(a_e012, b_e12)), mul(a_e0, b_s)),
        add(mul(a_e1, b_s), neg(mul(a_e2, b_e12))),
        add(mul(a_e1, b_e12), mul(a_e2, b_s)),
        add(mul(a_e01, b_s), neg(mul(neg(a_e20), b_e12))),
        neg(add(mul(a_e01, b_e12), mul(neg(a_e20), b_s))),
        add(mul(a_e12, b_s), mul(a_s, b_e12)),
        add(mul(a_e012, b_s), mul(a_e0, b_e12))}

def Multivector.gp.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Translator<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Translator{+b_s, +b_e20, +b_e01}:
      K.Multivector{
        mul(a_s, b_s),
        add(mul(a_e0, b_s), add(neg(mul(a_e1, b_e01)), neg(mul(a_e2, neg(b_e20))))),
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        add(mul(a_e01, b_s), add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01))),
        neg(add(mul(neg(a_e20), b_s), add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20))))),
        mul(a_e12, b_s),
        add(mul(a_e012, b_s), add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01)))}

def Multivector.gp.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Motor<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Motor{+b_s, +b_e12, +b_e20, +b_e01}:
      K.Multivector{
        add(neg(mul(a_e12, b_e12)), mul(a_s, b_s)),
        add(add(neg(mul(a_e012, b_e12)), mul(a_e0, b_s)), add(neg(mul(a_e1, b_e01)), neg(mul(a_e2, neg(b_e20))))),
        add(mul(a_e1, b_s), neg(mul(a_e2, b_e12))),
        add(mul(a_e1, b_e12), mul(a_e2, b_s)),
        add(add(mul(a_e01, b_s), neg(mul(neg(a_e20), b_e12))), add(mul(a_e12, neg(b_e20)), mul(a_s, b_e01))),
        neg(add(add(mul(a_e01, b_e12), mul(neg(a_e20), b_s)), add(neg(mul(a_e12, b_e01)), mul(a_s, neg(b_e20))))),
        add(mul(a_e12, b_s), mul(a_s, b_e12)),
        add(add(mul(a_e012, b_s), mul(a_e0, b_e12)), add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01)))}

def Multivector.gp.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Flector<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Flector{+b_e1, +b_e2, +b_e0, +b_e012}:
      K.Multivector{
        add(mul(a_e1, b_e1), mul(a_e2, b_e2)),
        add(add(mul(a_e01, b_e1), mul(neg(a_e20), b_e2)), add(neg(mul(a_e12, b_e012)), mul(a_s, b_e0))),
        add(mul(a_e12, b_e2), mul(a_s, b_e1)),
        add(neg(mul(a_e12, b_e1)), mul(a_s, b_e2)),
        add(add(mul(a_e012, b_e2), mul(a_e0, b_e1)), add(neg(mul(a_e1, b_e0)), mul(a_e2, b_e012))),
        neg(add(add(neg(mul(a_e012, b_e1)), mul(a_e0, b_e2)), add(neg(mul(a_e1, b_e012)), neg(mul(a_e2, b_e0))))),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1))),
        add(add(mul(a_e01, b_e2), neg(mul(neg(a_e20), b_e1))), add(mul(a_e12, b_e0), mul(a_s, b_e012)))}

def Multivector.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e01, +b_e20, +b_e12, +b_e012}:
      K.Multivector{
        add(add(neg(mul(a_e12, b_e12)), mul(a_e1, b_e1)), add(mul(a_e2, b_e2), mul(a_s, b_s))),
        add(add(add(neg(mul(a_e012, b_e12)), mul(a_e01, b_e1)), add(mul(neg(a_e20), b_e2), mul(a_e0, b_s))), add(add(neg(mul(a_e12, b_e012)), neg(mul(a_e1, b_e01))), add(neg(mul(a_e2, neg(b_e20))), mul(a_s, b_e0)))),
        add(add(mul(a_e12, b_e2), mul(a_e1, b_s)), add(neg(mul(a_e2, b_e12)), mul(a_s, b_e1))),
        add(add(neg(mul(a_e12, b_e1)), mul(a_e1, b_e12)), add(mul(a_e2, b_s), mul(a_s, b_e2))),
        add(add(add(mul(a_e012, b_e2), mul(a_e01, b_s)), add(neg(mul(neg(a_e20), b_e12)), mul(a_e0, b_e1))), add(add(mul(a_e12, neg(b_e20)), neg(mul(a_e1, b_e0))), add(mul(a_e2, b_e012), mul(a_s, b_e01)))),
        neg(add(add(add(neg(mul(a_e012, b_e1)), mul(a_e01, b_e12)), add(mul(neg(a_e20), b_s), mul(a_e0, b_e2))), add(add(neg(mul(a_e12, b_e01)), neg(mul(a_e1, b_e012))), add(neg(mul(a_e2, b_e0)), mul(a_s, neg(b_e20)))))),
        add(add(mul(a_e12, b_s), mul(a_e1, b_e2)), add(neg(mul(a_e2, b_e1)), mul(a_s, b_e12))),
        add(add(add(mul(a_e012, b_s), mul(a_e01, b_e2)), add(neg(mul(neg(a_e20), b_e1)), mul(a_e0, b_e12))), add(add(mul(a_e12, b_e0), neg(mul(a_e1, neg(b_e20)))), add(mul(a_e2, b_e01), mul(a_s, b_e012))))}

