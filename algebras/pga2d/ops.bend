        b_e01}

def Scalar.add.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Pseudoscalar<T>) -> K.Multivector<T>:
  match a b:
    case K.Scalar{+a_s} K.Pseudoscalar{+b_e012}:
      K.Multivector{
