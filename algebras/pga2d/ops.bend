        neg(a_e012)}

def Scalar.conjugate(~T: Data, ~zero: T, ~neg: T -> T, a: K.Scalar<T>) -> K.Scalar<T>:
  match a:
    case K.Scalar{+a_s}:
      K.Scalar{
        a_s}

def Line.conjugate(~T: Data, ~zero: T, ~neg: T -> T, a: K.Line<T>) -> K.Line<T>:
  match a:
    case K.Line{+a_e1, +a_e2, +a_e0}:
