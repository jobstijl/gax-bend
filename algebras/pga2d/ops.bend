        neg(add(mul(neg(a_e20), b_s), mul(a_s, neg(b_e20)))),
        mul(a_s, b_e12),
        add(add(mul(a_e01, b_e2), neg(mul(neg(a_e20), b_e1))), mul(a_s, b_e012))}

def Motor.wedge.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Scalar<T>) -> K.Motor<T>:
