  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Scalar{+b_s}:
      K.Flector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e0, b_s),
        mul(a_e012, b_s)}

def Flector.wedge.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Line<T>) -> K.Point<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Line{+b_e1, +b_e2, +b_e0}:
      K.Point{
        neg(add(mul(a_e0, b_e2), neg(mul(a_e2, b_e0)))),
        add(mul(a_e0, b_e1), neg(mul(a_e1, b_e0))),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1)))}

def Flector.wedge.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Point<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Point{+b_e20, +b_e01, +b_e12}:
      K.Pseudoscalar{
        add(mul(a_e0, b_e12), add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01)))}

def Flector.wedge.Direction(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Direction<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Direction{+b_e20, +b_e01}:
      K.Pseudoscalar{
        add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01))}

def Flector.wedge.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Rotor<T>) -> K.Flector<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Rotor{+b_s, +b_e12}:
      K.Flector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e0, b_s),
        add(mul(a_e012, b_s), mul(a_e0, b_e12))}

def Flector.wedge.Translator(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Translator<T>) -> K.Flector<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Translator{+b_s, +b_e20, +b_e01}:
      K.Flector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e0, b_s),
        add(mul(a_e012, b_s), add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01)))}

def Flector.wedge.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Motor<T>) -> K.Flector<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Motor{+b_s, +b_e12, +b_e20, +b_e01}:
      K.Flector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e0, b_s),
        add(add(mul(a_e012, b_s), mul(a_e0, b_e12)), add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01)))}

def Flector.wedge.Flector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Flector<T>) -> K.Point<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Flector{+b_e1, +b_e2, +b_e0, +b_e012}:
      K.Point{
        neg(add(mul(a_e0, b_e2), neg(mul(a_e2, b_e0)))),
        add(mul(a_e0, b_e1), neg(mul(a_e1, b_e0))),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1)))}

def Flector.wedge.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Flector<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Flector{+a_e1, +a_e2, +a_e0, +a_e012} K.Multivector{+b_s, +b_e0, +b_e1, +b_e2, +b_e01, +b_e20, +b_e12, +b_e012}:
      K.Multivector{
        zero,
        mul(a_e0, b_s),
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        add(mul(a_e0, b_e1), neg(mul(a_e1, b_e0))),
        neg(add(mul(a_e0, b_e2), neg(mul(a_e2, b_e0)))),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1))),
        add(add(mul(a_e012, b_s), mul(a_e0, b_e12)), add(neg(mul(a_e1, neg(b_e20))), mul(a_e2, b_e01)))}

def Multivector.wedge.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Scalar<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Scalar{+b_s}:
      K.Multivector{
        mul(a_s, b_s),
        mul(a_e0, b_s),
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e01, b_s),
        neg(mul(neg(a_e20), b_s)),
        mul(a_e12, b_s),
        mul(a_e012, b_s)}

def Multivector.wedge.Line(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Line<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Line{+b_e1, +b_e2, +b_e0}:
      K.Multivector{
        zero,
        mul(a_s, b_e0),
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        add(mul(a_e0, b_e1), neg(mul(a_e1, b_e0))),
        neg(add(mul(a_e0, b_e2), neg(mul(a_e2, b_e0)))),
        add(mul(a_e1, b_e2), neg(mul(a_e2, b_e1))),
        add(add(mul(a_e01, b_e2), neg(mul(neg(a_e20), b_e1))), mul(a_e12, b_e0))}

def Multivector.wedge.Point(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Point<T>) -> K.Multivector<T>:
