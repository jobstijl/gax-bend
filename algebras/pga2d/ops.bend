        b_e012}

def Scalar.add.Rotor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Rotor<T>) -> K.Rotor<T>:
  match a b:
    case K.Scalar{+a_s} K.Rotor{+b_s, +b_e12}:
