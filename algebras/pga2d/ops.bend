    case K.Multivector{+a_s, +a_e0, +a_e1, +a_e2, +a_e01, +a_e20, +a_e12, +a_e012} K.Motor{+b_s, +b_e12, +b_e20, +b_e01}:
      K.Multivector{
        add(a_s, b_s),
        a_e0,
        a_e1,
        a_e2,
        add(a_e01, b_e01),
        neg(add(neg(a_e20), neg(b_e20))),
        add(a_e12, b_e12),
        a_e012}

