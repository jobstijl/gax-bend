        mul(a_s, b_s),
        add(mul(a_e0, b_s), mul(a_s, b_e0)),
        add(mul(a_e1, b_s), mul(a_s, b_e1)),
        add(mul(a_e2, b_s), mul(a_s, b_e2)),
        add(add(mul(a_e01, b_s), mul(a_e0, b_e1)), add(neg(mul(a_e1, b_e0)), mul(a_s, b_e01))),
        neg(add(add(mul(neg(a_e20), b_s), mul(a_e0, b_e2)), add(neg(mul(a_e2, b_e0)), mul(a_s, neg(b_e20))))),
        add(add(mul(a_e12, b_s), mul(a_e1, b_e2)), add(neg(mul(a_e2, b_e1)), mul(a_s, b_e12))),
        add(add(add(mul(a_e012, b_s), mul(a_e01, b_e2)), add(neg(mul(neg(a_e20), b_e1)), mul(a_e0, b_e12))), add(add(mul(a_e12, b_e0), neg(mul(a_e1, neg(b_e20)))), add(mul(a_e2, b_e01), mul(a_s, b_e012))))}

