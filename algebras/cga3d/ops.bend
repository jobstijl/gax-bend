        mul(a_s, b_eo),
        mul(a_s, b_ei),
        mul(a_s, b_e23),
        mul(a_s, b_e31),
        mul(a_s, b_e12),
        mul(a_s, b_e1o),
        mul(a_s, b_e2o),
        mul(a_s, b_e3o),
        mul(a_s, b_e1i),
        mul(a_s, b_e2i),
        mul(a_s, b_e3i),
        mul(a_s, b_eoi),
