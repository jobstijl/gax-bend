      K.Odd{
        add(add(neg(mul(a_e3i, b_e31o)), mul(a_e2i, b_e12o)), neg(mul(a_e23, b_e123))),
        add(add(mul(a_e3i, b_e23o), neg(mul(a_e1i, b_e12o))), neg(mul(a_e31, b_e123))),
        add(add(neg(mul(a_e2i, b_e23o)), mul(a_e1i, b_e31o)), neg(mul(a_e12, b_e123))),
        add(add(neg(mul(a_e12, b_e12o)), neg(mul(a_e31, b_e31o))), neg(mul(a_e23, b_e23o))),
        add(add(add(add(add(mul(a_e3i, b_e3oi), mul(a_e2i, b_e2oi)), mul(a_e1i, b_e1oi)), neg(mul(a_e12, b_e12i))), neg(mul(a_e31, b_e31i))), neg(mul(a_e23, b_e23i))),
        mul(a_s, b_e23o),
        mul(a_s, b_e31o),
        mul(a_s, b_e12o),
        add(mul(a_e123i, b_e1oi), mul(a_s, b_e23i)),
        add(mul(a_e123i, b_e2oi), mul(a_s, b_e31i)),
        add(mul(a_e123i, b_e3oi), mul(a_s, b_e12i)),
        add(mul(a_e123i, b_e23o), mul(a_s, b_e1oi)),
        add(mul(a_e123i, b_e31o), mul(a_s, b_e2oi)),
        add(mul(a_e123i, b_e12o), mul(a_s, b_e3oi)),
        mul(a_s, b_e123),
        add(add(add(add(add(neg(mul(a_e3i, b_e12o)), neg(mul(a_e2i, b_e31o))), neg(mul(a_e1i, b_e23o))), mul(a_e12, b_e3oi)), mul(a_e31, b_e2oi)), mul(a_e23, b_e1oi))}

