def Quadvector.commutator.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Twist<T>) -> K.Quadvector<T>:
