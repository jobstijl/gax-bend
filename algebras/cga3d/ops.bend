      K.Odd{
        add(add(add(neg(mul(a_e1i, b_eo)), mul(a_e12, b_e2)), neg(mul(a_e31, b_e3))), mul(a_s, b_e1)),
        add(add(add(neg(mul(a_e2i, b_eo)), neg(mul(a_e12, b_e1))), mul(a_e23, b_e3)), mul(a_s, b_e2)),
        add(add(add(neg(mul(a_e3i, b_eo)), mul(a_e31, b_e1)), neg(mul(a_e23, b_e2))), mul(a_s, b_e3)),
        mul(a_s, b_eo),
        add(add(add(neg(mul(a_e3i, b_e3)), neg(mul(a_e2i, b_e2))), neg(mul(a_e1i, b_e1))), mul(a_s, b_ei)),
        zero,
        zero,
        zero,
        neg(mul(a_e123i, b_e1)),
        neg(mul(a_e123i, b_e2)),
        neg(mul(a_e123i, b_e3)),
        zero,
        zero,
        zero,
