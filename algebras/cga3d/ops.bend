def Quadvector.commutator.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Vector<T>) -> K.Trivector<T>:
  match a b:
