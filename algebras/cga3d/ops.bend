      +q1_6 = mul(a_e23, a_e3i)
      +q0_5 = mul(a_s, a_e2i)
      +q3_5 = mul(a_e12, a_e2i)
      +q2_6 = mul(a_e31, a_e3i)
      +q1_7 = mul(a_e23, a_e123i)
      +q0_4 = mul(a_s, a_e1i)
      +m0_0 = add(add(add(neg(q3_3), neg(q2_2)), q1_1), q0_0)
      +m0_1 = add(add(add(q1_2, q1_2), q0_3), q0_3)
      +m0_2 = add(add(add(q1_3, q1_3), neg(q0_2)), neg(q0_2))
      +m1_0 = add(add(add(q1_2, q1_2), neg(q0_3)), neg(q0_3))
      +m1_1 = add(add(add(neg(q3_3), q2_2), neg(q1_1)), q0_0)
      +m1_2 = add(add(add(q2_3, q2_3), q0_1), q0_1)
      +m2_0 = add(add(add(q1_3, q1_3), q0_2), q0_2)
      +m2_1 = add(add(add(q2_3, q2_3), neg(q0_1)), neg(q0_1))
      +m2_2 = add(add(add(q3_3, neg(q2_2)), neg(q1_1)), q0_0)
      +m3_0 = add(add(add(add(add(add(add(neg(q3_6), neg(q3_6)), neg(q2_5)), neg(q2_5)), q1_4), q1_4), neg(q0_7)), neg(q0_7))
      +m3_1 = add(add(add(add(add(add(add(neg(q3_7), neg(q3_7)), q2_4), q2_4), q1_5), q1_5), q0_6), q0_6)
      +m3_2 = add(add(add(add(add(add(add(q3_4, q3_4), q2_7), q2_7), q1_6), q1_6), neg(q0_5)), neg(q0_5))
      +m3_3 = add(add(add(neg(q3_3), neg(q2_2)), q1_1), q0_0)
      +m3_4 = add(add(add(q1_2, q1_2), q0_3), q0_3)
      +m3_5 = add(add(add(q1_3, q1_3), neg(q0_2)), neg(q0_2))
      +m4_0 = add(add(add(add(add(add(add(q3_7, q3_7), q2_4), q2_4), q1_5), q1_5), neg(q0_6)), neg(q0_6))
      +m4_1 = add(add(add(add(add(add(add(neg(q3_6), neg(q3_6)), q2_5), q2_5), neg(q1_4)), neg(q1_4)), neg(q0_7)), neg(q0_7))
      +m4_2 = add(add(add(add(add(add(add(q3_5, q3_5), q2_6), q2_6), neg(q1_7)), neg(q1_7)), q0_4), q0_4)
      +m4_3 = add(add(add(q1_2, q1_2), neg(q0_3)), neg(q0_3))
      +m4_4 = add(add(add(neg(q3_3), q2_2), neg(q1_1)), q0_0)
      +m4_5 = add(add(add(q2_3, q2_3), q0_1), q0_1)
      +m5_0 = add(add(add(add(add(add(add(q3_4, q3_4), neg(q2_7)), neg(q2_7)), q1_6), q1_6), q0_5), q0_5)
      +m5_1 = add(add(add(add(add(add(add(q3_5, q3_5), q2_6), q2_6), q1_7), q1_7), neg(q0_4)), neg(q0_4))
      +m5_2 = add(add(add(add(add(add(add(q3_6, q3_6), neg(q2_5)), neg(q2_5)), neg(q1_4)), neg(q1_4)), neg(q0_7)), neg(q0_7))
      +m5_3 = add(add(add(q1_3, q1_3), q0_2), q0_2)
      +m5_4 = add(add(add(q2_3, q2_3), neg(q0_1)), neg(q0_1))
      +m5_5 = add(add(add(q3_3, neg(q2_2)), neg(q1_1)), q0_0)
      K.Twist{
        add(mul(b_e23, m0_0), add(mul(b_e31, m0_1), mul(b_e12, m0_2))),
        add(mul(b_e23, m1_0), add(mul(b_e31, m1_1), mul(b_e12, m1_2))),
        add(mul(b_e23, m2_0), add(mul(b_e31, m2_1), mul(b_e12, m2_2))),
        add(mul(b_e23, m3_0), add(mul(b_e31, m3_1), add(mul(b_e12, m3_2), add(mul(b_e1i, m3_3), add(mul(b_e2i, m3_4), mul(b_e3i, m3_5)))))),
        add(mul(b_e23, m4_0), add(mul(b_e31, m4_1), add(mul(b_e12, m4_2), add(mul(b_e1i, m4_3), add(mul(b_e2i, m4_4), mul(b_e3i, m4_5)))))),
        add(mul(b_e23, m5_0), add(mul(b_e31, m5_1), add(mul(b_e12, m5_2), add(mul(b_e1i, m5_3), add(mul(b_e2i, m5_4), mul(b_e3i, m5_5))))))}

type MotorTwistMap<-T: Data> is Data:
  MotorTwistMap{m0_0: T, m0_1: T, m0_2: T, m1_0: T, m1_1: T, m1_2: T, m2_0: T, m2_1: T, m2_2: T, m3_0: T, m3_1: T, m3_2: T, m3_3: T, m3_4: T, m3_5: T, m4_0: T, m4_1: T, m4_2: T, m4_3: T, m4_4: T, m4_5: T, m5_0: T, m5_1: T, m5_2: T, m5_3: T, m5_4: T, m5_5: T}

def Motor.prepare.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>) -> MotorTwistMap<T>:
  match a:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i}:
      +q3_3 = mul(a_e12, a_e12)
      +q2_2 = mul(a_e31, a_e31)
      +q1_1 = mul(a_e23, a_e23)
      +q0_0 = mul(a_s, a_s)
      +q1_2 = mul(a_e23, a_e31)
      +q0_3 = mul(a_s, a_e12)
      +q1_3 = mul(a_e23, a_e12)
      +q0_2 = mul(a_s, a_e31)
      +q2_3 = mul(a_e31, a_e12)
      +q0_1 = mul(a_s, a_e23)
      +q3_6 = mul(a_e12, a_e3i)
      +q2_5 = mul(a_e31, a_e2i)
      +q1_4 = mul(a_e23, a_e1i)
      +q0_7 = mul(a_s, a_e123i)
      +q3_7 = mul(a_e12, a_e123i)
      +q2_4 = mul(a_e31, a_e1i)
      +q1_5 = mul(a_e23, a_e2i)
      +q0_6 = mul(a_s, a_e3i)
      +q3_4 = mul(a_e12, a_e1i)
      +q2_7 = mul(a_e31, a_e123i)
      +q1_6 = mul(a_e23, a_e3i)
      +q0_5 = mul(a_s, a_e2i)
      +q3_5 = mul(a_e12, a_e2i)
      +q2_6 = mul(a_e31, a_e3i)
      +q1_7 = mul(a_e23, a_e123i)
      +q0_4 = mul(a_s, a_e1i)
      +m0_0 = add(add(add(neg(q3_3), neg(q2_2)), q1_1), q0_0)
      +m0_1 = add(add(add(q1_2, q1_2), q0_3), q0_3)
      +m0_2 = add(add(add(q1_3, q1_3), neg(q0_2)), neg(q0_2))
      +m1_0 = add(add(add(q1_2, q1_2), neg(q0_3)), neg(q0_3))
      +m1_1 = add(add(add(neg(q3_3), q2_2), neg(q1_1)), q0_0)
      +m1_2 = add(add(add(q2_3, q2_3), q0_1), q0_1)
      +m2_0 = add(add(add(q1_3, q1_3), q0_2), q0_2)
      +m2_1 = add(add(add(q2_3, q2_3), neg(q0_1)), neg(q0_1))
      +m2_2 = add(add(add(q3_3, neg(q2_2)), neg(q1_1)), q0_0)
      +m3_0 = add(add(add(add(add(add(add(neg(q3_6), neg(q3_6)), neg(q2_5)), neg(q2_5)), q1_4), q1_4), neg(q0_7)), neg(q0_7))
      +m3_1 = add(add(add(add(add(add(add(neg(q3_7), neg(q3_7)), q2_4), q2_4), q1_5), q1_5), q0_6), q0_6)
      +m3_2 = add(add(add(add(add(add(add(q3_4, q3_4), q2_7), q2_7), q1_6), q1_6), neg(q0_5)), neg(q0_5))
      +m3_3 = add(add(add(neg(q3_3), neg(q2_2)), q1_1), q0_0)
      +m3_4 = add(add(add(q1_2, q1_2), q0_3), q0_3)
      +m3_5 = add(add(add(q1_3, q1_3), neg(q0_2)), neg(q0_2))
      +m4_0 = add(add(add(add(add(add(add(q3_7, q3_7), q2_4), q2_4), q1_5), q1_5), neg(q0_6)), neg(q0_6))
      +m4_1 = add(add(add(add(add(add(add(neg(q3_6), neg(q3_6)), q2_5), q2_5), neg(q1_4)), neg(q1_4)), neg(q0_7)), neg(q0_7))
      +m4_2 = add(add(add(add(add(add(add(q3_5, q3_5), q2_6), q2_6), neg(q1_7)), neg(q1_7)), q0_4), q0_4)
      +m4_3 = add(add(add(q1_2, q1_2), neg(q0_3)), neg(q0_3))
      +m4_4 = add(add(add(neg(q3_3), q2_2), neg(q1_1)), q0_0)
      +m4_5 = add(add(add(q2_3, q2_3), q0_1), q0_1)
      +m5_0 = add(add(add(add(add(add(add(q3_4, q3_4), neg(q2_7)), neg(q2_7)), q1_6), q1_6), q0_5), q0_5)
      +m5_1 = add(add(add(add(add(add(add(q3_5, q3_5), q2_6), q2_6), q1_7), q1_7), neg(q0_4)), neg(q0_4))
      +m5_2 = add(add(add(add(add(add(add(q3_6, q3_6), neg(q2_5)), neg(q2_5)), neg(q1_4)), neg(q1_4)), neg(q0_7)), neg(q0_7))
      +m5_3 = add(add(add(q1_3, q1_3), q0_2), q0_2)
      +m5_4 = add(add(add(q2_3, q2_3), neg(q0_1)), neg(q0_1))
      +m5_5 = add(add(add(q3_3, neg(q2_2)), neg(q1_1)), q0_0)
      MotorTwistMap{m0_0, m0_1, m0_2, m1_0, m1_1, m1_2, m2_0, m2_1, m2_2, m3_0, m3_1, m3_2, m3_3, m3_4, m3_5, m4_0, m4_1, m4_2, m4_3, m4_4, m4_5, m5_0, m5_1, m5_2, m5_3, m5_4, m5_5}

def Motor.Twist.apply(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, m: MotorTwistMap<T>, b: K.Twist<T>) -> K.Twist<T>:
  match m b:
    case MotorTwistMap{+m0_0, +m0_1, +m0_2, +m1_0, +m1_1, +m1_2, +m2_0, +m2_1, +m2_2, +m3_0, +m3_1, +m3_2, +m3_3, +m3_4, +m3_5, +m4_0, +m4_1, +m4_2, +m4_3, +m4_4, +m4_5, +m5_0, +m5_1, +m5_2, +m5_3, +m5_4, +m5_5} K.Twist{+b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i}:
      K.Twist{
        add(mul(b_e23, m0_0), add(mul(b_e31, m0_1), mul(b_e12, m0_2))),
        add(mul(b_e23, m1_0), add(mul(b_e31, m1_1), mul(b_e12, m1_2))),
        add(mul(b_e23, m2_0), add(mul(b_e31, m2_1), mul(b_e12, m2_2))),
        add(mul(b_e23, m3_0), add(mul(b_e31, m3_1), add(mul(b_e12, m3_2), add(mul(b_e1i, m3_3), add(mul(b_e2i, m3_4), mul(b_e3i, m3_5)))))),
        add(mul(b_e23, m4_0), add(mul(b_e31, m4_1), add(mul(b_e12, m4_2), add(mul(b_e1i, m4_3), add(mul(b_e2i, m4_4), mul(b_e3i, m4_5)))))),
        add(mul(b_e23, m5_0), add(mul(b_e31, m5_1), add(mul(b_e12, m5_2), add(mul(b_e1i, m5_3), add(mul(b_e2i, m5_4), mul(b_e3i, m5_5))))))}

def Motor.transform.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Bivector<T>) -> K.Bivector<T>:
  match a b:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Bivector{+b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi}:
      +q3_3 = mul(a_e12, a_e12)
      +q2_2 = mul(a_e31, a_e31)
      +q1_1 = mul(a_e23, a_e23)
      +q0_0 = mul(a_s, a_s)
      +q1_2 = mul(a_e23, a_e31)
      +q0_3 = mul(a_s, a_e12)
