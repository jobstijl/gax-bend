def Scalar.lc.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Scalar<T>) -> K.Scalar<T>:
  match a b:
    case K.Scalar{+a_s} K.Scalar{+b_s}:
      K.Scalar{
        mul(a_s, b_s)}

def Scalar.lc.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Vector<T>) -> K.Vector<T>:
  match a b:
    case K.Scalar{+a_s} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Vector{
        mul(a_s, b_e1),
        mul(a_s, b_e2),
        mul(a_s, b_e3),
        mul(a_s, b_eo),
        mul(a_s, b_ei)}

def Scalar.lc.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Twist<T>) -> K.Twist<T>:
  match a b:
    case K.Scalar{+a_s} K.Twist{+b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i}:
      K.Twist{
        mul(a_s, b_e23),
        mul(a_s, b_e31),
        mul(a_s, b_e12),
        mul(a_s, b_e1i),
        mul(a_s, b_e2i),
        mul(a_s, b_e3i)}

def Scalar.lc.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Bivector<T>) -> K.Bivector<T>:
  match a b:
    case K.Scalar{+a_s} K.Bivector{+b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi}:
      K.Bivector{
        mul(a_s, b_e23),
        mul(a_s, b_e31),
        mul(a_s, b_e12),
        mul(a_s, b_e1o),
        mul(a_s, b_e2o),
        mul(a_s, b_e3o),
        mul(a_s, b_e1i),
        mul(a_s, b_e2i),
        mul(a_s, b_e3i),
        mul(a_s, b_eoi)}

def Scalar.lc.Trivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Trivector<T>) -> K.Trivector<T>:
  match a b:
    case K.Scalar{+a_s} K.Trivector{+b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123}:
      K.Trivector{
