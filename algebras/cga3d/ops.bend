        add(add(mul(a_eo, b_e2i), neg(mul(a_e3, b_e23))), mul(a_e1, b_e12)),
        add(add(mul(a_eo, b_e3i), mul(a_e2, b_e23)), neg(mul(a_e1, b_e31))),
