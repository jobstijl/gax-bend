        add(mul(a_eo, b_e12oi), mul(a_e3, b_e123o)),
        add(neg(mul(a_ei, b_e23oi)), mul(a_e1, b_e123i)),
        add(neg(mul(a_ei, b_e31oi)), mul(a_e2, b_e123i)),
        add(neg(mul(a_ei, b_e12oi)), mul(a_e3, b_e123i)),
        add(mul(a_e3, b_e31oi), neg(mul(a_e2, b_e12oi))),
        add(neg(mul(a_e3, b_e23oi)), mul(a_e1, b_e12oi)),
