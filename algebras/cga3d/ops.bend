def Quadvector.commutator.Quadvector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Quadvector<T>) -> K.Bivector<T>:
