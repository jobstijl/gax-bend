def Vector.commutator.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Vector<T>) -> K.Bivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Bivector{
        add(neg(mul(a_e3, b_e2)), mul(a_e2, b_e3)),
        add(mul(a_e3, b_e1), neg(mul(a_e1, b_e3))),
        add(neg(mul(a_e2, b_e1)), mul(a_e1, b_e2)),
        add(neg(mul(a_eo, b_e1)), mul(a_e1, b_eo)),
        add(neg(mul(a_eo, b_e2)), mul(a_e2, b_eo)),
        add(neg(mul(a_eo, b_e3)), mul(a_e3, b_eo)),
        add(neg(mul(a_ei, b_e1)), mul(a_e1, b_ei)),
        add(neg(mul(a_ei, b_e2)), mul(a_e2, b_ei)),
        add(neg(mul(a_ei, b_e3)), mul(a_e3, b_ei)),
        add(neg(mul(a_ei, b_eo)), mul(a_eo, b_ei))}

