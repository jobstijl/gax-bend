        mul(a_s, b_e1oi),
        mul(a_s, b_e2oi),
        mul(a_s, b_e3oi),
        mul(a_s, b_e123),
        mul(a_s, b_e23oi),
        mul(a_s, b_e31oi),
        mul(a_s, b_e12oi),
        mul(a_s, b_e123o),
        mul(a_s, b_e123i),
        mul(a_s, b_e123oi)}

def Vector.dot.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Scalar<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Scalar{+b_s}:
      K.Vector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_eo, b_s),
        mul(a_ei, b_s)}

def Vector.dot.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Vector<T>) -> K.Scalar<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Scalar{
        add(add(add(add(neg(mul(a_ei, b_eo)), neg(mul(a_eo, b_ei))), mul(a_e3, b_e3)), mul(a_e2, b_e2)), mul(a_e1, b_e1))}

def Vector.dot.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Twist<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Twist{+b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i}:
      K.Vector{
        add(add(mul(a_eo, b_e1i), mul(a_e3, b_e31)), neg(mul(a_e2, b_e12))),
        add(add(mul(a_eo, b_e2i), neg(mul(a_e3, b_e23))), mul(a_e1, b_e12)),
        add(add(mul(a_eo, b_e3i), mul(a_e2, b_e23)), neg(mul(a_e1, b_e31))),
        zero,
        add(add(mul(a_e3, b_e3i), mul(a_e2, b_e2i)), mul(a_e1, b_e1i))}

def Vector.dot.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Bivector<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Bivector{+b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi}:
      K.Vector{
        add(add(add(mul(a_ei, b_e1o), mul(a_eo, b_e1i)), mul(a_e3, b_e31)), neg(mul(a_e2, b_e12))),
        add(add(add(mul(a_ei, b_e2o), mul(a_eo, b_e2i)), neg(mul(a_e3, b_e23))), mul(a_e1, b_e12)),
        add(add(add(mul(a_ei, b_e3o), mul(a_eo, b_e3i)), mul(a_e2, b_e23)), neg(mul(a_e1, b_e31))),
        add(add(add(mul(a_eo, b_eoi), mul(a_e3, b_e3o)), mul(a_e2, b_e2o)), mul(a_e1, b_e1o)),
        add(add(add(neg(mul(a_ei, b_eoi)), mul(a_e3, b_e3i)), mul(a_e2, b_e2i)), mul(a_e1, b_e1i))}

def Vector.dot.Trivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Trivector<T>) -> K.Bivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Trivector{+b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123}:
      K.Bivector{
        add(add(neg(mul(a_ei, b_e23o)), neg(mul(a_eo, b_e23i))), mul(a_e1, b_e123)),
        add(add(neg(mul(a_ei, b_e31o)), neg(mul(a_eo, b_e31i))), mul(a_e2, b_e123)),
        add(add(neg(mul(a_ei, b_e12o)), neg(mul(a_eo, b_e12i))), mul(a_e3, b_e123)),
        add(add(neg(mul(a_eo, b_e1oi)), mul(a_e3, b_e31o)), neg(mul(a_e2, b_e12o))),
        add(add(neg(mul(a_eo, b_e2oi)), neg(mul(a_e3, b_e23o))), mul(a_e1, b_e12o)),
        add(add(neg(mul(a_eo, b_e3oi)), mul(a_e2, b_e23o)), neg(mul(a_e1, b_e31o))),
        add(add(mul(a_ei, b_e1oi), mul(a_e3, b_e31i)), neg(mul(a_e2, b_e12i))),
        add(add(mul(a_ei, b_e2oi), neg(mul(a_e3, b_e23i))), mul(a_e1, b_e12i)),
        add(add(mul(a_ei, b_e3oi), mul(a_e2, b_e23i)), neg(mul(a_e1, b_e31i))),
        add(add(mul(a_e3, b_e3oi), mul(a_e2, b_e2oi)), mul(a_e1, b_e1oi))}

def Vector.dot.Quadvector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Quadvector<T>) -> K.Trivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Quadvector{+b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i}:
      K.Trivector{
        add(mul(a_eo, b_e23oi), mul(a_e1, b_e123o)),
        add(mul(a_eo, b_e31oi), mul(a_e2, b_e123o)),
        add(mul(a_eo, b_e12oi), mul(a_e3, b_e123o)),
        add(neg(mul(a_ei, b_e23oi)), mul(a_e1, b_e123i)),
        add(neg(mul(a_ei, b_e31oi)), mul(a_e2, b_e123i)),
        add(neg(mul(a_ei, b_e12oi)), mul(a_e3, b_e123i)),
        add(mul(a_e3, b_e31oi), neg(mul(a_e2, b_e12oi))),
        add(neg(mul(a_e3, b_e23oi)), mul(a_e1, b_e12oi)),
        add(mul(a_e2, b_e23oi), neg(mul(a_e1, b_e31oi))),
        add(mul(a_ei, b_e123o), mul(a_eo, b_e123i))}

def Vector.dot.Pseudoscalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Pseudoscalar<T>) -> K.Quadvector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Pseudoscalar{+b_e123oi}:
      K.Quadvector{
        mul(a_e1, b_e123oi),
        mul(a_e2, b_e123oi),
        mul(a_e3, b_e123oi),
        neg(mul(a_eo, b_e123oi)),
        mul(a_ei, b_e123oi)}

def Vector.dot.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Motor<T>) -> K.Odd<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Motor{+b_s, +b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i, +b_e123i}:
      K.Odd{
        add(add(add(mul(a_eo, b_e1i), mul(a_e3, b_e31)), neg(mul(a_e2, b_e12))), mul(a_e1, b_s)),
        add(add(add(mul(a_eo, b_e2i), neg(mul(a_e3, b_e23))), mul(a_e2, b_s)), mul(a_e1, b_e12)),
        add(add(add(mul(a_eo, b_e3i), mul(a_e3, b_s)), mul(a_e2, b_e23)), neg(mul(a_e1, b_e31))),
        mul(a_eo, b_s),
        add(add(add(mul(a_ei, b_s), mul(a_e3, b_e3i)), mul(a_e2, b_e2i)), mul(a_e1, b_e1i)),
        zero,
        zero,
        zero,
        mul(a_e1, b_e123i),
        mul(a_e2, b_e123i),
        mul(a_e3, b_e123i),
        zero,
        zero,
        zero,
        mul(a_eo, b_e123i),
        zero}

def Vector.dot.Even(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Even<T>) -> K.Odd<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Even{+b_s, +b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi, +b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i}:
      K.Odd{
        add(add(add(add(mul(a_ei, b_e1o), mul(a_eo, b_e1i)), mul(a_e3, b_e31)), neg(mul(a_e2, b_e12))), mul(a_e1, b_s)),
        add(add(add(add(mul(a_ei, b_e2o), mul(a_eo, b_e2i)), neg(mul(a_e3, b_e23))), mul(a_e2, b_s)), mul(a_e1, b_e12)),
        add(add(add(add(mul(a_ei, b_e3o), mul(a_eo, b_e3i)), mul(a_e3, b_s)), mul(a_e2, b_e23)), neg(mul(a_e1, b_e31))),
        add(add(add(add(mul(a_eo, b_eoi), mul(a_eo, b_s)), mul(a_e3, b_e3o)), mul(a_e2, b_e2o)), mul(a_e1, b_e1o)),
        add(add(add(add(neg(mul(a_ei, b_eoi)), mul(a_ei, b_s)), mul(a_e3, b_e3i)), mul(a_e2, b_e2i)), mul(a_e1, b_e1i)),
        add(mul(a_eo, b_e23oi), mul(a_e1, b_e123o)),
        add(mul(a_eo, b_e31oi), mul(a_e2, b_e123o)),
        add(mul(a_eo, b_e12oi), mul(a_e3, b_e123o)),
        add(neg(mul(a_ei, b_e23oi)), mul(a_e1, b_e123i)),
        add(neg(mul(a_ei, b_e31oi)), mul(a_e2, b_e123i)),
        add(neg(mul(a_ei, b_e12oi)), mul(a_e3, b_e123i)),
        add(mul(a_e3, b_e31oi), neg(mul(a_e2, b_e12oi))),
        add(neg(mul(a_e3, b_e23oi)), mul(a_e1, b_e12oi)),
        add(mul(a_e2, b_e23oi), neg(mul(a_e1, b_e31oi))),
        add(mul(a_ei, b_e123o), mul(a_eo, b_e123i)),
        zero}

def Vector.dot.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Odd<T>) -> K.Even<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Odd{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei, +b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123, +b_e123oi}:
      K.Even{
        add(add(add(add(neg(mul(a_ei, b_eo)), neg(mul(a_eo, b_ei))), mul(a_e3, b_e3)), mul(a_e2, b_e2)), mul(a_e1, b_e1)),
        add(add(neg(mul(a_ei, b_e23o)), neg(mul(a_eo, b_e23i))), mul(a_e1, b_e123)),
        add(add(neg(mul(a_ei, b_e31o)), neg(mul(a_eo, b_e31i))), mul(a_e2, b_e123)),
        add(add(neg(mul(a_ei, b_e12o)), neg(mul(a_eo, b_e12i))), mul(a_e3, b_e123)),
        add(add(neg(mul(a_eo, b_e1oi)), mul(a_e3, b_e31o)), neg(mul(a_e2, b_e12o))),
        add(add(neg(mul(a_eo, b_e2oi)), neg(mul(a_e3, b_e23o))), mul(a_e1, b_e12o)),
        add(add(neg(mul(a_eo, b_e3oi)), mul(a_e2, b_e23o)), neg(mul(a_e1, b_e31o))),
        add(add(mul(a_ei, b_e1oi), mul(a_e3, b_e31i)), neg(mul(a_e2, b_e12i))),
        add(add(mul(a_ei, b_e2oi), neg(mul(a_e3, b_e23i))), mul(a_e1, b_e12i)),
        add(add(mul(a_ei, b_e3oi), mul(a_e2, b_e23i)), neg(mul(a_e1, b_e31i))),
        add(add(mul(a_e3, b_e3oi), mul(a_e2, b_e2oi)), mul(a_e1, b_e1oi)),
        mul(a_e1, b_e123oi),
        mul(a_e2, b_e123oi),
        mul(a_e3, b_e123oi),
        neg(mul(a_eo, b_e123oi)),
        mul(a_ei, b_e123oi)}

def Vector.dot.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Multivector{+b_s, +b_e1, +b_e2, +b_e3, +b_eo, +b_ei, +b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi, +b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123, +b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i, +b_e123oi}:
      K.Multivector{
        add(add(add(add(neg(mul(a_ei, b_eo)), neg(mul(a_eo, b_ei))), mul(a_e3, b_e3)), mul(a_e2, b_e2)), mul(a_e1, b_e1)),
        add(add(add(add(mul(a_ei, b_e1o), mul(a_eo, b_e1i)), mul(a_e3, b_e31)), neg(mul(a_e2, b_e12))), mul(a_e1, b_s)),
        add(add(add(add(mul(a_ei, b_e2o), mul(a_eo, b_e2i)), neg(mul(a_e3, b_e23))), mul(a_e2, b_s)), mul(a_e1, b_e12)),
        add(add(add(add(mul(a_ei, b_e3o), mul(a_eo, b_e3i)), mul(a_e3, b_s)), mul(a_e2, b_e23)), neg(mul(a_e1, b_e31))),
        add(add(add(add(mul(a_eo, b_eoi), mul(a_eo, b_s)), mul(a_e3, b_e3o)), mul(a_e2, b_e2o)), mul(a_e1, b_e1o)),
        add(add(add(add(neg(mul(a_ei, b_eoi)), mul(a_ei, b_s)), mul(a_e3, b_e3i)), mul(a_e2, b_e2i)), mul(a_e1, b_e1i)),
        add(add(neg(mul(a_ei, b_e23o)), neg(mul(a_eo, b_e23i))), mul(a_e1, b_e123)),
        add(add(neg(mul(a_ei, b_e31o)), neg(mul(a_eo, b_e31i))), mul(a_e2, b_e123)),
