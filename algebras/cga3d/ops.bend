def Quadvector.dot.Trivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Trivector<T>) -> K.Vector<T>:
  match a b:
