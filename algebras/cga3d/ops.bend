        add(add(add(add(add(neg(mul(a_e12oi, b_e123i)), mul(a_eoi, b_e3i)), mul(a_e2i, b_e23)), neg(mul(a_e1i, b_e31))), mul(a_e31, b_e1i)), neg(mul(a_e23, b_e2i))),
