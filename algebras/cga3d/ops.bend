        add(neg(mul(a_eo, b_e3)), mul(a_e3, b_eo)),
        add(neg(mul(a_ei, b_e1)), mul(a_e1, b_ei)),
        add(neg(mul(a_ei, b_e2)), mul(a_e2, b_ei)),
        add(neg(mul(a_ei, b_e3)), mul(a_e3, b_ei)),
        add(neg(mul(a_ei, b_eo)), mul(a_eo, b_ei)),
        add(add(add(neg(mul(a_e3oi, b_e2)), mul(a_e2oi, b_e3)), neg(mul(a_e23i, b_eo))), mul(a_e23o, b_ei)),
