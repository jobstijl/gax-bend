        add(add(add(add(add(add(add(mul(a_e123oi, b_e123o), neg(mul(a_e3oi, b_e3o))), neg(mul(a_e2oi, b_e2o))), neg(mul(a_e1oi, b_e1o))), neg(mul(a_e12o, b_e12))), neg(mul(a_e31o, b_e31))), neg(mul(a_e23o, b_e23))), mul(a_eo, b_s)),
        add(add(add(add(add(add(add(neg(mul(a_e123oi, b_e123i)), mul(a_e3oi, b_e3i)), mul(a_e2oi, b_e2i)), mul(a_e1oi, b_e1i)), neg(mul(a_e12i, b_e12))), neg(mul(a_e31i, b_e31))), neg(mul(a_e23i, b_e23))), mul(a_ei, b_s)),
        add(add(add(mul(a_e123oi, b_e1oi), mul(a_e123, b_e1)), neg(mul(a_e23i, b_eo))), neg(mul(a_e23o, b_ei))),
        add(add(add(mul(a_e123oi, b_e2oi), mul(a_e123, b_e2)), neg(mul(a_e31i, b_eo))), neg(mul(a_e31o, b_ei))),
        add(add(add(mul(a_e123oi, b_e3oi), mul(a_e123, b_e3)), neg(mul(a_e12i, b_eo))), neg(mul(a_e12o, b_ei))),
        add(add(add(mul(a_e123oi, b_e23o), neg(mul(a_e1oi, b_eo))), neg(mul(a_e12o, b_e2))), mul(a_e31o, b_e3)),
        add(add(add(mul(a_e123oi, b_e31o), neg(mul(a_e2oi, b_eo))), mul(a_e12o, b_e1)), neg(mul(a_e23o, b_e3))),
        add(add(add(mul(a_e123oi, b_e12o), neg(mul(a_e3oi, b_eo))), neg(mul(a_e31o, b_e1))), mul(a_e23o, b_e2)),
        add(add(add(neg(mul(a_e123oi, b_e23i)), mul(a_e1oi, b_ei)), neg(mul(a_e12i, b_e2))), mul(a_e31i, b_e3)),
        add(add(add(neg(mul(a_e123oi, b_e31i)), mul(a_e2oi, b_ei)), mul(a_e12i, b_e1)), neg(mul(a_e23i, b_e3))),
        add(add(add(neg(mul(a_e123oi, b_e12i)), mul(a_e3oi, b_ei)), neg(mul(a_e31i, b_e1))), mul(a_e23i, b_e2)),
        add(add(add(neg(mul(a_e123oi, b_e123)), mul(a_e3oi, b_e3)), mul(a_e2oi, b_e2)), mul(a_e1oi, b_e1)),
