        add(neg(mul(a_e12oi, b_e1)), mul(a_e23oi, b_e3)),
        add(mul(a_e31oi, b_e1), neg(mul(a_e23oi, b_e2))),
        add(neg(mul(a_e123i, b_eo)), neg(mul(a_e123o, b_ei))),
        add(add(add(mul(a_e123i, b_e1o), neg(mul(a_e123o, b_e1i))), mul(a_e12oi, b_e31)), neg(mul(a_e31oi, b_e12))),
        add(add(add(mul(a_e123i, b_e2o), neg(mul(a_e123o, b_e2i))), neg(mul(a_e12oi, b_e23))), mul(a_e23oi, b_e12)),
        add(add(add(mul(a_e123i, b_e3o), neg(mul(a_e123o, b_e3i))), mul(a_e31oi, b_e23)), neg(mul(a_e23oi, b_e31))),
        add(add(add(mul(a_e123o, b_eoi), neg(mul(a_e12oi, b_e3o))), neg(mul(a_e31oi, b_e2o))), neg(mul(a_e23oi, b_e1o))),
        add(add(add(neg(mul(a_e123i, b_eoi)), mul(a_e12oi, b_e3i)), mul(a_e31oi, b_e2i)), mul(a_e23oi, b_e1i)),
        zero}

def Motor.commutator.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Vector<T>) -> K.Odd<T>:
  match a b:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Odd{
