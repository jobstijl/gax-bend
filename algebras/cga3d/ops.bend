def Odd.commutator.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Vector<T>) -> K.Even<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei, +a_e23o, +a_e31o, +a_e12o, +a_e23i, +a_e31i, +a_e12i, +a_e1oi, +a_e2oi, +a_e3oi, +a_e123, +a_e123oi} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Even{
        zero,
        add(neg(mul(a_e3, b_e2)), mul(a_e2, b_e3)),
        add(mul(a_e3, b_e1), neg(mul(a_e1, b_e3))),
        add(neg(mul(a_e2, b_e1)), mul(a_e1, b_e2)),
        add(neg(mul(a_eo, b_e1)), mul(a_e1, b_eo)),
        add(neg(mul(a_eo, b_e2)), mul(a_e2, b_eo)),
        add(neg(mul(a_eo, b_e3)), mul(a_e3, b_eo)),
        add(neg(mul(a_ei, b_e1)), mul(a_e1, b_ei)),
        add(neg(mul(a_ei, b_e2)), mul(a_e2, b_ei)),
        add(neg(mul(a_ei, b_e3)), mul(a_e3, b_ei)),
        add(neg(mul(a_ei, b_eo)), mul(a_eo, b_ei)),
        add(add(add(neg(mul(a_e3oi, b_e2)), mul(a_e2oi, b_e3)), neg(mul(a_e23i, b_eo))), mul(a_e23o, b_ei)),
        add(add(add(mul(a_e3oi, b_e1), neg(mul(a_e1oi, b_e3))), neg(mul(a_e31i, b_eo))), mul(a_e31o, b_ei)),
        add(add(add(neg(mul(a_e2oi, b_e1)), mul(a_e1oi, b_e2)), neg(mul(a_e12i, b_eo))), mul(a_e12o, b_ei)),
        add(add(add(mul(a_e123, b_eo), neg(mul(a_e12o, b_e3))), neg(mul(a_e31o, b_e2))), neg(mul(a_e23o, b_e1))),
        add(add(add(mul(a_e123, b_ei), neg(mul(a_e12i, b_e3))), neg(mul(a_e31i, b_e2))), neg(mul(a_e23i, b_e1)))}

def Odd.commutator.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Twist<T>) -> K.Odd<T>:
