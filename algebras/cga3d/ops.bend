def Vector.transform.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Vector<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      +q3_4 = mul(a_eo, a_ei)
      +q2_2 = mul(a_e3, a_e3)
      +q1_1 = mul(a_e2, a_e2)
      +q0_0 = mul(a_e1, a_e1)
      +q0_1 = mul(a_e1, a_e2)
      +q0_2 = mul(a_e1, a_e3)
      +q0_4 = mul(a_e1, a_ei)
      +q0_3 = mul(a_e1, a_eo)
      +q1_2 = mul(a_e2, a_e3)
      +q1_4 = mul(a_e2, a_ei)
      +q1_3 = mul(a_e2, a_eo)
      +q2_4 = mul(a_e3, a_ei)
      +q2_3 = mul(a_e3, a_eo)
      +q3_3 = mul(a_eo, a_eo)
      +q4_4 = mul(a_ei, a_ei)
      +m0_0 = add(add(add(add(q3_4, q3_4), neg(q2_2)), neg(q1_1)), q0_0)
      +m0_1 = add(q0_1, q0_1)
      +m0_2 = add(q0_2, q0_2)
      +m0_3 = add(neg(q0_4), neg(q0_4))
      +m0_4 = add(neg(q0_3), neg(q0_3))
      +m1_0 = add(q0_1, q0_1)
      +m1_1 = add(add(add(add(q3_4, q3_4), neg(q2_2)), q1_1), neg(q0_0))
      +m1_2 = add(q1_2, q1_2)
      +m1_3 = add(neg(q1_4), neg(q1_4))
      +m1_4 = add(neg(q1_3), neg(q1_3))
      +m2_0 = add(q0_2, q0_2)
      +m2_1 = add(q1_2, q1_2)
      +m2_2 = add(add(add(add(q3_4, q3_4), q2_2), neg(q1_1)), neg(q0_0))
      +m2_3 = add(neg(q2_4), neg(q2_4))
      +m2_4 = add(neg(q2_3), neg(q2_3))
      +m3_0 = add(q0_3, q0_3)
      +m3_1 = add(q1_3, q1_3)
      +m3_2 = add(q2_3, q2_3)
      +m3_3 = add(add(neg(q2_2), neg(q1_1)), neg(q0_0))
      +m3_4 = add(neg(q3_3), neg(q3_3))
      +m4_0 = add(q0_4, q0_4)
      +m4_1 = add(q1_4, q1_4)
      +m4_2 = add(q2_4, q2_4)
      +m4_3 = add(neg(q4_4), neg(q4_4))
      +m4_4 = add(add(neg(q2_2), neg(q1_1)), neg(q0_0))
      K.Vector{
        add(mul(b_e1, m0_0), add(mul(b_e2, m0_1), add(mul(b_e3, m0_2), add(mul(b_eo, m0_3), mul(b_ei, m0_4))))),
        add(mul(b_e1, m1_0), add(mul(b_e2, m1_1), add(mul(b_e3, m1_2), add(mul(b_eo, m1_3), mul(b_ei, m1_4))))),
        add(mul(b_e1, m2_0), add(mul(b_e2, m2_1), add(mul(b_e3, m2_2), add(mul(b_eo, m2_3), mul(b_ei, m2_4))))),
        add(mul(b_e1, m3_0), add(mul(b_e2, m3_1), add(mul(b_e3, m3_2), add(mul(b_eo, m3_3), mul(b_ei, m3_4))))),
        add(mul(b_e1, m4_0), add(mul(b_e2, m4_1), add(mul(b_e3, m4_2), add(mul(b_eo, m4_3), mul(b_ei, m4_4)))))}

type VectorVectorMap<-T: Data> is Data:
  VectorVectorMap{m0_0: T, m0_1: T, m0_2: T, m0_3: T, m0_4: T, m1_0: T, m1_1: T, m1_2: T, m1_3: T, m1_4: T, m2_0: T, m2_1: T, m2_2: T, m2_3: T, m2_4: T, m3_0: T, m3_1: T, m3_2: T, m3_3: T, m3_4: T, m4_0: T, m4_1: T, m4_2: T, m4_3: T, m4_4: T}

def Vector.prepare.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>) -> VectorVectorMap<T>:
  match a:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei}:
      +q3_4 = mul(a_eo, a_ei)
      +q2_2 = mul(a_e3, a_e3)
      +q1_1 = mul(a_e2, a_e2)
      +q0_0 = mul(a_e1, a_e1)
      +q0_1 = mul(a_e1, a_e2)
      +q0_2 = mul(a_e1, a_e3)
      +q0_4 = mul(a_e1, a_ei)
      +q0_3 = mul(a_e1, a_eo)
      +q1_2 = mul(a_e2, a_e3)
      +q1_4 = mul(a_e2, a_ei)
      +q1_3 = mul(a_e2, a_eo)
      +q2_4 = mul(a_e3, a_ei)
      +q2_3 = mul(a_e3, a_eo)
      +q3_3 = mul(a_eo, a_eo)
      +q4_4 = mul(a_ei, a_ei)
      +m0_0 = add(add(add(add(q3_4, q3_4), neg(q2_2)), neg(q1_1)), q0_0)
      +m0_1 = add(q0_1, q0_1)
      +m0_2 = add(q0_2, q0_2)
      +m0_3 = add(neg(q0_4), neg(q0_4))
      +m0_4 = add(neg(q0_3), neg(q0_3))
      +m1_0 = add(q0_1, q0_1)
      +m1_1 = add(add(add(add(q3_4, q3_4), neg(q2_2)), q1_1), neg(q0_0))
      +m1_2 = add(q1_2, q1_2)
      +m1_3 = add(neg(q1_4), neg(q1_4))
      +m1_4 = add(neg(q1_3), neg(q1_3))
      +m2_0 = add(q0_2, q0_2)
      +m2_1 = add(q1_2, q1_2)
      +m2_2 = add(add(add(add(q3_4, q3_4), q2_2), neg(q1_1)), neg(q0_0))
      +m2_3 = add(neg(q2_4), neg(q2_4))
      +m2_4 = add(neg(q2_3), neg(q2_3))
      +m3_0 = add(q0_3, q0_3)
      +m3_1 = add(q1_3, q1_3)
      +m3_2 = add(q2_3, q2_3)
      +m3_3 = add(add(neg(q2_2), neg(q1_1)), neg(q0_0))
      +m3_4 = add(neg(q3_3), neg(q3_3))
      +m4_0 = add(q0_4, q0_4)
      +m4_1 = add(q1_4, q1_4)
      +m4_2 = add(q2_4, q2_4)
      +m4_3 = add(neg(q4_4), neg(q4_4))
      +m4_4 = add(add(neg(q2_2), neg(q1_1)), neg(q0_0))
      VectorVectorMap{m0_0, m0_1, m0_2, m0_3, m0_4, m1_0, m1_1, m1_2, m1_3, m1_4, m2_0, m2_1, m2_2, m2_3, m2_4, m3_0, m3_1, m3_2, m3_3, m3_4, m4_0, m4_1, m4_2, m4_3, m4_4}

def Vector.Vector.apply(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, m: VectorVectorMap<T>, b: K.Vector<T>) -> K.Vector<T>:
  match m b:
    case VectorVectorMap{+m0_0, +m0_1, +m0_2, +m0_3, +m0_4, +m1_0, +m1_1, +m1_2, +m1_3, +m1_4, +m2_0, +m2_1, +m2_2, +m2_3, +m2_4, +m3_0, +m3_1, +m3_2, +m3_3, +m3_4, +m4_0, +m4_1, +m4_2, +m4_3, +m4_4} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Vector{
        add(mul(b_e1, m0_0), add(mul(b_e2, m0_1), add(mul(b_e3, m0_2), add(mul(b_eo, m0_3), mul(b_ei, m0_4))))),
        add(mul(b_e1, m1_0), add(mul(b_e2, m1_1), add(mul(b_e3, m1_2), add(mul(b_eo, m1_3), mul(b_ei, m1_4))))),
        add(mul(b_e1, m2_0), add(mul(b_e2, m2_1), add(mul(b_e3, m2_2), add(mul(b_eo, m2_3), mul(b_ei, m2_4))))),
        add(mul(b_e1, m3_0), add(mul(b_e2, m3_1), add(mul(b_e3, m3_2), add(mul(b_eo, m3_3), mul(b_ei, m3_4))))),
        add(mul(b_e1, m4_0), add(mul(b_e2, m4_1), add(mul(b_e3, m4_2), add(mul(b_eo, m4_3), mul(b_ei, m4_4)))))}

def Vector.transform.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Twist<T>) -> K.Bivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Twist{+b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i}:
      +q3_4 = mul(a_eo, a_ei)
      +q2_2 = mul(a_e3, a_e3)
      +q1_1 = mul(a_e2, a_e2)
      +q0_0 = mul(a_e1, a_e1)
      +q0_1 = mul(a_e1, a_e2)
      +q0_2 = mul(a_e1, a_e3)
      +q2_3 = mul(a_e3, a_eo)
      +q1_3 = mul(a_e2, a_eo)
      +q1_2 = mul(a_e2, a_e3)
      +q0_3 = mul(a_e1, a_eo)
      +q3_3 = mul(a_eo, a_eo)
      +q2_4 = mul(a_e3, a_ei)
      +q1_4 = mul(a_e2, a_ei)
      +q0_4 = mul(a_e1, a_ei)
      +m0_0 = add(add(add(add(neg(q3_4), neg(q3_4)), neg(q2_2)), neg(q1_1)), q0_0)
      +m0_1 = add(q0_1, q0_1)
      +m0_2 = add(q0_2, q0_2)
      +m0_4 = add(q2_3, q2_3)
      +m0_5 = add(neg(q1_3), neg(q1_3))
      +m1_0 = add(q0_1, q0_1)
      +m1_1 = add(add(add(add(neg(q3_4), neg(q3_4)), neg(q2_2)), q1_1), neg(q0_0))
      +m1_2 = add(q1_2, q1_2)
      +m1_3 = add(neg(q2_3), neg(q2_3))
      +m1_5 = add(q0_3, q0_3)
      +m2_0 = add(q0_2, q0_2)
      +m2_1 = add(q1_2, q1_2)
      +m2_2 = add(add(add(add(neg(q3_4), neg(q3_4)), q2_2), neg(q1_1)), neg(q0_0))
      +m2_3 = add(q1_3, q1_3)
      +m2_4 = add(neg(q0_3), neg(q0_3))
      +m3_1 = add(q2_3, q2_3)
      +m3_2 = add(neg(q1_3), neg(q1_3))
      +m3_3 = add(q3_3, q3_3)
      +m4_0 = add(neg(q2_3), neg(q2_3))
      +m4_2 = add(q0_3, q0_3)
      +m4_4 = add(q3_3, q3_3)
      +m5_0 = add(q1_3, q1_3)
      +m5_1 = add(neg(q0_3), neg(q0_3))
      +m5_5 = add(q3_3, q3_3)
      +m6_1 = add(q2_4, q2_4)
      +m6_2 = add(neg(q1_4), neg(q1_4))
      +m6_3 = add(add(q2_2, q1_1), neg(q0_0))
      +m6_4 = add(neg(q0_1), neg(q0_1))
      +m6_5 = add(neg(q0_2), neg(q0_2))
      +m7_0 = add(neg(q2_4), neg(q2_4))
      +m7_2 = add(q0_4, q0_4)
      +m7_3 = add(neg(q0_1), neg(q0_1))
      +m7_4 = add(add(q2_2, neg(q1_1)), q0_0)
      +m7_5 = add(neg(q1_2), neg(q1_2))
      +m8_0 = add(q1_4, q1_4)
      +m8_1 = add(neg(q0_4), neg(q0_4))
      +m8_3 = add(neg(q0_2), neg(q0_2))
      +m8_4 = add(neg(q1_2), neg(q1_2))
      +m8_5 = add(add(neg(q2_2), q1_1), q0_0)
      +m9_3 = add(neg(q0_3), neg(q0_3))
      +m9_4 = add(neg(q1_3), neg(q1_3))
      +m9_5 = add(neg(q2_3), neg(q2_3))
      K.Bivector{
        add(mul(b_e23, m0_0), add(mul(b_e31, m0_1), add(mul(b_e12, m0_2), add(mul(b_e2i, m0_4), mul(b_e3i, m0_5))))),
        add(mul(b_e23, m1_0), add(mul(b_e31, m1_1), add(mul(b_e12, m1_2), add(mul(b_e1i, m1_3), mul(b_e3i, m1_5))))),
        add(mul(b_e23, m2_0), add(mul(b_e31, m2_1), add(mul(b_e12, m2_2), add(mul(b_e1i, m2_3), mul(b_e2i, m2_4))))),
        add(mul(b_e31, m3_1), add(mul(b_e12, m3_2), mul(b_e1i, m3_3))),
        add(mul(b_e23, m4_0), add(mul(b_e12, m4_2), mul(b_e2i, m4_4))),
        add(mul(b_e23, m5_0), add(mul(b_e31, m5_1), mul(b_e3i, m5_5))),
        add(mul(b_e31, m6_1), add(mul(b_e12, m6_2), add(mul(b_e1i, m6_3), add(mul(b_e2i, m6_4), mul(b_e3i, m6_5))))),
        add(mul(b_e23, m7_0), add(mul(b_e12, m7_2), add(mul(b_e1i, m7_3), add(mul(b_e2i, m7_4), mul(b_e3i, m7_5))))),
        add(mul(b_e23, m8_0), add(mul(b_e31, m8_1), add(mul(b_e1i, m8_3), add(mul(b_e2i, m8_4), mul(b_e3i, m8_5))))),
        add(mul(b_e1i, m9_3), add(mul(b_e2i, m9_4), mul(b_e3i, m9_5)))}

type VectorTwistMap<-T: Data> is Data:
  VectorTwistMap{m0_0: T, m0_1: T, m0_2: T, m0_4: T, m0_5: T, m1_0: T, m1_1: T, m1_2: T, m1_3: T, m1_5: T, m2_0: T, m2_1: T, m2_2: T, m2_3: T, m2_4: T, m3_1: T, m3_2: T, m3_3: T, m4_0: T, m4_2: T, m4_4: T, m5_0: T, m5_1: T, m5_5: T, m6_1: T, m6_2: T, m6_3: T, m6_4: T, m6_5: T, m7_0: T, m7_2: T, m7_3: T, m7_4: T, m7_5: T, m8_0: T, m8_1: T, m8_3: T, m8_4: T, m8_5: T, m9_3: T, m9_4: T, m9_5: T}

def Vector.prepare.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>) -> VectorTwistMap<T>:
  match a:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei}:
      +q3_4 = mul(a_eo, a_ei)
      +q2_2 = mul(a_e3, a_e3)
      +q1_1 = mul(a_e2, a_e2)
      +q0_0 = mul(a_e1, a_e1)
      +q0_1 = mul(a_e1, a_e2)
      +q0_2 = mul(a_e1, a_e3)
      +q2_3 = mul(a_e3, a_eo)
      +q1_3 = mul(a_e2, a_eo)
      +q1_2 = mul(a_e2, a_e3)
      +q0_3 = mul(a_e1, a_eo)
      +q3_3 = mul(a_eo, a_eo)
      +q2_4 = mul(a_e3, a_ei)
      +q1_4 = mul(a_e2, a_ei)
      +q0_4 = mul(a_e1, a_ei)
      +m0_0 = add(add(add(add(neg(q3_4), neg(q3_4)), neg(q2_2)), neg(q1_1)), q0_0)
      +m0_1 = add(q0_1, q0_1)
      +m0_2 = add(q0_2, q0_2)
      +m0_4 = add(q2_3, q2_3)
      +m0_5 = add(neg(q1_3), neg(q1_3))
      +m1_0 = add(q0_1, q0_1)
      +m1_1 = add(add(add(add(neg(q3_4), neg(q3_4)), neg(q2_2)), q1_1), neg(q0_0))
      +m1_2 = add(q1_2, q1_2)
      +m1_3 = add(neg(q2_3), neg(q2_3))
      +m1_5 = add(q0_3, q0_3)
      +m2_0 = add(q0_2, q0_2)
      +m2_1 = add(q1_2, q1_2)
      +m2_2 = add(add(add(add(neg(q3_4), neg(q3_4)), q2_2), neg(q1_1)), neg(q0_0))
      +m2_3 = add(q1_3, q1_3)
      +m2_4 = add(neg(q0_3), neg(q0_3))
      +m3_1 = add(q2_3, q2_3)
      +m3_2 = add(neg(q1_3), neg(q1_3))
      +m3_3 = add(q3_3, q3_3)
      +m4_0 = add(neg(q2_3), neg(q2_3))
      +m4_2 = add(q0_3, q0_3)
      +m4_4 = add(q3_3, q3_3)
      +m5_0 = add(q1_3, q1_3)
      +m5_1 = add(neg(q0_3), neg(q0_3))
      +m5_5 = add(q3_3, q3_3)
      +m6_1 = add(q2_4, q2_4)
      +m6_2 = add(neg(q1_4), neg(q1_4))
      +m6_3 = add(add(q2_2, q1_1), neg(q0_0))
      +m6_4 = add(neg(q0_1), neg(q0_1))
      +m6_5 = add(neg(q0_2), neg(q0_2))
      +m7_0 = add(neg(q2_4), neg(q2_4))
      +m7_2 = add(q0_4, q0_4)
      +m7_3 = add(neg(q0_1), neg(q0_1))
      +m7_4 = add(add(q2_2, neg(q1_1)), q0_0)
      +m7_5 = add(neg(q1_2), neg(q1_2))
      +m8_0 = add(q1_4, q1_4)
      +m8_1 = add(neg(q0_4), neg(q0_4))
      +m8_3 = add(neg(q0_2), neg(q0_2))
      +m8_4 = add(neg(q1_2), neg(q1_2))
      +m8_5 = add(add(neg(q2_2), q1_1), q0_0)
      +m9_3 = add(neg(q0_3), neg(q0_3))
      +m9_4 = add(neg(q1_3), neg(q1_3))
      +m9_5 = add(neg(q2_3), neg(q2_3))
      VectorTwistMap{m0_0, m0_1, m0_2, m0_4, m0_5, m1_0, m1_1, m1_2, m1_3, m1_5, m2_0, m2_1, m2_2, m2_3, m2_4, m3_1, m3_2, m3_3, m4_0, m4_2, m4_4, m5_0, m5_1, m5_5, m6_1, m6_2, m6_3, m6_4, m6_5, m7_0, m7_2, m7_3, m7_4, m7_5, m8_0, m8_1, m8_3, m8_4, m8_5, m9_3, m9_4, m9_5}

def Vector.Twist.apply(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, m: VectorTwistMap<T>, b: K.Twist<T>) -> K.Bivector<T>:
  match m b:
    case VectorTwistMap{+m0_0, +m0_1, +m0_2, +m0_4, +m0_5, +m1_0, +m1_1, +m1_2, +m1_3, +m1_5, +m2_0, +m2_1, +m2_2, +m2_3, +m2_4, +m3_1, +m3_2, +m3_3, +m4_0, +m4_2, +m4_4, +m5_0, +m5_1, +m5_5, +m6_1, +m6_2, +m6_3, +m6_4, +m6_5, +m7_0, +m7_2, +m7_3, +m7_4, +m7_5, +m8_0, +m8_1, +m8_3, +m8_4, +m8_5, +m9_3, +m9_4, +m9_5} K.Twist{+b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i}:
      K.Bivector{
        add(mul(b_e23, m0_0), add(mul(b_e31, m0_1), add(mul(b_e12, m0_2), add(mul(b_e2i, m0_4), mul(b_e3i, m0_5))))),
        add(mul(b_e23, m1_0), add(mul(b_e31, m1_1), add(mul(b_e12, m1_2), add(mul(b_e1i, m1_3), mul(b_e3i, m1_5))))),
        add(mul(b_e23, m2_0), add(mul(b_e31, m2_1), add(mul(b_e12, m2_2), add(mul(b_e1i, m2_3), mul(b_e2i, m2_4))))),
        add(mul(b_e31, m3_1), add(mul(b_e12, m3_2), mul(b_e1i, m3_3))),
        add(mul(b_e23, m4_0), add(mul(b_e12, m4_2), mul(b_e2i, m4_4))),
        add(mul(b_e23, m5_0), add(mul(b_e31, m5_1), mul(b_e3i, m5_5))),
        add(mul(b_e31, m6_1), add(mul(b_e12, m6_2), add(mul(b_e1i, m6_3), add(mul(b_e2i, m6_4), mul(b_e3i, m6_5))))),
        add(mul(b_e23, m7_0), add(mul(b_e12, m7_2), add(mul(b_e1i, m7_3), add(mul(b_e2i, m7_4), mul(b_e3i, m7_5))))),
        add(mul(b_e23, m8_0), add(mul(b_e31, m8_1), add(mul(b_e1i, m8_3), add(mul(b_e2i, m8_4), mul(b_e3i, m8_5))))),
        add(mul(b_e1i, m9_3), add(mul(b_e2i, m9_4), mul(b_e3i, m9_5)))}

def Vector.transform.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Bivector<T>) -> K.Bivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Bivector{+b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi}:
      +q3_4 = mul(a_eo, a_ei)
      +q2_2 = mul(a_e3, a_e3)
      +q1_1 = mul(a_e2, a_e2)
      +q0_0 = mul(a_e1, a_e1)
      +q0_1 = mul(a_e1, a_e2)
      +q0_2 = mul(a_e1, a_e3)
      +q2_4 = mul(a_e3, a_ei)
      +q1_4 = mul(a_e2, a_ei)
      +q2_3 = mul(a_e3, a_eo)
      +q1_3 = mul(a_e2, a_eo)
      +q1_2 = mul(a_e2, a_e3)
      +q0_4 = mul(a_e1, a_ei)
      +q0_3 = mul(a_e1, a_eo)
      +q3_3 = mul(a_eo, a_eo)
      +q4_4 = mul(a_ei, a_ei)
      +m0_0 = add(add(add(add(neg(q3_4), neg(q3_4)), neg(q2_2)), neg(q1_1)), q0_0)
      +m0_1 = add(q0_1, q0_1)
      +m0_2 = add(q0_2, q0_2)
      +m0_4 = add(q2_4, q2_4)
      +m0_5 = add(neg(q1_4), neg(q1_4))
