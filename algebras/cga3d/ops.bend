        add(add(add(neg(mul(a_e123i, b_e12)), mul(a_e3i, b_s)), neg(mul(a_e12, b_e123i))), mul(a_s, b_e3i)),
        add(add(add(add(add(add(add(mul(a_e123i, b_s), mul(a_e3i, b_e12)), mul(a_e2i, b_e31)), mul(a_e1i, b_e23)), mul(a_e12, b_e3i)), mul(a_e31, b_e2i)), mul(a_e23, b_e1i)), mul(a_s, b_e123i))}

