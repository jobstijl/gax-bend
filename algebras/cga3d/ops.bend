        add(add(neg(mul(a_e123o, b_e12)), neg(mul(a_e31oi, b_e1o))), mul(a_e23oi, b_e2o)),
        add(add(neg(mul(a_e123i, b_e23)), mul(a_e12oi, b_e2i)), neg(mul(a_e31oi, b_e3i))),
