        add(add(neg(mul(a_e2i, b_e23oi)), mul(a_e1i, b_e31oi)), neg(mul(a_e12, b_e123i))),
        add(add(neg(mul(a_e12, b_e12oi)), neg(mul(a_e31, b_e31oi))), neg(mul(a_e23, b_e23oi))),
