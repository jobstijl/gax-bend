        add(add(mul(a_ei, b_e3o), neg(mul(a_eo, b_e3i))), mul(a_e3, b_eoi)),
        add(add(mul(a_e3, b_e12), mul(a_e2, b_e31)), mul(a_e1, b_e23))}

def Vector.wedge.Trivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Trivector<T>) -> K.Quadvector<T>:
