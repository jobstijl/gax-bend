        add(add(add(add(add(mul(a_e3oi, b_e1oi), neg(mul(a_e1oi, b_e3oi))), mul(a_e12i, b_e23o)), neg(mul(a_e23i, b_e12o))), mul(a_e12o, b_e23i)), neg(mul(a_e23o, b_e12i))),
        add(add(add(add(add(neg(mul(a_e2oi, b_e1oi)), mul(a_e1oi, b_e2oi)), neg(mul(a_e31i, b_e23o))), mul(a_e23i, b_e31o)), neg(mul(a_e31o, b_e23i))), mul(a_e23o, b_e31i)),
        add(add(add(add(add(neg(mul(a_e123, b_e23o)), neg(mul(a_e3oi, b_e31o))), mul(a_e2oi, b_e12o)), neg(mul(a_e12o, b_e2oi))), mul(a_e31o, b_e3oi)), mul(a_e23o, b_e123)),
        add(add(add(add(add(neg(mul(a_e123, b_e31o)), mul(a_e3oi, b_e23o)), neg(mul(a_e1oi, b_e12o))), mul(a_e12o, b_e1oi)), mul(a_e31o, b_e123)), neg(mul(a_e23o, b_e3oi))),
        add(add(add(add(add(neg(mul(a_e123, b_e12o)), neg(mul(a_e2oi, b_e23o))), mul(a_e1oi, b_e31o)), mul(a_e12o, b_e123)), neg(mul(a_e31o, b_e1oi))), mul(a_e23o, b_e2oi)),
        add(add(add(add(add(neg(mul(a_e123, b_e23i)), mul(a_e3oi, b_e31i)), neg(mul(a_e2oi, b_e12i))), mul(a_e12i, b_e2oi)), neg(mul(a_e31i, b_e3oi))), mul(a_e23i, b_e123)),
        add(add(add(add(add(neg(mul(a_e123, b_e31i)), neg(mul(a_e3oi, b_e23i))), mul(a_e1oi, b_e12i)), neg(mul(a_e12i, b_e1oi))), mul(a_e31i, b_e123)), mul(a_e23i, b_e3oi)),
