        add(neg(mul(a_e123i, b_e1)), mul(a_e23oi, b_ei)),
        add(neg(mul(a_e123i, b_e2)), mul(a_e31oi, b_ei)),
        add(neg(mul(a_e123i, b_e3)), mul(a_e12oi, b_ei)),
        add(mul(a_e12oi, b_e2), neg(mul(a_e31oi, b_e3))),
        add(neg(mul(a_e12oi, b_e1)), mul(a_e23oi, b_e3)),
        add(mul(a_e31oi, b_e1), neg(mul(a_e23oi, b_e2))),
        add(neg(mul(a_e123i, b_eo)), neg(mul(a_e123o, b_ei)))}

def Quadvector.dot.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Twist<T>) -> K.Bivector<T>:
  match a b:
