        add(add(add(neg(mul(a_eoi, b_eo)), neg(mul(a_e3o, b_e3))), neg(mul(a_e2o, b_e2))), neg(mul(a_e1o, b_e1))),
        add(add(add(mul(a_eoi, b_ei), neg(mul(a_e3i, b_e3))), neg(mul(a_e2i, b_e2))), neg(mul(a_e1i, b_e1))),
        add(add(mul(a_e123, b_e1), neg(mul(a_e23i, b_eo))), neg(mul(a_e23o, b_ei))),
        add(add(mul(a_e123, b_e2), neg(mul(a_e31i, b_eo))), neg(mul(a_e31o, b_ei))),
