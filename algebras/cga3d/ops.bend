        add(add(add(add(add(add(add(neg(mul(a_e123oi, b_e31oi)), neg(mul(a_e123, b_e31))), mul(a_e2oi, b_eoi)), neg(mul(a_e12i, b_e1o))), mul(a_e23i, b_e3o)), neg(mul(a_e12o, b_e1i))), mul(a_e23o, b_e3i)), mul(a_e2, b_s)),
