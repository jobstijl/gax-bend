        add(add(add(add(mul(a_e3i, b_e1oi), neg(mul(a_e2i, b_e123))), neg(mul(a_e1i, b_e3oi))), neg(mul(a_e12, b_e23i))), mul(a_e23, b_e12i)),
        add(add(add(add(neg(mul(a_e3i, b_e123)), neg(mul(a_e2i, b_e1oi))), mul(a_e1i, b_e2oi)), mul(a_e31, b_e23i)), neg(mul(a_e23, b_e31i))),
        add(add(add(neg(mul(a_e3i, b_e31o)), mul(a_e2i, b_e12o)), mul(a_e12, b_e2oi)), neg(mul(a_e31, b_e3oi))),
        add(add(add(mul(a_e3i, b_e23o), neg(mul(a_e1i, b_e12o))), neg(mul(a_e12, b_e1oi))), mul(a_e23, b_e3oi)),
        add(add(add(neg(mul(a_e2i, b_e23o)), mul(a_e1i, b_e31o)), mul(a_e31, b_e1oi)), neg(mul(a_e23, b_e2oi))),
        add(add(neg(mul(a_e3i, b_e12o)), neg(mul(a_e2i, b_e31o))), neg(mul(a_e1i, b_e23o))),
        zero}

def Motor.commutator.Quadvector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Quadvector<T>) -> K.Even<T>:
  match a b:
