        add(add(neg(mul(a_e12oi, b_e12)), neg(mul(a_e31oi, b_e31))), neg(mul(a_e23oi, b_e23)))}

def Quadvector.dot.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Bivector<T>) -> K.Bivector<T>:
  match a b:
