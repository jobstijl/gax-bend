        add(add(add(mul(a_e1oi, b_ei), neg(mul(a_e12i, b_e2))), mul(a_e31i, b_e3)), neg(mul(a_e23i, b_e123oi))),
        add(add(add(mul(a_e2oi, b_ei), mul(a_e12i, b_e1)), neg(mul(a_e31i, b_e123oi))), neg(mul(a_e23i, b_e3))),
        add(add(add(mul(a_e3oi, b_ei), neg(mul(a_e12i, b_e123oi))), neg(mul(a_e31i, b_e1))), mul(a_e23i, b_e2)),
        add(add(add(neg(mul(a_e123, b_e123oi)), mul(a_e3oi, b_e3)), mul(a_e2oi, b_e2)), mul(a_e1oi, b_e1)),
        mul(a_e23o, b_s),
        mul(a_e31o, b_s),
        mul(a_e12o, b_s),
        mul(a_e23i, b_s),
        mul(a_e31i, b_s),
        mul(a_e12i, b_s),
        mul(a_e1oi, b_s),
        mul(a_e2oi, b_s),
        mul(a_e3oi, b_s),
        mul(a_e123, b_s),
        zero,
        zero,
        zero,
        zero,
        zero,
        zero}

def Quadvector.dot.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Scalar<T>) -> K.Quadvector<T>:
  match a b:
    case K.Quadvector{+a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i} K.Scalar{+b_s}:
      K.Quadvector{
        mul(a_e23oi, b_s),
        mul(a_e31oi, b_s),
        mul(a_e12oi, b_s),
        mul(a_e123o, b_s),
