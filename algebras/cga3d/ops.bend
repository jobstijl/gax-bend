    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Bivector{+b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi}:
      K.Even{
        add(add(add(add(add(mul(a_e3i, b_e3o), mul(a_e2i, b_e2o)), mul(a_e1i, b_e1o)), neg(mul(a_e12, b_e12))), neg(mul(a_e31, b_e31))), neg(mul(a_e23, b_e23))),
        add(mul(a_e123i, b_e1o), mul(a_s, b_e23)),
        add(mul(a_e123i, b_e2o), mul(a_s, b_e31)),
        add(mul(a_e123i, b_e3o), mul(a_s, b_e12)),
        mul(a_s, b_e1o),
        mul(a_s, b_e2o),
        mul(a_s, b_e3o),
        add(neg(mul(a_e123i, b_e23)), mul(a_s, b_e1i)),
        add(neg(mul(a_e123i, b_e31)), mul(a_s, b_e2i)),
        add(neg(mul(a_e123i, b_e12)), mul(a_s, b_e3i)),
        mul(a_s, b_eoi),
        add(add(neg(mul(a_e3i, b_e2o)), mul(a_e2i, b_e3o)), mul(a_e23, b_eoi)),
        add(add(mul(a_e3i, b_e1o), neg(mul(a_e1i, b_e3o))), mul(a_e31, b_eoi)),
        add(add(neg(mul(a_e2i, b_e1o)), mul(a_e1i, b_e2o)), mul(a_e12, b_eoi)),
        add(add(mul(a_e12, b_e3o), mul(a_e31, b_e2o)), mul(a_e23, b_e1o)),
        add(add(add(add(add(mul(a_e3i, b_e12), mul(a_e2i, b_e31)), mul(a_e1i, b_e23)), mul(a_e12, b_e3i)), mul(a_e31, b_e2i)), mul(a_e23, b_e1i))}

def Motor.anticommutator.Trivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Trivector<T>) -> K.Odd<T>:
