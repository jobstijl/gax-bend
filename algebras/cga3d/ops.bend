        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_eo, b_s),
        mul(a_ei, b_s),
        mul(a_e23, b_s),
        mul(a_e31, b_s),
        mul(a_e12, b_s),
        mul(a_e1o, b_s),
        mul(a_e2o, b_s),
        mul(a_e3o, b_s),
        mul(a_e1i, b_s),
        mul(a_e2i, b_s),
        mul(a_e3i, b_s),
        mul(a_eoi, b_s),
        mul(a_e23o, b_s),
        mul(a_e31o, b_s),
        mul(a_e12o, b_s),
        mul(a_e23i, b_s),
        mul(a_e31i, b_s),
        mul(a_e12i, b_s),
        mul(a_e1oi, b_s),
        mul(a_e2oi, b_s),
        mul(a_e3oi, b_s),
        mul(a_e123, b_s),
        mul(a_e23oi, b_s),
        mul(a_e31oi, b_s),
