    case K.Quadvector{+a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i} K.Scalar{+b_s}:
      K.Quadvector{
        mul(a_e23oi, b_s),
        mul(a_e31oi, b_s),
        mul(a_e12oi, b_s),
        mul(a_e123o, b_s),
        mul(a_e123i, b_s)}

def Quadvector.rc.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Vector<T>) -> K.Trivector<T>:
  match a b:
    case K.Quadvector{+a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Trivector{
        add(neg(mul(a_e123o, b_e1)), neg(mul(a_e23oi, b_eo))),
        add(neg(mul(a_e123o, b_e2)), neg(mul(a_e31oi, b_eo))),
        add(neg(mul(a_e123o, b_e3)), neg(mul(a_e12oi, b_eo))),
        add(neg(mul(a_e123i, b_e1)), mul(a_e23oi, b_ei)),
        add(neg(mul(a_e123i, b_e2)), mul(a_e31oi, b_ei)),
        add(neg(mul(a_e123i, b_e3)), mul(a_e12oi, b_ei)),
        add(mul(a_e12oi, b_e2), neg(mul(a_e31oi, b_e3))),
        add(neg(mul(a_e12oi, b_e1)), mul(a_e23oi, b_e3)),
        add(mul(a_e31oi, b_e1), neg(mul(a_e23oi, b_e2))),
        add(neg(mul(a_e123i, b_eo)), neg(mul(a_e123o, b_ei)))}

def Quadvector.rc.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Twist<T>) -> K.Bivector<T>:
  match a b:
    case K.Quadvector{+a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i} K.Twist{+b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i}:
      K.Bivector{
        mul(a_e123o, b_e1i),
        mul(a_e123o, b_e2i),
        mul(a_e123o, b_e3i),
        neg(mul(a_e123o, b_e23)),
        neg(mul(a_e123o, b_e31)),
        neg(mul(a_e123o, b_e12)),
        add(add(neg(mul(a_e123i, b_e23)), mul(a_e12oi, b_e2i)), neg(mul(a_e31oi, b_e3i))),
        add(add(neg(mul(a_e123i, b_e31)), neg(mul(a_e12oi, b_e1i))), mul(a_e23oi, b_e3i)),
        add(add(neg(mul(a_e123i, b_e12)), mul(a_e31oi, b_e1i)), neg(mul(a_e23oi, b_e2i))),
        add(add(neg(mul(a_e12oi, b_e12)), neg(mul(a_e31oi, b_e31))), neg(mul(a_e23oi, b_e23)))}

def Quadvector.rc.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Bivector<T>) -> K.Bivector<T>:
  match a b:
    case K.Quadvector{+a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i} K.Bivector{+b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi}:
      K.Bivector{
        add(add(mul(a_e123i, b_e1o), mul(a_e123o, b_e1i)), mul(a_e23oi, b_eoi)),
        add(add(mul(a_e123i, b_e2o), mul(a_e123o, b_e2i)), mul(a_e31oi, b_eoi)),
        add(add(mul(a_e123i, b_e3o), mul(a_e123o, b_e3i)), mul(a_e12oi, b_eoi)),
        add(add(neg(mul(a_e123o, b_e23)), neg(mul(a_e12oi, b_e2o))), mul(a_e31oi, b_e3o)),
        add(add(neg(mul(a_e123o, b_e31)), mul(a_e12oi, b_e1o)), neg(mul(a_e23oi, b_e3o))),
        add(add(neg(mul(a_e123o, b_e12)), neg(mul(a_e31oi, b_e1o))), mul(a_e23oi, b_e2o)),
        add(add(neg(mul(a_e123i, b_e23)), mul(a_e12oi, b_e2i)), neg(mul(a_e31oi, b_e3i))),
        add(add(neg(mul(a_e123i, b_e31)), neg(mul(a_e12oi, b_e1i))), mul(a_e23oi, b_e3i)),
        add(add(neg(mul(a_e123i, b_e12)), mul(a_e31oi, b_e1i)), neg(mul(a_e23oi, b_e2i))),
        add(add(neg(mul(a_e12oi, b_e12)), neg(mul(a_e31oi, b_e31))), neg(mul(a_e23oi, b_e23)))}

def Quadvector.rc.Trivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Trivector<T>) -> K.Vector<T>:
  match a b:
    case K.Quadvector{+a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i} K.Trivector{+b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123}:
      K.Vector{
        add(add(add(mul(a_e123i, b_e23o), mul(a_e123o, b_e23i)), mul(a_e12oi, b_e2oi)), neg(mul(a_e31oi, b_e3oi))),
        add(add(add(mul(a_e123i, b_e31o), mul(a_e123o, b_e31i)), neg(mul(a_e12oi, b_e1oi))), mul(a_e23oi, b_e3oi)),
        add(add(add(mul(a_e123i, b_e12o), mul(a_e123o, b_e12i)), mul(a_e31oi, b_e1oi)), neg(mul(a_e23oi, b_e2oi))),
        add(add(add(mul(a_e123o, b_e123), mul(a_e12oi, b_e12o)), mul(a_e31oi, b_e31o)), mul(a_e23oi, b_e23o)),
        add(add(add(mul(a_e123i, b_e123), neg(mul(a_e12oi, b_e12i))), neg(mul(a_e31oi, b_e31i))), neg(mul(a_e23oi, b_e23i)))}

def Quadvector.rc.Quadvector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Quadvector<T>) -> K.Scalar<T>:
  match a b:
    case K.Quadvector{+a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i} K.Quadvector{+b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i}:
      K.Scalar{
        add(add(add(add(neg(mul(a_e123i, b_e123o)), neg(mul(a_e123o, b_e123i))), neg(mul(a_e12oi, b_e12oi))), neg(mul(a_e31oi, b_e31oi))), neg(mul(a_e23oi, b_e23oi)))}

def Quadvector.rc.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Motor<T>) -> K.Even<T>:
  match a b:
    case K.Quadvector{+a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i} K.Motor{+b_s, +b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i, +b_e123i}:
      K.Even{
        neg(mul(a_e123o, b_e123i)),
        mul(a_e123o, b_e1i),
        mul(a_e123o, b_e2i),
        mul(a_e123o, b_e3i),
        neg(mul(a_e123o, b_e23)),
        neg(mul(a_e123o, b_e31)),
        neg(mul(a_e123o, b_e12)),
        add(add(neg(mul(a_e123i, b_e23)), mul(a_e12oi, b_e2i)), neg(mul(a_e31oi, b_e3i))),
        add(add(neg(mul(a_e123i, b_e31)), neg(mul(a_e12oi, b_e1i))), mul(a_e23oi, b_e3i)),
        add(add(neg(mul(a_e123i, b_e12)), mul(a_e31oi, b_e1i)), neg(mul(a_e23oi, b_e2i))),
        add(add(neg(mul(a_e12oi, b_e12)), neg(mul(a_e31oi, b_e31))), neg(mul(a_e23oi, b_e23))),
        mul(a_e23oi, b_s),
        mul(a_e31oi, b_s),
        mul(a_e12oi, b_s),
        mul(a_e123o, b_s),
        mul(a_e123i, b_s)}

def Quadvector.rc.Even(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Even<T>) -> K.Even<T>:
  match a b:
    case K.Quadvector{+a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i} K.Even{+b_s, +b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi, +b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i}:
      K.Even{
        add(add(add(add(neg(mul(a_e123i, b_e123o)), neg(mul(a_e123o, b_e123i))), neg(mul(a_e12oi, b_e12oi))), neg(mul(a_e31oi, b_e31oi))), neg(mul(a_e23oi, b_e23oi))),
        add(add(mul(a_e123i, b_e1o), mul(a_e123o, b_e1i)), mul(a_e23oi, b_eoi)),
        add(add(mul(a_e123i, b_e2o), mul(a_e123o, b_e2i)), mul(a_e31oi, b_eoi)),
        add(add(mul(a_e123i, b_e3o), mul(a_e123o, b_e3i)), mul(a_e12oi, b_eoi)),
        add(add(neg(mul(a_e123o, b_e23)), neg(mul(a_e12oi, b_e2o))), mul(a_e31oi, b_e3o)),
        add(add(neg(mul(a_e123o, b_e31)), mul(a_e12oi, b_e1o)), neg(mul(a_e23oi, b_e3o))),
        add(add(neg(mul(a_e123o, b_e12)), neg(mul(a_e31oi, b_e1o))), mul(a_e23oi, b_e2o)),
        add(add(neg(mul(a_e123i, b_e23)), mul(a_e12oi, b_e2i)), neg(mul(a_e31oi, b_e3i))),
        add(add(neg(mul(a_e123i, b_e31)), neg(mul(a_e12oi, b_e1i))), mul(a_e23oi, b_e3i)),
        add(add(neg(mul(a_e123i, b_e12)), mul(a_e31oi, b_e1i)), neg(mul(a_e23oi, b_e2i))),
        add(add(neg(mul(a_e12oi, b_e12)), neg(mul(a_e31oi, b_e31))), neg(mul(a_e23oi, b_e23))),
        mul(a_e23oi, b_s),
        mul(a_e31oi, b_s),
        mul(a_e12oi, b_s),
        mul(a_e123o, b_s),
        mul(a_e123i, b_s)}

def Quadvector.rc.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Odd<T>) -> K.Odd<T>:
  match a b:
    case K.Quadvector{+a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i} K.Odd{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei, +b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123, +b_e123oi}:
      K.Odd{
        add(add(add(mul(a_e123i, b_e23o), mul(a_e123o, b_e23i)), mul(a_e12oi, b_e2oi)), neg(mul(a_e31oi, b_e3oi))),
        add(add(add(mul(a_e123i, b_e31o), mul(a_e123o, b_e31i)), neg(mul(a_e12oi, b_e1oi))), mul(a_e23oi, b_e3oi)),
        add(add(add(mul(a_e123i, b_e12o), mul(a_e123o, b_e12i)), mul(a_e31oi, b_e1oi)), neg(mul(a_e23oi, b_e2oi))),
        add(add(add(mul(a_e123o, b_e123), mul(a_e12oi, b_e12o)), mul(a_e31oi, b_e31o)), mul(a_e23oi, b_e23o)),
        add(add(add(mul(a_e123i, b_e123), neg(mul(a_e12oi, b_e12i))), neg(mul(a_e31oi, b_e31i))), neg(mul(a_e23oi, b_e23i))),
        add(neg(mul(a_e123o, b_e1)), neg(mul(a_e23oi, b_eo))),
        add(neg(mul(a_e123o, b_e2)), neg(mul(a_e31oi, b_eo))),
        add(neg(mul(a_e123o, b_e3)), neg(mul(a_e12oi, b_eo))),
        add(neg(mul(a_e123i, b_e1)), mul(a_e23oi, b_ei)),
        add(neg(mul(a_e123i, b_e2)), mul(a_e31oi, b_ei)),
        add(neg(mul(a_e123i, b_e3)), mul(a_e12oi, b_ei)),
        add(mul(a_e12oi, b_e2), neg(mul(a_e31oi, b_e3))),
        add(neg(mul(a_e12oi, b_e1)), mul(a_e23oi, b_e3)),
        add(mul(a_e31oi, b_e1), neg(mul(a_e23oi, b_e2))),
        add(neg(mul(a_e123i, b_eo)), neg(mul(a_e123o, b_ei))),
        zero}

def Quadvector.rc.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Quadvector{+a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i} K.Multivector{+b_s, +b_e1, +b_e2, +b_e3, +b_eo, +b_ei, +b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi, +b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123, +b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i, +b_e123oi}:
      K.Multivector{
        add(add(add(add(neg(mul(a_e123i, b_e123o)), neg(mul(a_e123o, b_e123i))), neg(mul(a_e12oi, b_e12oi))), neg(mul(a_e31oi, b_e31oi))), neg(mul(a_e23oi, b_e23oi))),
        add(add(add(mul(a_e123i, b_e23o), mul(a_e123o, b_e23i)), mul(a_e12oi, b_e2oi)), neg(mul(a_e31oi, b_e3oi))),
        add(add(add(mul(a_e123i, b_e31o), mul(a_e123o, b_e31i)), neg(mul(a_e12oi, b_e1oi))), mul(a_e23oi, b_e3oi)),
        add(add(add(mul(a_e123i, b_e12o), mul(a_e123o, b_e12i)), mul(a_e31oi, b_e1oi)), neg(mul(a_e23oi, b_e2oi))),
        add(add(add(mul(a_e123o, b_e123), mul(a_e12oi, b_e12o)), mul(a_e31oi, b_e31o)), mul(a_e23oi, b_e23o)),
        add(add(add(mul(a_e123i, b_e123), neg(mul(a_e12oi, b_e12i))), neg(mul(a_e31oi, b_e31i))), neg(mul(a_e23oi, b_e23i))),
        add(add(mul(a_e123i, b_e1o), mul(a_e123o, b_e1i)), mul(a_e23oi, b_eoi)),
        add(add(mul(a_e123i, b_e2o), mul(a_e123o, b_e2i)), mul(a_e31oi, b_eoi)),
        add(add(mul(a_e123i, b_e3o), mul(a_e123o, b_e3i)), mul(a_e12oi, b_eoi)),
        add(add(neg(mul(a_e123o, b_e23)), neg(mul(a_e12oi, b_e2o))), mul(a_e31oi, b_e3o)),
        add(add(neg(mul(a_e123o, b_e31)), mul(a_e12oi, b_e1o)), neg(mul(a_e23oi, b_e3o))),
        add(add(neg(mul(a_e123o, b_e12)), neg(mul(a_e31oi, b_e1o))), mul(a_e23oi, b_e2o)),
        add(add(neg(mul(a_e123i, b_e23)), mul(a_e12oi, b_e2i)), neg(mul(a_e31oi, b_e3i))),
        add(add(neg(mul(a_e123i, b_e31)), neg(mul(a_e12oi, b_e1i))), mul(a_e23oi, b_e3i)),
        add(add(neg(mul(a_e123i, b_e12)), mul(a_e31oi, b_e1i)), neg(mul(a_e23oi, b_e2i))),
        add(add(neg(mul(a_e12oi, b_e12)), neg(mul(a_e31oi, b_e31))), neg(mul(a_e23oi, b_e23))),
        add(neg(mul(a_e123o, b_e1)), neg(mul(a_e23oi, b_eo))),
        add(neg(mul(a_e123o, b_e2)), neg(mul(a_e31oi, b_eo))),
        add(neg(mul(a_e123o, b_e3)), neg(mul(a_e12oi, b_eo))),
        add(neg(mul(a_e123i, b_e1)), mul(a_e23oi, b_ei)),
        add(neg(mul(a_e123i, b_e2)), mul(a_e31oi, b_ei)),
        add(neg(mul(a_e123i, b_e3)), mul(a_e12oi, b_ei)),
        add(mul(a_e12oi, b_e2), neg(mul(a_e31oi, b_e3))),
        add(neg(mul(a_e12oi, b_e1)), mul(a_e23oi, b_e3)),
        add(mul(a_e31oi, b_e1), neg(mul(a_e23oi, b_e2))),
        add(neg(mul(a_e123i, b_eo)), neg(mul(a_e123o, b_ei))),
        mul(a_e23oi, b_s),
        mul(a_e31oi, b_s),
        mul(a_e12oi, b_s),
        mul(a_e123o, b_s),
        mul(a_e123i, b_s),
        zero}

def Pseudoscalar.rc.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Scalar<T>) -> K.Pseudoscalar<T>:
  match a b:
    case K.Pseudoscalar{+a_e123oi} K.Scalar{+b_s}:
      K.Pseudoscalar{
        mul(a_e123oi, b_s)}

def Pseudoscalar.rc.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Vector<T>) -> K.Quadvector<T>:
  match a b:
    case K.Pseudoscalar{+a_e123oi} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Quadvector{
        mul(a_e123oi, b_e1),
        mul(a_e123oi, b_e2),
        mul(a_e123oi, b_e3),
        neg(mul(a_e123oi, b_eo)),
        mul(a_e123oi, b_ei)}

def Pseudoscalar.rc.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Twist<T>) -> K.Trivector<T>:
  match a b:
    case K.Pseudoscalar{+a_e123oi} K.Twist{+b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i}:
      K.Trivector{
        zero,
        zero,
        zero,
        mul(a_e123oi, b_e1i),
        mul(a_e123oi, b_e2i),
        mul(a_e123oi, b_e3i),
        neg(mul(a_e123oi, b_e23)),
        neg(mul(a_e123oi, b_e31)),
        neg(mul(a_e123oi, b_e12)),
        zero}

def Pseudoscalar.rc.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Bivector<T>) -> K.Trivector<T>:
  match a b:
    case K.Pseudoscalar{+a_e123oi} K.Bivector{+b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi}:
      K.Trivector{
        neg(mul(a_e123oi, b_e1o)),
        neg(mul(a_e123oi, b_e2o)),
        neg(mul(a_e123oi, b_e3o)),
        mul(a_e123oi, b_e1i),
        mul(a_e123oi, b_e2i),
        mul(a_e123oi, b_e3i),
        neg(mul(a_e123oi, b_e23)),
        neg(mul(a_e123oi, b_e31)),
        neg(mul(a_e123oi, b_e12)),
        mul(a_e123oi, b_eoi)}

def Pseudoscalar.rc.Trivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Pseudoscalar<T>, b: K.Trivector<T>) -> K.Bivector<T>:
  match a b:
    case K.Pseudoscalar{+a_e123oi} K.Trivector{+b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123}:
      K.Bivector{
        mul(a_e123oi, b_e1oi),
        mul(a_e123oi, b_e2oi),
