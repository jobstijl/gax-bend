      K.Odd{
        add(add(add(mul(a_e3oi, b_e31oi), neg(mul(a_e2oi, b_e12oi))), neg(mul(a_e23i, b_e123o))), neg(mul(a_e23o, b_e123i))),
        add(add(add(neg(mul(a_e3oi, b_e23oi)), mul(a_e1oi, b_e12oi)), neg(mul(a_e31i, b_e123o))), neg(mul(a_e31o, b_e123i))),
        add(add(add(mul(a_e2oi, b_e23oi), neg(mul(a_e1oi, b_e31oi))), neg(mul(a_e12i, b_e123o))), neg(mul(a_e12o, b_e123i))),
        add(add(add(neg(mul(a_e123, b_e123o)), neg(mul(a_e12o, b_e12oi))), neg(mul(a_e31o, b_e31oi))), neg(mul(a_e23o, b_e23oi))),
        add(add(add(neg(mul(a_e123, b_e123i)), mul(a_e12i, b_e12oi)), mul(a_e31i, b_e31oi)), mul(a_e23i, b_e23oi)),
        add(mul(a_eo, b_e23oi), mul(a_e1, b_e123o)),
