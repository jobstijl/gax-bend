        add(add(neg(mul(a_e2i, b_eo)), neg(mul(a_e12, b_e1))), mul(a_e23, b_e3)),
        add(add(neg(mul(a_e3i, b_eo)), mul(a_e31, b_e1)), neg(mul(a_e23, b_e2))),
        zero,
        add(add(neg(mul(a_e3i, b_e3)), neg(mul(a_e2i, b_e2))), neg(mul(a_e1i, b_e1))),
        zero,
        zero,
        zero,
        neg(mul(a_e123i, b_e1)),
        neg(mul(a_e123i, b_e2)),
        neg(mul(a_e123i, b_e3)),
        zero,
        zero,
        zero,
        neg(mul(a_e123i, b_eo)),
        zero}

def Motor.commutator.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Twist<T>) -> K.Twist<T>:
  match a b:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Twist{+b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i}:
      K.Twist{
        add(mul(a_e12, b_e31), neg(mul(a_e31, b_e12))),
        add(neg(mul(a_e12, b_e23)), mul(a_e23, b_e12)),
        add(mul(a_e31, b_e23), neg(mul(a_e23, b_e31))),
        add(add(add(mul(a_e3i, b_e31), neg(mul(a_e2i, b_e12))), mul(a_e12, b_e2i)), neg(mul(a_e31, b_e3i))),
        add(add(add(neg(mul(a_e3i, b_e23)), mul(a_e1i, b_e12)), neg(mul(a_e12, b_e1i))), mul(a_e23, b_e3i)),
        add(add(add(mul(a_e2i, b_e23), neg(mul(a_e1i, b_e31))), mul(a_e31, b_e1i)), neg(mul(a_e23, b_e2i)))}

def Motor.commutator.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Bivector<T>) -> K.Even<T>:
  match a b:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Bivector{+b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi}:
      K.Even{
        zero,
        add(add(add(neg(mul(a_e3i, b_e2o)), mul(a_e2i, b_e3o)), mul(a_e12, b_e31)), neg(mul(a_e31, b_e12))),
        add(add(add(mul(a_e3i, b_e1o), neg(mul(a_e1i, b_e3o))), neg(mul(a_e12, b_e23))), mul(a_e23, b_e12)),
        add(add(add(neg(mul(a_e2i, b_e1o)), mul(a_e1i, b_e2o)), mul(a_e31, b_e23)), neg(mul(a_e23, b_e31))),
        add(mul(a_e12, b_e2o), neg(mul(a_e31, b_e3o))),
        add(neg(mul(a_e12, b_e1o)), mul(a_e23, b_e3o)),
        add(mul(a_e31, b_e1o), neg(mul(a_e23, b_e2o))),
        add(add(add(add(mul(a_e3i, b_e31), neg(mul(a_e2i, b_e12))), neg(mul(a_e1i, b_eoi))), mul(a_e12, b_e2i)), neg(mul(a_e31, b_e3i))),
        add(add(add(add(neg(mul(a_e3i, b_e23)), neg(mul(a_e2i, b_eoi))), mul(a_e1i, b_e12)), neg(mul(a_e12, b_e1i))), mul(a_e23, b_e3i)),
        add(add(add(add(neg(mul(a_e3i, b_eoi)), mul(a_e2i, b_e23)), neg(mul(a_e1i, b_e31))), mul(a_e31, b_e1i)), neg(mul(a_e23, b_e2i))),
        add(add(mul(a_e3i, b_e3o), mul(a_e2i, b_e2o)), mul(a_e1i, b_e1o)),
        mul(a_e123i, b_e1o),
        mul(a_e123i, b_e2o),
        mul(a_e123i, b_e3o),
        zero,
        neg(mul(a_e123i, b_eoi))}

def Motor.commutator.Trivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Trivector<T>) -> K.Odd<T>:
  match a b:
