        add(add(add(add(mul(a_e123i, b_e12o), mul(a_e123o, b_e12i)), neg(mul(a_e12oi, b_e123oi))), mul(a_e31oi, b_e1oi)), neg(mul(a_e23oi, b_e2oi))),
        add(add(add(add(mul(a_e123o, b_e123oi), mul(a_e123o, b_e123)), mul(a_e12oi, b_e12o)), mul(a_e31oi, b_e31o)), mul(a_e23oi, b_e23o)),
        add(add(add(add(neg(mul(a_e123i, b_e123oi)), mul(a_e123i, b_e123)), neg(mul(a_e12oi, b_e12i))), neg(mul(a_e31oi, b_e31i))), neg(mul(a_e23oi, b_e23i))),
        add(add(mul(a_e123i, b_e1o), mul(a_e123o, b_e1i)), mul(a_e23oi, b_eoi)),
        add(add(mul(a_e123i, b_e2o), mul(a_e123o, b_e2i)), mul(a_e31oi, b_eoi)),
        add(add(mul(a_e123i, b_e3o), mul(a_e123o, b_e3i)), mul(a_e12oi, b_eoi)),
