        add(add(add(add(neg(mul(a_e3i, b_e23)), neg(mul(a_e2i, b_eoi))), mul(a_e1i, b_e12)), neg(mul(a_e12, b_e1i))), mul(a_e23, b_e3i)),
        add(add(add(add(neg(mul(a_e3i, b_eoi)), mul(a_e2i, b_e23)), neg(mul(a_e1i, b_e31))), mul(a_e31, b_e1i)), neg(mul(a_e23, b_e2i))),
        add(add(mul(a_e3i, b_e3o), mul(a_e2i, b_e2o)), mul(a_e1i, b_e1o)),
        add(mul(a_e12, b_e31o), neg(mul(a_e31, b_e12o))),
