        mul(a_eo, b_e31),
        mul(a_eo, b_e12),
        add(add(add(mul(a_ei, b_e23), neg(mul(a_e3, b_e2i))), mul(a_e2, b_e3i)), mul(a_e1, b_e123i)),
        add(add(add(mul(a_ei, b_e31), mul(a_e3, b_e1i)), mul(a_e2, b_e123i)), neg(mul(a_e1, b_e3i))),
        add(add(add(mul(a_ei, b_e12), mul(a_e3, b_e123i)), neg(mul(a_e2, b_e1i))), mul(a_e1, b_e2i)),
        neg(mul(a_eo, b_e1i)),
        neg(mul(a_eo, b_e2i)),
        neg(mul(a_eo, b_e3i)),
        add(add(add(mul(a_eo, b_e123i), mul(a_e3, b_e12)), mul(a_e2, b_e31)), mul(a_e1, b_e23)),
        neg(mul(a_eo, b_e123i))}

def Vector.gp.Even(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Even<T>) -> K.Odd<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Even{+b_s, +b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi, +b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i}:
      K.Odd{
        add(add(add(add(mul(a_ei, b_e1o), mul(a_eo, b_e1i)), mul(a_e3, b_e31)), neg(mul(a_e2, b_e12))), mul(a_e1, b_s)),
        add(add(add(add(mul(a_ei, b_e2o), mul(a_eo, b_e2i)), neg(mul(a_e3, b_e23))), mul(a_e2, b_s)), mul(a_e1, b_e12)),
        add(add(add(add(mul(a_ei, b_e3o), mul(a_eo, b_e3i)), mul(a_e3, b_s)), mul(a_e2, b_e23)), neg(mul(a_e1, b_e31))),
        add(add(add(add(mul(a_eo, b_eoi), mul(a_eo, b_s)), mul(a_e3, b_e3o)), mul(a_e2, b_e2o)), mul(a_e1, b_e1o)),
        add(add(add(add(neg(mul(a_ei, b_eoi)), mul(a_ei, b_s)), mul(a_e3, b_e3i)), mul(a_e2, b_e2i)), mul(a_e1, b_e1i)),
        add(add(add(add(mul(a_eo, b_e23oi), mul(a_eo, b_e23)), neg(mul(a_e3, b_e2o))), mul(a_e2, b_e3o)), mul(a_e1, b_e123o)),
        add(add(add(add(mul(a_eo, b_e31oi), mul(a_eo, b_e31)), mul(a_e3, b_e1o)), mul(a_e2, b_e123o)), neg(mul(a_e1, b_e3o))),
        add(add(add(add(mul(a_eo, b_e12oi), mul(a_eo, b_e12)), mul(a_e3, b_e123o)), neg(mul(a_e2, b_e1o))), mul(a_e1, b_e2o)),
        add(add(add(add(neg(mul(a_ei, b_e23oi)), mul(a_ei, b_e23)), neg(mul(a_e3, b_e2i))), mul(a_e2, b_e3i)), mul(a_e1, b_e123i)),
        add(add(add(add(neg(mul(a_ei, b_e31oi)), mul(a_ei, b_e31)), mul(a_e3, b_e1i)), mul(a_e2, b_e123i)), neg(mul(a_e1, b_e3i))),
        add(add(add(add(neg(mul(a_ei, b_e12oi)), mul(a_ei, b_e12)), mul(a_e3, b_e123i)), neg(mul(a_e2, b_e1i))), mul(a_e1, b_e2i)),
        add(add(add(add(mul(a_ei, b_e1o), neg(mul(a_eo, b_e1i))), mul(a_e3, b_e31oi)), neg(mul(a_e2, b_e12oi))), mul(a_e1, b_eoi)),
        add(add(add(add(mul(a_ei, b_e2o), neg(mul(a_eo, b_e2i))), neg(mul(a_e3, b_e23oi))), mul(a_e2, b_eoi)), mul(a_e1, b_e12oi)),
        add(add(add(add(mul(a_ei, b_e3o), neg(mul(a_eo, b_e3i))), mul(a_e3, b_eoi)), mul(a_e2, b_e23oi)), neg(mul(a_e1, b_e31oi))),
        add(add(add(add(mul(a_ei, b_e123o), mul(a_eo, b_e123i)), mul(a_e3, b_e12)), mul(a_e2, b_e31)), mul(a_e1, b_e23)),
        add(add(add(add(mul(a_ei, b_e123o), neg(mul(a_eo, b_e123i))), mul(a_e3, b_e12oi)), mul(a_e2, b_e31oi)), mul(a_e1, b_e23oi))}

def Vector.gp.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Odd<T>) -> K.Even<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Odd{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei, +b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123, +b_e123oi}:
      K.Even{
        add(add(add(add(neg(mul(a_ei, b_eo)), neg(mul(a_eo, b_ei))), mul(a_e3, b_e3)), mul(a_e2, b_e2)), mul(a_e1, b_e1)),
        add(add(add(add(neg(mul(a_ei, b_e23o)), neg(mul(a_eo, b_e23i))), neg(mul(a_e3, b_e2))), mul(a_e2, b_e3)), mul(a_e1, b_e123)),
        add(add(add(add(neg(mul(a_ei, b_e31o)), neg(mul(a_eo, b_e31i))), mul(a_e3, b_e1)), mul(a_e2, b_e123)), neg(mul(a_e1, b_e3))),
        add(add(add(add(neg(mul(a_ei, b_e12o)), neg(mul(a_eo, b_e12i))), mul(a_e3, b_e123)), neg(mul(a_e2, b_e1))), mul(a_e1, b_e2)),
        add(add(add(add(neg(mul(a_eo, b_e1oi)), neg(mul(a_eo, b_e1))), mul(a_e3, b_e31o)), neg(mul(a_e2, b_e12o))), mul(a_e1, b_eo)),
        add(add(add(add(neg(mul(a_eo, b_e2oi)), neg(mul(a_eo, b_e2))), neg(mul(a_e3, b_e23o))), mul(a_e2, b_eo)), mul(a_e1, b_e12o)),
        add(add(add(add(neg(mul(a_eo, b_e3oi)), neg(mul(a_eo, b_e3))), mul(a_e3, b_eo)), mul(a_e2, b_e23o)), neg(mul(a_e1, b_e31o))),
        add(add(add(add(mul(a_ei, b_e1oi), neg(mul(a_ei, b_e1))), mul(a_e3, b_e31i)), neg(mul(a_e2, b_e12i))), mul(a_e1, b_ei)),
        add(add(add(add(mul(a_ei, b_e2oi), neg(mul(a_ei, b_e2))), neg(mul(a_e3, b_e23i))), mul(a_e2, b_ei)), mul(a_e1, b_e12i)),
        add(add(add(add(mul(a_ei, b_e3oi), neg(mul(a_ei, b_e3))), mul(a_e3, b_ei)), mul(a_e2, b_e23i)), neg(mul(a_e1, b_e31i))),
        add(add(add(add(neg(mul(a_ei, b_eo)), mul(a_eo, b_ei)), mul(a_e3, b_e3oi)), mul(a_e2, b_e2oi)), mul(a_e1, b_e1oi)),
        add(add(add(add(neg(mul(a_ei, b_e23o)), mul(a_eo, b_e23i)), neg(mul(a_e3, b_e2oi))), mul(a_e2, b_e3oi)), mul(a_e1, b_e123oi)),
        add(add(add(add(neg(mul(a_ei, b_e31o)), mul(a_eo, b_e31i)), mul(a_e3, b_e1oi)), mul(a_e2, b_e123oi)), neg(mul(a_e1, b_e3oi))),
        add(add(add(add(neg(mul(a_ei, b_e12o)), mul(a_eo, b_e12i)), mul(a_e3, b_e123oi)), neg(mul(a_e2, b_e1oi))), mul(a_e1, b_e2oi)),
        add(add(add(add(neg(mul(a_eo, b_e123oi)), neg(mul(a_eo, b_e123))), mul(a_e3, b_e12o)), mul(a_e2, b_e31o)), mul(a_e1, b_e23o)),
        add(add(add(add(mul(a_ei, b_e123oi), neg(mul(a_ei, b_e123))), mul(a_e3, b_e12i)), mul(a_e2, b_e31i)), mul(a_e1, b_e23i))}

def Vector.gp.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Multivector{+b_s, +b_e1, +b_e2, +b_e3, +b_eo, +b_ei, +b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi, +b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123, +b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i, +b_e123oi}:
      K.Multivector{
        add(add(add(add(neg(mul(a_ei, b_eo)), neg(mul(a_eo, b_ei))), mul(a_e3, b_e3)), mul(a_e2, b_e2)), mul(a_e1, b_e1)),
        add(add(add(add(mul(a_ei, b_e1o), mul(a_eo, b_e1i)), mul(a_e3, b_e31)), neg(mul(a_e2, b_e12))), mul(a_e1, b_s)),
        add(add(add(add(mul(a_ei, b_e2o), mul(a_eo, b_e2i)), neg(mul(a_e3, b_e23))), mul(a_e2, b_s)), mul(a_e1, b_e12)),
        add(add(add(add(mul(a_ei, b_e3o), mul(a_eo, b_e3i)), mul(a_e3, b_s)), mul(a_e2, b_e23)), neg(mul(a_e1, b_e31))),
        add(add(add(add(mul(a_eo, b_eoi), mul(a_eo, b_s)), mul(a_e3, b_e3o)), mul(a_e2, b_e2o)), mul(a_e1, b_e1o)),
        add(add(add(add(neg(mul(a_ei, b_eoi)), mul(a_ei, b_s)), mul(a_e3, b_e3i)), mul(a_e2, b_e2i)), mul(a_e1, b_e1i)),
        add(add(add(add(neg(mul(a_ei, b_e23o)), neg(mul(a_eo, b_e23i))), neg(mul(a_e3, b_e2))), mul(a_e2, b_e3)), mul(a_e1, b_e123)),
        add(add(add(add(neg(mul(a_ei, b_e31o)), neg(mul(a_eo, b_e31i))), mul(a_e3, b_e1)), mul(a_e2, b_e123)), neg(mul(a_e1, b_e3))),
        add(add(add(add(neg(mul(a_ei, b_e12o)), neg(mul(a_eo, b_e12i))), mul(a_e3, b_e123)), neg(mul(a_e2, b_e1))), mul(a_e1, b_e2)),
        add(add(add(add(neg(mul(a_eo, b_e1oi)), neg(mul(a_eo, b_e1))), mul(a_e3, b_e31o)), neg(mul(a_e2, b_e12o))), mul(a_e1, b_eo)),
        add(add(add(add(neg(mul(a_eo, b_e2oi)), neg(mul(a_eo, b_e2))), neg(mul(a_e3, b_e23o))), mul(a_e2, b_eo)), mul(a_e1, b_e12o)),
        add(add(add(add(neg(mul(a_eo, b_e3oi)), neg(mul(a_eo, b_e3))), mul(a_e3, b_eo)), mul(a_e2, b_e23o)), neg(mul(a_e1, b_e31o))),
        add(add(add(add(mul(a_ei, b_e1oi), neg(mul(a_ei, b_e1))), mul(a_e3, b_e31i)), neg(mul(a_e2, b_e12i))), mul(a_e1, b_ei)),
        add(add(add(add(mul(a_ei, b_e2oi), neg(mul(a_ei, b_e2))), neg(mul(a_e3, b_e23i))), mul(a_e2, b_ei)), mul(a_e1, b_e12i)),
        add(add(add(add(mul(a_ei, b_e3oi), neg(mul(a_ei, b_e3))), mul(a_e3, b_ei)), mul(a_e2, b_e23i)), neg(mul(a_e1, b_e31i))),
        add(add(add(add(neg(mul(a_ei, b_eo)), mul(a_eo, b_ei)), mul(a_e3, b_e3oi)), mul(a_e2, b_e2oi)), mul(a_e1, b_e1oi)),
        add(add(add(add(mul(a_eo, b_e23oi), mul(a_eo, b_e23)), neg(mul(a_e3, b_e2o))), mul(a_e2, b_e3o)), mul(a_e1, b_e123o)),
        add(add(add(add(mul(a_eo, b_e31oi), mul(a_eo, b_e31)), mul(a_e3, b_e1o)), mul(a_e2, b_e123o)), neg(mul(a_e1, b_e3o))),
        add(add(add(add(mul(a_eo, b_e12oi), mul(a_eo, b_e12)), mul(a_e3, b_e123o)), neg(mul(a_e2, b_e1o))), mul(a_e1, b_e2o)),
        add(add(add(add(neg(mul(a_ei, b_e23oi)), mul(a_ei, b_e23)), neg(mul(a_e3, b_e2i))), mul(a_e2, b_e3i)), mul(a_e1, b_e123i)),
        add(add(add(add(neg(mul(a_ei, b_e31oi)), mul(a_ei, b_e31)), mul(a_e3, b_e1i)), mul(a_e2, b_e123i)), neg(mul(a_e1, b_e3i))),
        add(add(add(add(neg(mul(a_ei, b_e12oi)), mul(a_ei, b_e12)), mul(a_e3, b_e123i)), neg(mul(a_e2, b_e1i))), mul(a_e1, b_e2i)),
        add(add(add(add(mul(a_ei, b_e1o), neg(mul(a_eo, b_e1i))), mul(a_e3, b_e31oi)), neg(mul(a_e2, b_e12oi))), mul(a_e1, b_eoi)),
        add(add(add(add(mul(a_ei, b_e2o), neg(mul(a_eo, b_e2i))), neg(mul(a_e3, b_e23oi))), mul(a_e2, b_eoi)), mul(a_e1, b_e12oi)),
        add(add(add(add(mul(a_ei, b_e3o), neg(mul(a_eo, b_e3i))), mul(a_e3, b_eoi)), mul(a_e2, b_e23oi)), neg(mul(a_e1, b_e31oi))),
        add(add(add(add(mul(a_ei, b_e123o), mul(a_eo, b_e123i)), mul(a_e3, b_e12)), mul(a_e2, b_e31)), mul(a_e1, b_e23)),
        add(add(add(add(neg(mul(a_ei, b_e23o)), mul(a_eo, b_e23i)), neg(mul(a_e3, b_e2oi))), mul(a_e2, b_e3oi)), mul(a_e1, b_e123oi)),
        add(add(add(add(neg(mul(a_ei, b_e31o)), mul(a_eo, b_e31i)), mul(a_e3, b_e1oi)), mul(a_e2, b_e123oi)), neg(mul(a_e1, b_e3oi))),
        add(add(add(add(neg(mul(a_ei, b_e12o)), mul(a_eo, b_e12i)), mul(a_e3, b_e123oi)), neg(mul(a_e2, b_e1oi))), mul(a_e1, b_e2oi)),
        add(add(add(add(neg(mul(a_eo, b_e123oi)), neg(mul(a_eo, b_e123))), mul(a_e3, b_e12o)), mul(a_e2, b_e31o)), mul(a_e1, b_e23o)),
        add(add(add(add(mul(a_ei, b_e123oi), neg(mul(a_ei, b_e123))), mul(a_e3, b_e12i)), mul(a_e2, b_e31i)), mul(a_e1, b_e23i)),
        add(add(add(add(mul(a_ei, b_e123o), neg(mul(a_eo, b_e123i))), mul(a_e3, b_e12oi)), mul(a_e2, b_e31oi)), mul(a_e1, b_e23oi))}

def Twist.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Twist<T>, b: K.Scalar<T>) -> K.Twist<T>:
  match a b:
    case K.Twist{+a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i} K.Scalar{+b_s}:
      K.Twist{
        mul(a_e23, b_s),
        mul(a_e31, b_s),
        mul(a_e12, b_s),
        mul(a_e1i, b_s),
        mul(a_e2i, b_s),
        mul(a_e3i, b_s)}

def Twist.gp.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Twist<T>, b: K.Vector<T>) -> K.Odd<T>:
  match a b:
    case K.Twist{+a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Odd{
        add(add(neg(mul(a_e1i, b_eo)), mul(a_e12, b_e2)), neg(mul(a_e31, b_e3))),
        add(add(neg(mul(a_e2i, b_eo)), neg(mul(a_e12, b_e1))), mul(a_e23, b_e3)),
        add(add(neg(mul(a_e3i, b_eo)), mul(a_e31, b_e1)), neg(mul(a_e23, b_e2))),
        zero,
        add(add(neg(mul(a_e3i, b_e3)), neg(mul(a_e2i, b_e2))), neg(mul(a_e1i, b_e1))),
        mul(a_e23, b_eo),
        mul(a_e31, b_eo),
        mul(a_e12, b_eo),
        add(add(mul(a_e3i, b_e2), neg(mul(a_e2i, b_e3))), mul(a_e23, b_ei)),
        add(add(neg(mul(a_e3i, b_e1)), mul(a_e1i, b_e3)), mul(a_e31, b_ei)),
        add(add(mul(a_e2i, b_e1), neg(mul(a_e1i, b_e2))), mul(a_e12, b_ei)),
        neg(mul(a_e1i, b_eo)),
        neg(mul(a_e2i, b_eo)),
        neg(mul(a_e3i, b_eo)),
        add(add(mul(a_e12, b_e3), mul(a_e31, b_e2)), mul(a_e23, b_e1)),
        zero}

def Twist.gp.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Twist<T>, b: K.Twist<T>) -> K.Motor<T>:
  match a b:
    case K.Twist{+a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i} K.Twist{+b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i}:
      K.Motor{
        add(add(neg(mul(a_e12, b_e12)), neg(mul(a_e31, b_e31))), neg(mul(a_e23, b_e23))),
        add(mul(a_e12, b_e31), neg(mul(a_e31, b_e12))),
        add(neg(mul(a_e12, b_e23)), mul(a_e23, b_e12)),
        add(mul(a_e31, b_e23), neg(mul(a_e23, b_e31))),
        add(add(add(mul(a_e3i, b_e31), neg(mul(a_e2i, b_e12))), mul(a_e12, b_e2i)), neg(mul(a_e31, b_e3i))),
        add(add(add(neg(mul(a_e3i, b_e23)), mul(a_e1i, b_e12)), neg(mul(a_e12, b_e1i))), mul(a_e23, b_e3i)),
        add(add(add(mul(a_e2i, b_e23), neg(mul(a_e1i, b_e31))), mul(a_e31, b_e1i)), neg(mul(a_e23, b_e2i))),
        add(add(add(add(add(mul(a_e3i, b_e12), mul(a_e2i, b_e31)), mul(a_e1i, b_e23)), mul(a_e12, b_e3i)), mul(a_e31, b_e2i)), mul(a_e23, b_e1i))}

def Twist.gp.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Twist<T>, b: K.Bivector<T>) -> K.Even<T>:
  match a b:
    case K.Twist{+a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i} K.Bivector{+b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi}:
      K.Even{
        add(add(add(add(add(mul(a_e3i, b_e3o), mul(a_e2i, b_e2o)), mul(a_e1i, b_e1o)), neg(mul(a_e12, b_e12))), neg(mul(a_e31, b_e31))), neg(mul(a_e23, b_e23))),
        add(add(add(neg(mul(a_e3i, b_e2o)), mul(a_e2i, b_e3o)), mul(a_e12, b_e31)), neg(mul(a_e31, b_e12))),
        add(add(add(mul(a_e3i, b_e1o), neg(mul(a_e1i, b_e3o))), neg(mul(a_e12, b_e23))), mul(a_e23, b_e12)),
