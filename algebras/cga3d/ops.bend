        add(add(mul(a_e1oi, b_ei), neg(mul(a_e12i, b_e2))), mul(a_e31i, b_e3)),
        add(add(mul(a_e2oi, b_ei), mul(a_e12i, b_e1)), neg(mul(a_e23i, b_e3))),
        add(add(mul(a_e3oi, b_ei), neg(mul(a_e31i, b_e1))), mul(a_e23i, b_e2)),
        add(add(mul(a_e3oi, b_e3), mul(a_e2oi, b_e2)), mul(a_e1oi, b_e1)),
        add(neg(mul(a_e123o, b_e1)), neg(mul(a_e23oi, b_eo))),
