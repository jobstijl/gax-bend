        mul(a_e23, b_s),
        mul(a_e31, b_s),
        mul(a_e12, b_s),
        mul(a_e1o, b_s),
        mul(a_e2o, b_s),
        mul(a_e3o, b_s),
        mul(a_e1i, b_s),
        mul(a_e2i, b_s),
        mul(a_e3i, b_s),
        mul(a_eoi, b_s),
        mul(a_e23oi, b_s),
        mul(a_e31oi, b_s),
        mul(a_e12oi, b_s),
        mul(a_e123o, b_s),
        mul(a_e123i, b_s)}

