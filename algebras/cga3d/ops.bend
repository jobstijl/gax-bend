      +q3_4 = mul(a_eo, a_ei)
      +q2_2 = mul(a_e3, a_e3)
      +q1_1 = mul(a_e2, a_e2)
      +q0_0 = mul(a_e1, a_e1)
      +m0_0 = add(add(add(add(neg(q3_4), neg(q3_4)), q2_2), q1_1), q0_0)
      VectorScalarMap{m0_0}

