def Vector.wedge.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Scalar<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Scalar{+b_s}:
      K.Vector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_eo, b_s),
        mul(a_ei, b_s)}

def Vector.wedge.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Vector<T>) -> K.Bivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Bivector{
        add(neg(mul(a_e3, b_e2)), mul(a_e2, b_e3)),
        add(mul(a_e3, b_e1), neg(mul(a_e1, b_e3))),
        add(neg(mul(a_e2, b_e1)), mul(a_e1, b_e2)),
        add(neg(mul(a_eo, b_e1)), mul(a_e1, b_eo)),
        add(neg(mul(a_eo, b_e2)), mul(a_e2, b_eo)),
        add(neg(mul(a_eo, b_e3)), mul(a_e3, b_eo)),
        add(neg(mul(a_ei, b_e1)), mul(a_e1, b_ei)),
        add(neg(mul(a_ei, b_e2)), mul(a_e2, b_ei)),
        add(neg(mul(a_ei, b_e3)), mul(a_e3, b_ei)),
        add(neg(mul(a_ei, b_eo)), mul(a_eo, b_ei))}

def Vector.wedge.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Twist<T>) -> K.Trivector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Twist{+b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i}:
      K.Trivector{
        mul(a_eo, b_e23),
        mul(a_eo, b_e31),
        mul(a_eo, b_e12),
        add(add(mul(a_ei, b_e23), neg(mul(a_e3, b_e2i))), mul(a_e2, b_e3i)),
        add(add(mul(a_ei, b_e31), mul(a_e3, b_e1i)), neg(mul(a_e1, b_e3i))),
        add(add(mul(a_ei, b_e12), neg(mul(a_e2, b_e1i))), mul(a_e1, b_e2i)),
        neg(mul(a_eo, b_e1i)),
        neg(mul(a_eo, b_e2i)),
        neg(mul(a_eo, b_e3i)),
        add(add(mul(a_e3, b_e12), mul(a_e2, b_e31)), mul(a_e1, b_e23))}

def Vector.wedge.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Bivector<T>) -> K.Trivector<T>:
