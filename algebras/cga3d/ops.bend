        add(add(add(neg(mul(a_e123i, b_e12)), mul(a_e3i, b_s)), neg(mul(a_e12, b_e123i))), mul(a_s, b_e3i)),
        add(mul(a_e123i, b_s), mul(a_s, b_e123i))}

def Motor.dot.Even(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Even<T>) -> K.Even<T>:
