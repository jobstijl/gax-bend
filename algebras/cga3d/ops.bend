        mul(a_s, b_e1i),
        mul(a_s, b_e2i),
        mul(a_s, b_e3i),
        mul(a_s, b_eoi),
        mul(a_s, b_e23oi),
        mul(a_s, b_e31oi),
        mul(a_s, b_e12oi),
        mul(a_s, b_e123o),
        mul(a_s, b_e123i)}

def Scalar.dot.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Odd<T>) -> K.Odd<T>:
  match a b:
