def Scalar.rc.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Scalar<T>) -> K.Scalar<T>:
  match a b:
    case K.Scalar{+a_s} K.Scalar{+b_s}:
      K.Scalar{
        mul(a_s, b_s)}

def Scalar.rc.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Motor<T>) -> K.Scalar<T>:
  match a b:
    case K.Scalar{+a_s} K.Motor{+b_s, +b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i, +b_e123i}:
      K.Scalar{
        mul(a_s, b_s)}

def Scalar.rc.Even(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Even<T>) -> K.Scalar<T>:
  match a b:
    case K.Scalar{+a_s} K.Even{+b_s, +b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi, +b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i}:
      K.Scalar{
        mul(a_s, b_s)}

def Scalar.rc.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Scalar<T>, b: K.Multivector<T>) -> K.Scalar<T>:
  match a b:
    case K.Scalar{+a_s} K.Multivector{+b_s, +b_e1, +b_e2, +b_e3, +b_eo, +b_ei, +b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi, +b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123, +b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i, +b_e123oi}:
      K.Scalar{
        mul(a_s, b_s)}

def Vector.rc.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Scalar<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Scalar{+b_s}:
      K.Vector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_eo, b_s),
        mul(a_ei, b_s)}

def Vector.rc.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Vector<T>) -> K.Scalar<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Scalar{
        add(add(add(add(neg(mul(a_ei, b_eo)), neg(mul(a_eo, b_ei))), mul(a_e3, b_e3)), mul(a_e2, b_e2)), mul(a_e1, b_e1))}

def Vector.rc.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Motor<T>) -> K.Vector<T>:
  match a b:
    case K.Vector{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei} K.Motor{+b_s, +b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i, +b_e123i}:
      K.Vector{
        mul(a_e1, b_s),
        mul(a_e2, b_s),
        mul(a_e3, b_s),
        mul(a_eo, b_s),
        mul(a_ei, b_s)}

