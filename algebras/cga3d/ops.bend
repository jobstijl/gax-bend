        add(add(add(neg(mul(a_ei, b_e12o)), mul(a_eo, b_e12i)), neg(mul(a_e2, b_e1oi))), mul(a_e1, b_e2oi)),
        add(add(add(neg(mul(a_eo, b_e123)), mul(a_e3, b_e12o)), mul(a_e2, b_e31o)), mul(a_e1, b_e23o)),
        add(add(add(neg(mul(a_ei, b_e123)), mul(a_e3, b_e12i)), mul(a_e2, b_e31i)), mul(a_e1, b_e23i))}

def Odd.commutator.Quadvector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Quadvector<T>) -> K.Odd<T>:
  match a b:
