def Odd.rc.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Odd<T>) -> K.Even<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei, +a_e23o, +a_e31o, +a_e12o, +a_e23i, +a_e31i, +a_e12i, +a_e1oi, +a_e2oi, +a_e3oi, +a_e123, +a_e123oi} K.Odd{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei, +b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123, +b_e123oi}:
      K.Even{
        add(add(add(add(add(add(add(add(add(add(add(add(add(add(add(neg(mul(a_e123oi, b_e123oi)), neg(mul(a_e123, b_e123))), mul(a_e3oi, b_e3oi)), mul(a_e2oi, b_e2oi)), mul(a_e1oi, b_e1oi)), mul(a_e12i, b_e12o)), mul(a_e31i, b_e31o)), mul(a_e23i, b_e23o)), mul(a_e12o, b_e12i)), mul(a_e31o, b_e31i)), mul(a_e23o, b_e23i)), neg(mul(a_ei, b_eo))), neg(mul(a_eo, b_ei))), mul(a_e3, b_e3)), mul(a_e2, b_e2)), mul(a_e1, b_e1)),
        add(add(add(mul(a_e123oi, b_e1oi), mul(a_e123, b_e1)), neg(mul(a_e23i, b_eo))), neg(mul(a_e23o, b_ei))),
        add(add(add(mul(a_e123oi, b_e2oi), mul(a_e123, b_e2)), neg(mul(a_e31i, b_eo))), neg(mul(a_e31o, b_ei))),
        add(add(add(mul(a_e123oi, b_e3oi), mul(a_e123, b_e3)), neg(mul(a_e12i, b_eo))), neg(mul(a_e12o, b_ei))),
        add(add(add(mul(a_e123oi, b_e23o), neg(mul(a_e1oi, b_eo))), neg(mul(a_e12o, b_e2))), mul(a_e31o, b_e3)),
        add(add(add(mul(a_e123oi, b_e31o), neg(mul(a_e2oi, b_eo))), mul(a_e12o, b_e1)), neg(mul(a_e23o, b_e3))),
        add(add(add(mul(a_e123oi, b_e12o), neg(mul(a_e3oi, b_eo))), neg(mul(a_e31o, b_e1))), mul(a_e23o, b_e2)),
        add(add(add(neg(mul(a_e123oi, b_e23i)), mul(a_e1oi, b_ei)), neg(mul(a_e12i, b_e2))), mul(a_e31i, b_e3)),
        add(add(add(neg(mul(a_e123oi, b_e31i)), mul(a_e2oi, b_ei)), mul(a_e12i, b_e1)), neg(mul(a_e23i, b_e3))),
        add(add(add(neg(mul(a_e123oi, b_e12i)), mul(a_e3oi, b_ei)), neg(mul(a_e31i, b_e1))), mul(a_e23i, b_e2)),
        add(add(add(neg(mul(a_e123oi, b_e123)), mul(a_e3oi, b_e3)), mul(a_e2oi, b_e2)), mul(a_e1oi, b_e1)),
        mul(a_e123oi, b_e1),
        mul(a_e123oi, b_e2),
        mul(a_e123oi, b_e3),
        neg(mul(a_e123oi, b_eo)),
        mul(a_e123oi, b_ei)}

def Odd.rc.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei, +a_e23o, +a_e31o, +a_e12o, +a_e23i, +a_e31i, +a_e12i, +a_e1oi, +a_e2oi, +a_e3oi, +a_e123, +a_e123oi} K.Multivector{+b_s, +b_e1, +b_e2, +b_e3, +b_eo, +b_ei, +b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi, +b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123, +b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i, +b_e123oi}:
      K.Multivector{
        add(add(add(add(add(add(add(add(add(add(add(add(add(add(add(neg(mul(a_e123oi, b_e123oi)), neg(mul(a_e123, b_e123))), mul(a_e3oi, b_e3oi)), mul(a_e2oi, b_e2oi)), mul(a_e1oi, b_e1oi)), mul(a_e12i, b_e12o)), mul(a_e31i, b_e31o)), mul(a_e23i, b_e23o)), mul(a_e12o, b_e12i)), mul(a_e31o, b_e31i)), mul(a_e23o, b_e23i)), neg(mul(a_ei, b_eo))), neg(mul(a_eo, b_ei))), mul(a_e3, b_e3)), mul(a_e2, b_e2)), mul(a_e1, b_e1)),
