def Motor.gp.Scalar(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Scalar<T>) -> K.Motor<T>:
  match a b:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Scalar{+b_s}:
      K.Motor{
        mul(a_s, b_s),
        mul(a_e23, b_s),
        mul(a_e31, b_s),
        mul(a_e12, b_s),
        mul(a_e1i, b_s),
        mul(a_e2i, b_s),
        mul(a_e3i, b_s),
        mul(a_e123i, b_s)}

def Motor.gp.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Vector<T>) -> K.Odd<T>:
  match a b:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Odd{
        add(add(add(neg(mul(a_e1i, b_eo)), mul(a_e12, b_e2)), neg(mul(a_e31, b_e3))), mul(a_s, b_e1)),
        add(add(add(neg(mul(a_e2i, b_eo)), neg(mul(a_e12, b_e1))), mul(a_e23, b_e3)), mul(a_s, b_e2)),
        add(add(add(neg(mul(a_e3i, b_eo)), mul(a_e31, b_e1)), neg(mul(a_e23, b_e2))), mul(a_s, b_e3)),
        mul(a_s, b_eo),
        add(add(add(neg(mul(a_e3i, b_e3)), neg(mul(a_e2i, b_e2))), neg(mul(a_e1i, b_e1))), mul(a_s, b_ei)),
        mul(a_e23, b_eo),
        mul(a_e31, b_eo),
        mul(a_e12, b_eo),
        add(add(add(neg(mul(a_e123i, b_e1)), mul(a_e3i, b_e2)), neg(mul(a_e2i, b_e3))), mul(a_e23, b_ei)),
        add(add(add(neg(mul(a_e123i, b_e2)), neg(mul(a_e3i, b_e1))), mul(a_e1i, b_e3)), mul(a_e31, b_ei)),
        add(add(add(neg(mul(a_e123i, b_e3)), mul(a_e2i, b_e1)), neg(mul(a_e1i, b_e2))), mul(a_e12, b_ei)),
        neg(mul(a_e1i, b_eo)),
        neg(mul(a_e2i, b_eo)),
        neg(mul(a_e3i, b_eo)),
        add(add(add(neg(mul(a_e123i, b_eo)), mul(a_e12, b_e3)), mul(a_e31, b_e2)), mul(a_e23, b_e1)),
        neg(mul(a_e123i, b_eo))}

def Motor.gp.Twist(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Twist<T>) -> K.Motor<T>:
  match a b:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Twist{+b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i}:
      K.Motor{
        add(add(neg(mul(a_e12, b_e12)), neg(mul(a_e31, b_e31))), neg(mul(a_e23, b_e23))),
        add(add(mul(a_e12, b_e31), neg(mul(a_e31, b_e12))), mul(a_s, b_e23)),
        add(add(neg(mul(a_e12, b_e23)), mul(a_e23, b_e12)), mul(a_s, b_e31)),
        add(add(mul(a_e31, b_e23), neg(mul(a_e23, b_e31))), mul(a_s, b_e12)),
        add(add(add(add(add(neg(mul(a_e123i, b_e23)), mul(a_e3i, b_e31)), neg(mul(a_e2i, b_e12))), mul(a_e12, b_e2i)), neg(mul(a_e31, b_e3i))), mul(a_s, b_e1i)),
        add(add(add(add(add(neg(mul(a_e123i, b_e31)), neg(mul(a_e3i, b_e23))), mul(a_e1i, b_e12)), neg(mul(a_e12, b_e1i))), mul(a_e23, b_e3i)), mul(a_s, b_e2i)),
        add(add(add(add(add(neg(mul(a_e123i, b_e12)), mul(a_e2i, b_e23)), neg(mul(a_e1i, b_e31))), mul(a_e31, b_e1i)), neg(mul(a_e23, b_e2i))), mul(a_s, b_e3i)),
        add(add(add(add(add(mul(a_e3i, b_e12), mul(a_e2i, b_e31)), mul(a_e1i, b_e23)), mul(a_e12, b_e3i)), mul(a_e31, b_e2i)), mul(a_e23, b_e1i))}

def Motor.gp.Bivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Bivector<T>) -> K.Even<T>:
  match a b:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Bivector{+b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi}:
      K.Even{
        add(add(add(add(add(mul(a_e3i, b_e3o), mul(a_e2i, b_e2o)), mul(a_e1i, b_e1o)), neg(mul(a_e12, b_e12))), neg(mul(a_e31, b_e31))), neg(mul(a_e23, b_e23))),
        add(add(add(add(add(mul(a_e123i, b_e1o), neg(mul(a_e3i, b_e2o))), mul(a_e2i, b_e3o)), mul(a_e12, b_e31)), neg(mul(a_e31, b_e12))), mul(a_s, b_e23)),
        add(add(add(add(add(mul(a_e123i, b_e2o), mul(a_e3i, b_e1o)), neg(mul(a_e1i, b_e3o))), neg(mul(a_e12, b_e23))), mul(a_e23, b_e12)), mul(a_s, b_e31)),
        add(add(add(add(add(mul(a_e123i, b_e3o), neg(mul(a_e2i, b_e1o))), mul(a_e1i, b_e2o)), mul(a_e31, b_e23)), neg(mul(a_e23, b_e31))), mul(a_s, b_e12)),
        add(add(mul(a_e12, b_e2o), neg(mul(a_e31, b_e3o))), mul(a_s, b_e1o)),
        add(add(neg(mul(a_e12, b_e1o)), mul(a_e23, b_e3o)), mul(a_s, b_e2o)),
        add(add(mul(a_e31, b_e1o), neg(mul(a_e23, b_e2o))), mul(a_s, b_e3o)),
