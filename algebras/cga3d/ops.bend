        add(mul(a_ei, b_e123o), mul(a_eo, b_e123i)),
        zero}

def Odd.commutator.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Motor<T>) -> K.Odd<T>:
  match a b:
