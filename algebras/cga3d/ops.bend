        add(add(add(add(mul(a_e123, b_e2i), mul(a_e3oi, b_e1i)), neg(mul(a_e1oi, b_e3i))), neg(mul(a_e12i, b_e23))), mul(a_e23i, b_e12)),
        add(add(add(add(mul(a_e123, b_e3i), neg(mul(a_e2oi, b_e1i))), mul(a_e1oi, b_e2i)), mul(a_e31i, b_e23)), neg(mul(a_e23i, b_e31))),
        add(add(add(mul(a_e3oi, b_e31), neg(mul(a_e2oi, b_e12))), neg(mul(a_e12o, b_e2i))), mul(a_e31o, b_e3i)),
        add(add(add(neg(mul(a_e3oi, b_e23)), mul(a_e1oi, b_e12)), mul(a_e12o, b_e1i)), neg(mul(a_e23o, b_e3i))),
        add(add(add(mul(a_e2oi, b_e23), neg(mul(a_e1oi, b_e31))), neg(mul(a_e31o, b_e1i))), mul(a_e23o, b_e2i)),
        add(add(mul(a_e12o, b_e3i), mul(a_e31o, b_e2i)), mul(a_e23o, b_e1i)),
