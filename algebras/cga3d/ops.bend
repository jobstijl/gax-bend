      +m5_4 = add(add(add(q2_3, q2_3), neg(q0_1)), neg(q0_1))
      +m5_5 = add(add(add(q3_3, neg(q2_2)), neg(q1_1)), q0_0)
      +m6_0 = add(add(add(add(add(add(add(neg(q3_6), neg(q3_6)), neg(q2_5)), neg(q2_5)), q1_4), q1_4), neg(q0_7)), neg(q0_7))
      +m6_1 = add(add(add(add(add(add(add(neg(q3_7), neg(q3_7)), q2_4), q2_4), q1_5), q1_5), q0_6), q0_6)
      +m6_2 = add(add(add(add(add(add(add(q3_4, q3_4), q2_7), q2_7), q1_6), q1_6), neg(q0_5)), neg(q0_5))
      +m6_3 = add(add(add(add(add(add(add(neg(q7_7), neg(q7_7)), q6_6), q6_6), q5_5), q5_5), neg(q4_4)), neg(q4_4))
      +m6_4 = add(add(add(add(add(add(add(q6_7, q6_7), q6_7), q6_7), neg(q4_5)), neg(q4_5)), neg(q4_5)), neg(q4_5))
      +m6_5 = add(add(add(add(add(add(add(neg(q5_7), neg(q5_7)), neg(q5_7)), neg(q5_7)), neg(q4_6)), neg(q4_6)), neg(q4_6)), neg(q4_6))
      +m6_6 = add(add(add(neg(q3_3), neg(q2_2)), q1_1), q0_0)
      +m6_7 = add(add(add(q1_2, q1_2), q0_3), q0_3)
      +m6_8 = add(add(add(q1_3, q1_3), neg(q0_2)), neg(q0_2))
      +m6_9 = add(add(add(add(add(add(add(neg(q3_5), neg(q3_5)), q2_6), q2_6), neg(q1_7)), neg(q1_7)), neg(q0_4)), neg(q0_4))
      +m7_0 = add(add(add(add(add(add(add(q3_7, q3_7), q2_4), q2_4), q1_5), q1_5), neg(q0_6)), neg(q0_6))
      +m7_1 = add(add(add(add(add(add(add(neg(q3_6), neg(q3_6)), q2_5), q2_5), neg(q1_4)), neg(q1_4)), neg(q0_7)), neg(q0_7))
      +m7_2 = add(add(add(add(add(add(add(q3_5, q3_5), q2_6), q2_6), neg(q1_7)), neg(q1_7)), q0_4), q0_4)
