      +m1_2 = add(add(add(q2_3, q2_3), q0_1), q0_1)
      +m1_3 = add(add(add(add(add(add(add(neg(q3_7), neg(q3_7)), neg(q2_4)), neg(q2_4)), neg(q1_5)), neg(q1_5)), q0_6), q0_6)
      +m1_4 = add(add(add(add(add(add(add(q3_6, q3_6), neg(q2_5)), neg(q2_5)), q1_4), q1_4), q0_7), q0_7)
      +m1_5 = add(add(add(add(add(add(add(neg(q3_5), neg(q3_5)), neg(q2_6)), neg(q2_6)), q1_7), q1_7), neg(q0_4)), neg(q0_4))
      +m2_0 = add(add(add(q1_3, q1_3), q0_2), q0_2)
      +m2_1 = add(add(add(q2_3, q2_3), neg(q0_1)), neg(q0_1))
      +m2_2 = add(add(add(q3_3, neg(q2_2)), neg(q1_1)), q0_0)
      +m2_3 = add(add(add(add(add(add(add(neg(q3_4), neg(q3_4)), q2_7), q2_7), neg(q1_6)), neg(q1_6)), neg(q0_5)), neg(q0_5))
      +m2_4 = add(add(add(add(add(add(add(neg(q3_5), neg(q3_5)), neg(q2_6)), neg(q2_6)), neg(q1_7)), neg(q1_7)), q0_4), q0_4)
      +m2_5 = add(add(add(add(add(add(add(neg(q3_6), neg(q3_6)), q2_5), q2_5), q1_4), q1_4), q0_7), q0_7)
      +m3_3 = add(add(add(neg(q3_3), neg(q2_2)), q1_1), q0_0)
