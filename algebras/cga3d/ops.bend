        add(add(neg(mul(a_e123i, b_e12)), mul(a_e31oi, b_e1i)), neg(mul(a_e23oi, b_e2i))),
        add(add(neg(mul(a_e12oi, b_e12)), neg(mul(a_e31oi, b_e31))), neg(mul(a_e23oi, b_e23))),
        mul(a_e23oi, b_s),
        mul(a_e31oi, b_s),
        mul(a_e12oi, b_s),
        mul(a_e123o, b_s),
