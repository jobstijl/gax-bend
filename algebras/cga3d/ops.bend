      K.Trivector{
        add(add(mul(a_eo, b_e23), neg(mul(a_e3, b_e2o))), mul(a_e2, b_e3o)),
        add(add(mul(a_eo, b_e31), mul(a_e3, b_e1o)), neg(mul(a_e1, b_e3o))),
        add(add(mul(a_eo, b_e12), neg(mul(a_e2, b_e1o))), mul(a_e1, b_e2o)),
        add(add(mul(a_ei, b_e23), neg(mul(a_e3, b_e2i))), mul(a_e2, b_e3i)),
        add(add(mul(a_ei, b_e31), mul(a_e3, b_e1i)), neg(mul(a_e1, b_e3i))),
        add(add(mul(a_ei, b_e12), neg(mul(a_e2, b_e1i))), mul(a_e1, b_e2i)),
