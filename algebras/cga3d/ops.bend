      +m1_1 = add(add(add(add(neg(q3_4), neg(q3_4)), neg(q2_2)), q1_1), neg(q0_0))
      +m1_2 = add(q1_2, q1_2)
      +m1_3 = add(neg(q2_4), neg(q2_4))
      +m1_5 = add(q0_4, q0_4)
      +m1_6 = add(neg(q2_3), neg(q2_3))
      +m1_8 = add(q0_3, q0_3)
      +m2_0 = add(q0_2, q0_2)
      +m2_1 = add(q1_2, q1_2)
      +m2_2 = add(add(add(add(neg(q3_4), neg(q3_4)), q2_2), neg(q1_1)), neg(q0_0))
      +m2_3 = add(q1_4, q1_4)
      +m2_4 = add(neg(q0_4), neg(q0_4))
      +m2_6 = add(q1_3, q1_3)
      +m2_7 = add(neg(q0_3), neg(q0_3))
      +m3_1 = add(q2_3, q2_3)
      +m3_2 = add(neg(q1_3), neg(q1_3))
      +m3_3 = add(add(q2_2, q1_1), neg(q0_0))
      +m3_4 = add(neg(q0_1), neg(q0_1))
      +m3_5 = add(neg(q0_2), neg(q0_2))
      +m3_6 = add(q3_3, q3_3)
      +m3_9 = add(neg(q0_3), neg(q0_3))
      +m4_0 = add(neg(q2_3), neg(q2_3))
      +m4_2 = add(q0_3, q0_3)
      +m4_3 = add(neg(q0_1), neg(q0_1))
      +m4_4 = add(add(q2_2, neg(q1_1)), q0_0)
      +m4_5 = add(neg(q1_2), neg(q1_2))
      +m4_7 = add(q3_3, q3_3)
      +m4_9 = add(neg(q1_3), neg(q1_3))
      +m5_0 = add(q1_3, q1_3)
      +m5_1 = add(neg(q0_3), neg(q0_3))
      +m5_3 = add(neg(q0_2), neg(q0_2))
      +m5_4 = add(neg(q1_2), neg(q1_2))
      +m5_5 = add(add(neg(q2_2), q1_1), q0_0)
      +m5_8 = add(q3_3, q3_3)
      +m5_9 = add(neg(q2_3), neg(q2_3))
      +m6_1 = add(q2_4, q2_4)
      +m6_2 = add(neg(q1_4), neg(q1_4))
      +m6_3 = add(q4_4, q4_4)
      +m6_6 = add(add(q2_2, q1_1), neg(q0_0))
      +m6_7 = add(neg(q0_1), neg(q0_1))
      +m6_8 = add(neg(q0_2), neg(q0_2))
      +m6_9 = add(q0_4, q0_4)
      +m7_0 = add(neg(q2_4), neg(q2_4))
      +m7_2 = add(q0_4, q0_4)
      +m7_4 = add(q4_4, q4_4)
      +m7_6 = add(neg(q0_1), neg(q0_1))
      +m7_7 = add(add(q2_2, neg(q1_1)), q0_0)
      +m7_8 = add(neg(q1_2), neg(q1_2))
      +m7_9 = add(q1_4, q1_4)
      +m8_0 = add(q1_4, q1_4)
      +m8_1 = add(neg(q0_4), neg(q0_4))
      +m8_5 = add(q4_4, q4_4)
      +m8_6 = add(neg(q0_2), neg(q0_2))
      +m8_7 = add(neg(q1_2), neg(q1_2))
      +m8_8 = add(add(neg(q2_2), q1_1), q0_0)
      +m8_9 = add(q2_4, q2_4)
      +m9_3 = add(q0_4, q0_4)
      +m9_4 = add(q1_4, q1_4)
      +m9_5 = add(q2_4, q2_4)
      +m9_6 = add(neg(q0_3), neg(q0_3))
      +m9_7 = add(neg(q1_3), neg(q1_3))
      +m9_8 = add(neg(q2_3), neg(q2_3))
      +m9_9 = add(add(add(add(q3_4, q3_4), q2_2), q1_1), q0_0)
