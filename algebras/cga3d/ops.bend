def Quadvector.dot.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Quadvector<T>, b: K.Motor<T>) -> K.Even<T>:
  match a b:
    case K.Quadvector{+a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i} K.Motor{+b_s, +b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i, +b_e123i}:
