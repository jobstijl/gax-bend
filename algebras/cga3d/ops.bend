      +q2_4 = mul(a_e31, a_e1i)
      +q1_5 = mul(a_e23, a_e2i)
      +q0_6 = mul(a_s, a_e3i)
      +q3_4 = mul(a_e12, a_e1i)
      +q2_7 = mul(a_e31, a_e123i)
      +q1_6 = mul(a_e23, a_e3i)
      +q0_5 = mul(a_s, a_e2i)
      +q2_3 = mul(a_e31, a_e12)
      +q0_1 = mul(a_s, a_e23)
      +q3_5 = mul(a_e12, a_e2i)
      +q2_6 = mul(a_e31, a_e3i)
      +q1_7 = mul(a_e23, a_e123i)
      +q0_4 = mul(a_s, a_e1i)
      +q7_7 = mul(a_e123i, a_e123i)
      +q6_6 = mul(a_e3i, a_e3i)
      +q5_5 = mul(a_e2i, a_e2i)
      +q4_4 = mul(a_e1i, a_e1i)
      +q6_7 = mul(a_e3i, a_e123i)
      +q4_5 = mul(a_e1i, a_e2i)
      +q5_7 = mul(a_e2i, a_e123i)
      +q4_6 = mul(a_e1i, a_e3i)
      +q5_6 = mul(a_e2i, a_e3i)
      +q4_7 = mul(a_e1i, a_e123i)
      +m0_0 = add(add(add(neg(q3_3), neg(q2_2)), q1_1), q0_0)
      +m0_1 = add(add(add(q1_2, q1_2), q0_3), q0_3)
      +m0_2 = add(add(add(q1_3, q1_3), neg(q0_2)), neg(q0_2))
      +m0_3 = add(add(add(add(add(add(add(q3_6, q3_6), q2_5), q2_5), neg(q1_4)), neg(q1_4)), q0_7), q0_7)
      +m0_4 = add(add(add(add(add(add(add(q3_7, q3_7), neg(q2_4)), neg(q2_4)), neg(q1_5)), neg(q1_5)), neg(q0_6)), neg(q0_6))
      +m0_5 = add(add(add(add(add(add(add(neg(q3_4), neg(q3_4)), neg(q2_7)), neg(q2_7)), neg(q1_6)), neg(q1_6)), q0_5), q0_5)
      +m1_0 = add(add(add(q1_2, q1_2), neg(q0_3)), neg(q0_3))
