        add(mul(a_ei, b_e123o), mul(a_eo, b_e123i))}

def Vector.commutator.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Vector<T>, b: K.Motor<T>) -> K.Odd<T>:
