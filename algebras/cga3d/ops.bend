def Multivector.rc.Vector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Multivector<T>, b: K.Vector<T>) -> K.Multivector<T>:
  match a b:
    case K.Multivector{+a_s, +a_e1, +a_e2, +a_e3, +a_eo, +a_ei, +a_e23, +a_e31, +a_e12, +a_e1o, +a_e2o, +a_e3o, +a_e1i, +a_e2i, +a_e3i, +a_eoi, +a_e23o, +a_e31o, +a_e12o, +a_e23i, +a_e31i, +a_e12i, +a_e1oi, +a_e2oi, +a_e3oi, +a_e123, +a_e23oi, +a_e31oi, +a_e12oi, +a_e123o, +a_e123i, +a_e123oi} K.Vector{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei}:
      K.Multivector{
        add(add(add(add(neg(mul(a_ei, b_eo)), neg(mul(a_eo, b_ei))), mul(a_e3, b_e3)), mul(a_e2, b_e2)), mul(a_e1, b_e1)),
        add(add(add(neg(mul(a_e1i, b_eo)), neg(mul(a_e1o, b_ei))), mul(a_e12, b_e2)), neg(mul(a_e31, b_e3))),
