        add(add(neg(mul(a_e3i, b_e12oi)), neg(mul(a_e2i, b_e31oi))), neg(mul(a_e1i, b_e23oi)))}

def Motor.commutator.Motor(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Motor<T>) -> K.Twist<T>:
  match a b:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Motor{+b_s, +b_e23, +b_e31, +b_e12, +b_e1i, +b_e2i, +b_e3i, +b_e123i}:
      K.Twist{
        add(mul(a_e12, b_e31), neg(mul(a_e31, b_e12))),
        add(neg(mul(a_e12, b_e23)), mul(a_e23, b_e12)),
        add(mul(a_e31, b_e23), neg(mul(a_e23, b_e31))),
        add(add(add(mul(a_e3i, b_e31), neg(mul(a_e2i, b_e12))), mul(a_e12, b_e2i)), neg(mul(a_e31, b_e3i))),
        add(add(add(neg(mul(a_e3i, b_e23)), mul(a_e1i, b_e12)), neg(mul(a_e12, b_e1i))), mul(a_e23, b_e3i)),
        add(add(add(mul(a_e2i, b_e23), neg(mul(a_e1i, b_e31))), mul(a_e31, b_e1i)), neg(mul(a_e23, b_e2i)))}

def Motor.commutator.Even(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Even<T>) -> K.Even<T>:
  match a b:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Even{+b_s, +b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi, +b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i}:
      K.Even{
        zero,
        add(add(add(neg(mul(a_e3i, b_e2o)), mul(a_e2i, b_e3o)), mul(a_e12, b_e31)), neg(mul(a_e31, b_e12))),
        add(add(add(mul(a_e3i, b_e1o), neg(mul(a_e1i, b_e3o))), neg(mul(a_e12, b_e23))), mul(a_e23, b_e12)),
        add(add(add(neg(mul(a_e2i, b_e1o)), mul(a_e1i, b_e2o)), mul(a_e31, b_e23)), neg(mul(a_e23, b_e31))),
        add(mul(a_e12, b_e2o), neg(mul(a_e31, b_e3o))),
        add(neg(mul(a_e12, b_e1o)), mul(a_e23, b_e3o)),
        add(mul(a_e31, b_e1o), neg(mul(a_e23, b_e2o))),
        add(add(add(add(add(mul(a_e123i, b_e23oi), mul(a_e3i, b_e31)), neg(mul(a_e2i, b_e12))), neg(mul(a_e1i, b_eoi))), mul(a_e12, b_e2i)), neg(mul(a_e31, b_e3i))),
        add(add(add(add(add(mul(a_e123i, b_e31oi), neg(mul(a_e3i, b_e23))), neg(mul(a_e2i, b_eoi))), mul(a_e1i, b_e12)), neg(mul(a_e12, b_e1i))), mul(a_e23, b_e3i)),
        add(add(add(add(add(mul(a_e123i, b_e12oi), neg(mul(a_e3i, b_eoi))), mul(a_e2i, b_e23)), neg(mul(a_e1i, b_e31))), mul(a_e31, b_e1i)), neg(mul(a_e23, b_e2i))),
        add(add(add(neg(mul(a_e123i, b_e123o)), mul(a_e3i, b_e3o)), mul(a_e2i, b_e2o)), mul(a_e1i, b_e1o)),
        add(add(add(mul(a_e123i, b_e1o), mul(a_e1i, b_e123o)), mul(a_e12, b_e31oi)), neg(mul(a_e31, b_e12oi))),
        add(add(add(mul(a_e123i, b_e2o), mul(a_e2i, b_e123o)), neg(mul(a_e12, b_e23oi))), mul(a_e23, b_e12oi)),
        add(add(add(mul(a_e123i, b_e3o), mul(a_e3i, b_e123o)), mul(a_e31, b_e23oi)), neg(mul(a_e23, b_e31oi))),
        zero,
        add(add(add(neg(mul(a_e123i, b_eoi)), neg(mul(a_e3i, b_e12oi))), neg(mul(a_e2i, b_e31oi))), neg(mul(a_e1i, b_e23oi)))}

def Motor.commutator.Odd(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Odd<T>) -> K.Odd<T>:
  match a b:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Odd{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei, +b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123, +b_e123oi}:
      K.Odd{
        add(add(add(mul(a_e123i, b_e23o), neg(mul(a_e1i, b_eo))), mul(a_e12, b_e2)), neg(mul(a_e31, b_e3))),
        add(add(add(mul(a_e123i, b_e31o), neg(mul(a_e2i, b_eo))), neg(mul(a_e12, b_e1))), mul(a_e23, b_e3)),
        add(add(add(mul(a_e123i, b_e12o), neg(mul(a_e3i, b_eo))), mul(a_e31, b_e1)), neg(mul(a_e23, b_e2))),
        zero,
        add(add(add(mul(a_e123i, b_e123), neg(mul(a_e3i, b_e3))), neg(mul(a_e2i, b_e2))), neg(mul(a_e1i, b_e1))),
        add(mul(a_e12, b_e31o), neg(mul(a_e31, b_e12o))),
        add(neg(mul(a_e12, b_e23o)), mul(a_e23, b_e12o)),
        add(mul(a_e31, b_e23o), neg(mul(a_e23, b_e31o))),
        add(add(add(add(add(neg(mul(a_e123i, b_e1)), neg(mul(a_e3i, b_e2oi))), mul(a_e2i, b_e3oi)), neg(mul(a_e1i, b_e123))), mul(a_e12, b_e31i)), neg(mul(a_e31, b_e12i))),
        add(add(add(add(add(neg(mul(a_e123i, b_e2)), mul(a_e3i, b_e1oi)), neg(mul(a_e2i, b_e123))), neg(mul(a_e1i, b_e3oi))), neg(mul(a_e12, b_e23i))), mul(a_e23, b_e12i)),
        add(add(add(add(add(neg(mul(a_e123i, b_e3)), neg(mul(a_e3i, b_e123))), neg(mul(a_e2i, b_e1oi))), mul(a_e1i, b_e2oi)), mul(a_e31, b_e23i)), neg(mul(a_e23, b_e31i))),
        add(add(add(neg(mul(a_e3i, b_e31o)), mul(a_e2i, b_e12o)), mul(a_e12, b_e2oi)), neg(mul(a_e31, b_e3oi))),
        add(add(add(mul(a_e3i, b_e23o), neg(mul(a_e1i, b_e12o))), neg(mul(a_e12, b_e1oi))), mul(a_e23, b_e3oi)),
        add(add(add(neg(mul(a_e2i, b_e23o)), mul(a_e1i, b_e31o)), mul(a_e31, b_e1oi)), neg(mul(a_e23, b_e2oi))),
        add(add(add(neg(mul(a_e123i, b_eo)), neg(mul(a_e3i, b_e12o))), neg(mul(a_e2i, b_e31o))), neg(mul(a_e1i, b_e23o))),
        zero}

def Motor.commutator.Multivector(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Motor<T>, b: K.Multivector<T>) -> K.Multivector<T>:
  match a b:
    case K.Motor{+a_s, +a_e23, +a_e31, +a_e12, +a_e1i, +a_e2i, +a_e3i, +a_e123i} K.Multivector{+b_s, +b_e1, +b_e2, +b_e3, +b_eo, +b_ei, +b_e23, +b_e31, +b_e12, +b_e1o, +b_e2o, +b_e3o, +b_e1i, +b_e2i, +b_e3i, +b_eoi, +b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123, +b_e23oi, +b_e31oi, +b_e12oi, +b_e123o, +b_e123i, +b_e123oi}:
      K.Multivector{
        zero,
        add(add(add(mul(a_e123i, b_e23o), neg(mul(a_e1i, b_eo))), mul(a_e12, b_e2)), neg(mul(a_e31, b_e3))),
        add(add(add(mul(a_e123i, b_e31o), neg(mul(a_e2i, b_eo))), neg(mul(a_e12, b_e1))), mul(a_e23, b_e3)),
        add(add(add(mul(a_e123i, b_e12o), neg(mul(a_e3i, b_eo))), mul(a_e31, b_e1)), neg(mul(a_e23, b_e2))),
        zero,
        add(add(add(mul(a_e123i, b_e123), neg(mul(a_e3i, b_e3))), neg(mul(a_e2i, b_e2))), neg(mul(a_e1i, b_e1))),
        add(add(add(neg(mul(a_e3i, b_e2o)), mul(a_e2i, b_e3o)), mul(a_e12, b_e31)), neg(mul(a_e31, b_e12))),
        add(add(add(mul(a_e3i, b_e1o), neg(mul(a_e1i, b_e3o))), neg(mul(a_e12, b_e23))), mul(a_e23, b_e12)),
        add(add(add(neg(mul(a_e2i, b_e1o)), mul(a_e1i, b_e2o)), mul(a_e31, b_e23)), neg(mul(a_e23, b_e31))),
        add(mul(a_e12, b_e2o), neg(mul(a_e31, b_e3o))),
        add(neg(mul(a_e12, b_e1o)), mul(a_e23, b_e3o)),
        add(mul(a_e31, b_e1o), neg(mul(a_e23, b_e2o))),
        add(add(add(add(add(mul(a_e123i, b_e23oi), mul(a_e3i, b_e31)), neg(mul(a_e2i, b_e12))), neg(mul(a_e1i, b_eoi))), mul(a_e12, b_e2i)), neg(mul(a_e31, b_e3i))),
        add(add(add(add(add(mul(a_e123i, b_e31oi), neg(mul(a_e3i, b_e23))), neg(mul(a_e2i, b_eoi))), mul(a_e1i, b_e12)), neg(mul(a_e12, b_e1i))), mul(a_e23, b_e3i)),
        add(add(add(add(add(mul(a_e123i, b_e12oi), neg(mul(a_e3i, b_eoi))), mul(a_e2i, b_e23)), neg(mul(a_e1i, b_e31))), mul(a_e31, b_e1i)), neg(mul(a_e23, b_e2i))),
        add(add(add(neg(mul(a_e123i, b_e123o)), mul(a_e3i, b_e3o)), mul(a_e2i, b_e2o)), mul(a_e1i, b_e1o)),
        add(mul(a_e12, b_e31o), neg(mul(a_e31, b_e12o))),
        add(neg(mul(a_e12, b_e23o)), mul(a_e23, b_e12o)),
        add(mul(a_e31, b_e23o), neg(mul(a_e23, b_e31o))),
