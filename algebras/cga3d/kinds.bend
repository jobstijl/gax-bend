# Every kind widened to the full basis

def Scalar.to_mv(~T: Data, ~zero: T, ~neg: T -> T, x: Scalar<T>) -> Multivector<T>:
  match x:
    case Scalar{+s}:
      Multivector{s, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero}

def Vector.to_mv(~T: Data, ~zero: T, ~neg: T -> T, x: Vector<T>) -> Multivector<T>:
  match x:
    case Vector{+e1, +e2, +e3, +eo, +ei}:
      Multivector{zero, e1, e2, e3, eo, ei, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero}

def Twist.to_mv(~T: Data, ~zero: T, ~neg: T -> T, x: Twist<T>) -> Multivector<T>:
  match x:
    case Twist{+e23, +e31, +e12, +e1i, +e2i, +e3i}:
      Multivector{zero, zero, zero, zero, zero, zero, e23, e31, e12, zero, zero, zero, e1i, e2i, e3i, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero}

def Bivector.to_mv(~T: Data, ~zero: T, ~neg: T -> T, x: Bivector<T>) -> Multivector<T>:
  match x:
    case Bivector{+e23, +e31, +e12, +e1o, +e2o, +e3o, +e1i, +e2i, +e3i, +eoi}:
      Multivector{zero, zero, zero, zero, zero, zero, e23, e31, e12, e1o, e2o, e3o, e1i, e2i, e3i, eoi, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero}

def Trivector.to_mv(~T: Data, ~zero: T, ~neg: T -> T, x: Trivector<T>) -> Multivector<T>:
  match x:
