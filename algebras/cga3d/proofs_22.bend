  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  ~half: T, ~hh: {add(half, half) == one : T}, a: K.Odd<T>, b: K.Odd<T>)
  -> {K.Multivector.fields(T, K.Multivector.of_tree(~T, ~zero, ~add, ~mul, ~neg, ~half, S.MV.gp(~T, ~add, ~mul, ~neg, 5n, K.CGA3.sig(), S.MV.gp(~T, ~add, ~mul, ~neg, 5n, K.CGA3.sig(), K.Odd.tree(~T, ~add, ~mul, ~neg, ~half, a), K.Odd.tree(~T, ~add, ~mul, ~neg, ~half, b)), S.MV.reverse(~T, ~neg, 5n, K.Odd.tree(~T, ~add, ~mul, ~neg, ~half, a)))))
      == K.Multivector.fields(T, K.Odd.to_mv(~T, ~zero, ~neg, O.Odd.transform.Odd(~T, ~zero, ~add, ~mul, ~neg, a, b))) : List<&2, T>}:
  match a b:
    case K.Odd{+a_e1, +a_e2, +a_e3, +a_eo, +a_ei, +a_e23o, +a_e31o, +a_e12o, +a_e23i, +a_e31i, +a_e12i, +a_e1oi, +a_e2oi, +a_e3oi, +a_e123, +a_e123oi} K.Odd{+b_e1, +b_e2, +b_e3, +b_eo, +b_ei, +b_e23o, +b_e31o, +b_e12o, +b_e23i, +b_e31i, +b_e12i, +b_e1oi, +b_e2oi, +b_e3oi, +b_e123, +b_e123oi}:
      NP.NormSH.eqs(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [a_e1, a_e2, a_e3, a_eo, a_ei, a_e23o, a_e31o, a_e12o, a_e23i, a_e31i, a_e12i, a_e1oi, a_e2oi, a_e3oi, a_e123, a_e123oi, b_e1, b_e2, b_e3, b_eo, b_ei, b_e23o, b_e31o, b_e12o, b_e23i, b_e31i, b_e12i, b_e1oi, b_e2oi, b_e3oi, b_e123, b_e123oi, half], 32n,
        K.Multivector.fields(N.Tm, K.Multivector.of_tree(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, ~N.TVar{32n}, S.MV.gp(~N.Tm, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, 5n, K.CGA3.sig(), S.MV.gp(~N.Tm, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, 5n, K.CGA3.sig(), K.Odd.tree(~N.Tm, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, ~N.TVar{32n}, K.Odd{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}, N.TVar{8n}, N.TVar{9n}, N.TVar{10n}, N.TVar{11n}, N.TVar{12n}, N.TVar{13n}, N.TVar{14n}, N.TVar{15n}}), K.Odd.tree(~N.Tm, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, ~N.TVar{32n}, K.Odd{N.TVar{16n}, N.TVar{17n}, N.TVar{18n}, N.TVar{19n}, N.TVar{20n}, N.TVar{21n}, N.TVar{22n}, N.TVar{23n}, N.TVar{24n}, N.TVar{25n}, N.TVar{26n}, N.TVar{27n}, N.TVar{28n}, N.TVar{29n}, N.TVar{30n}, N.TVar{31n}})), S.MV.reverse(~N.Tm, ~N.Tm.neg, 5n, K.Odd.tree(~N.Tm, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, ~N.TVar{32n}, K.Odd{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}, N.TVar{8n}, N.TVar{9n}, N.TVar{10n}, N.TVar{11n}, N.TVar{12n}, N.TVar{13n}, N.TVar{14n}, N.TVar{15n}}))))),
        K.Multivector.fields(N.Tm, K.Odd.to_mv(~N.Tm, ~N.TZero{}, ~N.Tm.neg, O.Odd.transform.Odd(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Odd{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}, N.TVar{8n}, N.TVar{9n}, N.TVar{10n}, N.TVar{11n}, N.TVar{12n}, N.TVar{13n}, N.TVar{14n}, N.TVar{15n}}, K.Odd{N.TVar{16n}, N.TVar{17n}, N.TVar{18n}, N.TVar{19n}, N.TVar{20n}, N.TVar{21n}, N.TVar{22n}, N.TVar{23n}, N.TVar{24n}, N.TVar{25n}, N.TVar{26n}, N.TVar{27n}, N.TVar{28n}, N.TVar{29n}, N.TVar{30n}, N.TVar{31n}}))),
        hh, {==})

def Odd.Odd.prepared(~T: Data, ~zero: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T, a: K.Odd<T>, b: K.Odd<T>)
  -> {O.Odd.transform.Odd(~T, ~zero, ~add, ~mul, ~neg, a, b) == O.Odd.Odd.apply(~T, ~zero, ~add, ~mul, ~neg, O.Odd.prepare.Odd(~T, ~zero, ~add, ~mul, ~neg, a), b) : K.Odd<T>}:
  match a b:
    case K.Odd{a_e1, a_e2, a_e3, a_eo, a_ei, a_e23o, a_e31o, a_e12o, a_e23i, a_e31i, a_e12i, a_e1oi, a_e2oi, a_e3oi, a_e123, a_e123oi} K.Odd{b_e1, b_e2, b_e3, b_eo, b_ei, b_e23o, b_e31o, b_e12o, b_e23i, b_e31i, b_e12i, b_e1oi, b_e2oi, b_e3oi, b_e123, b_e123oi}:
      {==}

