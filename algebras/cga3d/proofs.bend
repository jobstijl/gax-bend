  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  ~half: T, ~hh: {add(half, half) == one : T}, x: K.Multivector<T>)
  -> {K.Multivector.fields(T, K.Multivector.of_tree(~T, ~zero, ~add, ~mul, ~neg, ~half, K.Multivector.tree(~T, ~add, ~mul, ~neg, ~half, x))) == K.Multivector.fields(T, x) : List<&2, T>}:
  match x:
    case K.Multivector{+x_s, +x_e1, +x_e2, +x_e3, +x_eo, +x_ei, +x_e23, +x_e31, +x_e12, +x_e1o, +x_e2o, +x_e3o, +x_e1i, +x_e2i, +x_e3i, +x_eoi, +x_e23o, +x_e31o, +x_e12o, +x_e23i, +x_e31i, +x_e12i, +x_e1oi, +x_e2oi, +x_e3oi, +x_e123, +x_e23oi, +x_e31oi, +x_e12oi, +x_e123o, +x_e123i, +x_e123oi}:
      NP.NormSH.eqs(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [x_s, x_e1, x_e2, x_e3, x_eo, x_ei, x_e23, x_e31, x_e12, x_e1o, x_e2o, x_e3o, x_e1i, x_e2i, x_e3i, x_eoi, x_e23o, x_e31o, x_e12o, x_e23i, x_e31i, x_e12i, x_e1oi, x_e2oi, x_e3oi, x_e123, x_e23oi, x_e31oi, x_e12oi, x_e123o, x_e123i, x_e123oi, half], 32n,
        K.Multivector.fields(N.Tm, K.Multivector.of_tree(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, ~N.TVar{32n}, K.Multivector.tree(~N.Tm, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, ~N.TVar{32n}, K.Multivector{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}, N.TVar{8n}, N.TVar{9n}, N.TVar{10n}, N.TVar{11n}, N.TVar{12n}, N.TVar{13n}, N.TVar{14n}, N.TVar{15n}, N.TVar{16n}, N.TVar{17n}, N.TVar{18n}, N.TVar{19n}, N.TVar{20n}, N.TVar{21n}, N.TVar{22n}, N.TVar{23n}, N.TVar{24n}, N.TVar{25n}, N.TVar{26n}, N.TVar{27n}, N.TVar{28n}, N.TVar{29n}, N.TVar{30n}, N.TVar{31n}}))),
        K.Multivector.fields(N.Tm, K.Multivector{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}, N.TVar{8n}, N.TVar{9n}, N.TVar{10n}, N.TVar{11n}, N.TVar{12n}, N.TVar{13n}, N.TVar{14n}, N.TVar{15n}, N.TVar{16n}, N.TVar{17n}, N.TVar{18n}, N.TVar{19n}, N.TVar{20n}, N.TVar{21n}, N.TVar{22n}, N.TVar{23n}, N.TVar{24n}, N.TVar{25n}, N.TVar{26n}, N.TVar{27n}, N.TVar{28n}, N.TVar{29n}, N.TVar{30n}, N.TVar{31n}}),
        hh, {==})
