# Big binary64 arithmetic (src/big.bend) against IEEE binary64 as Python
# computes it (CPython floats are hardware doubles): 300 products and sums,
# bit for bit, over the finite range, with 42 subnormal products, 21
# products that underflow to zero, and 100 sums that cancel to a few
# bits. Bend has no native F64, so the expected bits were generated once
# and are listed below (tools/f64_cases.py prints them). Bd.f64 of an
# exact product or sum is proven to be Dy.f64 of it
# (proofs/big.bend, Mul64.lk, Add64.lk), which meets the rounding model
# with u = 2^-53 and eta = 2^-1075 (proofs/round.bend, Fl.model). The
# control adds 2^-1100 to each expected value.
import Base
import ../src/big.bend as B
import ../proofs/big.bend as BP
import ../src/int.bend as I
import ../src/dyadic.bend as D
import ../src/round.bend as RD
import ../proofs/eft.bend as E
import ../proofs/eft2.bend as E2
import ../proofs/eft3.bend as E3

# Proven (proofs/eft2.bend): Veltkamp's split with C = 2^27 + 1 is exact in
# binary64 rounding with gradual underflow, for every binary64 value
# A / 2^1074: hi + lo = a.
def F64.Split(+aa: I.Int, +fa: {E.Rn(53n, RD.Int.mag(aa)) == RD.Int.mag(aa) : Nat})
  -> {D.Dy.add(E2.DRf.h(52n, 1022n, 27n, D.Dy.of(Nat.add(1022n, 52n), aa)), E2.DRf.l(52n, 1022n, 27n, D.Dy.of(Nat.add(1022n, 52n), aa))) == D.Dy.of(Nat.add(1022n, 52n), aa) : D.Dy}:
  E2.DRf.split(52n, 1022n, 27n, aa, fa)

# Proven (proofs/eft3.bend): Dekker's product at 53 bits, s = 27, is exact
# with no exponent bounds (binary64 barring underflow and overflow), for a =
# A / 2^k, b = B / 2^k with A, B 53-bit integers. p = 1 + (26 + 26) and s =
# 27 are written as DTwoProd.odd states them.
def F64.TwoProd(+k: Nat, +aa: I.Int, +bb: I.Int, +fa: {E.Rn(1n+Nat.add(1n+1n+24n, 1n+1n+24n), RD.Int.mag(aa)) == RD.Int.mag(aa) : Nat}, +fb: {E.Rn(1n+Nat.add(1n+1n+24n, 1n+1n+24n), RD.Int.mag(bb)) == RD.Int.mag(bb) : Nat})
  -> {D.Dy.add(E2.DTP.p(Nat.add(1n+1n+24n, 1n+1n+24n), D.Dy.of(k, aa), D.Dy.of(k, bb)), E2.DTP.e(Nat.add(1n+1n+24n, 1n+1n+24n), 1n+1n+1n+24n, D.Dy.of(k, aa), D.Dy.of(k, bb))) == D.Dy.mul(D.Dy.of(k, aa), D.Dy.of(k, bb)) : D.Dy}:
  E3.DTwoProd.odd(24n, k, aa, bb, fa, fb)

def hb() -> Nat:
  8388608n

# a, b, a b, a + b, each as the high and low 32 bits of its encoding
type C is Data:
  C{ah: Nat, al: Nat, bh: Nat, bl: Nat, ph: Nat, pl: Nat, sh: Nat, sl: Nat}

# the exact value of a double, from its bits
def dec.go(+s: Bool, +n: B.Bn, +ex: Nat) -> B.Bd:
  Bool.pick(B.Bd, Nat.is_lt(ex, 1075n), B.Bd{s, n, Nat.sub(1075n, ex)}, B.Bd{s, B.Bn.shl(hb(), Nat.sub(ex, 1075n), n), 0n})

def dec(+hi: Nat, +lo: Nat) -> B.Bd:
  +s = Bool.not(Nat.is_lt(hi, 2147483648n))
  +ex = Nat.mod(Nat.div(hi, 1048576n), 2048n)
  +fr = B.Bn.add(hb(), B.Bn.shl(hb(), 32n, B.Bn.of(hb(), Nat.mod(hi, 1048576n))), B.Bn.of(hb(), lo))
  Bool.pick(B.Bd, Nat.is_eq(ex, 0n), dec.go(s, fr, 1n), dec.go(s, B.Bn.add(hb(), fr, B.Bn.pow2(hb(), 52n)), ex))

def Bn.zero(m: B.Bn) -> Bool:
  Bool.not(B.Bn.lt(B.BNil{}, m))

def same.n(x: B.Bd, y: B.Bd) -> Bool:
  match x y:
    case B.Bd{n1, +m1, e1} B.Bd{n2, +m2, e2}:
      Bool.and(Nat.is_eq(e1, e2), Bool.and(Bool.not(Bool.or(B.Bn.lt(m1, m2), B.Bn.lt(m2, m1))), Bool.or(Bn.zero(m1), Bool.not(Bool.xor(n1, n2)))))

def same(x: B.Bd, y: B.Bd) -> Bool:
  same.n(B.Bd.norm(hb(), x), B.Bd.norm(hb(), y))

def want(ctl: Bool, +z: B.Bd) -> B.Bd:
  match ctl:
    case False{}:
      z
    case True{}:
      B.Bd.add(hb(), z, B.Bd{False{}, B.BCons{1n, B.BNil{}}, 1100n})

def bad(+ctl: Bool, c: C) -> Nat:
  match c:
    case C{ah, al, bh, bl, ph, pl, sh, sl}:
      +x = dec(ah, al)
      +y = dec(bh, bl)
      Nat.add(Bool.pick(Nat, same(dec(ph, pl), want(ctl, B.Bd.f64(hb(), B.Bd.mul(hb(), x, y)))), 0n, 1n),
        Bool.pick(Nat, same(dec(sh, sl), want(ctl, B.Bd.f64(hb(), B.Bd.add(hb(), x, y)))), 0n, 1n))

def run(+ctl: Bool, cs: List<&2, C>) -> Nat:
  match cs:
    case Nil{}:
      0n
    case c <> rest:
      Nat.add(bad(ctl, c), run(ctl, rest))

