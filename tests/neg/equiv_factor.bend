# A negative control: equivariance without its factor |m|^2 must fail (copied from algebras/pga3d/equiv.bend, then changed).

import Base
import ../../src/spec.bend as S
import ../../src/ring.bend as R
import ../../src/norm.bend as N
import ../../proofs/equiv.bend as EQ
import ../../algebras/pga3d/kinds.bend as K
import ../../algebras/pga3d/ops.bend as O

# Equivariance (gen/equiv.bend): the versor's sandwich commutes with the
# product, up to |m|², the scalar part of m ~m. A hypothesis, where present,
# is the condition that makes m a versor.


def Motor.vee.Point.Point.equiv_nofactor(~T: Data, ~zero: T, ~one: T, ~add: T -> T -> T, ~mul: T -> T -> T, ~neg: T -> T,
  ~aa: R.Ring.Assoc(T, add), ~ac: R.Ring.Comm(T, add), ~z: R.Ring.ZeroL(T, add, zero), ~inv: R.Ring.AddInv(T, add, neg, zero),
  ~ma: R.Ring.Assoc(T, mul), ~mc: R.Ring.Comm(T, mul), ~u: R.Ring.UnitR(T, mul, one), ~dl: R.Ring.DistL(T, add, mul),
  ~na: R.Ring.NegAdd(T, add, neg), ~nm: R.Ring.NegMulL(T, mul, neg), ~nn: R.Ring.NegNeg(T, neg),
  m: K.Motor<T>, a: K.Point<T>, b: K.Point<T>)
  -> {K.Motor.e0123(T, O.Motor.gp.Motor(~T, ~zero, ~add, ~mul, ~neg, m, O.Motor.reverse(~T, ~zero, ~neg, m))) == zero : T} -> {K.Line.fields(T, O.Point.vee.Point(~T, ~zero, ~add, ~mul, ~neg, O.Motor.transform.Point(~T, ~zero, ~add, ~mul, ~neg, m, a), O.Motor.transform.Point(~T, ~zero, ~add, ~mul, ~neg, m, b)))
    == K.Line.fields(T, K.Line.map(~T, ~T, ~(x => x), O.Motor.transform.Line(~T, ~zero, ~add, ~mul, ~neg, m, O.Point.vee.Point(~T, ~zero, ~add, ~mul, ~neg, a, b)))) : List<&2, T>}:
  match m a b:
    case K.Motor{m_s, m_e23, m_e31, m_e12, m_e01, m_e02, m_e03, m_e0123} K.Point{a_e032, a_e013, a_e021, a_e123} K.Point{b_e032, b_e013, b_e021, b_e123}:
      hr => EQ.Rel.eqs(~T, ~zero, ~one, ~add, ~mul, ~neg, ~aa, ~ac, ~z, ~inv, ~ma, ~mc, ~u, ~dl, ~na, ~nm, ~nn, [m_s, m_e23, m_e31, m_e12, m_e01, m_e02, m_e03, m_e0123, a_e032, a_e013, a_e021, a_e123, b_e032, b_e013, b_e021, b_e123],
        K.Line.fields(N.Tm, O.Point.vee.Point(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, O.Motor.transform.Point(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Motor{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}, K.Point{N.TVar{8n}, N.TVar{9n}, N.TVar{10n}, N.TVar{11n}}), O.Motor.transform.Point(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Motor{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}, K.Point{N.TVar{12n}, N.TVar{13n}, N.TVar{14n}, N.TVar{15n}}))),
        K.Line.fields(N.Tm, K.Line.map(~N.Tm, ~N.Tm, ~(x => x), O.Motor.transform.Line(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Motor{N.TVar{0n}, N.TVar{1n}, N.TVar{2n}, N.TVar{3n}, N.TVar{4n}, N.TVar{5n}, N.TVar{6n}, N.TVar{7n}}, O.Point.vee.Point(~N.Tm, ~N.TZero{}, ~N.Tm.add, ~N.Tm.mul, ~N.Tm.neg, K.Point{N.TVar{8n}, N.TVar{9n}, N.TVar{10n}, N.TVar{11n}}, K.Point{N.TVar{12n}, N.TVar{13n}, N.TVar{14n}, N.TVar{15n}})))),
        [N.TZero{},
         N.TZero{},
         N.TZero{},
         N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{0n}, N.TMul{N.TVar{8n}, N.TVar{15n}}}}}, N.TAdd{N.TMul{N.TVar{0n}, N.TMul{N.TVar{0n}, N.TMul{N.TVar{11n}, N.TVar{12n}}}}, N.TAdd{N.TMul{N.TVar{0n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{10n}, N.TVar{15n}}}}, N.TAdd{N.TMul{N.TVar{0n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{10n}, N.TVar{15n}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{11n}, N.TVar{14n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{11n}, N.TVar{14n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{9n}, N.TVar{15n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{9n}, N.TVar{15n}}}}}, N.TAdd{N.TMul{N.TVar{0n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{11n}, N.TVar{13n}}}}, N.TAdd{N.TMul{N.TVar{0n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{11n}, N.TVar{13n}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{1n}, N.TMul{N.TVar{1n}, N.TMul{N.TVar{8n}, N.TVar{15n}}}}}, N.TAdd{N.TMul{N.TVar{1n}, N.TMul{N.TVar{1n}, N.TMul{N.TVar{11n}, N.TVar{12n}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{1n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{9n}, N.TVar{15n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{1n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{9n}, N.TVar{15n}}}}}, N.TAdd{N.TMul{N.TVar{1n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{11n}, N.TVar{13n}}}}, N.TAdd{N.TMul{N.TVar{1n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{11n}, N.TVar{13n}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{1n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{10n}, N.TVar{15n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{1n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{10n}, N.TVar{15n}}}}}, N.TAdd{N.TMul{N.TVar{1n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{11n}, N.TVar{14n}}}}, N.TAdd{N.TMul{N.TVar{1n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{11n}, N.TVar{14n}}}}, N.TAdd{N.TMul{N.TVar{2n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{8n}, N.TVar{15n}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{2n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{11n}, N.TVar{12n}}}}}, N.TAdd{N.TMul{N.TVar{3n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{8n}, N.TVar{15n}}}}, N.TNeg{N.TMul{N.TVar{3n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{11n}, N.TVar{12n}}}}}}}}}}}}}}}}}}}}}}}}}}}},
         N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{0n}, N.TMul{N.TVar{9n}, N.TVar{15n}}}}}, N.TAdd{N.TMul{N.TVar{0n}, N.TMul{N.TVar{0n}, N.TMul{N.TVar{11n}, N.TVar{13n}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{1n}, N.TMul{N.TVar{10n}, N.TVar{15n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{1n}, N.TMul{N.TVar{10n}, N.TVar{15n}}}}}, N.TAdd{N.TMul{N.TVar{0n}, N.TMul{N.TVar{1n}, N.TMul{N.TVar{11n}, N.TVar{14n}}}}, N.TAdd{N.TMul{N.TVar{0n}, N.TMul{N.TVar{1n}, N.TMul{N.TVar{11n}, N.TVar{14n}}}}, N.TAdd{N.TMul{N.TVar{0n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{8n}, N.TVar{15n}}}}, N.TAdd{N.TMul{N.TVar{0n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{8n}, N.TVar{15n}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{11n}, N.TVar{12n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{0n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{11n}, N.TVar{12n}}}}}, N.TAdd{N.TMul{N.TVar{1n}, N.TMul{N.TVar{1n}, N.TMul{N.TVar{9n}, N.TVar{15n}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{1n}, N.TMul{N.TVar{1n}, N.TMul{N.TVar{11n}, N.TVar{13n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{1n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{8n}, N.TVar{15n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{1n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{8n}, N.TVar{15n}}}}}, N.TAdd{N.TMul{N.TVar{1n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{11n}, N.TVar{12n}}}}, N.TAdd{N.TMul{N.TVar{1n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{11n}, N.TVar{12n}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{2n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{9n}, N.TVar{15n}}}}}, N.TAdd{N.TMul{N.TVar{2n}, N.TMul{N.TVar{2n}, N.TMul{N.TVar{11n}, N.TVar{13n}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{2n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{10n}, N.TVar{15n}}}}}, N.TAdd{N.TNeg{N.TMul{N.TVar{2n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{10n}, N.TVar{15n}}}}}, N.TAdd{N.TMul{N.TVar{2n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{11n}, N.TVar{14n}}}}, N.TAdd{N.TMul{N.TVar{2n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{11n}, N.TVar{14n}}}}, N.TAdd{N.TMul{N.TVar{3n}, N.TMul{N.TVar{3n}, N.TMul{N.TVar{9n}, N.TVar{15n}}}}, N.TNeg{N.TMul{N.TVar{3n}, N.TMul{N.TVar{3n}, N.T