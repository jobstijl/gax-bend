# b-posit32 arithmetic (src/posit.bend) against an independent reference:
# tools/bposit_cases.py rounds the exact result's bit string, as the posit
# standard defines rounding, where src/posit.bend rounds to nearest at the
# scale's precision (21 to 25 bits). 400 products and sums of b-posit32
# pairs (random, near 1, and from the longest regimes), with 27 products
# saturating at maxpos and 22 at minpos, and 40 quire dot products of
# length 8 (Bd.dot, rounded once).
# Every input pattern also decodes and re-encodes to itself. The control
# perturbs each expected pattern by one. proofs/posit.bend (imported, so
# the gate checks it) proves the rounding model for every b-posit format
# (Pz.model) and the run-time rounding equal to the spec (Pz.lk, Pmul.lk,
# Padd.lk, Quire.lk); this test checks the spec against the standard's
# bit-string rounding and checks the bit encoding.
import Base
import ../src/big.bend as B
import ../src/posit.bend as P
import ../proofs/posit.bend as PP

def hb() -> Nat:
  8388608n

# a, b, the pattern of a b, the pattern of a + b
type C is Data:
  C{a: Nat, b: Nat, p: Nat, s: Nat}

# xs, ys, the pattern of their dot product
type Q is Data:
  Q{xs: List<&2, Nat>, ys: List<&2, Nat>, d: Nat}

def dec(+pt: Nat) -> B.Bd:
  P.P32.dec(hb(), pt)

def rd(x: B.Bd) -> Nat:
  P.P32.enc(hb(), P.P32.fl(hb(), x))

def want(+ctl: Bool, +pt: Nat) -> Nat:
  Bool.pick(Nat, ctl, Nat.add(pt, 1n), pt)

def miss(+a: Nat, +b: Nat) -> Nat:
  Bool.pick(Nat, Nat.is_eq(a, b), 0n, 1n)

def bad(+ctl: Bool, c: C) -> Nat:
  match c:
    case C{+a, +b, +p, +s}:
      +x = dec(a)
      +y = dec(b)
      Nat.add(Nat.add(miss(rd(B.Bd.mul(hb(), x, y)), want(ctl, p)), miss(rd(B.Bd.add(hb(), x, y)), want(ctl, s))),
        Nat.add(miss(rd(x), want(ctl, a)), miss(rd(y), want(ctl, b))))

def run(+ctl: Bool, cs: List<&2, C>) -> Nat:
  match cs:
    case Nil{}:
      0n
    case c <> rest:
      Nat.add(bad(ctl, c), run(ctl, rest))

def decs(xs: List<&2, Nat>) -> List<&2, B.Bd>:
  match xs:
    case Nil{}:
      Nil{}
    case x <> xr:
      dec(x) <> decs(xr)

def qbad(+ctl: Bool, q: Q) -> Nat:
  match q:
    case Q{xs, ys, +d}:
      miss(rd(B.Bd.dot(hb(), decs(xs), decs(ys))), want(ctl, d))

def qrun(+ctl: Bool, qs: List<&2, Q>) -> Nat:
  match qs:
    case Nil{}:
      0n
    case q <> rest:
      Nat.add(qbad(ctl, q), qrun(ctl, rest))

