def main() -> IO(Unit):
  do IO<Unit>:
    IO.print("400 b-posit32 products and sums, 800 round trips, mismatches: " ++ Nat.show(run(False{}, cases())))
    IO.print("40 quire dot products of length 8, mismatches: " ++ Nat.show(qrun(False{}, dots())))
    IO.print("control, patterns off by one: " ++ Nat.show(run(True{}, cases())) ++ " and " ++ Nat.show(qrun(True{}, dots())))
#|400 b-posit32 products and sums, 800 round trips, mismatches: 0
#|40 quire dot products of length 8, mismatches: 0
#|control, patterns off by one: 1600 and 40
