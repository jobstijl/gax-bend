# The proof writer's entry point: `bend gen/proofs/main.bend <dir>` writes
# the generated Layer-S proof modules into <dir> (proofs/ by default).

import Base
import ./dsl.bend as D
import ./gp.bend as GP
import ./assoc.bend as AS
import ./wedge.bend as WE
import ./scale.bend as SC
import ./inv.bend as IN
import ./rev.bend as RE
import ./gen.bend as GE
import ./grade.bend as GR
import ./err.bend as ER

def put.fin(r: File & Result<&1, &1, U32 & String, Unit>) -> IO(Unit):
  (f, res) = r
  File.close(f)

def put(path: String, text: String) -> IO(Unit):
  +banner = {"# Generated by gen/proofs/main.bend. Do not edit: run tools/regen.sh.\n#\n" : String}
  do IO<Unit>:
    f : File <- IO.try(File, File.open(path, "w"))
    r : File & Result<&1, &1, U32 & String, Unit> <- File.write(f, banner ++ text)
    put.fin(r)

def outdir.go(args: List<String>) -> String:
  match args:
    case Nil{}:
      "proofs"
    case d <> rest:
      d

def outdir(args: List<String>) -> String:
  match args:
    case Nil{}:
      "proofs"
    case p <> rest:
      outdir.go(rest)

# every flag identity the proofs use, in the order the modules use them
def flags() -> List<&2, D.Fl>:
  List.append(&2, D.Fl, GP.GP.flags(), List.append(&2, D.Fl, AS.A.flags(),
    List.append(&2, D.Fl, WE.W.flags(), List.append(&2, D.Fl, IN.I.flags(), RE.V.flags()))))

def main() -> IO(Unit):
  do IO<Unit>:
    args : List<String> <- IO.args()
    +out : String = outdir(args)
    put(out ++ "/gp.bend", GP.GP.text())
    put(out ++ "/gp_assoc.bend", AS.A.text())
    put(out ++ "/wedge.bend", WE.W.text())
    put(out ++ "/scale.bend", SC.C.text())
    put(out ++ "/inv.bend", IN.I.text())
    put(out ++ "/rev.bend", RE.V.text())
    put(out ++ "/gen.bend", GE.N.text())
    put(out ++ "/grade.bend", GR.Q.text())
    put(out ++ "/err.bend", ER.Er.text())
    put(out ++ "/flags.bend", D.flag.module(flags()))
